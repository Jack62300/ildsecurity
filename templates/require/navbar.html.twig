{# ==================== ICONS ==================== #}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

{# ==================== ROUTE COURANTE & FLAGS ==================== #}
{% set current   = app.request.attributes.get('_route') %}
{% set isInterv  = current starts with 'app_intervention_' %}
{% set isVeh     = current starts with 'admin_vehicle' or current starts with 'admin_fuel' %}
{% set isUtile   = current starts with 'phone_number' %}
{% set isTools   = isVeh or isUtile %}
{% set isAdmin   = current starts with 'users' 
                or current starts with 'agences' 
                or current starts with 'devices'
                or current starts with 'organisme'
                or current starts with 'phone_category'
                or current starts with 'audit_'
                or current starts with 'app_export'
                or current starts with 'mod_request_admin' %}

{# ==================== NAVBAR CSS (existant) ==================== #}
<link rel="stylesheet" href="{{ asset('styles/require/navbar.css') }}">

{# ===== titrage dans les dropdowns ===== #}
<style>
  .dropdown-title{
    padding:.75rem 1.25rem .25rem;
    font-size:.72rem; font-weight:800; letter-spacing:.08em;
    text-transform:uppercase; color:#6b7280;
  }
  .dropdown-sep{ margin:.25rem 0 .5rem; border:0; border-top:1px solid var(--menu-divider); }
</style>

<header class="modern-navbar" role="banner" id="navbar">
  <div class="navbar-container">

    {# ===== Brand ===== #}
    <a class="brand-modern" href="{{ path('app_index') }}">
      <img src="{{ asset('assets/images/logo.png') }}" alt="Logo" class="brand-logo">
      <div class="brand-text">
        <div class="brand-name">ILD SECURITY</div>
        <div class="brand-subtitle">Gestion clients</div>
      </div>
    </a>

    {# ===== Desktop nav ===== #}
    <nav class="nav-modern" role="navigation" aria-label="Navigation principale">
      <ul class="nav-list-modern">

        <li class="nav-item-modern">
          <a class="nav-link-modern {{ current starts with 'app_index' ? 'is-active' }}"
             href="{{ path('app_index') }}">
            <i class="bi bi-house-door nav-icon"></i> Accueil
          </a>
        </li>

        {% if is_granted('ROLE_USER') %}
          {# === Interventions (dropdown principal) === #}
          <li class="nav-item-modern nav-dropdown">
            <button class="dropdown-toggle-modern {{ isInterv ? 'is-active' : '' }}"
                    type="button" data-dropdown="menu-interv"
                    aria-expanded="{{ isInterv ? 'true' : 'false' }}">
              <i class="bi bi-clipboard-check nav-icon"></i>
              Interventions
              <i class="bi bi-chevron-down dropdown-arrow"></i>
            </button>
            <div class="dropdown-menu-modern" id="menu-interv" role="menu">
              <div class="dropdown-title">Interventions</div>
              <hr class="dropdown-sep">
              <a class="dropdown-item-modern {{ current == 'app_intervention_index' ? 'is-active' }}"
                 href="{{ path('app_intervention_index') }}">
                <i class="bi bi-list-ul"></i> Tous les bons
              </a>
              <a class="dropdown-item-modern {{ current == 'app_intervention_new' ? 'is-active' }}"
                 href="{{ path('app_intervention_new') }}">
                <i class="bi bi-file-earmark-plus"></i> Nouveau bon
              </a>
            </div>
          </li>

          {# === Outils (dropdown principal) === #}
          <li class="nav-item-modern nav-dropdown">
            <button class="dropdown-toggle-modern {{ isTools ? 'is-active' : '' }}"
                    type="button" data-dropdown="menu-tools"
                    aria-expanded="{{ isTools ? 'true' : 'false' }}">
              <i class="bi bi-tools nav-icon"></i>
              Outils
              <i class="bi bi-chevron-down dropdown-arrow"></i>
            </button>
            <div class="dropdown-menu-modern" id="menu-tools" role="menu">
              <div class="dropdown-title">Véhicules</div>
              <hr class="dropdown-sep">
              <a class="dropdown-item-modern {{ current == 'admin_vehicle_index' ? 'is-active' }}"
                 href="{{ path('admin_vehicle_index') }}">
                <i class="bi bi-truck"></i> Flotte de véhicules
              </a>
              <a class="dropdown-item-modern {{ current == 'admin_fuel_index' ? 'is-active' }}"
                 href="{{ path('admin_fuel_index') }}">
                <i class="bi bi-fuel-pump"></i> Gestion carburant
              </a>

              <div class="dropdown-title">Utile</div>
              <hr class="dropdown-sep">
              <a class="dropdown-item-modern {{ current == 'phone_number_index' ? 'is-active' }}"
                 href="{{ path('phone_number_index') }}">
                <i class="bi bi-telephone"></i> Numéros utiles
              </a>
            </div>
          </li>
        {% endif %}

        {% if is_granted('ROLE_ADMIN') %}
          {# === Administration (dropdown principal) === #}
          <li class="nav-item-modern nav-dropdown">
            <button class="dropdown-toggle-modern {{ isAdmin ? 'is-active' : '' }}"
                    type="button" data-dropdown="menu-admin"
                    aria-expanded="{{ isAdmin ? 'true' : 'false' }}">
              <i class="bi bi-gear nav-icon"></i>
              Administration
              <i class="bi bi-chevron-down dropdown-arrow"></i>
            </button>
            <div class="dropdown-menu-modern" id="menu-admin" role="menu">
              <div class="dropdown-title">Gestion</div>
              <hr class="dropdown-sep">
              <a class="dropdown-item-modern {{ current starts with 'users' ? 'is-active' }}"
                 href="{{ path('users_index') }}">
                <i class="bi bi-people"></i> Utilisateurs
              </a>
              <a class="dropdown-item-modern {{ current starts with 'agences' ? 'is-active' }}"
                 href="{{ path('agences_index') }}">
                <i class="bi bi-building"></i> Agences
              </a>
              <a class="dropdown-item-modern {{ current starts with 'organisme' ? 'is-active' }}"
                 href="{{ path('organisme_index') }}">
                <i class="bi bi-bank"></i> Organismes
              </a>
              <a class="dropdown-item-modern {{ current starts with 'phone_category' ? 'is-active' }}"
                 href="{{ path('phone_category_index') }}">
                <i class="bi bi-tags"></i> Catégories utiles
              </a>

              <div class="dropdown-title">Sécurité</div>
              <hr class="dropdown-sep">
              <a class="dropdown-item-modern {{ current starts with 'devices' ? 'is-active' }}"
                 href="{{ path('devices_index') }}">
                <i class="bi bi-phone"></i> Appareils
              </a>
              <a class="dropdown-item-modern {{ current starts with 'audit_' ? 'is-active' }}"
                 href="{{ path('audit_index') }}">
                <i class="bi bi-stickies-fill"></i> Logs
              </a>

              <div class="dropdown-title">Système</div>
              <hr class="dropdown-sep">
              <a class="dropdown-item-modern {{ current starts with 'mod_request_admin' ? 'is-active' }}"
                 href="{{ path('mod_request_admin_index') }}">
                <i class="bi bi-lightbulb"></i> Suggestions
              </a>
              <a class="dropdown-item-modern {{ current starts with 'app_export' ? 'is-active' }}"
                 href="{{ path('app_export') }}">
                <i class="bi bi-filetype-csv"></i> Exportation
              </a>
            </div>
          </li>
        {% endif %}

      </ul>
    </nav>

    {# ===== User (desktop) ===== #}
    {% if app.user %}
      <div class="user-section-modern">
        <div class="user-profile-modern">
          <img src="{{ asset('assets/images/logo.png') }}" alt="Avatar {{ app.user.username }}" class="user-avatar-modern">
          <div class="user-info-modern">
            <div class="user-name-modern">{{ app.user.username }}</div>
            <div class="user-role-modern">
              {% if is_granted('ROLE_ADMIN') %}Administrateur{% else %}Utilisateur{% endif %}
            </div>
          </div>
        </div>
        <a href="{{ path('app_logout') }}" class="logout-btn-modern">
          <i class="bi bi-box-arrow-right"></i> Déconnexion
        </a>
      </div>
    {% endif %}

    {# ===== Burger (mobile) ===== #}
    <button class="burger-modern" aria-label="Menu" aria-expanded="false" data-mobile-menu="toggle">
      <span class="burger-line"></span>
      <span class="burger-line"></span>
      <span class="burger-line"></span>
    </button>

  </div>
</header>

{# ==================== MENU MOBILE (sections simples) ==================== #}
<div class="mobile-menu-modern" id="mobile-menu">
  <ul class="mobile-nav-list">
    <li><a class="mobile-nav-link {{ current starts with 'app_index' ? 'is-active' }}" href="{{ path('app_index') }}"><i class="bi bi-house-door"></i> Accueil</a></li>

    {% if is_granted('ROLE_USER') %}
      <li class="nav-label-modern" style="padding: .25rem 1rem; color:#6b7280;">Interventions</li>
      <li><a class="mobile-nav-link {{ current == 'app_intervention_index' ? 'is-active' }}" href="{{ path('app_intervention_index') }}"><i class="bi bi-list-ul"></i> Tous les bons</a></li>
      <li><a class="mobile-nav-link {{ current == 'app_intervention_new' ? 'is-active' }}" href="{{ path('app_intervention_new') }}"><i class="bi bi-file-earmark-plus"></i> Nouveau bon</a></li>

      <li class="nav-label-modern" style="padding: .5rem 1rem .25rem; color:#6b7280; ">Outils</li>
      <li><a class="mobile-nav-link {{ current == 'admin_vehicle_index' ? 'is-active' }}" href="{{ path('admin_vehicle_index') }}"><i class="bi bi-truck"></i> Flotte de véhicules</a></li>
      <li><a class="mobile-nav-link {{ current == 'admin_fuel_index' ? 'is-active' }}" href="{{ path('admin_fuel_index') }}"><i class="bi bi-fuel-pump"></i> Gestion carburant</a></li>
      <li><a class="mobile-nav-link {{ current == 'phone_number_index' ? 'is-active' }}" href="{{ path('phone_number_index') }}"><i class="bi bi-telephone"></i> Numéros utiles</a></li>
    {% endif %}

    {% if is_granted('ROLE_ADMIN') %}
      <li class="nav-label-modern" style="padding: .5rem 1rem .25rem; color:#6b7280;">Administration</li>
      <li><a class="mobile-nav-link {{ current starts with 'users' ? 'is-active' }}" href="{{ path('users_index') }}"><i class="bi bi-people"></i> Utilisateurs</a></li>
      <li><a class="mobile-nav-link {{ current starts with 'agences' ? 'is-active' }}" href="{{ path('agences_index') }}"><i class="bi bi-building"></i> Agences</a></li>
      <li><a class="mobile-nav-link {{ current starts with 'organisme' ? 'is-active' }}" href="{{ path('organisme_index') }}"><i class="bi bi-bank"></i> Organismes</a></li>
      <li><a class="mobile-nav-link {{ current starts with 'phone_category' ? 'is-active' }}" href="{{ path('phone_category_index') }}"><i class="bi bi-tags"></i> Catégories utiles</a></li>
      <li><a class="mobile-nav-link {{ current starts with 'devices' ? 'is-active' }}" href="{{ path('devices_index') }}"><i class="bi bi-phone"></i> Appareils</a></li>
      <li><a class="mobile-nav-link {{ current starts with 'audit_' ? 'is-active' }}" href="{{ path('audit_index') }}"><i class="bi bi-stickies-fill"></i> Logs</a></li>
      <li><a class="mobile-nav-link {{ current starts with 'mod_request_admin' ? 'is-active' }}" href="{{ path('mod_request_admin_index') }}"><i class="bi bi-lightbulb"></i> Suggestions</a></li>
      <li><a class="mobile-nav-link {{ current starts with 'app_export' ? 'is-active' }}" href="{{ path('app_export') }}"><i class="bi bi-filetype-csv"></i> Exportation</a></li>
    {% endif %}
  </ul>

  {% if app.user %}
    <div class="mobile-user-section">
      <div class="user-profile-modern">
        <img src="{{ asset('assets/images/logo2.png') }}" alt="Avatar {{ app.user.username }}" class="user-avatar-modern">
        <div class="user-info-modern">
          <div class="user-name-modern">{{ app.user.username }}</div>
          <div class="user-role-modern">
            {% if is_granted('ROLE_ADMIN') %}Administrateur{% else %}Utilisateur{% endif %}
          </div>
        </div>
      </div>
      <a href="{{ path('app_logout') }}" class="logout-btn-modern">
        <i class="bi bi-box-arrow-right"></i> Déconnexion
      </a>
    </div>
  {% endif %}
</div>

{# ==================== JS : dropdowns principaux + burger ==================== #}
<script>
document.addEventListener('DOMContentLoaded', function () {
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) navbar.classList.add('scrolled');
    else navbar.classList.remove('scrolled');
  });

  // Dropdowns (niveau 1 uniquement)
  const toggles = document.querySelectorAll('[data-dropdown]');
  toggles.forEach(btn => {
    const menu = document.getElementById(btn.getAttribute('data-dropdown'));
    if (!menu) return;
    btn.addEventListener('click', (e) => {
      e.preventDefault(); e.stopPropagation();
      // fermer les autres
      toggles.forEach(b => {
        const m = document.getElementById(b.getAttribute('data-dropdown'));
        if (b !== btn && m) { m.classList.remove('show'); b.classList.remove('is-active'); b.setAttribute('aria-expanded','false'); }
      });
      const open = menu.classList.contains('show');
      menu.classList.toggle('show', !open);
      btn.classList.toggle('is-active', !open);
      btn.setAttribute('aria-expanded', String(!open));
    });
  });

  // Fermer au clic à l’extérieur
  document.addEventListener('click', () => {
    toggles.forEach(b => {
      const m = document.getElementById(b.getAttribute('data-dropdown'));
      if (m) { m.classList.remove('show'); b.classList.remove('is-active'); b.setAttribute('aria-expanded','false'); }
    });
  });

  // Mobile burger
  const burgerBtn = document.querySelector('[data-mobile-menu="toggle"]');
  const mobileMenu = document.getElementById('mobile-menu');
  if (burgerBtn && mobileMenu) {
    burgerBtn.addEventListener('click', function () {
      const open = this.classList.contains('active');
      this.classList.toggle('active', !open);
      mobileMenu.classList.toggle('show', !open);
      this.setAttribute('aria-expanded', String(!open));
      document.body.style.overflow = open ? '' : 'hidden';
    });
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        burgerBtn.classList.remove('active');
        mobileMenu.classList.remove('show');
        burgerBtn.setAttribute('aria-expanded','false');
        document.body.style.overflow = '';
      });
    });
  }

  // ESC
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      toggles.forEach(b => {
        const m = document.getElementById(b.getAttribute('data-dropdown'));
        if (m) { m.classList.remove('show'); b.classList.remove('is-active'); b.setAttribute('aria-expanded','false'); }
      });
      if (burgerBtn && mobileMenu) {
        burgerBtn.classList.remove('active');
        mobileMenu.classList.remove('show');
        burgerBtn.setAttribute('aria-expanded','false');
        document.body.style.overflow = '';
      }
    }
  });
});
</script>
