{# ==================== ICONS (Bootstrap) ==================== #}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

{% set current = app.request.attributes.get('_route') %}
{% set isVeh   = current starts with 'admin_vehicle' or current starts with 'admin_fuel' %}
{% set isUtile = current starts with 'phone_number' %}
{% set isTools = isVeh or isUtile %}
{% set isInterv = current starts with 'app_intervention_' %}

{# ==================== STYLES ==================== #}
<link rel="stylesheet" href="{{ asset('styles/require/navbar.css') }}">

{# ==================== NAVBAR ==================== #}
<header class="modern-navbar" role="banner" id="navbar">
  <div class="navbar-container">

    <a class="brand-modern" href="{{ path('app_index') }}">
      <img src="{{ asset('assets/images/logo.png') }}" alt="Logo" class="brand-logo">
      <div class="brand-text">
        <div class="brand-name">ILD SECURITY</div>
        <div class="brand-subtitle">Gestion clients</div>
      </div>
      
    </a>

    <nav class="nav-modern" role="navigation" aria-label="Navigation principale">
      <ul class="nav-list-modern">

        <li class="nav-item-modern">
          <a class="nav-link-modern {{ current starts with 'app_index' ? 'is-active' }}" href="{{ path('app_index') }}">
            <i class="bi bi-house-door nav-icon"></i>
            Accueil
          </a>
        </li>

        {% if is_granted('ROLE_USER') %}

          {# ===== Interventions ===== #}
          <li class="nav-item-modern nav-dropdown">
            <button class="dropdown-toggle-modern {{ isInterv ? 'is-active' }}" type="button"
                    data-dropdown="interventions-menu"
                    aria-expanded="{{ isInterv ? 'true' : 'false' }}">
              <i class="bi bi-clipboard-check nav-icon"></i>
              Interventions
              <i class="bi bi-chevron-down dropdown-arrow"></i>
            </button>

            <div class="dropdown-menu-modern" id="interventions-menu">
              <a class="dropdown-item-modern {{ current == 'app_intervention_index' ? 'is-active' }}"
                 href="{{ path('app_intervention_index') }}">
                <i class="bi bi-list-ul"></i>
                Tous les bons
              </a>
              <a class="dropdown-item-modern {{ current == 'app_intervention_new' ? 'is-active' }}"
                 href="{{ path('app_intervention_new') }}">
                <i class="bi bi-file-earmark-plus"></i>
                Nouveau bon
              </a>
            </div>
          </li>

          {# ===== Outils (Véhicules + Utile) ===== #}
          <li class="nav-item-modern nav-dropdown">
            <button class="dropdown-toggle-modern {{ isTools ? 'is-active' }}" type="button"
                    data-dropdown="tools-menu"
                    aria-expanded="{{ isTools ? 'true' : 'false' }}">
              <i class="bi bi-tools nav-icon"></i>
              Outils
              <i class="bi bi-chevron-down dropdown-arrow"></i>
            </button>

            <div class="dropdown-menu-modern" id="tools-menu">
              {# --- Sous-sous-menu Véhicules --- #}
              <div class="dropdown-submenu">
                <button class="dropdown-toggle-modern submenu-toggle {{ isVeh ? 'is-active' }}"
                        type="button"
                        data-submenu="tools-vehicles"
                        aria-expanded="{{ isVeh ? 'true' : 'false' }}">
                  <i class="bi bi-truck"></i>
                  Véhicules
                  <i class="bi bi-chevron-right submenu-arrow"></i>
                </button>
                <div class="dropdown-menu-modern submenu" id="tools-vehicles" role="menu">
                  <a class="dropdown-item-modern {{ current == 'admin_vehicle_index' ? 'is-active' }}"
                     href="{{ path('admin_vehicle_index') }}">
                    <i class="bi bi-truck"></i>
                    Flotte de véhicules
                  </a>
                  <a class="dropdown-item-modern {{ current == 'admin_fuel_index' ? 'is-active' }}"
                     href="{{ path('admin_fuel_index') }}">
                    <i class="bi bi-fuel-pump"></i>
                    Gestion carburant
                  </a>
                </div>
              </div>

              {# --- Sous-sous-menu Utile --- #}
              <div class="dropdown-submenu">
                <button class="dropdown-toggle-modern submenu-toggle {{ isUtile ? 'is-active' }}"
                        type="button"
                        data-submenu="tools-utile"
                        aria-expanded="{{ isUtile ? 'true' : 'false' }}">
                  <i class="bi bi-bookmark-star"></i>
                  Utile
                  <i class="bi bi-chevron-right submenu-arrow"></i>
                </button>
                <div class="dropdown-menu-modern submenu" id="tools-utile" role="menu">
                  <a class="dropdown-item-modern {{ current == 'phone_number_index' ? 'is-active' }}"
                     href="{{ path('phone_number_index') }}">
                    <i class="bi bi-telephone"></i>
                    Numéros utiles
                  </a>
                </div>
              </div>
            </div>
          </li>
        {% endif %}

        {% if is_granted('ROLE_ADMIN') %}
          {# ===== Administration ===== #}
          <li class="nav-item-modern nav-dropdown">
            <button class="dropdown-toggle-modern {{ (current starts with 'users' or current starts with 'agences' or current starts with 'devices' or current starts with 'organisme' or current starts with 'phone_category') ? 'is-active' }}"
                    type="button" data-dropdown="admin-menu" aria-expanded="false">
              <i class="bi bi-gear nav-icon"></i>
              Administration
              <i class="bi bi-chevron-down dropdown-arrow"></i>
            </button>

            <div class="dropdown-menu-modern" id="admin-menu">
              <a class="dropdown-item-modern" href="{{ path('users_index') }}">
                <i class="bi bi-people"></i>
                Utilisateurs
              </a>
              <a class="dropdown-item-modern" href="{{ path('agences_index') }}">
                <i class="bi bi-building"></i>
                Agences
              </a>
              <a class="dropdown-item-modern" href="{{ path('mod_request_admin_index') }}">
                <i class="bi bi-building"></i>
                Suggestions
              </a>
              <a class="dropdown-item-modern" href="{{ path('devices_index') }}">
                <i class="bi bi-phone"></i>
                Appareils
              </a>
              <a class="dropdown-item-modern" href="{{ path('organisme_index') }}">
                <i class="bi bi-bank"></i>
                Organismes
              </a>
              <a class="dropdown-item-modern" href="{{ path('app_export') }}">
                <i class="bi bi-filetype-csv"></i>
                Exportation
              </a>
              <a class="dropdown-item-modern {{ current starts with 'phone_category' ? 'is-active' }}"
                 href="{{ path('phone_category_index') }}">
                <i class="bi bi-tags"></i>
                Catégories utiles
              </a>
            </div>
          </li>
        {% endif %}

      </ul>
    </nav>

    {% if app.user %}
      <div class="user-section-modern">
        <div class="user-profile-modern">
          <img src="{{ asset('assets/images/logo.png') }}" alt="Avatar {{ app.user.username }}" class="user-avatar-modern">
          <div class="user-info-modern">
            <div class="user-name-modern">{{ app.user.username }}</div>
            <div class="user-role-modern">
              {% if is_granted('ROLE_ADMIN') %}Administrateur{% else %}Utilisateur{% endif %}
            </div>
          </div>
        </div>
        <a href="{{ path('app_logout') }}" class="logout-btn-modern">
          <i class="bi bi-box-arrow-right"></i>
          Déconnexion
        </a>
      </div>
    {% endif %}

    <button class="burger-modern" aria-label="Menu" aria-expanded="false" data-mobile-menu="toggle">
      <span class="burger-line"></span>
      <span class="burger-line"></span>
      <span class="burger-line"></span>
    </button>

  </div>
</header>

{# ==================== MENU MOBILE ==================== #}
<div class="mobile-menu-modern" id="mobile-menu">
  <ul class="mobile-nav-list">
    <li>
      <a class="mobile-nav-link {{ current starts with 'app_index' ? 'is-active' }}" href="{{ path('app_index') }}">
        <i class="bi bi-house-door"></i>
        Accueil
      </a>
    </li>

    {% if is_granted('ROLE_USER') %}
      {# Interventions (mobile) #}
      <li>
        <a class="mobile-nav-link {{ current == 'app_intervention_index' ? 'is-active' }}" href="{{ path('app_intervention_index') }}">
          <i class="bi bi-list-ul"></i>
          Tous les bons
        </a>
      </li>
      <li>
        <a class="mobile-nav-link {{ current == 'app_intervention_new' ? 'is-active' }}" href="{{ path('app_intervention_new') }}">
          <i class="bi bi-file-earmark-plus"></i>
          Nouveau bon
        </a>
      </li>

      {# Outils (mobile) #}
      <li>
        <button class="mobile-nav-link mobile-accordion {{ isTools ? 'is-active' }}"
                type="button"
                data-mobile-submenu="m-tools"
                aria-expanded="{{ isTools ? 'true' : 'false' }}">
          <i class="bi bi-tools"></i>
          Outils
          <i class="bi bi-chevron-down" style="margin-left:auto;"></i>
        </button>
        <ul class="mobile-sublist" id="m-tools">
          <li>
            <button class="mobile-nav-link mobile-accordion {{ isVeh ? 'is-active' }}"
                    type="button"
                    data-mobile-submenu="m-tools-veh"
                    aria-expanded="{{ isVeh ? 'true' : 'false' }}">
              <i class="bi bi-truck"></i>
              Véhicules
              <i class="bi bi-chevron-down" style="margin-left:auto;"></i>
            </button>
            <ul class="mobile-sublist" id="m-tools-veh">
              <li>
                <a class="mobile-nav-link {{ current == 'admin_vehicle_index' ? 'is-active' }}" href="{{ path('admin_vehicle_index') }}">
                  <i class="bi bi-truck"></i> Flotte de véhicules
                </a>
              </li>
              <li>
                <a class="mobile-nav-link {{ current == 'admin_fuel_index' ? 'is-active' }}" href="{{ path('admin_fuel_index') }}">
                  <i class="bi bi-fuel-pump"></i> Gestion carburant
                </a>
              </li>
            </ul>
          </li>

          <li>
            <button class="mobile-nav-link mobile-accordion {{ isUtile ? 'is-active' }}"
                    type="button"
                    data-mobile-submenu="m-tools-utile"
                    aria-expanded="{{ isUtile ? 'true' : 'false' }}">
              <i class="bi bi-bookmark-star"></i>
              Utile
              <i class="bi bi-chevron-down" style="margin-left:auto;"></i>
            </button>
            <ul class="mobile-sublist" id="m-tools-utile">
              <li>
                <a class="mobile-nav-link {{ current == 'phone_number_index' ? 'is-active' }}" href="{{ path('phone_number_index') }}">
                  <i class="bi bi-telephone"></i> Numéros utiles
                </a>
              </li>
            </ul>
          </li>
        </ul>
      </li>
    {% endif %}

    {% if is_granted('ROLE_ADMIN') %}
      <li><a class="mobile-nav-link {{ current starts with 'users' ? 'is-active' }}" href="{{ path('users_index') }}"><i class="bi bi-people"></i> Utilisateurs</a></li>
      <li><a class="mobile-nav-link {{ current starts with 'agences' ? 'is-active' }}" href="{{ path('agences_index') }}"><i class="bi bi-building"></i> Agences</a></li>
      <li><a class="mobile-nav-link {{ current starts with 'devices' ? 'is-active' }}" href="{{ path('devices_index') }}"><i class="bi bi-phone"></i> Appareils</a></li>
      <li><a class="mobile-nav-link {{ current starts with 'organisme' ? 'is-active' }}" href="{{ path('organisme_index') }}"><i class="bi bi-bank"></i> Organismes</a></li>
      <li><a class="mobile-nav-link {{ current starts with 'export' ? 'is-active' }}" href="{{ path('app_export') }}"><i class="bi bi-download"></i> Export</a></li>
      <li><a class="mobile-nav-link {{ current starts with 'phone_category' ? 'is-active' }}" href="{{ path('phone_category_index') }}"><i class="bi bi-tags"></i> Catégories utiles</a></li>
    {% endif %}
  </ul>

  {% if app.user %}
    <div class="mobile-user-section">
      <div class="user-profile-modern">
        <img src="{{ asset('assets/images/logo2.png') }}" alt="Avatar {{ app.user.username }}" class="user-avatar-modern">
        <div class="user-info-modern">
          <div class="user-name-modern">{{ app.user.username }}</div>
          <div class="user-role-modern">
            {% if is_granted('ROLE_ADMIN') %}Administrateur{% else %}Utilisateur{% endif %}
          </div>
        </div>
      </div>
      <a href="{{ path('app_logout') }}" class="logout-btn-modern">
        <i class="bi bi-box-arrow-right"></i>
        Déconnexion
      </a>
    </div>
  {% endif %}
</div>

{# ==================== SCRIPTS ==================== #}
<script>
document.addEventListener('DOMContentLoaded', function () {
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) navbar.classList.add('scrolled');
    else navbar.classList.remove('scrolled');
  });

  // Dropdowns (niveau 1)
  const dropdownToggles = document.querySelectorAll('[data-dropdown]');
  dropdownToggles.forEach(toggle => {
    const dropdown = document.getElementById(toggle.getAttribute('data-dropdown'));
    if (!dropdown) return;
    toggle.addEventListener('click', (e) => {
      e.preventDefault(); e.stopPropagation();
      // Fermer autres menus de niveau 1
      dropdownToggles.forEach(t => {
        const d = document.getElementById(t.getAttribute('data-dropdown'));
        if (t !== toggle && d) { d.classList.remove('show'); t.setAttribute('aria-expanded','false'); t.classList.remove('is-active'); }
      });
      // Fermer tous les sous-menus ouverts
      document.querySelectorAll('.dropdown-menu-modern.submenu').forEach(sm => sm.classList.remove('show'));
      document.querySelectorAll('.submenu-toggle').forEach(st => { st.setAttribute('aria-expanded','false'); st.classList.remove('is-active'); });

      const isOpen = dropdown.classList.contains('show');
      dropdown.classList.toggle('show', !isOpen);
      toggle.classList.toggle('is-active', !isOpen);
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });
  });

  // Sous-menus (niveau 2)
  const submenuToggles = document.querySelectorAll('[data-submenu]');
  submenuToggles.forEach(st => {
    const submenu = document.getElementById(st.getAttribute('data-submenu'));
    if (!submenu) return;
    st.addEventListener('click', (e) => {
      e.preventDefault(); e.stopPropagation();
      // Fermer autres sous-menus du même parent
      const parentMenu = st.closest('.dropdown-menu-modern');
      parentMenu.querySelectorAll('.dropdown-menu-modern.submenu').forEach(sm => {
        if (sm !== submenu) sm.classList.remove('show');
      });
      parentMenu.querySelectorAll('.submenu-toggle').forEach(other => {
        if (other !== st) { other.setAttribute('aria-expanded','false'); other.classList.remove('is-active'); }
      });
      const isOpen = submenu.classList.contains('show');
      submenu.classList.toggle('show', !isOpen);
      st.classList.toggle('is-active', !isOpen);
      st.setAttribute('aria-expanded', String(!isOpen));
    });
  });

  // Fermer au clic en dehors
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.nav-dropdown')) {
      dropdownToggles.forEach(t => {
        const d = document.getElementById(t.getAttribute('data-dropdown'));
        if (d) { d.classList.remove('show'); t.setAttribute('aria-expanded','false'); t.classList.remove('is-active'); }
      });
      document.querySelectorAll('.dropdown-menu-modern.submenu').forEach(sm => sm.classList.remove('show'));
      document.querySelectorAll('.submenu-toggle').forEach(st => { st.setAttribute('aria-expanded','false'); st.classList.remove('is-active'); });
    }
  });

  // Mobile menu
  const burgerBtn = document.querySelector('[data-mobile-menu="toggle"]');
  const mobileMenu = document.getElementById('mobile-menu');
  if (burgerBtn && mobileMenu) {
    burgerBtn.addEventListener('click', function () {
      const isOpen = this.classList.contains('active');
      this.classList.toggle('active', !isOpen);
      mobileMenu.classList.toggle('show', !isOpen);
      this.setAttribute('aria-expanded', String(!isOpen));
      document.body.style.overflow = isOpen ? '' : 'hidden';
    });
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        burgerBtn.classList.remove('active');
        mobileMenu.classList.remove('show');
        burgerBtn.setAttribute('aria-expanded','false');
        document.body.style.overflow = '';
      });
    });
  }

  // Accordions mobile
  document.querySelectorAll('[data-mobile-submenu]').forEach(btn => {
    const list = document.getElementById(btn.getAttribute('data-mobile-submenu'));
    if (!list) return;
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const isOpen = list.classList.contains('show');
      // Fermer frères
      const container = btn.closest('li');
      container?.parentElement?.querySelectorAll('.mobile-sublist').forEach(ul => { if (ul !== list) ul.classList.remove('show'); });
      container?.parentElement?.querySelectorAll('[data-mobile-submenu]').forEach(b => { if (b !== btn) b.setAttribute('aria-expanded','false'); });
      list.classList.toggle('show', !isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  });

  // ESC to close
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      dropdownToggles.forEach(t => {
        const d = document.getElementById(t.getAttribute('data-dropdown'));
        if (d) { d.classList.remove('show'); t.setAttribute('aria-expanded','false'); t.classList.remove('is-active'); }
      });
      document.querySelectorAll('.dropdown-menu-modern.submenu').forEach(sm => sm.classList.remove('show'));
      document.querySelectorAll('.submenu-toggle').forEach(st => { st.setAttribute('aria-expanded','false'); st.classList.remove('is-active'); });
      if (burgerBtn && mobileMenu) {
        burgerBtn.classList.remove('active');
        mobileMenu.classList.remove('show');
        burgerBtn.setAttribute('aria-expanded','false');
        document.body.style.overflow = '';
      }
    }
  });
});
</script>
