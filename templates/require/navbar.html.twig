{# ==================== ICONS (Bootstrap) ==================== #}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

{% set current = app.request.attributes.get('_route') %}
{% set isVeh   = current starts with 'admin_vehicle' or current starts with 'admin_fuel' %}
{% set isUtile = current starts with 'phone_number' %}
{% set isTools = isVeh or isUtile %}
{% set isInterv = current starts with 'app_intervention_' %}

{# ==================== STYLES ==================== #}
{% block stylesheets %}
<style>
/* Navbar modern — ILD SECURITY — THEME SÉCURITÉ PRIVÉE */
/* Date: 2025-10-03 */
/* Hypothèse : :root définit déjà --brand-dark, --brand, --brand-mid, --accent-amber, --primary-gradient, --border-radius, --transition. 
   Si besoin local, dé-commenter ci-dessous et ajuster :
:root{
  --brand-dark:#0b1e39; --brand:#0a3a7a; --brand-mid:#1a4f9a; --accent-amber:#f59e0b;
  --primary-gradient: linear-gradient(135deg, var(--brand-dark) 0%, var(--brand) 100%);
  --border-radius:12px; --transition: all .3s cubic-bezier(.4,0,.2,1);
}
*/
:root{
  --navbar-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  --icon-color: color-mix(in oklab, var(--brand) 75%, #7aa2d8);
  --icon-color-hover: var(--brand);
  --icon-color-active: #ffffff;
  --brand-dark: #0b1e39;         /* Bleu nuit profond */
  --brand: #0a3a7a;              /* Bleu sécurité (focus/cta) */
  --brand-light: #e6eef8;        /* Fond clair bleuté */
  --accent-amber: #f59e0b;       /* Pour alertes / badges info */
  --muted-blue: #94a3b8;
}

/* ===== NAVBAR SHELL ===== */
.modern-navbar {
  background: rgba(255, 255, 255, .95);
  backdrop-filter: blur(20px);
  border-bottom: 5px solid color-mix(in oklab, var(--accent-amber) 45%, transparent);
  box-shadow: var(--navbar-shadow);
  position: sticky; top: 0; z-index: 1050;
  transition: var(--transition);
}
.modern-navbar.scrolled {
  background: rgba(255, 255, 255, .98);
  box-shadow: 0 12px 40px rgba(0, 0, 0, .15);
}
.navbar-container {
  max-width: 1400px; margin: 0 auto; padding: 0 2rem;
  display: flex; align-items: center; justify-content: space-between; min-height: 80px;
}

/* ===== BRAND ===== */
.brand-modern {
  display: flex; align-items: center; gap: 1rem;
  text-decoration: none; color: #2d3748; font-weight: 700; font-size: 1.5rem;
  transition: var(--transition); position: relative; z-index: 1051;
}
.brand-modern:hover { color: var(--brand); transform: translateY(-2px); }
.brand-logo { height: 50px; width: auto; transition: var(--transition); border-radius: 8px; }
.brand-modern:hover .brand-logo { transform: scale(1.05); }
.brand-text { display: flex; flex-direction: column; line-height: 1.2; }
.brand-name { font-size: 1.25rem; font-weight: 800; }
.brand-subtitle { font-size: 0.75rem; opacity: .7; font-weight: 500; }

/* ===== DESKTOP NAV ===== */
.nav-modern { display: flex; align-items: center; gap: 0.5rem; margin: 0 auto; }
.nav-list-modern { display: flex; align-items: center; gap: 0.5rem; list-style: none; margin: 0; padding: 0; }
.nav-item-modern { position: relative; }

.nav-link-modern {
  display: flex; align-items: center; gap: 0.5rem;
  padding: 0.75rem 1.25rem; border-radius: var(--border-radius);
  text-decoration: none; color: #4a5568; font-weight: 600; font-size: 0.95rem;
  transition: var(--transition); position: relative; overflow: hidden;
}
.nav-link-modern::before {
  content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%;
  background: linear-gradient(90deg,transparent,color-mix(in oklab, var(--brand) 15%, transparent),transparent);
  transition: left 0.5s;
}
.nav-link-modern:hover::before { left: 100%; }
.nav-link-modern:hover {
  color: var(--brand);
  background: color-mix(in oklab, var(--brand) 8%, #eef2f7);
  transform: translateY(-2px);
}
.nav-link-modern.is-active {
  background: var(--primary-gradient); color: #fff;
  box-shadow: 0 4px 15px color-mix(in oklab, var(--brand-dark) 35%, transparent);
}
.nav-link-modern.is-active:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px color-mix(in oklab, var(--brand-dark) 45%, transparent);
}

/* unified icon look */
.nav-icon { font-size: 1.05rem; color: var(--icon-color); transition: var(--transition); }
.nav-link-modern:hover .nav-icon,
.dropdown-toggle-modern:hover .nav-icon { color: var(--icon-color-hover); }
.nav-link-modern.is-active .nav-icon,
.dropdown-toggle-modern.is-active .nav-icon { color: var(--icon-color-active); }

/* ===== DROPDOWNS (niveau 1) ===== */
.nav-dropdown { position: relative; }
.dropdown-toggle-modern {
  display: flex; align-items: center; gap: 0.5rem;
  padding: 0.75rem 1.25rem; border-radius: var(--border-radius);
  text-decoration: none; color: #4a5568; font-weight: 600; font-size: 0.95rem;
  transition: var(--transition); background: none; border: none; cursor: pointer; width: 100%;
}
.dropdown-toggle-modern:hover {
  color: var(--brand);
  background: color-mix(in oklab, var(--brand) 8%, #eef2f7);
  transform: translateY(-2px);
}
.dropdown-toggle-modern.is-active {
  background: var(--primary-gradient); color: #fff;
  box-shadow: 0 4px 15px color-mix(in oklab, var(--brand-dark) 35%, transparent);
}
.dropdown-arrow { transition: transform 0.3s; }
.dropdown-toggle-modern[aria-expanded="true"] .dropdown-arrow { transform: rotate(180deg); }

.dropdown-menu-modern {
  position: absolute; top: calc(100% + 0.5rem); left: 50%;
  transform: translateX(-50%) translateY(-10px);
  background: #fff; border-radius: var(--border-radius);
  box-shadow: 0 20px 60px rgba(0, 0, 0, .15);
  border: 1px solid rgba(0, 0, 0, .05);
  min-width: 240px; opacity: 0; visibility: hidden;
  transition: var(--transition); z-index: 1000;
}
.dropdown-menu-modern.show { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }

.dropdown-item-modern {
  display: flex; align-items: center; gap: 0.75rem;
  padding: 1rem 1.25rem; color: #4a5568; text-decoration: none; font-weight: 500;
  transition: var(--transition); border-bottom: 1px solid rgba(0, 0, 0, .05);
}
.dropdown-item-modern:last-child { border-bottom: none; }
.dropdown-item-modern:hover { background: #f8fafc; color: var(--brand); transform: translateX(5px); }
.dropdown-item-modern .bi { color: var(--icon-color); transition: var(--transition); }
.dropdown-item-modern:hover .bi { color: var(--icon-color-hover); }

/* ===== SOUS-MENUS (niveau 2) ===== */
.dropdown-submenu { position: relative; }
.submenu-toggle { width: 100%; justify-content: flex-start; }
.submenu-arrow { margin-left: auto; transition: transform .3s; }
.submenu-toggle[aria-expanded="true"] .submenu-arrow { transform: rotate(-90deg); }

.dropdown-menu-modern.submenu {
  position: absolute; top: 0; left: 100%; transform: translateX(8px);
  min-width: 220px; opacity: 0; visibility: hidden; transition: var(--transition);
  z-index: 1001;
}
.dropdown-menu-modern.submenu.show { opacity: 1; visibility: visible; }

/* ===== USER ===== */
.user-section-modern { display: flex; align-items: center; gap: 1rem; position: relative; z-index: 1051; }
.user-profile-modern {
  display: flex; align-items: center; gap: 0.75rem;
  padding: 0.5rem 1rem; border-radius: var(--border-radius);
  background: color-mix(in oklab, var(--brand) 6%, #f1f5f9);
  border: 2px solid color-mix(in oklab, var(--brand) 12%, #e2e8f0);
  transition: var(--transition); text-decoration: none; color: #2d3748;
}
.user-profile-modern:hover {
  background: color-mix(in oklab, var(--brand) 10%, #eef2f7);
  border-color: color-mix(in oklab, var(--brand) 20%, #dbe3ef);
  transform: translateY(-2px);
  color: #2d3748;
}
.user-avatar-modern {
  width: 40px; height: 40px; border-radius: 50%; object-fit: cover;
  border: 2px solid color-mix(in oklab, var(--brand) 18%, #e2e8f0); transition: var(--transition);
}
.user-profile-modern:hover .user-avatar-modern {
  border-color: color-mix(in oklab, var(--brand) 30%, #dbe3ef);
  transform: scale(1.05);
}
.user-info-modern { display: flex; flex-direction: column; line-height: 1.2; }
.user-name-modern { font-weight: 600; font-size: 0.95rem; }
.user-role-modern { font-size: 0.8rem; opacity: .7; font-weight: 500; }

.logout-btn-modern {
  background: linear-gradient(135deg,#dc2626 0%,#b91c1c 100%);
  border: none; color: #fff; padding: 0.75rem 1.5rem; border-radius: var(--border-radius);
  font-weight: 600; font-size: 0.9rem; transition: var(--transition);
  display: flex; align-items: center; gap: 0.5rem; text-decoration: none;
}
.logout-btn-modern:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(220, 38, 38, .3); color: #fff; }
.logout-btn-modern .bi { color: #fff; }

/* ===== BURGER & MOBILE MENU ===== */
.burger-modern {
  display: none; flex-direction: column; gap: 4px; background: none; border: none; padding: 0.5rem; cursor: pointer;
  border-radius: 8px; transition: var(--transition); position: relative; z-index: 1052;
}
.burger-modern:hover { background: color-mix(in oklab, var(--brand) 10%, #eef2f7); }
.burger-line { width: 24px; height: 3px; background: #4a5568; border-radius: 2px; transition: var(--transition); }
.burger-modern.active .burger-line:nth-child(1) { transform: rotate(45deg) translate(6px, 6px); }
.burger-modern.active .burger-line:nth-child(2) { opacity: 0; }
.burger-modern.active .burger-line:nth-child(3) { transform: rotate(-45deg) translate(6px, -6px); }

.mobile-menu-modern {
  position: fixed; top: 0; left: 0; width: 100%; height: 100vh;
  background: rgba(255, 255, 255, .98); backdrop-filter:blur(20px);
  z-index: 1050; opacity: 0; visibility: hidden; transition: var(--transition);
  display: flex; flex-direction: column; padding: 90px 1.5rem 1.5rem;
  overflow-y: auto; -webkit-overflow-scrolling: touch;
}
.mobile-menu-modern.show { opacity: 1; visibility: visible; }
.mobile-nav-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem; flex-grow: 1; }
.mobile-nav-link {
  display: flex; align-items: center; gap: 1rem; padding: 1rem 1.25rem; border-radius: var(--border-radius);
  text-decoration: none; color: #4a5568; font-weight: 600; font-size: 1rem; transition: var(--transition);
  background: rgba(248, 250, 252, .5);
}
.mobile-nav-link:hover, .mobile-nav-link.is-active {
  background: var(--primary-gradient); color: #fff; transform: translateX(10px);
}

/* ===== Mobile sous-listes (accordéons) ===== */
.mobile-sublist { list-style: none; margin: 0; padding-left: 1rem; display: none; gap: 0.5rem; }
.mobile-sublist.show { display: flex; flex-direction: column; }
.mobile-accordion { width: 100%; text-align: left; }

.mobile-user-section {
  margin-top: auto; padding: 1.5rem 0 0; border-top: 1px solid rgba(0, 0, 0, .1); display: flex; flex-direction: column; gap: 1rem;
}
.mobile-user-section .user-profile-modern {
  background: color-mix(in oklab, var(--brand) 8%, #eef2f7); border: 2px solid color-mix(in oklab, var(--brand) 15%, #e2e8f0);
  padding: 0.75rem 1rem; width: 100%; justify-content: flex-start;
}
.mobile-user-section .logout-btn-modern {
  width: 100%; justify-content: center; padding: 1rem 1.5rem; font-size: 1rem;
  margin-bottom: env(safe-area-inset-bottom, 10px);
}

/* ===== ANIMS & HELPERS ===== */
@media(max-width:768px) {
  .navbar-container { padding: 0 1rem; min-height: 70px; }
  .nav-modern { display: none; }
  .user-section-modern { display: none; }
  .burger-modern { display: flex; }
  .brand-text { display: none; }
  .brand-logo { height: 40px; }
  .mobile-menu-modern { padding-top: 80px; }
}
@media(max-height:600px) {
  .mobile-nav-link { padding: 0.75rem 1rem; font-size: 0.95rem; }
  .mobile-nav-list { gap: 0.5rem; }
  .mobile-user-section { padding: 1rem 0 0; }
}
@supports(padding:max(0px)) {
  .mobile-user-section .logout-btn-modern { margin-bottom: max(10px, env(safe-area-inset-bottom)); }
}
@media(min-width:769px) { .mobile-menu-modern { display: none !important; } }

@keyframes slideInDown {
  from { opacity: 0; transform: translateY(-20px) }
  to   { opacity: 1; transform: translateY(0) }
}
.dropdown-menu-modern.show { animation: slideInDown 0.3s ease-out; }

/* notification badge (optionnel) */
.nav-badge {
  position: absolute; top: -8px; right: -8px; background: #dc2626; color: #fff;
  border-radius: 50%; width: 20px; height: 20px; font-size: 0.7rem;
  display: flex; align-items: center; justify-content: center; font-weight: 700;
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(220, 38, 38, .7) }
  70% { box-shadow: 0 0 0 10px rgba(220, 38, 38, 0) }
  100% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0) }
}

/* === Fix responsive header (mobile & small tablet) === */
.page-header .d-flex { gap: 0.75rem; }
@media (max-width: 992px) {
  .page-header .d-flex { flex-wrap: wrap; }
  .page-header .btn-new-client { white-space: nowrap; }
}
@media (max-width: 768px) {
  .page-header { padding: 1.25rem; text-align: left; }
  .page-header .d-flex { flex-direction: column; align-items: stretch; }
  .page-header h1 { font-size: 2rem; margin-bottom: .25rem; }
  .page-header .subtitle { margin-bottom: .25rem; }
  .page-header .btn-new-client {
    width: 100%; display: flex; align-items: center; justify-content: center;
    padding: .75rem 1rem; font-size: 1rem; min-height: 44px;
  }
  .page-header .btn-new-client.me-2 { margin-right: 0 !important; }
  .page-header .btn-new-client + .btn-new-client { margin-top: .5rem; }
}
@media (max-width: 480px) {
  .page-header h1 { font-size: 1.75rem; }
  .page-header .btn-new-client { padding: .65rem .9rem; font-size: .95rem; }
}

/* === Cards actions: layout plus compact sur mobile === */
.client-card-actions { flex-wrap: wrap; gap: .5rem; }
.btn-card-action {
  flex: 0 0 auto; padding: .55rem .9rem; font-size: .95rem; min-height: 40px;
}
.client-card-actions .btn-card-action.w-100 { width: auto !important; }
.client-card-actions form { flex: 0 0 auto; }

@media (max-width: 768px) {
  .client-card-actions { justify-content: center; padding: .75rem 1rem; }
  .btn-card-action { padding: .5rem .85rem; font-size: .95rem; }
  .client-card-actions .d-inline .btn { width: auto !important; }
}
@media (max-width: 480px) {
  .client-card-actions { gap: .4rem; }
  .btn-card-action { padding: .45rem .7rem; font-size: .9rem; min-height: 38px; }
  .btn-card-action i { margin-right: .35rem; }
}
/* === Cards actions: grille ordonnée sur mobile === */
@media (max-width: 768px) {
  .client-card-actions {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .6rem; padding: .85rem 1rem;
  }
  .client-card-actions .btn-card-action {
    width: 100%; justify-content: center; padding: .55rem .9rem; font-size: .95rem; min-height: 42px; flex: 0 0 auto;
  }
  .client-card-actions form { grid-column: 1 / -1; }
  .client-card-actions .btn-card-action.w-100 { width: 100% !important; }
}

/* ===== DARK MODE ===== */
@media (prefers-color-scheme: dark) {
  .modern-navbar { background: rgba(10, 15, 25, .8); border-bottom-color: color-mix(in oklab, var(--accent-amber) 35%, transparent); }
  .dropdown-menu-modern { background: #0f172a; border-color: rgba(255,255,255,.06); }
  .dropdown-item-modern { color: #cbd5e1; border-bottom-color: rgba(255,255,255,.06); }
  .dropdown-item-modern:hover { background: #0b1222; color: var(--icon-color-active); }
  .mobile-menu-modern { background: rgba(10, 15, 25, .95); }
  .burger-line { background: #e5e7eb; }
  .brand-modern { color: #e5edf7; }
}
/* ===== NAVBAR + MENUS : SURFACE AWARE ===== */
/* Ajoute ceci APRÈS ton CSS de navbar existant */

.modern-navbar{
  /* couleurs par défaut (surface claire) */
  --surface-bg: rgba(255,255,255,.95);
  --surface-bg-scrolled: rgba(255,255,255,.98);
  --surface-text: #2d3748;

  --menu-bg: #ffffff;
  --menu-text: #4a5568;
  --menu-divider: rgba(0,0,0,.06);
  --menu-hover-bg: #f8fafc;

  --mobile-bg: rgba(255,255,255,.98);
  --burger-line: #4a5568;

  /* états communs */
  --menu-shadow: 0 20px 60px rgba(0,0,0,.15);
  --menu-border: 1px solid rgba(0,0,0,.05);
}

/* ====== VARIANTE SURFACE SOMBRE ====== */
.modern-navbar[data-surface="dark"]{
  --surface-bg: rgba(10,15,25,.85);
  --surface-bg-scrolled: rgba(10,15,25,.92);
  --surface-text: #e5edf7;

  --menu-bg: #0f172a;
  --menu-text: #cbd5e1;
  --menu-divider: rgba(255,255,255,.06);
  --menu-hover-bg: #0b1222;

  --mobile-bg: rgba(10,15,25,.95);
  --burger-line: #e5e7eb;

  /* ombre un peu plus douce pour ne pas “baver” */
  --menu-shadow: 0 16px 48px rgba(0,0,0,.35);
  --menu-border: 1px solid rgba(255,255,255,.08);
}

/* ====== VARIANTE SURFACE CLAIRE (explicite) ====== */
.modern-navbar[data-surface="light"]{
  /* garde les valeurs par défaut ci-dessus */
}

/* Applique les variables à la navbar */
.modern-navbar{
  background: var(--surface-bg);
  color: var(--surface-text);
}
.modern-navbar.scrolled{
  background: var(--surface-bg-scrolled);
}

/* Liens / toggles héritent de la surface */
.nav-link-modern,
.dropdown-toggle-modern,
.user-profile-modern,
.mobile-nav-link{
  color: var(--menu-text);
}

/* Dropdowns (NIVEAU 1 + SOUS-MENUS) pilotés par variables surface */
.dropdown-menu-modern{
  background: var(--menu-bg);
  color: var(--menu-text);
  box-shadow: var(--menu-shadow);
  border: var(--menu-border);
}
.dropdown-item-modern{
  color: var(--menu-text);
  border-bottom: 1px solid var(--menu-divider);
}
.dropdown-item-modern:last-child{ border-bottom: none; }
.dropdown-item-modern:hover{
  background: var(--menu-hover-bg);
  color: var(--brand);
}

/* Icônes synchronisées */
.dropdown-item-modern .bi,
.nav-icon{ color: var(--icon-color); }
.dropdown-item-modern:hover .bi,
.nav-link-modern:hover .nav-icon,
.dropdown-toggle-modern:hover .nav-icon{ color: var(--icon-color-hover); }

/* Menu mobile */
.mobile-menu-modern{
  background: var(--mobile-bg);
}
.burger-line{ background: var(--burger-line); }

/* Profil utilisateur sur surface */
.user-profile-modern{
  background: color-mix(in oklab, var(--brand) 6%, var(--menu-bg));
  border: 2px solid color-mix(in oklab, var(--brand) 12%, var(--menu-bg));
}
.user-profile-modern:hover{
  background: color-mix(in oklab, var(--brand) 10%, var(--menu-bg));
  border-color: color-mix(in oklab, var(--brand) 22%, var(--menu-bg));
}
.user-avatar-modern{
  border-color: color-mix(in oklab, var(--brand) 18%, var(--menu-bg));
}

/* Badge notifs lisible sur sombre comme sur clair */
.nav-badge{
  background: #dc2626; color: #fff;
  box-shadow: 0 0 0 0 rgba(220, 38, 38, .7);
}
/* ===== BRAND (titre/logo) lisible selon la surface ===== */
:root{
  --brand-title-light: #0f273f;      /* titre sur fond clair */
  --brand-subtitle-light: #5b6b7f;   /* sous-titre sur fond clair */
  --brand-title-dark: #e6eef8;       /* titre sur fond sombre */
  --brand-subtitle-dark: #c9d6e5;    /* sous-titre sur fond sombre */
}

/* valeurs par défaut = surface claire */
.modern-navbar .brand-name{ color: var(--brand-title-light); }
.modern-navbar .brand-subtitle{ color: var(--brand-subtitle-light); opacity: 1; text-shadow: none; }

/* surface sombre */
.modern-navbar[data-surface="dark"] .brand-name{ color: var(--brand-title-dark); }
.modern-navbar[data-surface="dark"] .brand-subtitle{ color: var(--brand-subtitle-dark); }

/* hover cohérent */
.brand-modern:hover .brand-name,
.brand-modern:hover .brand-subtitle{
  color: var(--brand);               /* bleu sécurité */
}

/* si un style précédent “blanchit” via l’héritage, on l’écrase */
.modern-navbar .brand-text,
.modern-navbar .brand-name,
.modern-navbar .brand-subtitle{ mix-blend-mode: normal; }


</style>
{% endblock %}

{# ==================== NAVBAR ==================== #}
<header class="modern-navbar" role="banner" id="navbar">
  <div class="navbar-container">

    <a class="brand-modern" href="{{ path('app_index') }}">
      <img src="{{ asset('assets/images/logo.png') }}" alt="Logo" class="brand-logo">
      <div class="brand-text">
        <div class="brand-name">ILD SECURITY</div>
        <div class="brand-subtitle">Gestion clients</div>
      </div>
      
    </a>

    <nav class="nav-modern" role="navigation" aria-label="Navigation principale">
      <ul class="nav-list-modern">

        <li class="nav-item-modern">
          <a class="nav-link-modern {{ current starts with 'app_index' ? 'is-active' }}" href="{{ path('app_index') }}">
            <i class="bi bi-house-door nav-icon"></i>
            Accueil
          </a>
        </li>

        {% if is_granted('ROLE_USER') %}

          {# ===== Interventions ===== #}
          <li class="nav-item-modern nav-dropdown">
            <button class="dropdown-toggle-modern {{ isInterv ? 'is-active' }}" type="button"
                    data-dropdown="interventions-menu"
                    aria-expanded="{{ isInterv ? 'true' : 'false' }}">
              <i class="bi bi-clipboard-check nav-icon"></i>
              Interventions
              <i class="bi bi-chevron-down dropdown-arrow"></i>
