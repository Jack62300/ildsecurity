{% set current = app.request.attributes.get('_route') %}

<style>
/* ========== VARIABLES CSS MODERNES ========== */
:root {
  --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  --navbar-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  --border-radius: 12px;
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ========== NAVBAR MODERNE ========== */
.modern-navbar {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border-bottom: 5px solid rgba(163, 93, 36, 0.51);
  box-shadow: var(--navbar-shadow);
  position: sticky;
  top: 0;
  z-index: 1050;
  transition: var(--transition);
}

.modern-navbar.scrolled {
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
}

.navbar-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 2rem;
  display: flex;
  align-items: center;
  justify-content: between;
  min-height: 80px;
}

/* ========== LOGO MODERNE ========== */
.brand-modern {
  display: flex;
  align-items: center;
  gap: 1rem;
  text-decoration: none;
  color: #2d3748;
  font-weight: 700;
  font-size: 1.5rem;
  transition: var(--transition);
  position: relative;
  z-index: 1051;
}

.brand-modern:hover {
  color: #667eea;
  transform: translateY(-2px);
}

.brand-logo {
  height: 50px;
  width: auto;
  transition: var(--transition);
  border-radius: 8px;
}

.brand-modern:hover .brand-logo {
  transform: scale(1.05);
}

.brand-text {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

.brand-name {
  font-size: 1.25rem;
  font-weight: 800;
}

.brand-subtitle {
  font-size: 0.75rem;
  opacity: 0.7;
  font-weight: 500;
}

/* ========== NAVIGATION MODERNE ========== */
.nav-modern {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0 auto;
}

.nav-list-modern {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.nav-item-modern {
  position: relative;
}

.nav-link-modern {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.25rem;
  border-radius: var(--border-radius);
  text-decoration: none;
  color: #4a5568;
  font-weight: 600;
  font-size: 0.95rem;
  transition: var(--transition);
  position: relative;
  overflow: hidden;
}

.nav-link-modern::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(102, 126, 234, 0.1), transparent);
  transition: left 0.5s;
}

.nav-link-modern:hover::before {
  left: 100%;
}

.nav-link-modern:hover {
  color: #667eea;
  background: rgba(102, 126, 234, 0.08);
  transform: translateY(-2px);
}

.nav-link-modern.is-active {
  background: var(--primary-gradient);
  color: white;
  box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
}

.nav-link-modern.is-active:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
}

.nav-icon {
  font-size: 1.1rem;
}

/* ========== DROPDOWN ADMIN ========== */
.nav-dropdown {
  position: relative;
}

.dropdown-toggle-modern {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.25rem;
  border-radius: var(--border-radius);
  text-decoration: none;
  color: #4a5568;
  font-weight: 600;
  font-size: 0.95rem;
  transition: var(--transition);
  background: none;
  border: none;
  cursor: pointer;
}

.dropdown-toggle-modern:hover {
  color: #667eea;
  background: rgba(102, 126, 234, 0.08);
  transform: translateY(-2px);
}

.dropdown-arrow {
  transition: transform 0.3s ease;
}

.dropdown-toggle-modern[aria-expanded="true"] .dropdown-arrow {
  transform: rotate(180deg);
}

.dropdown-menu-modern {
  position: absolute;
  top: calc(100% + 0.5rem);
  left: 50%;
  transform: translateX(-50%);
  background: white;
  border-radius: var(--border-radius);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
  border: 1px solid rgba(0, 0, 0, 0.05);
  min-width: 220px;
  opacity: 0;
  visibility: hidden;
  transform: translateX(-50%) translateY(-10px);
  transition: var(--transition);
  z-index: 1000;
}

.dropdown-menu-modern.show {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(0);
}

.dropdown-item-modern {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1rem 1.25rem;
  color: #4a5568;
  text-decoration: none;
  font-weight: 500;
  transition: var(--transition);
  border-bottom: 1px solid rgba(0, 0, 0, 0.05);
}

.dropdown-item-modern:last-child {
  border-bottom: none;
}

.dropdown-item-modern:hover {
  background: #f8fafc;
  color: #667eea;
  transform: translateX(5px);
}

.dropdown-item-modern i {
  width: 20px;
  text-align: center;
}

/* ========== USER SECTION MODERNE ========== */
.user-section-modern {
  display: flex;
  align-items: center;
  gap: 1rem;
  position: relative;
  z-index: 1051;
}

.user-profile-modern {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.5rem 1rem;
  border-radius: var(--border-radius);
  background: rgba(102, 126, 234, 0.05);
  border: 2px solid rgba(102, 126, 234, 0.1);
  transition: var(--transition);
  text-decoration: none;
  color: #2d3748;
}

.user-profile-modern:hover {
  background: rgba(102, 126, 234, 0.1);
  border-color: rgba(102, 126, 234, 0.2);
  transform: translateY(-2px);
  color: #2d3748;
}

.user-avatar-modern {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid rgba(102, 126, 234, 0.2);
  transition: var(--transition);
}

.user-profile-modern:hover .user-avatar-modern {
  border-color: rgba(102, 126, 234, 0.4);
  transform: scale(1.05);
}

.user-info-modern {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

.user-name-modern {
  font-weight: 600;
  font-size: 0.95rem;
}

.user-role-modern {
  font-size: 0.8rem;
  opacity: 0.7;
  font-weight: 500;
}

.logout-btn-modern {
  background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
  border: none;
  color: white;
  padding: 0.75rem 1.5rem;
  border-radius: var(--border-radius);
  font-weight: 600;
  font-size: 0.9rem;
  transition: var(--transition);
  display: flex;
  align-items: center;
  gap: 0.5rem;
  text-decoration: none;
}

.logout-btn-modern:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(220, 38, 38, 0.3);
  color: white;
}

/* ========== BURGER MENU MODERNE ========== */
.burger-modern {
  display: none;
  flex-direction: column;
  gap: 4px;
  background: none;
  border: none;
  padding: 0.5rem;
  cursor: pointer;
  border-radius: 8px;
  transition: var(--transition);
  position: relative;
  z-index: 1052;
}

.burger-modern:hover {
  background: rgba(102, 126, 234, 0.1);
}

.burger-line {
  width: 24px;
  height: 3px;
  background: #4a5568;
  border-radius: 2px;
  transition: var(--transition);
}

.burger-modern.active .burger-line:nth-child(1) {
  transform: rotate(45deg) translate(6px, 6px);
}

.burger-modern.active .burger-line:nth-child(2) {
  opacity: 0;
}

.burger-modern.active .burger-line:nth-child(3) {
  transform: rotate(-45deg) translate(6px, -6px);
}

/* ========== MOBILE MENU ========== */
.mobile-menu-modern {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px);
  z-index: 1050;
  opacity: 0;
  visibility: hidden;
  transition: var(--transition);
  display: flex;
  flex-direction: column;
  padding: 100px 2rem 2rem;
}

.mobile-menu-modern.show {
  opacity: 1;
  visibility: visible;
}

.mobile-nav-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.mobile-nav-link {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.25rem 1.5rem;
  border-radius: var(--border-radius);
  text-decoration: none;
  color: #4a5568;
  font-weight: 600;
  font-size: 1.1rem;
  transition: var(--transition);
  background: rgba(248, 250, 252, 0.5);
}

.mobile-nav-link:hover,
.mobile-nav-link.is-active {
  background: var(--primary-gradient);
  color: white;
  transform: translateX(10px);
}

.mobile-user-section {
  margin-top: auto;
  padding-top: 2rem;
  border-top: 1px solid rgba(0, 0, 0, 0.1);
}

/* ========== RESPONSIVE ========== */
@media (max-width: 768px) {
  .navbar-container {
    padding: 0 1rem;
    min-height: 70px;
  }

  .nav-modern {
    display: none;
  }

  .user-section-modern {
    display: none;
  }

  .burger-modern {
    display: flex;
  }

  .brand-text {
    display: none;
  }

  .brand-logo {
    height: 40px;
  }
}

@media (min-width: 769px) {
  .mobile-menu-modern {
    display: none !important;
  }
}

/* ========== ANIMATIONS ========== */
@keyframes slideInDown {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.dropdown-menu-modern.show {
  animation: slideInDown 0.3s ease-out;
}

/* ========== NOTIFICATIONS BADGE ========== */
.nav-badge {
  position: absolute;
  top: -8px;
  right: -8px;
  background: #dc2626;
  color: white;
  border-radius: 50%;
  width: 20px;
  height: 20px;
  font-size: 0.7rem;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7);
  }
  70% {
    box-shadow: 0 0 0 10px rgba(220, 38, 38, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(220, 38, 38, 0);
  }
}
</style>

<header class="modern-navbar" role="banner" id="navbar">
  <div class="navbar-container">
    
    <!-- Logo moderne -->
    <a class="brand-modern" href="/">
      <img src="{{ asset('assets/images/logo.png') }}" alt="Logo" class="brand-logo">
      <div class="brand-text">
        <div class="brand-name">ILD SECURITY</div>
        <div class="brand-subtitle">Gestion clients</div>
      </div>
    </a>

    <!-- Navigation principale (desktop) -->
    <nav class="nav-modern" role="navigation" aria-label="Navigation principale">
      <ul class="nav-list-modern">
        
        <!-- Home -->
        <li class="nav-item-modern">
          <a class="nav-link-modern {{ current starts with 'app_index' ? 'is-active' }}" 
             href="{{ path('app_index') }}">
            <i class="bi bi-house nav-icon"></i>
            Accueil
          </a>
        </li>

        <!-- Clients -->
        <li class="nav-item-modern">
          <a class="nav-link-modern {{ current starts with 'clients' ? 'is-active' }}" 
             href="{{ path('clients_index') }}">
            <i class="bi bi-people nav-icon"></i>
            Clients
          </a>
        </li>

        <!-- Menu Admin (dropdown) -->
        {% if is_granted('ROLE_ADMIN') %}
          <li class="nav-item-modern nav-dropdown">
            <button class="dropdown-toggle-modern" 
                    type="button" 
                    data-dropdown="admin-menu"
                    aria-expanded="false">
              <i class="bi bi-gear nav-icon"></i>
              Administration
              <i class="bi bi-chevron-down dropdown-arrow"></i>
            </button>
            
            <div class="dropdown-menu-modern" id="admin-menu">
              <a class="dropdown-item-modern" href="{{ path('users_index') }}">
                <i class="bi bi-person-gear"></i>
                Utilisateurs
              </a>
              <a class="dropdown-item-modern" href="{{ path('agences_index') }}">
                <i class="bi bi-building"></i>
                Agences
              </a>
              <a class="dropdown-item-modern" href="{{ path('devices_index') }}">
                <i class="bi bi-phone"></i>
                Appareils
                
              </a>
              <a class="dropdown-item-modern" href="{{ path('organisme_index') }}">
                <i class="bi bi-diagram-3"></i>
                Organismes
              </a>
            </div>
          </li>
        {% endif %}

      </ul>
    </nav>

    <!-- Section utilisateur (desktop) -->
    {% if app.user %}
      <div class="user-section-modern">
        <div class="user-profile-modern">
          <img src="{{ asset('assets/images/logo2.png') }}" 
               alt="Avatar {{ app.user.username }}" 
               class="user-avatar-modern">
          <div class="user-info-modern">
            <div class="user-name-modern">{{ app.user.username }}</div>
            <div class="user-role-modern">
              {% if is_granted('ROLE_ADMIN') %}Administrateur{% else %}Utilisateur{% endif %}
            </div>
          </div>
        </div>
        
        <a href="{{ path('app_logout') }}" class="logout-btn-modern">
          <i class="bi bi-box-arrow-right"></i>
          Déconnexion
        </a>
      </div>
    {% endif %}

    <!-- Bouton burger (mobile) -->
    <button class="burger-modern" 
            aria-label="Menu" 
            aria-expanded="false"
            data-mobile-menu="toggle">
      <span class="burger-line"></span>
      <span class="burger-line"></span>
      <span class="burger-line"></span>
    </button>

  </div>
</header>

<!-- Menu mobile -->
<div class="mobile-menu-modern" id="mobile-menu">
  <ul class="mobile-nav-list">
    
    <li>
      <a class="mobile-nav-link {{ current starts with 'app_index' ? 'is-active' }}" 
         href="{{ path('app_index') }}">
        <i class="bi bi-house"></i>
        Accueil
      </a>
    </li>

    <li>
      <a class="mobile-nav-link {{ current starts with 'clients' ? 'is-active' }}" 
         href="{{ path('clients_index') }}">
        <i class="bi bi-people"></i>
        Clients
      </a>
    </li>

    {% if is_granted('ROLE_ADMIN') %}
      <li>
        <a class="mobile-nav-link" href="{{ path('users_index') }}">
          <i class="bi bi-person-gear"></i>
          Utilisateurs
        </a>
      </li>
      
      <li>
        <a class="mobile-nav-link" href="{{ path('agences_index') }}">
          <i class="bi bi-building"></i>
          Agences
        </a>
      </li>
      
      <li>
        <a class="mobile-nav-link" href="{{ path('devices_index') }}">
          <i class="bi bi-phone"></i>
          Appareils autorisés
        </a>
      </li>
      
      <li>
        <a class="mobile-nav-link" href="{{ path('organisme_index') }}">
          <i class="bi bi-diagram-3"></i>
          Organismes
        </a>
      </li>
    {% endif %}

  </ul>

  <!-- Section utilisateur mobile -->
  {% if app.user %}
    <div class="mobile-user-section">
      <div class="user-profile-modern mb-3">
        <img src="{{ asset('assets/images/logo2.png') }}" 
             alt="Avatar {{ app.user.username }}" 
             class="user-avatar-modern">
        <div class="user-info-modern">
          <div class="user-name-modern">{{ app.user.username }}</div>
          <div class="user-role-modern">
            {% if is_granted('ROLE_ADMIN') %}Administrateur{% else %}Utilisateur{% endif %}
          </div>
        </div>
      </div>
      
      <a href="{{ path('app_logout') }}" class="logout-btn-modern w-100 justify-content-center">
        <i class="bi bi-box-arrow-right"></i>
        Déconnexion
      </a>
    </div>
  {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // ========== Navbar scroll effect ==========
  const navbar = document.getElementById('navbar');
  let lastScrollY = window.scrollY;

  window.addEventListener('scroll', function() {
    if (window.scrollY > 50) {
      navbar.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
    }
    lastScrollY = window.scrollY;
  });

  // ========== Dropdown functionality ==========
  const dropdownToggles = document.querySelectorAll('[data-dropdown]');
  
  dropdownToggles.forEach(toggle => {
    const dropdownId = toggle.getAttribute('data-dropdown');
    const dropdown = document.getElementById(dropdownId);
    
    if (!dropdown) return;

    toggle.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      
      // Fermer les autres dropdowns
      dropdownToggles.forEach(otherToggle => {
        if (otherToggle !== toggle) {
          const otherId = otherToggle.getAttribute('data-dropdown');
          const otherDropdown = document.getElementById(otherId);
          if (otherDropdown) {
            otherDropdown.classList.remove('show');
            otherToggle.setAttribute('aria-expanded', 'false');
          }
        }
      });

      // Toggle le dropdown actuel
      const isOpen = dropdown.classList.contains('show');
      if (isOpen) {
        dropdown.classList.remove('show');
        toggle.setAttribute('aria-expanded', 'false');
      } else {
        dropdown.classList.add('show');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Fermer dropdowns en cliquant ailleurs
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.nav-dropdown')) {
      dropdownToggles.forEach(toggle => {
        const dropdownId = toggle.getAttribute('data-dropdown');
        const dropdown = document.getElementById(dropdownId);
        if (dropdown) {
          dropdown.classList.remove('show');
          toggle.setAttribute('aria-expanded', 'false');
        }
      });
    }
  });

  // ========== Mobile menu functionality ==========
  const burgerBtn = document.querySelector('[data-mobile-menu="toggle"]');
  const mobileMenu = document.getElementById('mobile-menu');
  
  if (burgerBtn && mobileMenu) {
    burgerBtn.addEventListener('click', function() {
      const isOpen = this.classList.contains('active');
      
      if (isOpen) {
        this.classList.remove('active');
        mobileMenu.classList.remove('show');
        this.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      } else {
        this.classList.add('active');
        mobileMenu.classList.add('show');
        this.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }
    });

    // Fermer le menu mobile en cliquant sur un lien
    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', function() {
        burgerBtn.classList.remove('active');
        mobileMenu.classList.remove('show');
        burgerBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      });
    });
  }

  // ========== Keyboard navigation ==========
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      // Fermer tous les dropdowns
      dropdownToggles.forEach(toggle => {
        const dropdownId = toggle.getAttribute('data-dropdown');
        const dropdown = document.getElementById(dropdownId);
        if (dropdown) {
          dropdown.classList.remove('show');
          toggle.setAttribute('aria-expanded', 'false');
        }
      });

      // Fermer le menu mobile
      if (burgerBtn && mobileMenu) {
        burgerBtn.classList.remove('active');
        mobileMenu.classList.remove('show');
        burgerBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }
    }
  });
});
</script>