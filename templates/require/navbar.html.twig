{% set current = app.request.attributes.get('_route') %}

{# ==================== STYLES ==================== #}
<style>
:root {
  --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  --navbar-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  --border-radius: 12px;
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.modern-navbar{background:rgba(255,255,255,.95);backdrop-filter:blur(20px);border-bottom:5px solid rgba(163,93,36,.51);box-shadow:var(--navbar-shadow);position:sticky;top:0;z-index:1050;transition:var(--transition)}
.modern-navbar.scrolled{background:rgba(255,255,255,.98);box-shadow:0 12px 40px rgba(0,0,0,.15)}
.navbar-container{max-width:1400px;margin:0 auto;padding:0 2rem;display:flex;align-items:center;justify-content:space-between;min-height:80px}
.brand-modern{display:flex;align-items:center;gap:1rem;text-decoration:none;color:#2d3748;font-weight:700;font-size:1.5rem;transition:var(--transition);position:relative;z-index:1051}
.brand-modern:hover{color:#667eea;transform:translateY(-2px)}
.brand-logo{height:50px;width:auto;transition:var(--transition);border-radius:8px}
.brand-modern:hover .brand-logo{transform:scale(1.05)}
.brand-text{display:flex;flex-direction:column;line-height:1.2}
.brand-name{font-size:1.25rem;font-weight:800}
.brand-subtitle{font-size:.75rem;opacity:.7;font-weight:500}
.nav-modern{display:flex;align-items:center;gap:.5rem;margin:0 auto}
.nav-list-modern{display:flex;align-items:center;gap:.5rem;list-style:none;margin:0;padding:0}
.nav-item-modern{position:relative}
.nav-link-modern{display:flex;align-items:center;gap:.5rem;padding:.75rem 1.25rem;border-radius:var(--border-radius);text-decoration:none;color:#4a5568;font-weight:600;font-size:.95rem;transition:var(--transition);position:relative;overflow:hidden}
.nav-link-modern::before{content:'';position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(102,126,234,.1),transparent);transition:left .5s}
.nav-link-modern:hover::before{left:100%}
.nav-link-modern:hover{color:#667eea;background:rgba(102,126,234,.08);transform:translateY(-2px)}
.nav-link-modern.is-active{background:var(--primary-gradient);color:#fff;box-shadow:0 4px 15px rgba(102,126,234,.3)}
.nav-link-modern.is-active:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(102,126,234,.4)}
.nav-icon{font-size:1.1rem}
.nav-dropdown{position:relative}
.dropdown-toggle-modern{display:flex;align-items:center;gap:.5rem;padding:.75rem 1.25rem;border-radius:var(--border-radius);text-decoration:none;color:#4a5568;font-weight:600;font-size:.95rem;transition:var(--transition);background:none;border:none;cursor:pointer}
.dropdown-toggle-modern:hover{color:#667eea;background:rgba(102,126,234,.08);transform:translateY(-2px)}
.dropdown-toggle-modern.is-active{background:var(--primary-gradient);color:#fff;box-shadow:0 4px 15px rgba(102,126,234,.3)}
.dropdown-arrow{transition:transform .3s}
.dropdown-toggle-modern[aria-expanded="true"] .dropdown-arrow{transform:rotate(180deg)}
.dropdown-menu-modern{position:absolute;top:calc(100% + .5rem);left:50%;transform:translateX(-50%);background:#fff;border-radius:var(--border-radius);box-shadow:0 20px 60px rgba(0,0,0,.15);border:1px solid rgba(0,0,0,.05);min-width:240px;opacity:0;visibility:hidden;transform:translateX(-50%) translateY(-10px);transition:var(--transition);z-index:1000}
.dropdown-menu-modern.show{opacity:1;visibility:visible;transform:translateX(-50%) translateY(0)}
.dropdown-item-modern{display:flex;align-items:center;gap:.75rem;padding:1rem 1.25rem;color:#4a5568;text-decoration:none;font-weight:500;transition:var(--transition);border-bottom:1px solid rgba(0,0,0,.05)}
.dropdown-item-modern:last-child{border-bottom:none}
.dropdown-item-modern:hover{background:#f8fafc;color:#667eea;transform:translateX(5px)}
.dropdown-item-modern i{width:20px;text-align:center}
.user-section-modern{display:flex;align-items:center;gap:1rem;position:relative;z-index:1051}
.user-profile-modern{display:flex;align-items:center;gap:.75rem;padding:.5rem 1rem;border-radius:var(--border-radius);background:rgba(102,126,234,.05);border:2px solid rgba(102,126,234,.1);transition:var(--transition);text-decoration:none;color:#2d3748}
.user-profile-modern:hover{background:rgba(102,126,234,.1);border-color:rgba(102,126,234,.2);transform:translateY(-2px);color:#2d3748}
.user-avatar-modern{width:40px;height:40px;border-radius:50%;object-fit:cover;border:2px solid rgba(102,126,234,.2);transition:var(--transition)}
.user-profile-modern:hover .user-avatar-modern{border-color:rgba(102,126,234,.4);transform:scale(1.05)}
.user-info-modern{display:flex;flex-direction:column;line-height:1.2}
.user-name-modern{font-weight:600;font-size:.95rem}
.user-role-modern{font-size:.8rem;opacity:.7;font-weight:500}
.logout-btn-modern{background:linear-gradient(135deg,#dc2626 0%,#b91c1c 100%);border:none;color:#fff;padding:.75rem 1.5rem;border-radius:var(--border-radius);font-weight:600;font-size:.9rem;transition:var(--transition);display:flex;align-items:center;gap:.5rem;text-decoration:none}
.logout-btn-modern:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(220,38,38,.3);color:#fff}
.burger-modern{display:none;flex-direction:column;gap:4px;background:none;border:none;padding:.5rem;cursor:pointer;border-radius:8px;transition:var(--transition);position:relative;z-index:1052}
.burger-modern:hover{background:rgba(102,126,234,.1)}
.burger-line{width:24px;height:3px;background:#4a5568;border-radius:2px;transition:var(--transition)}
.burger-modern.active .burger-line:nth-child(1){transform:rotate(45deg) translate(6px,6px)}
.burger-modern.active .burger-line:nth-child(2){opacity:0}
.burger-modern.active .burger-line:nth-child(3){transform:rotate(-45deg) translate(6px,-6px)}
.mobile-menu-modern{position:fixed;top:0;left:0;width:100%;height:100vh;background:rgba(255,255,255,.98);backdrop-filter:blur(20px);z-index:1050;opacity:0;visibility:hidden;transition:var(--transition);display:flex;flex-direction:column;padding:90px 1.5rem 1.5rem;overflow-y:auto;-webkit-overflow-scrolling:touch}
.mobile-menu-modern.show{opacity:1;visibility:visible}
.mobile-nav-list{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.75rem;flex-grow:1}
.mobile-nav-link{display:flex;align-items:center;gap:1rem;padding:1rem 1.25rem;border-radius:var(--border-radius);text-decoration:none;color:#4a5568;font-weight:600;font-size:1rem;transition:var(--transition);background:rgba(248,250,252,.5)}
.mobile-nav-link:hover,.mobile-nav-link.is-active{background:var(--primary-gradient);color:#fff;transform:translateX(10px)}
.mobile-user-section{margin-top:auto;padding:1.5rem 0 0;border-top:1px solid rgba(0,0,0,.1);display:flex;flex-direction:column;gap:1rem;min-height:auto;flex-shrink:0}
.mobile-user-section .user-profile-modern{background:rgba(102,126,234,.08);border:2px solid rgba(102,126,234,.15);padding:.75rem 1rem;margin-bottom:0;width:100%;justify-content:flex-start}
.mobile-user-section .logout-btn-modern{width:100%;justify-content:center;padding:1rem 1.5rem;font-size:1rem;margin-bottom:env(safe-area-inset-bottom,10px)}

/* ========== ICÔNES SPÉCIFIQUES ========== */
.nav-icon-home::before { content: '🏠'; }
.nav-icon-clients::before { content: '👥'; }
.nav-icon-admin::before { content: '⚙️'; }
.nav-icon-users::before { content: '👤'; }
.nav-icon-agencies::before { content: '🏢'; }
.nav-icon-devices::before { content: '📱'; }
.nav-icon-organisms::before { content: '🏛️'; }
.nav-icon-vehicles::before { content: '🚛'; }
.nav-icon-fuel::before { content: '⛽'; }
.nav-icon-logout::before { content: '🚪'; }

/* Alternative avec Bootstrap Icons (si préféré) */
.use-bootstrap-icons .nav-icon-home::before { content: none; }
.use-bootstrap-icons .nav-icon-clients::before { content: none; }
.use-bootstrap-icons .nav-icon-admin::before { content: none; }
.use-bootstrap-icons .nav-icon-users::before { content: none; }
.use-bootstrap-icons .nav-icon-agencies::before { content: none; }
.use-bootstrap-icons .nav-icon-devices::before { content: none; }
.use-bootstrap-icons .nav-icon-organisms::before { content: none; }
.use-bootstrap-icons .nav-icon-vehicles::before { content: none; }
.use-bootstrap-icons .nav-icon-fuel::before { content: none; }
.use-bootstrap-icons .nav-icon-logout::before { content: none; }

@media (max-width:768px){.navbar-container{padding:0 1rem;min-height:70px}.nav-modern{display:none}.user-section-modern{display:none}.burger-modern{display:flex}.brand-text{display:none}.brand-logo{height:40px}.mobile-menu-modern{padding-top:80px}}
@media (max-height:600px){.mobile-nav-link{padding:.75rem 1rem;font-size:.95rem}.mobile-nav-list{gap:.5rem}.mobile-user-section{padding:1rem 0 0}}
@supports (padding:max(0px)){.mobile-user-section .logout-btn-modern{margin-bottom:max(10px,env(safe-area-inset-bottom))}}
@media (min-width:769px){.mobile-menu-modern{display:none !important}}
@keyframes slideInDown{from{opacity:0;transform:translateY(-20px)}to{opacity:1;transform:translateY(0)}}
.dropdown-menu-modern.show{animation:slideInDown .3s ease-out}
.nav-badge{position:absolute;top:-8px;right:-8px;background:#dc2626;color:#fff;border-radius:50%;width:20px;height:20px;font-size:.7rem;display:flex;align-items:center;justify-content:center;font-weight:700;animation:pulse 2s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(220,38,38,.7)}70%{box-shadow:0 0 0 10px rgba(220,38,38,0)}100%{box-shadow:0 0 0 0 rgba(220,38,38,0)}}
</style>

{# ==================== NAVBAR ==================== #}
<header class="modern-navbar" role="banner" id="navbar">
  <div class="navbar-container">

    <a class="brand-modern" href="{{ path('app_index') }}">
      <img src="{{ asset('assets/images/logo.png') }}" alt="Logo" class="brand-logo">
      <div class="brand-text">
        <div class="brand-name">ILD SECURITY</div>
        <div class="brand-subtitle">Gestion clients</div>
      </div>
    </a>

    <nav class="nav-modern" role="navigation" aria-label="Navigation principale">
      <ul class="nav-list-modern">
        <li class="nav-item-modern">
          <a class="nav-link-modern {{ current starts with 'app_index' ? 'is-active' }}"
             href="{{ path('app_index') }}">
            <i class="nav-icon nav-icon-home"></i> Accueil
          </a>
        </li>

        {# <li class="nav-item-modern">
          <a class="nav-link-modern {{ current starts with 'clients' ? 'is-active' }}"
             href="{{ path('clients_index') }}">
            <i class="nav-icon nav-icon-clients"></i> Clients
          </a>
        </li> #}

        {# ========== NOUVEAU MENU VÉHICULES ========== #}
        {% if is_granted('ROLE_ADMIN') %}
          <li class="nav-item-modern nav-dropdown">
            <button class="dropdown-toggle-modern {{ (current starts with 'admin_vehicle' or current starts with 'admin_fuel') ? 'is-active' }}" 
                    type="button" data-dropdown="vehicles-menu" aria-expanded="false">
              <i class="nav-icon nav-icon-vehicles"></i> Véhicules
              <i class="bi bi-chevron-down dropdown-arrow"></i>
            </button>

            <div class="dropdown-menu-modern" id="vehicles-menu">
              <a class="dropdown-item-modern" href="{{ path('admin_vehicle_index') }}">
                <i class="nav-icon-vehicles"></i> Flotte de véhicules
              </a>
              <a class="dropdown-item-modern" href="{{ path('admin_fuel_index') }}">
                <i class="nav-icon-fuel"></i> Gestion carburant
              </a>
            </div>
          </li>
        {% endif %}

        {% if is_granted('ROLE_ADMIN') %}
          <li class="nav-item-modern nav-dropdown">
            <button class="dropdown-toggle-modern {{ (current starts with 'users' or current starts with 'agences' or current starts with 'devices' or current starts with 'organisme') ? 'is-active' }}" 
                    type="button" data-dropdown="admin-menu" aria-expanded="false">
              <i class="nav-icon nav-icon-admin"></i> Administration
              <i class="bi bi-chevron-down dropdown-arrow"></i>
            </button>

            <div class="dropdown-menu-modern" id="admin-menu">
              <a class="dropdown-item-modern" href="{{ path('users_index') }}">
                <i class="nav-icon-users"></i> Utilisateurs
              </a>
              <a class="dropdown-item-modern" href="{{ path('agences_index') }}">
                <i class="nav-icon-agencies"></i> Agences
              </a>
              <a class="dropdown-item-modern" href="{{ path('devices_index') }}">
                <i class="nav-icon-devices"></i> Appareils
              </a>
              <a class="dropdown-item-modern" href="{{ path('organisme_index') }}">
                <i class="nav-icon-organisms"></i> Organismes
              </a>
            </div>
          </li>
        {% endif %}
      </ul>
    </nav>

    {% if app.user %}
      <div class="user-section-modern">
        <div class="user-profile-modern">
          <img src="{{ asset('assets/images/logo2.png') }}" alt="Avatar {{ app.user.username }}" class="user-avatar-modern">
          <div class="user-info-modern">
            <div class="user-name-modern">{{ app.user.username }}</div>
            <div class="user-role-modern">
              {% if is_granted('ROLE_ADMIN') %}Administrateur{% else %}Utilisateur{% endif %}
            </div>
          </div>
        </div>
        <a href="{{ path('app_logout') }}" class="logout-btn-modern">
          <i class="nav-icon-logout"></i> Déconnexion
        </a>
      </div>
    {% endif %}

    <button class="burger-modern" aria-label="Menu" aria-expanded="false" data-mobile-menu="toggle">
      <span class="burger-line"></span><span class="burger-line"></span><span class="burger-line"></span>
    </button>
  </div>
</header>

{# ==================== MENU MOBILE ==================== #}
<div class="mobile-menu-modern" id="mobile-menu">
  <ul class="mobile-nav-list">
    <li>
      <a class="mobile-nav-link {{ current starts with 'app_index' ? 'is-active' }}" href="{{ path('app_index') }}">
        <i class="nav-icon-home"></i> Accueil
      </a>
    </li>

    {# <li>
      <a class="mobile-nav-link {{ current starts with 'clients' ? 'is-active' }}" href="{{ path('clients_index') }}">
        <i class="nav-icon-clients"></i> Clients
      </a>
    </li> #}

    {% if is_granted('ROLE_ADMIN') %}
      {# ===== Section Véhicules mobile ===== #}
      <li>
        <a class="mobile-nav-link {{ current starts with 'admin_vehicle' ? 'is-active' }}" href="{{ path('admin_vehicle_index') }}">
          <i class="nav-icon-vehicles"></i> Flotte de véhicules
        </a>
      </li>
      <li>
        <a class="mobile-nav-link {{ current starts with 'admin_fuel' ? 'is-active' }}" href="{{ path('admin_fuel_index') }}">
          <i class="nav-icon-fuel"></i> Gestion carburant
        </a>
      </li>
      
      {# ===== Section Administration mobile ===== #}
      <li>
        <a class="mobile-nav-link {{ current starts with 'users' ? 'is-active' }}" href="{{ path('users_index') }}">
          <i class="nav-icon-users"></i> Utilisateurs
        </a>
      </li>
      <li>
        <a class="mobile-nav-link {{ current starts with 'agences' ? 'is-active' }}" href="{{ path('agences_index') }}">
          <i class="nav-icon-agencies"></i> Agences
        </a>
      </li>
      <li>
        <a class="mobile-nav-link {{ current starts with 'devices' ? 'is-active' }}" href="{{ path('devices_index') }}">
          <i class="nav-icon-devices"></i> Appareils
        </a>
      </li>
      <li>
        <a class="mobile-nav-link {{ current starts with 'organisme' ? 'is-active' }}" href="{{ path('organisme_index') }}">
          <i class="nav-icon-organisms"></i> Organismes
        </a>
      </li>
    {% endif %}
  </ul>

  {% if app.user %}
    <div class="mobile-user-section">
      <div class="user-profile-modern">
        <img src="{{ asset('assets/images/logo2.png') }}" alt="Avatar {{ app.user.username }}" class="user-avatar-modern">
        <div class="user-info-modern">
          <div class="user-name-modern">{{ app.user.username }}</div>
          <div class="user-role-modern">{% if is_granted('ROLE_ADMIN') %}Administrateur{% else %}Utilisateur{% endif %}</div>
        </div>
      </div>
      <a href="{{ path('app_logout') }}" class="logout-btn-modern">
        <i class="nav-icon-logout"></i> Déconnexion
      </a>
    </div>
  {% endif %}
</div>

{# ==================== SCRIPTS ==================== #}
<script>
document.addEventListener('DOMContentLoaded', function () {
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) navbar.classList.add('scrolled');
    else navbar.classList.remove('scrolled');
  });

  const dropdownToggles = document.querySelectorAll('[data-dropdown]');
  dropdownToggles.forEach(toggle => {
    const dropdown = document.getElementById(toggle.getAttribute('data-dropdown'));
    if (!dropdown) return;
    toggle.addEventListener('click', (e) => {
      e.preventDefault(); e.stopPropagation();
      dropdownToggles.forEach(t => {
        const d = document.getElementById(t.getAttribute('data-dropdown'));
        if (t !== toggle && d) { d.classList.remove('show'); t.setAttribute('aria-expanded','false'); }
      });
      const isOpen = dropdown.classList.contains('show');
      dropdown.classList.toggle('show', !isOpen);
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });
  });
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.nav-dropdown')) {
      dropdownToggles.forEach(t => {
        const d = document.getElementById(t.getAttribute('data-dropdown'));
        if (d) { d.classList.remove('show'); t.setAttribute('aria-expanded','false'); }
      });
    }
  });

  const burgerBtn = document.querySelector('[data-mobile-menu="toggle"]');
  const mobileMenu = document.getElementById('mobile-menu');
  if (burgerBtn && mobileMenu) {
    burgerBtn.addEventListener('click', function () {
      const isOpen = this.classList.contains('active');
      this.classList.toggle('active', !isOpen);
      mobileMenu.classList.toggle('show', !isOpen);
      this.setAttribute('aria-expanded', String(!isOpen));
      document.body.style.overflow = isOpen ? '' : 'hidden';
    });
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        burgerBtn.classList.remove('active');
        mobileMenu.classList.remove('show');
        burgerBtn.setAttribute('aria-expanded','false');
        document.body.style.overflow = '';
      });
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      dropdownToggles.forEach(t => {
        const d = document.getElementById(t.getAttribute('data-dropdown'));
        if (d) { d.classList.remove('show'); t.setAttribute('aria-expanded','false'); }
      });
      if (burgerBtn && mobileMenu) {
        burgerBtn.classList.remove('active');
        mobileMenu.classList.remove('show');
        burgerBtn.setAttribute('aria-expanded','false');
        document.body.style.overflow = '';
      }
    }
  });
});
</script>