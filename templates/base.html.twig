<!DOCTYPE html>
{% set currentRoute = app.request.attributes.get('_route') %}
{% set showNavbar = currentRoute != 'app_login' and (isDeniedPage is not defined or not isDeniedPage) %}
<html>
  <head>
    <meta charset="UTF-8">
    <title>{% block title %}ILD SECURITY | MOBILE MANAGEMENT{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    {% if isDeniedPage is defined and isDeniedPage %}
      <link rel="stylesheet" href="{{ asset('assets/css/denied.css') }}">
    {% else %}
      <link rel="stylesheet" href="{{ asset('assets/css/custom.css') }}">
    {% endif %}
    {% block stylesheets %}{% endblock %}
   
        {# Icônes pour différents appareils #}
    <meta name="application-name" content="ILD SECURITY MOBILE">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="Mon App">
    <meta name="mobile-web-app-capable" content="yes">

    {# Icônes pour différents appareils #}
    {# <link rel="manifest" href="{{ path('app_manifest') }}" type="application/manifest+json"> #}
    <link rel="manifest" href="{{ asset('manifest.webmanifest') }}">
    <meta name="theme-color" content="#0b1220">


    {# Favicon générique (facultatif) #}
    <link rel="icon" type="image/png" sizes="192x192" href="{{ asset('icons/icon-192.png') }}">

    {# Apple Touch (iOS) #}
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('icons/icon-192.png') }}">
     {% block javascripts %} <script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js', { scope: '/' });
    });
  }
</script>{% endblock %}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.full.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const $el = $('.vehicle-select');
  function templateResult(state) {
    if (!state.id) return state.text;
    const $opt = state.element;
    const photo = $($opt).data('photo'); // récupère data-photo
    const img = photo ? `<img src="${photo}" style="height:24px;width:36px;object-fit:cover;border-radius:4px;margin-right:8px">` : '';
    return $(`<span>${img}${state.text}</span>`);
  }
  function templateSelection(state) {
    return templateResult(state);
  }
  $el.select2({
    width: '100%',
    templateResult,
    templateSelection,
    escapeMarkup: m => m // autorise notre HTML
  });
});
</script>
  </head>

  <body class="{{ showNavbar ? 'has-header' : 'no-header' }}">
    {% if showNavbar %}
      {% include 'require/navbar.html.twig' %}
    {% endif %}

    <main class="{{ showNavbar ? 'page' : '' }}">
      {% block body %}{% endblock %}
    </main>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      const btn = document.querySelector('.nav-toggle');
      const nav = document.querySelector('.nav');
      if (btn && nav) {
        btn.addEventListener('click', () => {
          const open = nav.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      }
    </script>

      <script>
    window.addEventListener('load', () => {
      const header = document.querySelector('.site-header');
      if (!header) return;
      const setNavH = () => {
        const h = header.offsetHeight || 64;
        document.documentElement.style.setProperty('--nav-h', h + 'px');
      };
      setNavH();
      new ResizeObserver(setNavH).observe(header);
    });
  </script>

<script>
(function () {
  const input   = document.getElementById('client-search');
  const form    = document.getElementById('client-search-form');
  const alpha   = document.getElementById('alpha-filter');
  const results = document.getElementById('client-results');
  const loader  = document.getElementById('client-loader');

  if (!input || !results) return;

  let currentLetter = '';
  let timer;

  const setLoading = s => loader && loader.classList.toggle('d-none', !s);

  const buildUrl = () => {
    const p = new URLSearchParams();
    const q = input.value.trim();
    if (q) p.set('q', q);
    if (currentLetter !== '') p.set('letter', currentLetter);
    return '/clients/search?' + p.toString();
  };

  async function runSearch() {
    const q = input.value.trim();

    // ⛔ Si pas de texte ET pas de lettre sélectionnée → on efface et on sort
    if (!q && currentLetter === '') {
      results.innerHTML = '';
      setLoading(false);
      return;
    }

    setLoading(true);
    try {
      const res  = await fetch(buildUrl(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
      const html = await res.text();
      results.innerHTML = html;
    } catch (e) {
      results.innerHTML = '<div class="col-12 text-danger text-center py-4">Erreur lors de la recherche.</div>';
      console.error(e);
    } finally {
      setLoading(false);
    }
  }

  const debounce = () => { clearTimeout(timer); timer = setTimeout(runSearch, 300); };

  // Saisie : recherche uniquement si non vide (géré dans runSearch)
  input.addEventListener('input', debounce);

  // Submit du formulaire : empêche le reload et lance
  form.addEventListener('submit', (e) => { e.preventDefault(); runSearch(); });

  // Alphabet : sélectionne la lettre et lance (ou vide si "Tous")
  if (alpha) {
    alpha.addEventListener('click', (e) => {
      const a = e.target.closest('a[data-letter]');
      if (!a) return;
      e.preventDefault();
      currentLetter = a.dataset.letter || '';     // '' pour "Tous"
      alpha.querySelectorAll('a').forEach(el => el.classList.replace('btn-dark','btn-outline-secondary'));
      a.classList.add('btn-dark'); a.classList.remove('btn-outline-secondary');
      runSearch();                                // runSearch videra si aucun q et lettre=''
    });
  }

  // ❌ NE PAS lancer automatiquement au chargement
  // runSearch();
})();
</script>

<footer class="p-3 text-center">
  <button id="pwa-install-btn" class="btn btn-teal d-none" type="button" style="gap:.5rem; display:inline-flex; align-items:center;">
    <img src="{{ asset('icons/icon-192.png') }}" alt="" width="24" height="24">
    Installer l’app
  </button>

  {# Indication iOS (Safari n’a pas beforeinstallprompt) #}
  <div id="ios-a2hs" class="small text-muted d-none">
    Sur iPhone/iPad : <strong>Partager ▸ Sur l’écran d’accueil</strong> pour installer.
  </div>
</footer>
<script>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('/sw.js', { scope: '/' });
  });
}
</script>



