{# templates/clients/_cards.html.twig #}
{% set base = '/uploads/clients' %}

{% if clients is empty %}
  <div class="col-12">
    <div class="d-flex flex-column align-items-center justify-content-center py-5 text-center">
      <div class="mb-3">
        <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
      </div>
      <h5 class="text-muted mb-2">Aucun client trouvé</h5>
      <p class="text-muted small">Essayez de modifier vos critères de recherche</p>
    </div>
  </div>
{% else %}

  {# ====== Desktop / Tablette (≥ lg) : GRILLE DE CARTES ====== #}
  <div class="d-none d-lg-block">
    <div class="row g-3">
      {% for c in clients %}
        {% set firstPhoto = (c.photos is defined and c.photos|length > 0) ? c.photos|first : null %}
        {% set imgSrc = firstPhoto and firstPhoto.imageName
          ? asset(base ~ '/' ~ firstPhoto.imageName)
          : 'https://picsum.photos/400/250?grayscale&random=' ~ c.id
        %}

        <div class="col-xl-4 col-lg-6">
          <div class="card h-100 shadow-sm border-0 hover-card">
            <div class="position-relative overflow-hidden">
              <img src="{{ imgSrc }}" alt="Photo {{ c.nom }}"
                   class="card-img-top"
                   style="height: 180px; object-fit: cover;">
              <div class="position-absolute top-0 end-0 m-2">
                <span class="badge bg-primary bg-opacity-75 text-white">#{{ c.id }}</span>
              </div>
            </div>
            
            <div class="card-body d-flex flex-column">
              <h5 class="card-title text-truncate mb-2" title="{{ c.nom }}">
                {{ c.nom }}
              </h5>
              
              {% if c.adresse %}
                <p class="card-text text-muted small mb-3 flex-grow-1">
                  <i class="bi bi-geo-alt me-1"></i>
                  <span class="text-truncate d-inline-block" style="max-width: calc(100% - 20px);" title="{{ c.adresse }}">
                    {{ c.adresse }}
                  </span>
                </p>
              {% else %}
                <p class="card-text text-muted small mb-3 flex-grow-1">
                  <i class="bi bi-geo-alt me-1"></i>
                  <span class="fst-italic">Adresse non renseignée</span>
                </p>
              {% endif %}
              
              <div class="d-flex gap-1 mt-auto">
                <a class="btn btn-primary btn-sm flex-fill" 
                   href="{{ path('client_show', {id: c.id}) }}">
                  <i class="bi bi-eye me-1"></i> Voir
                </a>
                {% if is_granted('ROLE_ADMIN') %}
                  <a class="btn btn-outline-secondary btn-sm" 
                     href="{{ path('clients_edit', {id: c.id}) }}" 
                     title="Éditer">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <button class="btn btn-outline-danger btn-sm" 
                          title="Supprimer"
                          data-bs-toggle="modal" 
                          data-bs-target="#deleteModal{{ c.id }}">
                    <i class="bi bi-trash"></i>
                  </button>
                {% endif %}
              </div>
            </div>
          </div>
        </div>

        {# Modal de confirmation de suppression #}
        {% if is_granted('ROLE_ADMIN') %}
        <div class="modal fade" id="deleteModal{{ c.id }}" tabindex="-1">
          <div class="modal-dialog modal-sm">
            <div class="modal-content">
              <div class="modal-header border-0 pb-0">
                <h6 class="modal-title">Confirmer la suppression</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <p class="mb-0">Êtes-vous sûr de vouloir supprimer le client <strong>{{ c.nom }}</strong> ?</p>
              </div>
              <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <form method="post" action="{{ path('clients_delete', {id: c.id}) }}" class="d-inline">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete_client_' ~ c.id) }}">
                  <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                </form>
              </div>
            </div>
          </div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {# ====== Tablette (md à lg) : LISTE AVEC IMAGES MOYENNES ====== #}
  <div class="d-none d-md-block d-lg-none">
    <div class="vstack gap-3">
      {% for c in clients %}
        {% set firstPhoto = (c.photos is defined and c.photos|length > 0) ? c.photos|first : null %}
        {% set imgSrc = firstPhoto and firstPhoto.imageName
          ? asset(base ~ '/' ~ firstPhoto.imageName)
          : 'https://picsum.photos/300/200?grayscale&random=' ~ c.id
        %}

        <div class="card shadow-sm border-0 hover-card">
          <div class="card-body">
            <div class="row align-items-center g-3">
              <div class="col-md-3">
                <img src="{{ imgSrc }}" alt="Photo {{ c.nom }}"
                     class="img-fluid rounded"
                     style="width: 100%; height: 120px; object-fit: cover;">
              </div>
              
              <div class="col-md-6">
                <div class="d-flex align-items-center mb-2">
                  <h5 class="mb-0 me-2 text-truncate" title="{{ c.nom }}">{{ c.nom }}</h5>
                  <span class="badge bg-primary">#{{ c.id }}</span>
                </div>
                {% if c.adresse %}
                  <p class="text-muted small mb-0">
                    <i class="bi bi-geo-alt me-1"></i>
                    <span title="{{ c.adresse }}">{{ c.adresse|length > 60 ? c.adresse|slice(0, 60) ~ '...' : c.adresse }}</span>
                  </p>
                {% else %}
                  <p class="text-muted small fst-italic mb-0">
                    <i class="bi bi-geo-alt me-1"></i>
                    Adresse non renseignée
                  </p>
                {% endif %}
              </div>
              
              <div class="col-md-3">
                <div class="d-flex flex-column gap-2">
                  <a class="btn btn-primary btn-sm w-100" 
                     href="{{ path('client_show', {id: c.id}) }}">
                    <i class="bi bi-eye me-1"></i> Voir
                  </a>
                  {% if is_granted('ROLE_ADMIN') %}
                    <div class="d-flex gap-1">
                      <a class="btn btn-outline-secondary btn-sm flex-fill" 
                         href="{{ path('clients_edit', {id: c.id}) }}">
                        <i class="bi bi-pencil me-1"></i> Éditer
                      </a>
                      <button class="btn btn-outline-danger btn-sm" 
                              data-bs-toggle="modal" 
                              data-bs-target="#deleteModal{{ c.id }}">
                        <i class="bi bi-trash"></i>
                      </button>
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>

        {# Modal de suppression pour tablette #}
        {% if is_granted('ROLE_ADMIN') %}
        <div class="modal fade" id="deleteModal{{ c.id }}" tabindex="-1">
          <div class="modal-dialog modal-sm">
            <div class="modal-content">
              <div class="modal-header border-0 pb-0">
                <h6 class="modal-title">Confirmer la suppression</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <p class="mb-0">Êtes-vous sûr de vouloir supprimer le client <strong>{{ c.nom }}</strong> ?</p>
              </div>
              <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <form method="post" action="{{ path('clients_delete', {id: c.id}) }}" class="d-inline">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete_client_' ~ c.id) }}">
                  <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                </form>
              </div>
            </div>
          </div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {# ====== Mobile (< md) : CARTES COMPACTES ====== #}
  <div class="d-md-none">
    <div class="vstack gap-3">
      {% for c in clients %}
        {% set firstPhoto = (c.photos is defined and c.photos|length > 0) ? c.photos|first : null %}
        {% set imgSrc = firstPhoto and firstPhoto.imageName
          ? asset(base ~ '/' ~ firstPhoto.imageName)
          : 'https://picsum.photos/300/200?grayscale&random=' ~ c.id
        %}

        <div class="card shadow-sm border-0 hover-card">
          <img src="{{ imgSrc }}" alt="Photo {{ c.nom }}"
               class="card-img-top"
               style="height: 140px; object-fit: cover;">
          
          <div class="card-body pb-2">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h6 class="card-title mb-0 text-truncate flex-grow-1 me-2" title="{{ c.nom }}">
                {{ c.nom }}
              </h6>
              <span class="badge bg-primary text-nowrap">#{{ c.id }}</span>
            </div>
            
            {% if c.adresse %}
              <p class="card-text text-muted small mb-3">
                <i class="bi bi-geo-alt me-1"></i>
                <span class="text-truncate d-inline-block" style="max-width: calc(100% - 20px);" title="{{ c.adresse }}">
                  {{ c.adresse }}
                </span>
              </p>
            {% else %}
              <p class="card-text text-muted small fst-italic mb-3">
                <i class="bi bi-geo-alt me-1"></i>
                Adresse non renseignée
              </p>
            {% endif %}
          </div>
          
          <div class="card-footer bg-transparent border-0 pt-0">
            <div class="d-flex gap-1">
              <a class="btn btn-primary btn-sm flex-fill" 
                 href="{{ path('client_show', {id: c.id}) }}">
                <i class="bi bi-eye me-1"></i> Voir
              </a>
              {% if is_granted('ROLE_ADMIN') %}
                <a class="btn btn-outline-secondary btn-sm" 
                   href="{{ path('clients_edit', {id: c.id}) }}" 
                   title="Éditer">
                  <i class="bi bi-pencil"></i>
                </a>
                <button class="btn btn-outline-danger btn-sm" 
                        title="Supprimer"
                        data-bs-toggle="modal" 
                        data-bs-target="#deleteModalMobile{{ c.id }}">
                  <i class="bi bi-trash"></i>
                </button>
              {% endif %}
            </div>
          </div>
        </div>

        {# Modal de suppression pour mobile #}
        {% if is_granted('ROLE_ADMIN') %}
        <div class="modal fade" id="deleteModalMobile{{ c.id }}" tabindex="-1">
          <div class="modal-dialog modal-sm">
            <div class="modal-content">
              <div class="modal-header border-0 pb-0">
                <h6 class="modal-title">Confirmer la suppression</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <p class="mb-0">Êtes-vous sûr de vouloir supprimer le client <strong>{{ c.nom }}</strong> ?</p>
              </div>
              <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <form method="post" action="{{ path('clients_delete', {id: c.id}) }}" class="d-inline">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete_client_' ~ c.id) }}">
                  <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                </form>
              </div>
            </div>
          </div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

{% endif %}

<link rel="stylesheet" href="{{ asset('styles/clients/_cards.css') }}">