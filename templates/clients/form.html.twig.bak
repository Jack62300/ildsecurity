{# templates/clients/form.html.twig #}
{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}
  {{ mode == 'new' ? 'Nouveau client' : 'Modifier le client #' ~ client.id }}
{% endblock %}
 {% block javascripts %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  // --- Ne rien faire pour les non-admins (ADMIN/DEV uniquement) ---
  const IS_ADMIN = {{ is_granted('ROLE_ADMIN') ? 'true' : 'false' }};
  if (!IS_ADMIN) return;

  // --- Contexte ---
  const IS_EDIT = {{ mode == 'new' ? 'false' : 'true' }};

  // Charger la CSS Leaflet si absente
  (function ensureLeafletCss(){
    if (![...document.styleSheets].some(s => (s.href||'').includes('leaflet.css'))) {
      const l = document.createElement('link');
      l.rel = 'stylesheet';
      l.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
      document.head.appendChild(l);
    }
  })();

  // ====== France / Hauts-de-France ======
  const HDF_CENTER = [50.45, 2.74]; // centre HDF (Lens-Arras)
  const HDF_BBOX   = { left: 1.40, bottom: 49.60, right: 4.40, top: 51.30 }; // (W,S,E,N)
  const bboxStr    = `${HDF_BBOX.left},${HDF_BBOX.bottom},${HDF_BBOX.right},${HDF_BBOX.top}`;

  // Helpers
  const toFixed7 = v => Number(v).toFixed(7);
  const debounce = (fn, t=300) => { let id; return (...a)=>{ clearTimeout(id); id=setTimeout(()=>fn(...a), t); } };

  // Champs existants (du FormType)
  const addrEl = document.querySelector('[name$="[adresse]"]');
  const latEl  = document.querySelector('[name$="[latitude]"]');
  const lngEl  = document.querySelector('[name$="[longitude]"]');

  if (!addrEl || !latEl || !lngEl) return; // champs essentiels manquants

  // ==== Injection des éléments UI manquants (sans modifier le template) ====
  // 1) Conteneur “tools” sous l’adresse (suggestions + spinner + boutons)
  const addrGroup = addrEl.closest('.form-group, .mb-3') || addrEl.parentElement;
  addrGroup.style.position = 'relative';

  const suggestBox = document.createElement('div');
  suggestBox.id = 'address-suggestions';
  Object.assign(suggestBox.style, {
    position:'absolute', left:'0', right:'0', top:'100%',
    background:'#fff', border:'1px solid #e5e7eb', borderRadius:'6px',
    boxShadow:'0 10px 20px rgba(0,0,0,0.08)', zIndex:'999', display:'none',
    maxHeight:'300px', overflowY:'auto', marginTop:'6px'
  });
  addrGroup.appendChild(suggestBox);

  const spinner = document.createElement('div');
  spinner.id = 'addr-spinner';
  Object.assign(spinner.style, {
    position:'absolute', width:'18px', height:'18px', border:'2px solid #e5e7eb',
    borderTopColor:'#60a5fa', borderRadius:'50%', right:'10px', top:'12px',
    animation:'spin 1s linear infinite', display:'none', zIndex:'1000'
  });
  addrGroup.appendChild(spinner);

  // Petite keyframes pour le spinner
  const styleSpin = document.createElement('style');
  styleSpin.textContent = '@keyframes spin{to{transform:rotate(360deg)}}';
  document.head.appendChild(styleSpin);

  // Boutons sous l’adresse
  const toolsRow = document.createElement('div');
  toolsRow.style.marginTop = '8px';

  const geoBtn = document.createElement('button');
  geoBtn.type = 'button';
  geoBtn.id = 'btn-geocode';
  geoBtn.textContent = 'Localiser';
  geoBtn.className = 'btn-primary';
  Object.assign(geoBtn.style, { padding:'.4rem .8rem', marginRight:'8px' });

  const osmQuick = document.createElement('button');
  osmQuick.type = 'button';
  osmQuick.id = 'osm-quick';
  osmQuick.textContent = 'Voir sur OpenStreetMap';
  osmQuick.className = 'btn-secondary';
  Object.assign(osmQuick.style, { padding:'.4rem .8rem', display:'none' });

  toolsRow.appendChild(geoBtn);
  toolsRow.appendChild(osmQuick);
  addrGroup.insertAdjacentElement('afterend', toolsRow);

  // 2) Carte : on l’insère après les champs lat/lon
  const mapContainer = document.createElement('div');
  mapContainer.id = 'client-map-picker';
  Object.assign(mapContainer.style, {
    height:'380px', minHeight:'320px', border:'1px solid #e5e7eb',
    borderRadius:'8px', marginTop:'10px'
  });

  const lonGroup = lngEl.closest('.form-group, .mb-3');
  if (lonGroup && lonGroup.parentElement) {
    lonGroup.parentElement.insertAdjacentElement('afterend', mapContainer);
  } else {
    // fallback : à la fin du formulaire
    (addrGroup.closest('form') || document.body).appendChild(mapContainer);
  }

  // ========= LEAFLET =========
  let map, marker;

  function showOsmQuick(lat, lon) {
    osmQuick.style.display = 'inline-block';
    osmQuick.onclick = () =>
      window.open(`https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=18/${lat}/${lon}`, '_blank', 'noopener');
  }

  function initMap() {
    const initLat = latEl.value ? parseFloat(latEl.value) : null;
    const initLng = lngEl.value ? parseFloat(lngEl.value) : null;

    const center = (initLat && initLng) ? [initLat, initLng] : HDF_CENTER;
    const zoom   = (initLat && initLng) ? 15 : 8;

    map = L.map(mapContainer, { zoomControl: true }).setView(center, zoom);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    marker = L.marker(center, { draggable: true }).addTo(map);
    if (!initLat || !initLng) marker.setOpacity(0.7);

    map.whenReady(() => setTimeout(() => map.invalidateSize(), 100));

    marker.on('dragend', async e => {
      const { lat, lng } = e.target.getLatLng();
      latEl.value = toFixed7(lat);
      lngEl.value = toFixed7(lng);
      showOsmQuick(lat, lng);
      await reverseGeocode(lat, lng);
    });

    map.on('click', async e => {
      const { lat, lng } = e.latlng;
      marker.setLatLng([lat, lng]).setOpacity(1);
      latEl.value = toFixed7(lat);
      lngEl.value = toFixed7(lng);
      showOsmQuick(lat, lng);
      await reverseGeocode(lat, lng);
    });

    if (initLat && initLng) showOsmQuick(initLat, initLng);
    if (IS_EDIT) syncFromAddressOnLoad();
  }

  initMap();

  // ========= GEOCODING (BAN + fallback Nominatim) =========
  async function banSearch(q, limit = 8) {
    const url = new URL('https://api-adresse.data.gouv.fr/search/');
    url.searchParams.set('q', q);
    url.searchParams.set('autocomplete', '1');
    url.searchParams.set('limit', String(limit));
    url.searchParams.set('lat', String(HDF_CENTER[0]));
    url.searchParams.set('lon', String(HDF_CENTER[1]));
    url.searchParams.set('bbox', bboxStr);

    const r = await fetch(url.toString());
    if (!r.ok) return [];
    const data = await r.json();
    const feats = data.features || [];
    return feats.map(f => {
      const [lon, lat] = f.geometry?.coordinates || [];
      const p = f.properties || {};
      return {
        display: p.label || '',
        title: (p.housenumber ? p.housenumber + ' ' : '') + (p.street || p.name || ''),
        sub: [p.postcode, p.city, p.context].filter(Boolean).join(' · '),
        lat: parseFloat(lat), lon: parseFloat(lon),
        src: 'BAN'
      };
    });
  }

  async function banReverse(lat, lon) {
    const url = `https://api-adresse.data.gouv.fr/reverse/?lat=${encodeURIComponent(lat)}&lon=${encodeURIComponent(lon)}`;
    const r = await fetch(url);
    if (!r.ok) return null;
    const data = await r.json();
    const f = (data.features || [])[0];
    if (!f) return null;
    const p = f.properties || {};
    return p.label || null;
  }

  async function nominatimSearch(q, limit = 5) {
    const url = `https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&limit=${limit}&countrycodes=fr&viewbox=${HDF_BBOX.left},${HDF_BBOX.top},${HDF_BBOX.right},${HDF_BBOX.bottom}&bounded=1&q=${encodeURIComponent(q)}`;
    const r = await fetch(url, { headers: { 'Accept-Language': 'fr' } });
    if (!r.ok) return [];
    const data = await r.json();
    return data.map(d => {
      const a = d.address || {};
      return {
        display: d.display_name,
        title: (a.house_number ? a.house_number + ' ' : '') + (a.road || (d.display_name || '').split(',')[0]),
        sub: [a.postcode, a.city || a.town || a.village, 'FR'].filter(Boolean).join(' · '),
        lat: parseFloat(d.lat), lon: parseFloat(d.lon),
        src: 'Nominatim'
      };
    });
  }

  async function nominatimReverse(lat, lon) {
    const url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&addressdetails=1&lat=${encodeURIComponent(lat)}&lon=${encodeURIComponent(lon)}`;
    const r = await fetch(url, { headers: { 'Accept-Language': 'fr' } });
    if (!r.ok) return null;
    const data = await r.json();
    return data.display_name || null;
  }

  async function geocodeSingle(q) {
    const ban = await banSearch(q, 1);
    if (ban.length) return ban[0];
    const osm = await nominatimSearch(q, 1);
    if (osm.length) return osm[0];
    return null;
  }

  async function reverseGeocode(lat, lon) {
    try {
      spinner.style.display = 'inline-block';
      let address = await banReverse(lat, lon);
      if (!address) address = await nominatimReverse(lat, lon);
      if (address && addrEl) {
        addrEl.value = address;
        marker && marker.bindPopup(address).openPopup();
      }
    } catch (e) {
      console.error('reverse geocode error', e);
    } finally {
      spinner.style.display = 'none';
    }
  }

  // ========= SYNC adresse -> map au chargement (édition) =========
  async function syncFromAddressOnLoad() {
    const addr = (addrEl?.value || '').trim();
    if (!addr) return;

    const curLat = latEl.value ? parseFloat(latEl.value) : null;
    const curLng = lngEl.value ? parseFloat(lngEl.value) : null;

    spinner.style.display = 'inline-block';
    const res = await geocodeSingle(addr);
    spinner.style.display = 'none';
    if (!res) return;

    const { lat, lon, display } = res;
    const mustMove = !curLat || !curLng ||
      Math.hypot(lat - curLat, lon - curLng) > 0.0003; // ~30m

    if (mustMove) {
      latEl.value = toFixed7(lat);
      lngEl.value = toFixed7(lon);
      marker.setLatLng([lat, lon]).setOpacity(1);
      map.setView([lat, lon], 16);
      marker.bindPopup(display || addr).openPopup();
      showOsmQuick(lat, lon);
      setTimeout(() => map.invalidateSize(), 50);
    }
  }

  // ========= AUTOCOMPLÉTION =========
  let activeIndex = -1;
  let currentItems = [];

  function renderSuggestions(items) {
    currentItems = items; activeIndex = -1;
    if (!items.length) return hideSuggestions();

    suggestBox.innerHTML = items.map((it, i) => `
      <div class="address-suggestion" data-index="${i}" style="padding:.6rem .8rem; border-bottom:1px solid #f1f5f9; cursor:pointer">
        <div style="font-weight:600; color:#1e293b">${it.title || it.display}</div>
        ${it.sub ? `<div style="font-size:.85rem; color:#64748b">${it.sub}</div>` : ''}
        <div style="font-size:.7rem; color:#94a3b8; margin-top:2px">${it.src || ''}</div>
      </div>
    `).join('');
    suggestBox.style.display = 'block';
  }
  function hideSuggestions(){ suggestBox.style.display='none'; suggestBox.innerHTML=''; currentItems=[]; activeIndex=-1; }

  const fetchSuggestions = debounce(async (q) => {
    if (!q || q.length < 3) { hideSuggestions(); return; }
    const ban = await banSearch(q, 8);
    const list = [...ban];
    if (list.length < 5) list.push(...await nominatimSearch(q, 5 - list.length));
    renderSuggestions(list.slice(0, 10));
  }, 250);

  function applySelection(i) {
    const it = currentItems[i]; if (!it) return;
    addrEl.value = it.display;
    latEl.value  = toFixed7(it.lat);
    lngEl.value  = toFixed7(it.lon);
    marker.setLatLng([it.lat, it.lon]).setOpacity(1);
    map.setView([it.lat, it.lon], 16);
    marker.bindPopup(it.display).openPopup();
    showOsmQuick(it.lat, it.lon);
    hideSuggestions();
    setTimeout(() => map.invalidateSize(), 50);
  }

  if (addrEl) {
    addrEl.setAttribute('autocomplete', 'off');

    addrEl.addEventListener('input', e => fetchSuggestions(e.target.value.trim()));
    addrEl.addEventListener('focus', () => { if (currentItems.length) suggestBox.style.display = 'block'; });

    addrEl.addEventListener('blur', async () => {
      const q = addrEl.value.trim();
      if (!q) return;
      spinner.style.display = 'inline-block';
      const res = await geocodeSingle(q);
      spinner.style.display = 'none';
      if (!res) return;
      addrEl.value = res.display || q;
      latEl.value  = toFixed7(res.lat);
      lngEl.value  = toFixed7(res.lon);
      marker.setLatLng([res.lat, res.lon]).setOpacity(1);
      map.setView([res.lat, res.lon], 16);
      marker.bindPopup(res.display || q).openPopup();
      showOsmQuick(res.lat, res.lon);
      setTimeout(() => map.invalidateSize(), 50);
    });

    addrEl.addEventListener('keydown', (e) => {
      if (suggestBox.style.display !== 'block') return;
      const max = currentItems.length - 1;
      if (e.key === 'ArrowDown') { e.preventDefault(); activeIndex = Math.min(max, activeIndex + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); activeIndex = Math.max(0, activeIndex - 1); }
      else if (e.key === 'Enter')   { if (activeIndex >= 0) { e.preventDefault(); applySelection(activeIndex); } }
      else if (e.key === 'Escape')  { hideSuggestions(); return; }
      [...suggestBox.children].forEach((el, i) => {
        el.style.background = i === activeIndex ? '#f8fafc' : '#fff';
      });
    });

    suggestBox.addEventListener('click', (e) => {
      const itemEl = e.target.closest('.address-suggestion'); if (!itemEl) return;
      applySelection(parseInt(itemEl.dataset.index, 10));
    });

    document.addEventListener('click', (e) => {
      if (!suggestBox.contains(e.target) && !addrEl.contains(e.target)) hideSuggestions();
    });
  }

  // Bouton "Localiser"
  geoBtn.addEventListener('click', async () => {
    const q = (addrEl?.value || '').trim();
    if (!q) { alert('Veuillez saisir une adresse.'); return; }
    spinner.style.display = 'inline-block';
    const res = await geocodeSingle(q);
    spinner.style.display = 'none';
    if (!res) { alert('Adresse introuvable.'); return; }
    addrEl.value = res.display || q;
    latEl.value  = toFixed7(res.lat);
    lngEl.value  = toFixed7(res.lon);
    marker.setLatLng([res.lat, res.lon]).setOpacity(1);
    map.setView([res.lat, res.lon], 16);
    marker.bindPopup(res.display || q).openPopup();
    showOsmQuick(res.lat, res.lon);
    setTimeout(() => map.invalidateSize(), 50);
  });
});
</script>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  .client-form-container {
    max-width: 1000px;
    margin: 2rem auto;
    background: #ffffff;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    border: 1px solid #e5e7eb;
    overflow: hidden;
  }

  .form-header {
    background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
    border-bottom: 2px solid #e2e8f0;
    padding: 1.5rem 2rem;
    position: relative;
  }

  .form-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #93c5fd, #60a5fa, #93c5fd);
  }

  .form-title {
    display: flex;
    align-items: center;
    justify-content: between;
    gap: 1rem;
    margin: 0;
    flex-wrap: wrap;
  }

  .title-content {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
  }

  .title-icon {
    width: 40px;
    height: 40px;
    background: #93c5fd;
    color: #1e40af;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .title-text {
    color: #1e293b;
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
  }

  .permission-badge {
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid;
  }

  .permission-badge.admin {
    background: #d1fae5;
    color: #047857;
    border-color: #86efac;
  }

  .permission-badge.restricted {
    background: #fef3c7;
    color: #d97706;
    border-color: #fbbf24;
  }

  .form-content {
    padding: 2rem;
    background: #ffffff;
  }

  .form-section {
    margin-bottom: 2.5rem;
  }

  .form-section:last-child {
    margin-bottom: 0;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .section-icon {
    width: 32px;
    height: 32px;
    background: #dbeafe;
    color: #1d4ed8;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    border: 1px solid #93c5fd;
  }

  .section-title {
    color: #1e293b;
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
  }

  /* Formulaire en lecture seule */
  .readonly-info {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .readonly-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
  }

  .readonly-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .readonly-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #374151;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .readonly-value {
    font-size: 0.875rem;
    color: #1e293b;
    font-weight: 500;
  }

  .readonly-value.empty {
    color: #94a3b8;
    font-style: italic;
  }

  /* Amélioration des champs de formulaire */
  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-label {
    font-weight: 600;
    color: #1f2937;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
  }

  .form-control {
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 0.75rem;
    font-size: 0.875rem;
    transition: all 0.2s ease;
    background: #ffffff;
    color: #1f2937;
  }

  .form-control:focus {
    border-color: #93c5fd;
    box-shadow: 0 0 0 3px rgba(147, 197, 253, 0.2);
    outline: none;
  }

  .form-control:invalid {
    border-color: #dc2626;
  }

  .form-control:invalid:focus {
    box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.1);
  }

  /* Section photos */
  .photos-section {
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 1.5rem;
    margin-top: 1rem;
  }

  #photos-collection .form-group {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 1rem;
    margin-bottom: 1rem;
  }

  .add-photo-btn {
    background: #ffffff;
    border: 2px dashed #93c5fd;
    color: #1d4ed8;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s ease;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .add-photo-btn:hover {
    background: #f0f9ff;
    border-color: #60a5fa;
    color: #1e40af;
  }

  /* Boutons d'action */
  .form-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
    padding-top: 1.5rem;
    border-top: 1px solid #e5e7eb;
    margin-top: 2rem;
  }

  .btn-primary {
    background: #93c5fd;
    border: 1px solid #93c5fd;
    color: #1e40af;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-weight: 500;
    font-size: 0.875rem;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-primary:hover {
    background: #60a5fa;
    border-color: #60a5fa;
    color: #1e3a8a;
  }

  .btn-secondary {
    background: #ffffff;
    border: 1px solid #d1d5db;
    color: #374151;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-weight: 500;
    font-size: 0.875rem;
    transition: all 0.2s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-secondary:hover {
    background: #f9fafb;
    border-color: #9ca3af;
    color: #111827;
    text-decoration: none;
  }

  /* Messages d'alerte */
  .alert {
    border-radius: 6px;
    padding: 1rem;
    margin-bottom: 1.5rem;
    border: 1px solid;
  }

  .alert-danger {
    background: #fef2f2;
    color: #991b1b;
    border-color: #fecaca;
  }

  .alert-success {
    background: #f0fdf4;
    color: #166534;
    border-color: #bbf7d0;
  }

  .alert-info {
    background: #eff6ff;
    color: #1e40af;
    border-color: #bfdbfe;
  }

  .alert-warning {
    background: #fffbeb;
    color: #92400e;
    border-color: #fed7aa;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .client-form-container {
      margin: 1rem;
      border-radius: 6px;
    }
    
    .form-header {
      padding: 1rem 1.5rem;
    }
    
    .form-content {
      padding: 1.5rem;
    }
    
    .title-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    
    .form-title {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    
    .readonly-grid {
      grid-template-columns: 1fr;
    }
    
    .form-actions {
      flex-direction: column-reverse;
    }
    
    .btn-primary,
    .btn-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid py-4">

  {% for label, messages in app.flashes %}
    {% for message in messages %}
      <div class="alert alert-{{ label }}">{{ message }}</div>
    {% endfor %}
  {% endfor %}

  <div class="client-form-container">
    <div class="form-header">
      <div class="form-title">
        <div class="title-content">
          <div class="title-icon">
            {% if mode == 'new' %}
              👤+
            {% else %}
              ⚙️
            {% endif %}
          </div>
          <h1 class="title-text">
            {% if mode == 'new' %}
              Nouveau client
            {% else %}
              Client #{{ client.id }}
            {% endif %}
          </h1>
        </div>

        {% if photos_only %}
          <span class="permission-badge restricted">
            📷 Édition photos uniquement
          </span>
        {% elseif mode == 'edit' %}
          <span class="permission-badge admin">
            🔑 Accès administrateur
          </span>
        {% endif %}
      </div>
    </div>

    <div class="form-content">
      {{ form_start(form, { attr: { id: 'client-form' } }) }}

      {% if form.vars.submitted and not form.vars.valid %}
        <div class="alert alert-danger">
          <strong>Erreurs de validation :</strong>
          {{ form_errors(form) }}
          {% for child in form %}
            {{ form_errors(child) }}
          {% endfor %}
        </div>
      {% endif %}

      {# SECTION INFORMATIONS CLIENT #}
      {% if not photos_only %}
        <div class="form-section">
          <div class="section-header">
            <div class="section-icon">📋</div>
            <h2 class="section-title">Informations client</h2>
          </div>
          
          <div class="row g-3">
            {% if form.nom is defined %}<div class="col-md-6">{{ form_row(form.nom) }}</div>{% endif %}
            {% if form.codetls is defined %}<div class="col-md-6">{{ form_row(form.codetls) }}</div>{% endif %}
            {% if form.organisme is defined %}<div class="col-md-6">{{ form_row(form.organisme) }}</div>{% endif %}
            {% if form.key is defined %}<div class="col-md-6">{{ form_row(form.key) }}</div>{% endif %}
            {% if form.agence is defined %}<div class="col-md-6">{{ form_row(form.agence) }}</div>{% endif %}
            {% if form.codeAlarme is defined %}<div class="col-md-6">{{ form_row(form.codeAlarme) }}</div>{% endif %}
            {% if form.description is defined %}<div class="col-12">{{ form_row(form.description) }}</div>{% endif %}
            {% if form.keycodeild is defined %}<div class="col-md-6">{{ form_row(form.keycodeild) }}</div>{% endif %}
            {% if form.adresse is defined %}<div class="col-md-6">{{ form_row(form.adresse) }}</div>{% endif %}
            <div class="col-md-6">{% if form.latitude is defined %}{{ form_row(form.latitude) }}{% endif %}</div>
            <div class="col-md-6">{% if form.longitude is defined %}{{ form_row(form.longitude) }}{% endif %}</div>
            {% if form.information is defined %}<div class="col-12">{{ form_row(form.information) }}</div>{% endif %}
          </div>
        </div>
      {% else %}
        {# MODE LECTURE SEULE POUR LES UTILISATEURS #}
        <div class="form-section">
          <div class="section-header">
            <div class="section-icon">📋</div>
            <h2 class="section-title">Informations client (lecture seule)</h2>
          </div>
          
          <div class="readonly-info">
            <div class="readonly-grid">
              <div class="readonly-item">
                <div class="readonly-label">Nom</div>
                <div class="readonly-value">{{ client.nom }}</div>
              </div>
              <div class="readonly-item">
                <div class="readonly-label">Organisme</div>
                <div class="readonly-value {{ client.organisme ? '' : 'empty' }}">
                  {{ client.organisme ?? 'Non renseigné' }}
                </div>
              </div>
              <div class="readonly-item">
                <div class="readonly-label">Agence</div>
                <div class="readonly-value {{ client.agence ? '' : 'empty' }}">
                  {{ client.agence ?? 'Non renseigné' }}
                </div>
              </div>
              <div class="readonly-item">
                <div class="readonly-label">Adresse</div>
                <div class="readonly-value {{ client.adresse ? '' : 'empty' }}">
                  {{ client.adresse ?? 'Non renseigné' }}
                </div>
              </div>
              <div class="readonly-item">
                <div class="readonly-label">Code TLS</div>
                <div class="readonly-value {{ client.codetls ? '' : 'empty' }}">
                  {{ client.codetls ?? 'Non renseigné' }}
                </div>
              </div>
              <div class="readonly-item">
                <div class="readonly-label">Code alarme</div>
                <div class="readonly-value {{ client.codeAlarme ? '' : 'empty' }}">
                  {{ client.codeAlarme ?? 'Non renseigné' }}
                </div>
              </div>
              <div class="readonly-item">
                <div class="readonly-label">Key ILD</div>
                <div class="readonly-value {{ client.keycodeild ? '' : 'empty' }}">
                  {{ client.keycodeild ?? 'Non renseigné' }}
                </div>
              </div>
              <div class="readonly-item">
                <div class="readonly-label">Coordonnées</div>
                <div class="readonly-value {{ (client.latitude and client.longitude) ? '' : 'empty' }}">
                  {% if client.latitude and client.longitude %}
                    {{ client.latitude }}, {{ client.longitude }}
                  {% else %}
                    Non renseigné
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endif %}

      {# SECTION PHOTOS (accessible à tous) #}
      <div class="form-section">
        <div class="section-header">
          <div class="section-icon">📷</div>
          <h2 class="section-title">Photos</h2>
        </div>

        <div class="photos-section">
          {% if form.photos is defined %}
            <div id="photos-collection" data-prototype="{{ form_widget(form.photos.vars.prototype)|e('html_attr') }}">
              {{ form_widget(form.photos) }}
            </div>
            <button type="button" class="add-photo-btn" id="add-photo">
              ➕ Ajouter une photo
            </button>
          {% endif %}

          {% if form.mobileUploads is defined %}
            {{ form_row(form.mobileUploads) }}
          {% endif %}
        </div>
      </div>

      <div class="form-actions">
        <a href="{{ path('clients_index') }}" class="btn-secondary">
          ❌ Annuler
        </a>
        <button type="submit" class="btn-primary">
          ✅ {{ mode == 'new' ? 'Créer le client' : 'Enregistrer' }}
        </button>
      </div>

      {{ form_end(form) }}
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  // Gestion de l'ajout de photos
  const addBtn = document.getElementById('add-photo');
  const container = document.getElementById('photos-collection');
  
  if (addBtn && container) {
    addBtn.addEventListener('click', function () {
      const index = container.querySelectorAll('fieldset, .form-group, .mb-3').length;
      const proto = container.dataset.prototype.replace(/__name__/g, index);
      const wrap = document.createElement('div');
      wrap.innerHTML = proto;
      
      // Ajouter la classe de style à l'élément ajouté
      const newElement = wrap.firstElementChild;
      newElement.classList.add('form-group');
      
      container.appendChild(newElement);
      
      // Focus sur le nouveau champ ajouté
      const newInput = newElement.querySelector('input');
      if (newInput) {
        newInput.focus();
      }
    });
  }

  // Amélioration du feedback utilisateur sur la soumission
  const form = document.getElementById('client-form');
  const submitBtn = form?.querySelector('button[type="submit"]');
  
  if (form && submitBtn) {
    form.addEventListener('submit', function(e) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '⏳ Enregistrement...';
      
      // Re-enable le bouton si le formulaire est invalide
      setTimeout(() => {
        if (!form.checkValidity()) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '✅ {{ mode == 'new' ? 'Créer le client' : 'Enregistrer' }}';
        }
      }, 100);
    });
  }

  // Validation en temps réel pour les champs requis
  const requiredFields = document.querySelectorAll('[required]');
  requiredFields.forEach(field => {
    field.addEventListener('blur', function() {
      if (this.value.trim() === '') {
        this.classList.add('is-invalid');
      } else {
        this.classList.remove('is-invalid');
      }
    });
    
    field.addEventListener('input', function() {
      if (this.value.trim() !== '') {
        this.classList.remove('is-invalid');
      }
    });
  });
});
</script>
{% endblock %}