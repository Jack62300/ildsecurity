{% extends 'base.html.twig' %}

{% block title %}Fiche client — {{ client.nom }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <link rel="stylesheet" href="{{ asset('styles/clients/show.css') }}">
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">

  {# ========== HEADER MODERNE ========== #}
  <div class="page-header">
    <div class="d-flex flex-column">
      <h1>
        <i class="bi bi-person-vcard me-2"></i>{{ client.nom }}
      </h1>
      <p class="subtitle mb-0">
        Fiche complète du client #{{ client.id }}
        {% if client.organisme %}
          • {{ client.organisme.name }}
        {% endif %}
      </p>
      
      <div class="page-header-actions">
        <a href="{{ path('clients_index') }}" class="btn-header">
          <i class="bi bi-arrow-left"></i>
          Retour à la liste
        </a>
        <a href="{{ path('clients_edit', {id: client.id}) }}" class="btn-header btn-primary-alt">
          <i class="bi bi-pencil"></i>
          Modifier
        </a>
        <button onclick="window.print()" class="btn-header">
          <i class="bi bi-printer"></i>
          Imprimer
        </button>
      </div>
    </div>
  </div>

  {# ========== CONTENU PRINCIPAL ========== #}
  <div class="client-sheet">
    <div class="modern-card">

      {# ========== INFORMATIONS GÉNÉRALES ========== #}
      <div class="info-section">
        <div class="section-title">
          <div class="section-icon">
            <i class="bi bi-info-circle"></i>
          </div>
          Informations générales
        </div>

        <div class="info-grid">
          <div class="info-item">
            <div class="info-label">
              <i class="bi bi-person"></i>
              Nom du client
            </div>
            <div class="info-value">{{ client.nom }}</div>
          </div>

          <div class="info-item">
            <div class="info-label">
              <i class="bi bi-hash"></i>
              Code TLS
            </div>
            <div class="info-value {{ client.codetls ? '' : 'empty' }}">
              {{ client.codetls ?: 'Non renseigné' }}
            </div>
          </div>

          <div class="info-item">
            <div class="info-label">
              <i class="bi bi-building"></i>
              Organisme
            </div>
            <div class="info-value">
              {% if client.organisme %}
                <span class="organisme-badge">
                  <i class="bi bi-building"></i>
                  {{ client.organisme.name }}
                </span>
              {% else %}
                <span class="empty">Non assigné</span>
              {% endif %}
            </div>
          </div>

          <div class="info-item">
            <div class="info-label">
              <i class="bi bi-shield-lock"></i>
              Code alarme
            </div>
            <div class="info-value {{ client.codeAlarme ? '' : 'empty' }}">
              {{ client.codeAlarme ?: 'Non renseigné' }}
            </div>
          </div>

          <div class="info-item">
            <div class="info-label">
              <i class="bi bi-key"></i>
              Keycode ILD
            </div>
            <div class="info-value {{ client.keycodeild ? '' : 'empty' }}">
              {{ client.keycodeild ?: 'Non renseigné' }}
            </div>
          </div>

          <div class="info-item">
            <div class="info-label">
              <i class="bi bi-geo-alt"></i>
              Adresse
            </div>
            <div class="info-value {{ client.adresse ? '' : 'empty' }}">
              {{ client.adresse ? client.adresse|nl2br : 'Non renseignée' }}
            </div>
          </div>
        </div>
      </div>

      {# ========== ACCÈS ET SÉCURITÉ ========== #}
      <div class="info-section">
        <div class="section-title">
          <div class="section-icon">
            <i class="bi bi-key-fill"></i>
          </div>
          Accès et sécurité
        </div>

        <div class="info-grid">
          <div class="info-item">
            <div class="info-label">
              <i class="bi bi-collection"></i>
              Clés d'accès
            </div>
            <div class="info-value">
              {% set keys = client.key is iterable ? client.key : (client.key ? client.key|split(',') : []) %}
              {% if keys|length > 0 %}
                <div class="chips">
                  {% for k in keys %}
                    {% set item = k|trim %}
                    {% if item != '' %}
                      <span class="chip">{{ item }}</span>
                    {% endif %}
                  {% endfor %}
                </div>
              {% else %}
                <span class="empty">Aucune clé renseignée</span>
              {% endif %}
            </div>
          </div>

          <div class="info-item">
            <div class="info-label">
              <i class="bi bi-chat-text"></i>
              Informations complémentaires
            </div>
            <div class="info-value {{ client.information ? '' : 'empty' }}">
              {{ client.information ? client.information|nl2br : 'Aucune information' }}
            </div>
          </div>
        </div>
      </div>

      {# ========== DESCRIPTION ========== #}
      {% if client.description %}
        <div class="info-section">
          <div class="section-title">
            <div class="section-icon">
              <i class="bi bi-file-text"></i>
            </div>
            Description
          </div>
          <div class="info-value">{{ client.description|nl2br }}</div>
        </div>
      {% endif %}

      {# ========== LOCALISATION ========== #}
      {% if client.latitude and client.longitude %}
        <div class="info-section">
          <div class="section-title">
            <div class="section-icon">
              <i class="bi bi-geo-alt"></i>
            </div>
            Localisation
          </div>
          
          <div class="map-container">
            <div id="client-map"></div>
          </div>
          
          <div class="coordinates-info">
            <div>
              <strong>Coordonnées GPS :</strong>
            </div>
            <div>
              Latitude: {{ client.latitude }} • Longitude: {{ client.longitude }}
            </div>
          </div>
        </div>
      {% endif %}

      {# ========== GALERIE PHOTOS ========== #}
      <div class="info-section">
        <div class="section-title">
          <div class="section-icon">
            <i class="bi bi-images"></i>
          </div>
          Galerie photos
        </div>

        {% set base = '/uploads/clients' %}
        {% if client.photos is defined and client.photos|length > 0 %}
          <div class="photo-gallery">
            {% for p in client.photos %}
              {% if p.imageName %}
                <a href="{{ asset(base ~ '/' ~ p.imageName) }}" target="_blank" rel="noopener" class="photo-item">
                  <img src="{{ asset(base ~ '/' ~ p.imageName) }}" 
                       alt="Photo {{ loop.index }} de {{ client.nom }}"
                       loading="lazy">
                  <div class="photo-overlay">
                    <div class="photo-info">
                      Photo {{ loop.index }}
                    </div>
                  </div>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        {% else %}
          <div class="empty-state">
            <i class="bi bi-image"></i>
            <div>Aucune photo disponible</div>
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</div>
  {% if client.latitude and client.longitude %}
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    const map = L.map('client-map').setView([{{ client.latitude }}, {{ client.longitude }}], 15);
    
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);
    
    const marker = L.marker([{{ client.latitude }}, {{ client.longitude }}]).addTo(map);
    
    marker.bindPopup(`
      <div style="text-align: center;">
        <strong>{{ client.nom|e('js') }}</strong><br>
        {% if client.adresse %}
          <small>{{ client.adresse|e('js') }}</small>
        {% endif %}
      </div>
    `).openPopup();
    
    setTimeout(() => map.invalidateSize(), 100);
  });
  </script>
  {% endif %}
{% endblock %}

