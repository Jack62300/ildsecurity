{% extends 'base.html.twig' %}

{% block title %}Fiche client — {{ client.nom }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <link rel="stylesheet" href="{{ asset('styles/clients/show.css') }}">
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">

  {# ===== HEADER COMPACT + ACTIONS ===== #}
  <div class="page-header">
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
      <div>
        <h1 class="mb-1">
          <i class="bi bi-person-vcard me-2"></i>{{ client.nom }}
        </h1>
        <p class="subtitle mb-0">
          Fiche client #{{ client.id }}
          {% if client.organisme %} • {{ client.organisme.name }}{% endif %}
        </p>
      </div>

      <div class="page-header-actions">
        <a href="{{ path('clients_index') }}" class="btn-header">
          <i class="bi bi-arrow-left"></i> Retour
        </a>
        <a href="{{ path('clients_edit', {id: client.id}) }}" class="btn-header btn-primary-alt">
          <i class="bi bi-pencil"></i> Modifier
        </a>
        <button onclick="window.print()" class="btn-header">
          <i class="bi bi-printer"></i> Imprimer
        </button>
      </div>
    </div>
  </div>

  {# ===== BARRE DE SYNTHÈSE ===== #}
  <div class="client-sheet">
    <div class="modern-card">
      <div class="info-section">
        <div class="info-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
          <div class="info-item">
            <div class="info-label"><i class="bi bi-hash"></i>Identifiant</div>
            <div class="info-value">#{{ client.id }}</div>
          </div>
          <div class="info-item">
            <div class="info-label"><i class="bi bi-building"></i>Organisme</div>
            <div class="info-value">
              {% if client.organisme %}
                <span class="organisme-badge"><i class="bi bi-building"></i>{{ client.organisme.name }}</span>
              {% else %}
                <span class="empty">Non assigné</span>
              {% endif %}
            </div>
          </div>
          <div class="info-item">
            <div class="info-label"><i class="bi bi-shield-lock"></i>Code alarme</div>
            <div class="info-value {{ client.codeAlarme ? '' : 'empty' }}">
              {{ client.codeAlarme ?: 'Non renseigné' }}
            </div>
          </div>
          <div class="info-item">
            <div class="info-label"><i class="bi bi-key"></i>Keycode ILD</div>
            <div class="info-value {{ client.keycodeild ? '' : 'empty' }}">
              {{ client.keycodeild ?: 'Non renseigné' }}
            </div>
          </div>
        </div>
      </div>
    </div>

    {# ===== LAYOUT 2 COLONNES ===== #}
    <div class="mt-3" style="display:grid; grid-template-columns: 2fr 1.3fr; gap: 1.25rem;">
      {# === COLONNE GAUCHE : Infos & description === #}
      <div style="display:flex; flex-direction:column; gap:1.25rem;">

        {# Informations générales #}
        <div class="modern-card">
          <div class="info-section">
            <div class="section-title">
              <div class="section-icon"><i class="bi bi-info-circle"></i></div>
              Informations générales
            </div>

            <div class="info-grid">
              <div class="info-item">
                <div class="info-label"><i class="bi bi-person"></i>Nom du client</div>
                <div class="info-value">{{ client.nom }}</div>
              </div>

              <div class="info-item">
                <div class="info-label"><i class="bi bi-hash"></i>Code TLS</div>
                <div class="info-value {{ client.codetls ? '' : 'empty' }}">
                  {{ client.codetls ?: 'Non renseigné' }}
                </div>
              </div>

              <div class="info-item" style="grid-column: 1 / -1;">
                <div class="info-label"><i class="bi bi-geo-alt"></i>Adresse</div>
                <div class="info-value {{ client.adresse ? '' : 'empty' }}">
                  {{ client.adresse ? client.adresse|nl2br : 'Non renseignée' }}
                </div>
              </div>
            </div>
          </div>
        </div>

        {# Accès et sécurité #}
        <div class="modern-card">
          <div class="info-section">
            <div class="section-title">
              <div class="section-icon"><i class="bi bi-key-fill"></i></div>
              Accès & sécurité
            </div>

            <div class="info-grid">
              <div class="info-item">
                <div class="info-label"><i class="bi bi-collection"></i>Clés d'accès</div>
                <div class="info-value">
                  {% set keys = client.key is iterable ? client.key : (client.key ? client.key|split(',') : []) %}
                  {% if keys|length > 0 %}
                    <div class="chips">
                      {% for k in keys %}
                        {% set item = k|trim %}
                        {% if item != '' %}<span class="chip">{{ item }}</span>{% endif %}
                      {% endfor %}
                    </div>
                  {% else %}
                    <span class="empty">Aucune clé renseignée</span>
                  {% endif %}
                </div>
              </div>

              <div class="info-item" style="grid-column: 1 / -1;">
                <div class="info-label"><i class="bi bi-chat-text"></i>Informations complémentaires</div>
                <div class="info-value {{ client.information ? '' : 'empty' }}">
                  {{ client.information ? client.information|nl2br : 'Aucune information' }}
                </div>
              </div>
            </div>
          </div>
        </div>

        {# Description (si présente) #}
        {% if client.description %}
          <div class="modern-card">
            <div class="info-section">
              <div class="section-title">
                <div class="section-icon"><i class="bi bi-file-text"></i></div>
                Description
              </div>
              <div class="info-value">{{ client.description|nl2br }}</div>
            </div>
          </div>
        {% endif %}

      </div>

      {# === COLONNE DROITE : Carte & Galerie === #}
      <div style="display:flex; flex-direction:column; gap:1.25rem;">

        {# Localisation (si lat/lng) #}
        {% if client.latitude and client.longitude %}
        <div class="modern-card">
          <div class="info-section">
            <div class="section-title">
              <div class="section-icon"><i class="bi bi-geo-alt"></i></div>
              Localisation
            </div>
            <div class="map-container"><div id="client-map"></div></div>
            <div class="coordinates-info mt-2">
              <div><strong>Coordonnées GPS :</strong></div>
              <div>Latitude: {{ client.latitude }} • Longitude: {{ client.longitude }}</div>
            </div>
          </div>
        </div>
        {% endif %}

        {# ========== GALERIE PHOTOS (max 10) ========== #}
        <div class="modern-card">
          <div class="info-section">
            <div class="section-title">
              <div class="section-icon"><i class="bi bi-images"></i></div>
              Galerie photos
              {# compteur #}
              {% set total = (client.photos is defined) ? client.photos|length : 0 %}
              {% set shown = total > 10 ? 10 : total %}
              <span class="photo-counter-badge" title="Nombre total de photos">{{ shown }}/{{ total }}</span>
            </div>

            {% set base = '/uploads/clients' %}
            {% if total > 0 %}
              {% set photos10 = client.photos|slice(0, shown) %}
              <div class="photo-gallery photo-gallery--max10">
                {% for p in photos10 %}
                  {% if p.imageName %}
                    <a href="{{ asset(base ~ '/' ~ p.imageName) }}" target="_blank" rel="noopener" class="photo-item" aria-label="Photo {{ loop.index }} de {{ client.nom }}">
                      <img src="{{ asset(base ~ '/' ~ p.imageName) }}"
                           alt="Photo {{ loop.index }} de {{ client.nom }}"
                           loading="lazy" decoding="async">
                      <div class="photo-overlay"><div class="photo-info">Photo {{ loop.index }}</div></div>
                    </a>
                  {% endif %}
                {% endfor %}
              </div>

              {% if total > shown %}
                <div class="photo-more-note">
                  <i class="bi bi-info-circle me-1"></i>
                  {{ total - shown }} photo(s) supplémentaire(s) non affichée(s) ici.
                </div>
              {% endif %}
            {% else %}
              <div class="empty-state">
                <i class="bi bi-image"></i>
                <div>Aucune photo disponible</div>
              </div>
            {% endif %}
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

{# ===== Leaflet init (si coordonnées) ===== #}
{% if client.latitude and client.longitude %}
<script>
document.addEventListener('DOMContentLoaded', function () {
  const map = L.map('client-map').setView([{{ client.latitude }}, {{ client.longitude }}], 15);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; OpenStreetMap contributors'
  }).addTo(map);
  const marker = L.marker([{{ client.latitude }}, {{ client.longitude }}]).addTo(map);
  marker.bindPopup(`
    <div style="text-align:center;">
      <strong>{{ client.nom|e('js') }}</strong><br>
      {% if client.adresse %}<small>{{ client.adresse|e('js') }}</small>{% endif %}
    </div>
  `);
  setTimeout(() => map.invalidateSize(), 100);
});
</script>
{% endif %}
{% endblock %}
