{# templates/clients/form_osm_full.html.twig #}
{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}{{ mode == 'new' ? 'Nouveau client' : 'Modifier le client #' ~ client.id }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>

  <style>
    :root {
      /* Modern Color Palette */
      --primary: #6366f1;
      --primary-dark: #4f46e5;
      --primary-light: #818cf8;
      --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
      --secondary: #64748b;
      --success: #10b981;
      --danger: #ef4444;
      --warning: #f59e0b;
      --info: #3b82f6;
      
      /* Grays */
      --gray-50: #f8fafc;
      --gray-100: #f1f5f9;
      --gray-200: #e2e8f0;
      --gray-300: #cbd5e1;
      --gray-400: #94a3b8;
      --gray-500: #64748b;
      --gray-600: #475569;
      --gray-700: #334155;
      --gray-800: #1e293b;
      
      /* Shadows */
      --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
      --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
      --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
      --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1);
      --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1);
      
      /* Border Radius */
      --radius-sm: 0.375rem;
      --radius: 0.5rem;
      --radius-md: 0.75rem;
      --radius-lg: 1rem;
      --radius-xl: 1.5rem;
      
      /* Transitions */
      --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      --transition-slow: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body {
      background: linear-gradient(135deg, var(--gray-50) 0%, var(--gray-100) 100%);
      min-height: 100vh;
    }

    /* Page Header */
    .page-header {
      background: var(--primary-gradient);
      border-radius: var(--radius-xl);
      color: white;
      padding: 2.5rem;
      margin-bottom: 2rem;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-xl);
    }

    .page-header::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -25%;
      width: 80%;
      height: 200%;
      background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
      animation: float 20s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-20px) rotate(10deg); }
    }

    .page-header h1 {
      font-size: 2.5rem;
      font-weight: 800;
      margin-bottom: 0.5rem;
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .page-header .subtitle {
      font-size: 1.125rem;
      opacity: 0.95;
      position: relative;
      z-index: 1;
    }

    /* Form Card */
    .client-form-shell {
      max-width: 1000px;
    }

    .modern-form-card {
      background: white;
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-xl);
      overflow: visible;
      transition: var(--transition);
      animation: slideUp 0.5s ease-out;
    }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .modern-form-card:hover {
      box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.15);
    }

    /* Form Sections */
    .form-section {
      margin-bottom: 2.5rem;
      padding: 2rem;
      background: var(--gray-50);
      border-radius: var(--radius-lg);
      border: 1px solid var(--gray-200);
      transition: var(--transition);
    }

    .form-section:hover {
      border-color: var(--gray-300);
      box-shadow: var(--shadow-md);
    }

    .form-section-title {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2rem;
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--gray-800);
    }

    .section-icon {
      width: 48px;
      height: 48px;
      background: var(--primary-gradient);
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 1.25rem;
      box-shadow: var(--shadow-md);
    }

    /* Form Controls */
    .form-label {
      font-weight: 600;
      color: var(--gray-700);
      margin-bottom: 0.5rem;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.025em;
    }

    .form-control,
    .form-select {
      border: 2px solid var(--gray-200);
      border-radius: var(--radius-md);
      padding: 0.875rem 1rem;
      font-size: 1rem;
      transition: var(--transition);
      background: white;
    }

    .form-control:hover,
    .form-select:hover {
      border-color: var(--gray-300);
    }

    .form-control:focus,
    .form-select:focus {
      border-color: var(--primary);
      background: white;
      box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
      outline: none;
    }

    /* Address Input Group */
    .input-group-modern {
      position: relative;
      z-index: 3500;
    }

    .input-icon {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--gray-400);
      z-index: 2;
      font-size: 1.1rem;
    }

    .input-group-modern input.form-control {
      padding-left: 3rem;
    }

    .addr-spinner {
      position: absolute;
      right: 1rem;
      top: 50%;
      transform: translateY(-50%);
      width: 20px;
      height: 20px;
      border: 2px solid var(--gray-200);
      border-top-color: var(--primary);
      border-radius: 50%;
      animation: spin 1s linear infinite;
      display: none;
      z-index: 3;
    }

    @keyframes spin {
      to { transform: translateY(-50%) rotate(360deg); }
    }

    /* Address Suggestions */
    .address-suggestions {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      right: 0;
      background: white;
      border: 1px solid var(--gray-200);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-xl);
      max-height: 320px;
      overflow-y: auto;
      padding: 0.25rem 0;
      z-index: 4000;
      display: none;
    }

    .address-suggestion {
      padding: 0.75rem 1rem 0.75rem 3rem;
      cursor: pointer;
      display: flex;
      gap: 0.5rem;
      position: relative;
      transition: var(--transition);
      border-bottom: 1px solid var(--gray-100);
    }

    .address-suggestion:last-child {
      border-bottom: none;
    }

    .address-suggestion i {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--primary);
      opacity: 0.8;
    }

    .address-suggestion:hover,
    .address-suggestion.active {
      background: var(--gray-50);
    }

    .address-suggestion .label {
      font-weight: 600;
      color: var(--gray-800);
      line-height: 1.3;
    }

    .address-suggestion .sub {
      display: block;
      font-size: 0.875rem;
      color: var(--gray-500);
      margin-top: 0.125rem;
    }

    .address-suggestion .src {
      display: inline-block;
      font-size: 0.75rem;
      color: var(--gray-400);
      background: var(--gray-100);
      padding: 2px 6px;
      border-radius: var(--radius-sm);
      margin-top: 0.25rem;
    }

    /* Map Section */
    .map-container {
      position: relative;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-lg);
      margin-top: 1rem;
      border: 2px solid var(--gray-200);
    }

    #client-map-picker {
      height: 400px;
      min-height: 400px;
      border-radius: var(--radius-lg);
      background: var(--gray-50);
    }

    .leaflet-container {
      background: var(--gray-50);
      font-family: inherit;
    }

    .map-controls {
      display: flex;
      align-items: flex-end;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .map-controls .flex-grow-1 {
      flex: 1;
    }

    .btn-geocode {
      background: white;
      border: 2px solid var(--primary);
      color: var(--primary);
      font-weight: 600;
      border-radius: var(--radius-md);
      padding: 0.875rem 1.5rem;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-geocode:hover {
      background: var(--primary);
      color: white;
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .map-hint {
      font-size: 0.875rem;
      color: white;
      background: linear-gradient(135deg, var(--info) 0%, var(--primary) 100%);
      padding: 1rem 1.25rem;
      border-radius: var(--radius-md);
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      box-shadow: var(--shadow-md);
    }

    .coordinates-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .coordinate-field .form-control {
      font-family: 'SF Mono', Monaco, Consolas, monospace;
      font-size: 0.9rem;
      background: var(--gray-50);
      letter-spacing: 0.025em;
    }

    /* Buttons */
    .btn-primary-modern {
      background: var(--primary-gradient);
      color: white;
      border: none;
      padding: 0.875rem 1.75rem;
      border-radius: var(--radius-md);
      font-weight: 600;
      transition: var(--transition);
      box-shadow: var(--shadow-md);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-primary-modern:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
    }

    .btn-secondary-modern {
      background: white;
      color: var(--gray-700);
      border: 2px solid var(--gray-200);
      padding: 0.875rem 1.75rem;
      border-radius: var(--radius-md);
      font-weight: 600;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-secondary-modern:hover {
      background: var(--gray-50);
      border-color: var(--gray-300);
    }

    #osm-quick {
      margin-left: 0.25rem;
      background: white;
      color: var(--gray-600);
      border: 1px solid var(--gray-300);
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      border-radius: var(--radius-md);
      transition: var(--transition);
    }

    #osm-quick:hover {
      background: var(--gray-50);
      color: var(--primary);
      border-color: var(--primary);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .coordinates-grid {
        grid-template-columns: 1fr;
      }
      
      .map-controls {
        flex-direction: column;
        align-items: stretch;
      }
      
      .map-controls .pt-4 {
        padding-top: 0 !important;
      }
      
      #client-map-picker {
        height: 320px;
        min-height: 320px;
      }
    }

    /* Validation States */
    .is-invalid {
      border-color: var(--danger) !important;
      background: rgba(239, 68, 68, 0.05) !important;
    }

    .is-invalid:focus {
      border-color: var(--danger) !important;
      box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.1) !important;
    }
  </style>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script>
  document.addEventListener('DOMContentLoaded', function () {
    const IS_EDIT = {{ mode == 'new' ? 'false' : 'true' }};

    /* Helpers */
    const $ = (s, c=document) => c.querySelector(s);
    const $$ = (s, c=document) => Array.from(c.querySelectorAll(s));
    const debounce = (fn, t=300) => { let id; return (...a)=>{ clearTimeout(id); id=setTimeout(()=>fn(...a), t); } };
    const toFixed7 = v => Number(v).toFixed(7);

    /* DOM */
    const mapEl = $('#client-map-picker');
    const latEl = $('#lat-input') || document.querySelector('[name$="[latitude]"]');
    const lngEl = $('#lng-input') || document.querySelector('[name$="[longitude]"]');
    const addrEl = $('#adresse-input') || document.querySelector('[name$="[adresse]"]');
    const geoBtn = $('#btn-geocode');
    const suggestBox = $('#address-suggestions');
    const osmQuick = $('#osm-quick');
    const spinner = $('#addr-spinner');

    if (mapEl && mapEl.offsetHeight < 50) mapEl.style.height = '320px';

    /* Leaflet */
    let map, marker;

    function initMap() {
      if (!mapEl || !latEl || !lngEl) return;

      const initLat = latEl.value ? parseFloat(latEl.value) : null;
      const initLng = lngEl.value ? parseFloat(lngEl.value) : null;
      const center = (initLat && initLng) ? [initLat, initLng] : [46.6, 2.2];
      const zoom = (initLat && initLng) ? 14 : 6;

      map = L.map(mapEl, { zoomControl: true }).setView(center, zoom);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors'
      }).addTo(map);

      marker = L.marker(center, { draggable:true }).addTo(map);
      if (!initLat || !initLng) marker.setOpacity(0.7);

      map.whenReady(() => setTimeout(() => map.invalidateSize(), 100));

      marker.on('dragend', async e => {
        const {lat, lng} = e.target.getLatLng();
        latEl.value = toFixed7(lat);
        lngEl.value = toFixed7(lng);
        showOsmQuick(lat, lng);
        await reverseGeocode(lat, lng);
      });

      map.on('click', async e => {
        const {lat, lng} = e.latlng;
        marker.setLatLng([lat, lng]).setOpacity(1);
        latEl.value = toFixed7(lat);
        lngEl.value = toFixed7(lng);
        showOsmQuick(lat, lng);
        await reverseGeocode(lat, lng);
      });

      if (initLat && initLng) showOsmQuick(initLat, initLng);

      if (IS_EDIT) syncFromAddressOnLoad();
    }

    window.addEventListener('load', () => { if (map) setTimeout(() => map.invalidateSize(), 0); });

    initMap();

    function showOsmQuick(lat, lon) {
      const btn = $('#osm-quick');
      if (!btn) return;
      btn.style.display = 'inline-block';
      btn.onclick = () => window.open(
        `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=18/${lat}/${lon}`,
        '_blank','noopener'
      );
    }

    /* Reverse geocoding */
    async function reverseGeocode(lat, lon) {
      try {
        spinner && (spinner.style.display = 'inline-block');
        const url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${encodeURIComponent(lat)}&lon=${encodeURIComponent(lon)}&addressdetails=1`;
        const r = await fetch(url, { headers: { 'Accept-Language': 'fr' } });
        if (!r.ok) throw new Error('HTTP ' + r.status);
        const data = await r.json();
        const display = data.display_name || '';
        if (display && addrEl) addrEl.value = display;
        if (map && marker && display) marker.bindPopup(display).openPopup();
      } catch (e) {
        console.error('reverse geocode error', e);
      } finally {
        spinner && (spinner.style.display = 'none');
      }
    }

    /* Geocoders (sans clé) */
    async function geocodeSingle(q) {
      try {
        const u = 'https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&limit=1&q=' + encodeURIComponent(q);
        const r = await fetch(u, { headers: { 'Accept-Language': 'fr' } });
        if (r.ok) {
          const d = await r.json();
          if (d.length) return { display:d[0].display_name, lat:parseFloat(d[0].lat), lon:parseFloat(d[0].lon) };
        }
      } catch(_) {}
      try {
        const u2 = 'https://photon.komoot.io/api/?q=' + encodeURIComponent(q) + '&lang=fr&limit=1';
        const r2 = await fetch(u2);
        if (r2.ok) {
          const d2 = await r2.json();
          const f = d2.features && d2.features[0];
          if (f) {
            const [lon, lat] = f.geometry.coordinates;
            const p = f.properties || {};
            const display = [p.name, p.street, p.city, p.postcode, p.country].filter(Boolean).join(', ');
            return { display, lat: parseFloat(lat), lon: parseFloat(lon) };
          }
        }
      } catch(_) {}
      return null;
    }

    function distanceMeters(aLat,aLon,bLat,bLon){
      const toRad = d => d*Math.PI/180, R=6371000;
      const dLat=toRad(bLat-aLat), dLon=toRad(bLon-aLon);
      const la1=toRad(aLat), la2=toRad(bLat);
      const x=Math.sin(dLat/2)**2 + Math.cos(la1)*Math.cos(la2)*Math.sin(dLon/2)**2;
      return 2*R*Math.asin(Math.sqrt(x));
    }

    async function syncFromAddressOnLoad(){
      if (!addrEl || !latEl || !lngEl) return;
      const addr = (addrEl.value || '').trim();
      if (!addr) return;

      const curLat = latEl.value ? parseFloat(latEl.value) : null;
      const curLng = lngEl.value ? parseFloat(lngEl.value) : null;

      spinner && (spinner.style.display = 'inline-block');
      const res = await geocodeSingle(addr);
      spinner && (spinner.style.display = 'none');
      if (!res) return;

      const {lat, lon, display} = res;
      const mustMove = !curLat || !curLng || distanceMeters(curLat, curLng, lat, lon) > 30;

      if (mustMove) {
        latEl.value = toFixed7(lat);
        lngEl.value = toFixed7(lon);
        marker.setLatLng([lat, lon]).setOpacity(1);
        map.setView([lat, lon], 16);
        marker.bindPopup(display || addr).openPopup();
        showOsmQuick(lat, lon);
        setTimeout(() => map.invalidateSize(), 50);
      }
    }

    /* Autocomplétion */
    let activeIndex = -1;
    let currentItems = [];

    function renderSuggestions(items) {
      currentItems = items; activeIndex = -1;
      if (!items.length) { hideSuggestions(); return; }
      suggestBox.innerHTML = items.map((it,i)=>`
        <div class="address-suggestion" data-index="${i}" role="option" tabindex="-1">
          <i class="bi bi-geo-alt"></i>
          <div>
            <span class="label">${it.title || it.display}</span>
            ${it.sub ? `<span class="sub">${it.sub}</span>` : ''}
            <span class="src">${it.src || ''}</span>
          </div>
        </div>
      `).join('');
      suggestBox.style.display = 'block';
    }
    function hideSuggestions(){ suggestBox.style.display='none'; suggestBox.innerHTML=''; currentItems=[]; activeIndex=-1; }

    const fetchSuggestions = debounce(async (q) => {
      if (!q || q.length < 3) { hideSuggestions(); return; }
      const list = [];
      try {
        const u = 'https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&limit=6&q=' + encodeURIComponent(q);
        const r = await fetch(u, { headers: { 'Accept-Language': 'fr' } });
        if (r.ok) {
          const data = await r.json();
          data.forEach(d=>{
            const a = d.address || {};
            list.push({
              title: (a.house_number? a.house_number+' ' : '') + (a.road || (d.display_name||'').split(',')[0]),
              sub: [a.city||a.town||a.village||'', a.postcode, a.country].filter(Boolean).join(' · '),
              display: d.display_name,
              lat: parseFloat(d.lat), lon: parseFloat(d.lon),
              src: 'Nominatim'
            });
          });
        }
      } catch(_) {}
      try {
        const u2 = 'https://photon.komoot.io/api/?q=' + encodeURIComponent(q) + '&lang=fr&limit=4';
        const r2 = await fetch(u2);
        if (r2.ok) {
          const data2 = await r2.json();
          (data2.features||[]).forEach(f=>{
            const p=f.properties||{}, [lon,lat]=f.geometry.coordinates||[];
            list.push({
              title: [p.housenumber,p.street].filter(Boolean).join(' ') || p.name || q,
              sub: [p.city||p.town||p.village||'', p.postcode, p.country].filter(Boolean).join(' · '),
              display: [p.name,p.street,p.city,p.postcode,p.country].filter(Boolean).join(', '),
              lat: parseFloat(lat), lon: parseFloat(lon),
              src:'Photon'
            });
          });
        }
      } catch(_) {}
      renderSuggestions(list.slice(0,8));
    }, 300);

    function applySelection(i){
      const it = currentItems[i]; if (!it) return;
      addrEl.value = it.display;
      latEl.value = toFixed7(it.lat);
      lngEl.value = toFixed7(it.lon);
      marker.setLatLng([it.lat,it.lon]).setOpacity(1);
      map.setView([it.lat,it.lon], 16);
      marker.bindPopup(it.display).openPopup();
      showOsmQuick(it.lat, it.lon);
      hideSuggestions();
      setTimeout(()=> map.invalidateSize(), 50);
    }

    if (addrEl && suggestBox) {
      addrEl.setAttribute('autocomplete','off');
      addrEl.addEventListener('input', e => fetchSuggestions(e.target.value.trim()));
      addrEl.addEventListener('focus', ()=>{ if (currentItems.length) suggestBox.style.display='block'; });

      addrEl.addEventListener('blur', async () => {
        const q = addrEl.value.trim();
        if (!q) return;
        spinner && (spinner.style.display='inline-block');
        const res = await geocodeSingle(q);
        spinner && (spinner.style.display='none');
        if (!res) return;
        const {lat,lon,display} = res;
        latEl.value = toFixed7(lat);
        lngEl.value = toFixed7(lon);
        marker.setLatLng([lat,lon]).setOpacity(1);
        map.setView([lat,lon],16);
        marker.bindPopup(display || q).openPopup();
        showOsmQuick(lat, lon);
        setTimeout(()=> map.invalidateSize(), 50);
      });

      addrEl.addEventListener('keydown', (e)=>{
        if (suggestBox.style.display !== 'block') return;
        const max = currentItems.length - 1;
        if (e.key === 'ArrowDown'){ e.preventDefault(); activeIndex = Math.min(max, activeIndex+1); }
        else if (e.key === 'ArrowUp'){ e.preventDefault(); activeIndex = Math.max(0, activeIndex-1); }
        else if (e.key === 'Enter'){ if (activeIndex>=0){ e.preventDefault(); applySelection(activeIndex);} }
        else if (e.key === 'Escape'){ hideSuggestions(); return; }
        $$('.address-suggestion', suggestBox).forEach((el,i)=>{
          el.classList.toggle('active', i===activeIndex);
          if (i===activeIndex) el.scrollIntoView({block:'nearest'});
        });
      });

      suggestBox.addEventListener('click', (e)=>{
        const itemEl = e.target.closest('.address-suggestion'); if (!itemEl) return;
        applySelection(parseInt(itemEl.dataset.index,10));
      });

      document.addEventListener('click', (e)=>{
        if (!suggestBox.contains(e.target) && !addrEl.contains(e.target)) hideSuggestions();
      });
    }

    if (geoBtn) {
      geoBtn.addEventListener('click', async () => {
        const q = (addrEl?.value || '').trim();
        if (!q) { alert('Veuillez saisir une adresse.'); return; }
        try {
          spinner && (spinner.style.display='inline-block');
          const res = await geocodeSingle(q);
          if (!res) { alert('Adresse introuvable.'); return; }
          const {lat,lon,display} = res;
          addrEl.value = display || q;
          latEl.value = toFixed7(lat);
          lngEl.value = toFixed7(lon);
          marker.setLatLng([lat, lon]).setOpacity(1);
          map.setView([lat, lon], 16);
          marker.bindPopup(display || q).openPopup();
          showOsmQuick(lat, lon);
          setTimeout(()=> map.invalidateSize(), 50);
        } catch (e) {
          console.error(e);
          alert('Échec du géocodage. Réessayez.');
        } finally {
          spinner && (spinner.style.display='none');
        }
      });
    }
  });
  </script>
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
  <div class="page-header">
    <div class="d-flex flex-column">
      <h1>
        {% if mode == 'new' %}<i class="bi bi-person-plus me-2"></i>Nouveau Client
        {% else %}<i class="bi bi-person-gear me-2"></i>Modifier le Client{% endif %}
      </h1>
      <p class="subtitle mb-0">
        {% if mode == 'new' %}Ajoutez un nouveau client à votre système{% else %}Modifiez les informations du client #{{ client.id }}{% endif %}
      </p>
    </div>
  </div>

  <div class="client-form-shell mx-auto">
    <div class="modern-form-card">
      <div class="p-4">
        {{ form_start(form, {attr: {class: 'needs-validation', novalidate: 'novalidate', id: 'client-form'}}) }}

        <div class="form-section">
          <div class="form-section-title">
            <div class="section-icon"><i class="bi bi-person-badge"></i></div>
            Informations générales
          </div>
          <div class="row g-4">
            <div class="col-12 col-md-6">{{ form_row(form.nom, { attr: {placeholder:'Nom complet du client'} }) }}</div>
            <div class="col-12 col-md-6">{{ form_row(form.codetls, { label:'Code TLS', attr: {placeholder:'Code TLS'} }) }}</div>
            <div class="col-12 col-md-6">{{ form_row(form.organisme, { label:'TLS / DIRECT (organisme)' }) }}</div>
            <div class="col-12 col-md-6">{{ form_row(form.codeAlarme, { label:'Code alarme', attr: {placeholder:'Code alarme'} }) }}</div>
            <div class="col-12 col-md-6">{{ form_row(form.keycodeild, { label:'Keycode ILD', attr: {placeholder:'Keycode ILD'} }) }}</div>
            <div class="col-12">{{ form_row(form.key, { label:'Clés', attr: {rows:3, placeholder:'Description des clés et accès...'} }) }}</div>
            <div class="col-12">{{ form_row(form.agence) }}</div>
            <div class="col-12">{{ form_row(form.description, { attr: {rows:4, placeholder:'Description détaillée du client...'} }) }}</div>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section-title">
            <div class="section-icon"><i class="bi bi-geo-alt"></i></div>
            Localisation
          </div>

          <div class="row g-4">
            <div class="col-12">
              <div class="map-controls">
                <div class="flex-grow-1">
                  <div class="input-group-modern">
                    <i class="bi bi-house input-icon"></i>
                    {{ form_row(form.adresse, {
                      label: 'Adresse',
                      row_attr: {'class': 'mb-0'},
                      attr: { id:'adresse-input', autocomplete:'off', placeholder:'Commencez à taper une adresse…' }
                    }) }}
                    <div id="addr-spinner" class="addr-spinner"></div>
                    <div id="address-suggestions" class="address-suggestions" role="listbox" aria-label="Suggestions d’adresse"></div>
                  </div>
                  <button type="button" class="btn btn-outline-secondary btn-sm mt-2" id="osm-quick" style="display:none">
                    <i class="bi bi-map me-1"></i>Voir sur OpenStreetMap
                  </button>
                </div>
                <div class="pt-4">
                  <button class="btn btn-geocode" type="button" id="btn-geocode">
                    <i class="bi bi-search me-2"></i>Localiser
                  </button>
                </div>
              </div>

              <div class="map-hint">
                <i class="bi bi-info-circle me-2"></i>
                Clic/drag sur la carte = coordonnées + adresse auto. En édition, la carte se recale si l’adresse ne correspond pas aux coordonnées.
              </div>
            </div>

            <div class="col-12">
              <div class="coordinates-grid">
                <div class="coordinate-field">{{ form_row(form.latitude, { attr: {id:'lat-input', readonly:true, placeholder:'0.0000000'} }) }}</div>
                <div class="coordinate-field">{{ form_row(form.longitude, { attr: {id:'lng-input', readonly:true, placeholder:'0.0000000'} }) }}</div>
              </div>
            </div>

            <div class="col-12">
              <div class="map-container">
                <div id="client-map-picker"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section-title">
            <div class="section-icon"><i class="bi bi-chat-text"></i></div>
            Informations complémentaires
          </div>
          <div class="row g-4">
            <div class="col-12">{{ form_row(form.information, { label:'Information', attr: {rows:4, placeholder:'Informations complémentaires, notes spéciales...'} }) }}</div>
          </div>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary-modern btn-modern" id="submit-btn"><i class="bi bi-check-lg"></i>{{ mode == 'new' ? 'Créer le client' : 'Enregistrer les modifications' }}</button>
          <a href="{{ path('clients_index') }}" class="btn btn-secondary-modern btn-modern"><i class="bi bi-x-lg"></i>Annuler</a>
        </div>

        {{ form_end(form) }}
      </div>
    </div>
  </div>
</div>
{% endblock %}
