{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% block title %}{{ mode == 'new' ? 'Nouvel organisme' : 'Éditer organisme #' ~ organisme.id }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <link rel="stylesheet" href="{{ asset('styles/organismes/form.css') }}">
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">

  {# ========== HEADER MODERNE ========== #}
  <div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h1>{{ mode == 'new' ? 'Nouvel organisme' : 'Éditer organisme' }}</h1>
        <p class="subtitle mb-0">{{ mode == 'new' ? 'Créer un nouvel organisme dans le système' : 'Modifier les informations de l\'organisme #' ~ organisme.id }}</p>
      </div>
      <a href="{{ path('organisme_index') }}" class="btn btn-new-device">
        <i class="bi bi-arrow-left me-2"></i>Retour à la liste
      </a>
    </div>
  </div>

  {# ========== FORMULAIRE ========== #}
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-6">
      <div class="form-container">
        
        {# En-tête du formulaire #}
        <div class="form-header">
          <h2>
            <div class="form-icon">
              <i class="bi bi-{{ mode == 'new' ? 'plus-circle' : 'pencil-square' }}"></i>
            </div>
            {{ mode == 'new' ? 'Informations du nouvel organisme' : 'Modifier l\'organisme' }}
          </h2>
        </div>

        {# Corps du formulaire #}
        <div class="form-body">
          {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
          
          <div class="form-group">
            {{ form_label(form.name, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.name, {
              'attr': {
                'class': 'form-control',
                'placeholder': 'Entrez le nom de l\'organisme...'
              }
            }) }}
            {{ form_errors(form.name) }}
          </div>

          <div class="btn-actions">
            <button type="submit" class="btn btn-primary-modern">
              <i class="bi bi-{{ mode == 'new' ? 'plus-lg' : 'check-lg' }}"></i>
              {{ mode == 'new' ? 'Créer l\'organisme' : 'Enregistrer les modifications' }}
            </button>
            <a href="{{ path('organisme_index') }}" class="btn btn-secondary-modern">
              <i class="bi bi-x-lg"></i>
              Annuler
            </a>
          </div>

          {{ form_end(form) }}
        </div>
      </div>
    </div>
  </div>
</div>

{# ========== JAVASCRIPT POUR LES INTERACTIONS ========== #}
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Animation des labels au focus
  const formControls = document.querySelectorAll('.form-control');
  
  formControls.forEach(control => {
    // Effet de focus amélioré
    control.addEventListener('focus', function() {
      this.parentElement.classList.add('focused');
    });
    
    control.addEventListener('blur', function() {
      this.parentElement.classList.remove('focused');
    });

    // Validation en temps réel simple
    control.addEventListener('input', function() {
      if (this.value.trim() !== '') {
        this.classList.remove('is-invalid');
      }
    });
  });

  // Confirmation avant de quitter la page si le formulaire a été modifié
  let formModified = false;
  const form = document.querySelector('form');
  const originalValues = {};
  
  // Sauvegarder les valeurs originales
  formControls.forEach((control, index) => {
    originalValues[index] = control.value;
    
    control.addEventListener('input', function() {
      formModified = true;
    });
  });

  // Vérifier si le formulaire a été modifié avant de quitter
  window.addEventListener('beforeunload', function(e) {
    if (formModified) {
      e.preventDefault();
      e.returnValue = '';
    }
  });

  // Ne pas demander confirmation lors de la soumission
  form.addEventListener('submit', function() {
    formModified = false;
  });

  // Animation du bouton de soumission
  const submitBtn = document.querySelector('.btn-primary-modern');
  form.addEventListener('submit', function(e) {
    submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Enregistrement...';
    submitBtn.disabled = true;
  });
});
</script>
{% endblock %}