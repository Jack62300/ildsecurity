{# TailAdmin-like menu for EasyAdmin 4 #}
{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Context\AdminContext #}

<ul class="space-y-1">
  {% for item in ea.mainMenu.items %}
    {% set is_empty_submenu = item.type == constant('EasyCorp\\Bundle\\EasyAdminBundle\\Dto\\MenuItemDto::TYPE_SUBMENU') and not item.hasSubItems %}

    {% if not is_empty_submenu %}

      {# ===== Section ===== #}
      {% if item.isMenuSection %}
        <li class="pt-5 pb-2 px-3 text-[11px] uppercase tracking-wide text-slate-400">
          {{ item.label|trans }}
        </li>

      {# ===== Item avec sous-menus ===== #}
      {% elseif item.hasSubItems %}
        <li x-data="{open: {{ item.isExpanded ? 'true' : 'false' }} }" class="px-2">
          <button
            @click="open = !open"
            class="w-full flex items-center justify-between gap-3 px-3 py-2.5 rounded-lg
                   text-slate-700 hover:bg-slate-100 transition
                   {{ item.isSelected ? 'bg-slate-100 font-semibold' : '' }}">
            <span class="flex items-center gap-3">
              {% if item.icon %}
                <i class="{{ item.icon }} w-5 text-slate-500"
                   :class="open ? 'text-primary' : ''"></i>
              {% endif %}
              {{ item.label|trans|raw }}
            </span>
            <i class="fa-solid fa-chevron-right text-[11px] text-slate-400 transition"
               :class="open ? 'rotate-90 text-primary' : ''"></i>
          </button>

          <ul x-show="open" x-collapse class="mt-1 ms-6 space-y-1">
            {% for sub in item.subItems %}
              {% if sub.isMenuSection %}{# ignore #}
              {% else %}
                <li>
                  <a href="{{ sub.linkUrl }}"
                     class="group flex items-center gap-2 px-3 py-2 rounded-lg text-sm transition
                            {{ sub.isSelected
                                ? 'bg-primary/10 text-primary font-semibold'
                                : 'text-slate-600 hover:bg-slate-100' }}">
                    <span class="inline-block w-1.5 h-1.5 rounded-full
                                 {{ sub.isSelected ? 'bg-primary' : 'bg-slate-300 group-hover:bg-slate-400' }}"></span>
                    <span>{{ sub.label|trans|raw }}</span>
                  </a>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </li>

      {# ===== Item simple ===== #}
      {% else %}
        <li>
          <a href="{{ item.linkUrl }}"
             class="mx-2 flex items-center gap-3 px-3 py-2.5 rounded-lg transition
                    {{ item.isSelected
                        ? 'bg-primary text-white shadow-card'
                        : 'text-slate-700 hover:bg-slate-100' }}">
            {% if item.icon %}
              <i class="{{ item.icon }} w-5
                         {{ item.isSelected ? 'text-white' : 'text-slate-500' }}"></i>
            {% endif %}
            <span>{{ item.label|trans|raw }}</span>
          </a>
        </li>
      {% endif %}
    {% endif %}
  {% endfor %}
</ul>
