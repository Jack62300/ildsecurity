{% extends 'base.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
{% block importmap %}{{ importmap('styles/index.css') }}{% endblock %}
  {# <link rel="stylesheet" href="{{ asset('styles/users/index.css') }}"> #}
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">

  {# ========== HEADER MODERNE ========== #}
  <div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h1>Gestion des Utilisateurs</h1>
        <p class="subtitle mb-0">{{ users|length }} utilisateur{{ users|length > 1 ? 's' : '' }} enregistré{{ users|length > 1 ? 's' : '' }}</p>
      </div>
      <a href="{{ path('users_new') }}" class="btn btn-new-user">
        <i class="bi bi-plus-lg me-2"></i>Nouvel Utilisateur
      </a>
    </div>
  </div>

  {% if users is empty %}
    {# ========== ÉTAT VIDE ========== #}
    <div class="empty-state">
      <i class="bi bi-people empty-state-icon"></i>
      <h4>Aucun utilisateur trouvé</h4>
      <p>Commencez par ajouter votre premier utilisateur pour voir la liste ici</p>
    </div>
  {% else %}

    {# ========== TABLEAU MODERNE (Desktop) ========== #}
    <div class="modern-table-container">
      <table class="table modern-table">
        <thead>
          <tr>
            <th style="width: 60px;"></th>
            <th>Utilisateur</th>
            <th>Email</th>
            <th>Agence</th>
            <th>Rôles</th>
            <th style="width: 120px;" class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
        {% for u in users %}
          <tr>
            <td>
              <div class="user-avatar">
                {{ u.username|slice(0, 1)|upper }}
              </div>
            </td>
            <td>
              <div class="user-name">{{ u.username }}</div>
              <div class="user-id">#{{ u.id }}</div>
            </td>
            <td>
              <i class="bi bi-envelope text-muted me-2"></i>{{ u.email }}
            </td>
            <td>
              {% if u.agence %}
                <i class="bi bi-building text-muted me-2"></i>{{ u.agence }}
              {% else %}
                <span class="text-muted fst-italic">Non assignée</span>
              {% endif %}
            </td>
            <td>
              {% set roleLabels = {
                'ROLE_ADMIN': 'Responsable',
                'ROLE_DEV': 'Développeur',
                'ROLE_SUPPORT': 'Administrateur',
                'ROLE_OPERATEUR': 'Agent Mobile',
                'ROLE_USER': 'Utilisateur'
              } %}
              {% set roleClasses = {
                'ROLE_ADMIN': 'role-admin',
                'ROLE_DEV': 'role-dev',
                'ROLE_SUPPORT': 'role-support',
                'ROLE_OPERATEUR': 'role-operateur',
                'ROLE_USER': 'role-user'
              } %}
              {% for role in u.roles %}
                <span class="role-badge {{ roleClasses[role] ?? 'role-user' }}">
                  {{ roleLabels[role] ?? role }}
                </span>
              {% endfor %}
            </td>
            <td class="text-center">
              <div class="dropdown actions-dropdown">
                <button class="btn btn-sm dropdown-toggle" 
                        type="button" 
                        data-bs-toggle="dropdown"
                        data-bs-auto-close="true"
                        data-bs-boundary="viewport">
                  <i class="bi bi-three-dots"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li>
                    <a class="dropdown-item" href="{{ path('users_edit', {id: u.id}) }}">
                      <i class="bi bi-pencil me-2"></i>Modifier
                    </a>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <form method="post" action="{{ path('users_delete', {id: u.id}) }}"
                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?');">
                      <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ u.id) }}">
                      <button class="dropdown-item text-danger" type="submit">
                        <i class="bi bi-trash me-2"></i>Supprimer
                      </button>
                    </form>
                  </li>
                </ul>
              </div>
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>

    {# ========== CARTES MOBILES ========== #}
    <div class="mobile-cards">
      {% for u in users %}
        <div class="user-card">
          <div class="user-card-header">
            <div class="user-avatar">
              {{ u.username|slice(0, 1)|upper }}
            </div>
            <div class="user-card-info flex-grow-1">
              <h5>{{ u.username }}</h5>
              <p class="text-muted small mb-2">
                <i class="bi bi-envelope me-1"></i>{{ u.email }}
              </p>
              {% if u.agence %}
                <p class="text-muted small mb-2">
                  <i class="bi bi-building me-1"></i>{{ u.agence }}
                </p>
              {% endif %}
              <div class="mb-0">
                {% set roleLabels = {
                  'ROLE_ADMIN': 'Responsable',
                  'ROLE_DEV': 'Développeur', 
                  'ROLE_SUPPORT': 'Administrateur',
                  'ROLE_OPERATEUR': 'Agent Mobile',
                  'ROLE_USER': 'Utilisateur'
                } %}
                {% set roleClasses = {
                  'ROLE_ADMIN': 'role-admin',
                  'ROLE_DEV': 'role-dev',
                  'ROLE_SUPPORT': 'role-support',
                  'ROLE_OPERATEUR': 'role-operateur',
                  'ROLE_USER': 'role-user'
                } %}
                {% for role in u.roles %}
                  <span class="role-badge {{ roleClasses[role] ?? 'role-user' }}">
                    {{ roleLabels[role] ?? role }}
                  </span>
                {% endfor %}
              </div>
            </div>
          </div>
          
          <div class="user-card-actions">
            <a href="{{ path('users_edit', {id: u.id}) }}" 
               class="btn btn-primary btn-card-action">
              <i class="bi bi-pencil"></i>Modifier
            </a>
            <form method="post" 
                  action="{{ path('users_delete', {id: u.id}) }}"
                  onsubmit="return confirm('Supprimer cet utilisateur ?');"
                  class="d-inline flex-fill">
              <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ u.id) }}">
              <button class="btn btn-outline-danger btn-card-action w-100">
                <i class="bi bi-trash"></i>Supprimer
              </button>
            </form>
          </div>
        </div>
      {% endfor %}
    </div>

  {% endif %}
</div>

{# ========== JAVASCRIPT POUR GESTION DROPDOWNS ========== #}
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Gestion intelligente de la position des dropdowns
  const dropdowns = document.querySelectorAll('.actions-dropdown');
  
  dropdowns.forEach(dropdown => {
    const toggle = dropdown.querySelector('.dropdown-toggle');
    const menu = dropdown.querySelector('.dropdown-menu');
    
    toggle.addEventListener('click', function() {
      // Calculer la position et ajuster si nécessaire
      setTimeout(() => {
        const rect = menu.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        
        // Si le menu dépasse en bas de l'écran
        if (rect.bottom > windowHeight - 20) {
          menu.style.top = 'auto';
          menu.style.bottom = '100%';
          menu.style.transform = 'translateY(-5px)';
        }
      }, 10);
    });
  });
});
</script>
{% endblock %}