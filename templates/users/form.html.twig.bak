{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}{{ mode == 'new' ? 'Nouvel utilisateur' : 'Modifier l\'utilisateur #' ~ user.id }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <style>
    :root {
      --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      --card-shadow-hover: 0 15px 40px rgba(0, 0, 0, 0.12);
      --border-radius: 12px;
      --border-radius-lg: 16px;
      --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .page-header {
      background: var(--primary-gradient);
      border-radius: var(--border-radius-lg);
      color: white;
      padding: 2rem;
      margin-bottom: 2rem;
      position: relative;
      overflow: hidden;
    }
    .page-header::before {
      content: '';
      position: absolute; inset: 0;
      background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="80" cy="20" r="20" fill="rgba(255,255,255,0.1)"/><circle cx="90" cy="60" r="15" fill="rgba(255,255,255,0.08)"/><circle cx="70" cy="80" r="10" fill="rgba(255,255,255,0.06)"/></svg>') no-repeat right top / 200px 200px;
      opacity: .3;
    }
    .page-header h1 { font-size: 2.2rem; font-weight: 700; margin-bottom: .5rem; position: relative; z-index: 1; }
    .page-header .subtitle { opacity: .9; font-size: 1.1rem; position: relative; z-index: 1; }
    .breadcrumb-nav { position: relative; z-index: 1; margin-top: 1rem; }
    .breadcrumb-nav a { color: rgba(255,255,255,.85); text-decoration: none; transition: var(--transition); }
    .breadcrumb-nav a:hover { color: #fff; }
    .breadcrumb-nav .separator { color: rgba(255,255,255,.6); margin: 0 .5rem; }

    .form-container { max-width: 800px; margin: 0 auto; }
    .modern-form-card {
      background: #fff; border-radius: var(--border-radius-lg);
      box-shadow: var(--card-shadow); overflow: hidden; transition: var(--transition);
      animation: slideInUp .5s ease-out;
    }
    .modern-form-card:hover { box-shadow: var(--card-shadow-hover); }

    .form-label { font-weight: 600; color: #2d3748; margin-bottom: .5rem; display: flex; align-items: center; gap: .5rem; }
    .form-control, .form-select {
      border: 2px solid #e2e8f0; border-radius: var(--border-radius);
      padding: .875rem 1rem; font-size: 1rem; transition: var(--transition); background: #fff;
    }
    .form-control:focus, .form-select:focus { border-color: #667eea; box-shadow: 0 0 0 3px rgba(102,126,234,.1); outline: none; }
    .form-control:hover:not(:focus), .form-select:hover:not(:focus) { border-color: #cbd5e0; }

    /* Radios modernes pour le rôle */
    .role-group .form-check {
      background: #fff; border: 2px solid #e2e8f0; border-radius: var(--border-radius);
      padding: .85rem 1rem; margin-bottom: .75rem; transition: var(--transition);
      display: flex; align-items: center; gap: .6rem;
    }
    .role-group .form-check:hover { border-color: #cbd5e0; background: #f8fafc; transform: translateY(-1px); }
    .role-group .form-check-input { margin: 0; }
    .role-group .form-check-input:checked { border-color: #667eea; background-color: #667eea; }
    .role-group .form-check.checked { border-color: #667eea; background: rgba(102,126,234,.05); box-shadow: 0 4px 15px rgba(102,126,234,.1); }
    .role-group .form-check-label { font-weight: 500; }

    .btn-modern { padding: .875rem 2rem; font-weight: 600; border-radius: var(--border-radius); transition: var(--transition); display: flex; align-items: center; gap: .5rem; min-height: 48px; }
    .btn-primary { background: var(--primary-gradient); border: none; color: #fff; }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(102,126,234,.3); color: #fff; }
    .btn-outline-secondary { background: #fff; border: 2px solid #e2e8f0; color: #4a5568; }
    .btn-outline-secondary:hover { border-color: #cbd5e0; background: #f7fafc; transform: translateY(-1px); color: #4a5568; }

    @media (max-width: 768px) {
      .page-header { padding: 1.5rem; text-align: center; }
      .page-header h1 { font-size: 1.8rem; }
      .form-container { margin: 0 1rem; }
    }

    @keyframes slideInUp { from { opacity: 0; transform: translateY(20px);} to { opacity: 1; transform: translateY(0);} }

    .is-invalid { border-color: #dc2626 !important; background: #fef2f2 !important; }
    .is-invalid:focus { box-shadow: 0 0 0 3px rgba(220,38,38,.1) !important; }
    .invalid-feedback { color: #dc2626; font-size: .875rem; margin-top: .5rem; display: flex; align-items: center; gap: .5rem; }
    .is-valid { border-color: #10b981 !important; background: #f0fdf4 !important; }
    .is-valid:focus { box-shadow: 0 0 0 3px rgba(16,185,129,.1) !important; }
  </style>
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">

  <div class="page-header">
    <div class="d-flex flex-column">
      <h1>
        {% if mode == 'new' %}
          <i class="bi bi-person-plus me-2"></i>Nouvel Utilisateur
        {% else %}
          <i class="bi bi-person-gear me-2"></i>Modifier l'Utilisateur
        {% endif %}
      </h1>
      <p class="subtitle mb-0">
        {% if mode == 'new' %}
          Créez un nouveau compte utilisateur avec les permissions appropriées
        {% else %}
          Modifiez les informations de l'utilisateur #{{ user.id }}
        {% endif %}
      </p>
      <nav class="breadcrumb-nav">
        <a href="{{ path('users_index') }}"><i class="bi bi-people me-1"></i>Utilisateurs</a>
        <span class="separator">›</span>
        <span>{{ mode == 'new' ? 'Nouvel utilisateur' : 'Modification' }}</span>
      </nav>
    </div>
  </div>

  <div class="form-container">
    <div class="modern-form-card">
      <div class="card-body p-4 p-md-5">

        {{ form_start(form, {'attr': {'id': 'user-form'}}) }}
          <div class="row g-3">
            <div class="col-12 col-md-6">{{ form_row(form.username) }}</div>
            <div class="col-12 col-md-6">{{ form_row(form.email) }}</div>
            <div class="col-12 col-md-6">{{ form_row(form.agence) }}</div>

            {# -------- Rôle unique (primaryRole) -------- #}
            <div class="col-12">
              <label class="form-label d-flex align-items-center gap-2">
                <i class="bi bi-shield-check"></i> Rôle
              </label>
              <div class="role-group">
                {{ form_widget(form.primaryRole) }}
                {{ form_errors(form.primaryRole) }}
              </div>
              <div class="form-text text-muted">
                La hiérarchie des rôles appliquera automatiquement les permissions associées.
              </div>
            </div>

            <div class="col-12">{{ form_row(form.plainPassword) }}</div>
          </div>

          <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary btn-modern" type="submit" id="submit-btn">
              <i class="bi bi-check-lg"></i>
              {% if mode == 'new' %}Créer l'utilisateur{% else %}Enregistrer les modifications{% endif %}
            </button>
            <a class="btn btn-outline-secondary btn-modern" href="{{ path('users_index') }}">
              <i class="bi bi-x-lg"></i> Annuler
            </a>
          </div>
        {{ form_end(form) }}

      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('user-form');
  const submitBtn = document.getElementById('submit-btn');

  // Mise en valeur du rôle sélectionné (radios)
  const roleRadios = document.querySelectorAll('input[name*="[primaryRole]"]');
  function refreshRoleStyles(){
    roleRadios.forEach(r => {
      const box = r.closest('.form-check');
      if (box) box.classList.toggle('checked', r.checked);
    });
  }
  roleRadios.forEach(r => r.addEventListener('change', refreshRoleStyles));
  refreshRoleStyles();

  // Validation légère (username/email) et UX
  if (form && submitBtn) {
    const inputs = form.querySelectorAll('input[type="text"], input[type="email"], input[type="password"], select');
    inputs.forEach(input => {
      input.addEventListener('blur', function(){ validateField(this); });
      input.addEventListener('input', function(){
        this.classList.remove('is-invalid');
        const fb = this.parentNode.querySelector('.invalid-feedback');
        if (fb) fb.style.display = 'none';
      });
    });

    function validateField(field){
      const value = field.value.trim();
      const name = field.name; let ok = true; let msg = '';
      if (name.includes('[username]')) { ok = value.length >= 3 && /^[a-zA-Z0-9_]+$/.test(value); msg = 'Le nom d\'utilisateur doit contenir au moins 3 caractères (lettres, chiffres, underscore)'; }
      else if (name.includes('[email]')) { const re=/^[^\s@]+@[^\s@]+\.[^\s@]+$/; ok = (value==='' || re.test(value)); msg='Format d\'email invalide'; }
      if (value && !ok) { field.classList.add('is-invalid'); showErr(field, msg); } else if (value && ok) { field.classList.add('is-valid'); }
    }
    function showErr(field, msg){
      const c = field.parentNode; let fb = c.querySelector('.invalid-feedback');
      if (!fb) { fb = document.createElement('div'); fb.className='invalid-feedback'; c.appendChild(fb); }
      fb.innerHTML = '<i class="bi bi-exclamation-triangle"></i> ' + msg; fb.style.display='flex';
    }

    form.addEventListener('submit', function(){
      submitBtn.innerHTML = '<i class="bi bi-arrow-repeat me-2"></i>Enregistrement...';
      submitBtn.disabled = true;
    });
  }

  // Auto-suggestion username depuis email
  const usernameInput = document.querySelector('input[name*="[username]"]');
  const emailInput = document.querySelector('input[name*="[email]"]');
  if (usernameInput && emailInput) {
    emailInput.addEventListener('input', function(){
      if (!usernameInput.value && this.value.includes('@')) {
        const suggestion = this.value.split('@')[0].toLowerCase().replace(/[^a-z0-9_]/g,'');
        if (suggestion.length >= 3) usernameInput.setAttribute('placeholder', 'Suggestion: ' + suggestion);
      }
    });
  }

  // Raccourci Ctrl/Cmd+S
  document.addEventListener('keydown', function(e){
    if ((e.ctrlKey || e.metaKey) && e.key === 's') {
      e.preventDefault();
      if (submitBtn && !submitBtn.disabled) submitBtn.click();
    }
  });

  // Focus premier champ
  const first = document.querySelector('#user-form input:not([type="hidden"])');
  if (first) setTimeout(()=> first.focus(), 200);
});
</script>
{% endblock %}
