{% extends '@EasyAdmin/page/content.html.twig' %}

{% block main %}
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
  <div class="bg-white rounded-xl shadow-card border border-slate-200 p-5">
    <div class="flex items-center justify-between">
      <div class="text-slate-400"><i class="fa-solid fa-users"></i></div>
    </div>
    <div class="mt-3 text-3xl font-extrabold text-slate-900">{{ stats.clients }}</div>
    <p class="text-slate-500 mt-1">Clients</p>
  </div>

  <div class="bg-white rounded-xl shadow-card border border-slate-200 p-5">
    <div class="text-slate-400"><i class="fa-solid fa-key"></i></div>
    <div class="mt-3 text-3xl font-extrabold text-slate-900">{{ stats.keys }}</div>
    <p class="text-slate-500 mt-1">Clefs</p>
  </div>

  <div class="bg-white rounded-xl shadow-card border border-slate-200 p-5">
    <div class="text-slate-400"><i class="fa-solid fa-user-shield"></i></div>
    <div class="mt-3 text-3xl font-extrabold text-slate-900">{{ stats.users }}</div>
    <p class="text-slate-500 mt-1">Utilisateurs</p>
  </div>
</div>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mt-6">
  <div class="bg-white rounded-xl shadow-card border border-slate-200 p-5 xl:col-span-2">
    <h3 class="font-semibold text-slate-800 mb-4">Monthly Sales</h3>
    <div class="h-56 bg-slate-50 rounded-lg border border-slate-200"></div>
  </div>
  <div class="bg-white rounded-xl shadow-card border border-slate-200 p-5">
    <h3 class="font-semibold text-slate-800 mb-4">Monthly Target</h3>
    <div class="h-56 bg-slate-50 rounded-lg border border-slate-200"></div>
  </div>
</div>
{% endblock %}
