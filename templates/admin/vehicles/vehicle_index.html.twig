{% extends 'base.html.twig' %}
{% block title %}Flotte de Véhicules{% endblock %}

{% block body %}
<link rel="stylesheet" href="{{ asset('assets/css/admin/vehicles/vehicle_index.css') }}">

<div class="">
  <!-- Header Section -->
  <div class="page-header">
    <div class="header-content">
      <div class="header-title">
        <h1>Flotte de Véhicules</h1>
        <div class="header-subtitle">
          {{ vehicles|length }} véhicule{{ vehicles|length > 1 ? 's' : '' }} enregistré{{ vehicles|length > 1 ? 's' : '' }}
        </div>
      </div>
      
      {% if is_granted('ROLE_ADMIN') %}
        <div class="header-actions">
          <a href="{{ path('admin_vehicle_new') }}" class="btn-new-vehicle">
            + Nouveau Véhicule
          </a>
        </div>
      {% endif %}
    </div>
  </div>

  <!-- Search Section -->
  {# <div class="search-container">
    <form method="get" class="search-form">
      <span class="search-icon">🔍</span>
      <input type="text" name="q" value="{{ app.request.get('q') }}" 
             class="search-input" 
             placeholder="Rechercher un véhicule par plaque, modèle ou marque...">
    </form>
  </div> #}

  <!-- Content Section -->
  {% if vehicles is empty %}
    <!-- Empty State -->
    <div class="empty-state">
      <div class="empty-state-icon">
        🚗
      </div>
      <h4>Aucun véhicule trouvé</h4>
      <p>
        Commencez par ajouter votre premier véhicule pour voir la liste ici
        {% if is_granted('ROLE_ADMIN') %}
          <br><a href="{{ path('admin_vehicle_new') }}" class="empty-link">Ajouter un véhicule</a>
        {% endif %}
      </p>
    </div>
  {% else %}

    <!-- Table Desktop -->
    <div class="modern-table-container d-none d-md-block">
      <div class="table-wrapper">
        <table class="modern-table table">
          <thead>
            <tr>
              <th style="width:100px;">Photo</th>
              <th>Plaque d'immatriculation</th>
              <th>Modèle</th>
              <th>Dernière mise à jour</th>
              <th style="width:120px;">Actions</th>
            </tr>
          </thead>
          <tbody>
          {% for v in vehicles %}
            <tr>
              <td>
                {% if v.photoName %}
                  <img src="{{ vich_uploader_asset(v, 'photoFile') }}"
                       alt="Photo {{ v.plate }}"
                       class="vehicle-photo">
                {% else %}
                  <div class="photo-placeholder">🚗</div>
                {% endif %}
              </td>
              <td>
                <div class="plate-text">{{ v.plate }}</div>
              </td>
              <td>
                <div class="model-text">{{ v.model ?: '—' }}</div>
              </td>
              <td>
                <div class="date-text">
                  {{ v.updatedAt ? v.updatedAt|date('d/m/Y à H:i') : '—' }}
                </div>
              </td>
              <td>
                {% if is_granted('ROLE_ADMIN') %}
                  <div class="actions-dropdown dropdown">
                    <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown">
                      Actions
                    </button>
                    <ul class="dropdown-menu">
                      <li>
                        <a class="dropdown-item" href="{{ path('admin_vehicle_edit', {id: v.id}) }}">
                          ✏️ Modifier
                        </a>
                      </li>
                      <li>
                        <form method="post" action="{{ path('admin_vehicle_delete', {id: v.id}) }}"
                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce véhicule ?');">
                          <input type="hidden" name="_token" value="{{ csrf_token('delete_vehicle_' ~ v.id) }}">
                          <button type="submit" class="dropdown-item text-danger">
                            🗑️ Supprimer
                          </button>
                        </form>
                      </li>
                    </ul>
                  </div>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Cards Mobile -->
    <div class="vehicle-cards d-md-none">
      {% for v in vehicles %}
        <div class="vehicle-card">
          <div class="vehicle-card-header">
            <div class="card-photo">
              {% if v.photoName %}
                <img src="{{ vich_uploader_asset(v, 'photoFile') }}"
                     alt="Photo {{ v.plate }}">
              {% else %}
                <div class="card-photo-placeholder">🚗</div>
              {% endif %}
            </div>
            
            <div class="vehicle-card-info">
              <h5>{{ v.plate }}</h5>
              <div class="model-text">{{ v.model ?: 'Modèle non spécifié' }}</div>
              <div class="date-text">
                {{ v.updatedAt ? v.updatedAt|date('d/m H:i') : '—' }}
              </div>
            </div>
          </div>
          
          {% if is_granted('ROLE_ADMIN') %}
            <div class="vehicle-card-actions">
              <a href="{{ path('admin_vehicle_edit', {id: v.id}) }}" class="btn-card-action btn-edit">
                ✏️ Modifier
              </a>
              <form method="post" action="{{ path('admin_vehicle_delete', {id: v.id}) }}"
                    onsubmit="return confirm('Supprimer ce véhicule ?');" style="flex: 1;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_vehicle_' ~ v.id) }}">
                <button type="submit" class="btn-card-action btn-delete" style="width: 100%;">
                  🗑️ Supprimer
                </button>
              </form>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

  {% endif %}
</div>
{% endblock %}