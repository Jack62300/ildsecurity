{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}{{ vehicle.id ? 'Modifier le véhicule' : 'Nouveau véhicule' }}{% endblock %}

{% block body %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <link rel="stylesheet" href="{{ asset('assets/css/admin/vehicles/vehicle_form.css') }}">
<div class="container-fluid px-4 py-3">

  {# ========== HEADER MODERNE ========== #}
  <div class="page-header">
    <div class="d-flex flex-column">
      <h1>
        {% if vehicle.id %}
          <i class="bi bi-pencil-square me-2"></i>Modifier le Véhicule
        {% else %}
          <i class="bi bi-plus-circle me-2"></i>Nouveau Véhicule
        {% endif %}
      </h1>
      <p class="subtitle mb-0">
        {% if vehicle.id %}
          Modifiez les informations du véhicule {{ vehicle.plate }}
        {% else %}
          Ajoutez un nouveau véhicule à votre flotte
        {% endif %}
      </p>
      
      <nav class="breadcrumb-nav">
        <a href="{{ path('admin_vehicle_index') }}">
          <i class="bi bi-truck me-1"></i>Véhicules
        </a>
        <span class="separator">›</span>
        <span>{{ vehicle.id ? 'Modification' : 'Nouveau véhicule' }}</span>
      </nav>
    </div>
  </div>

  {# ========== FORMULAIRE MODERNE ========== #}
  <div class="form-container">
    <div class="modern-form-card">
      
      {# Header du formulaire #}
      <div class="form-header">
        <h2>
          <div class="form-icon">
            <i class="bi bi-truck"></i>
          </div>
          Informations du véhicule
        </h2>
      </div>

      {# Corps du formulaire #}
      <div class="form-body">
        {{ form_start(form, {
          'attr': {'id': 'vehicle-form', 'novalidate': 'novalidate'},
          'enctype': 'multipart/form-data'
        }) }}
          
          <div class="row g-4">
            
            {# Plaque d'immatriculation #}
            <div class="col-md-6">
              <div class="form-group">
                {{ form_label(form.plate, 'Plaque d\'immatriculation', {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-group-modern">
                  <i class="bi bi-credit-card input-icon"></i>
                  {{ form_widget(form.plate, {
                    'attr': {
                      'class': 'form-control',
                      'placeholder': 'Ex: AB-123-CD'
                    }
                  }) }}
                </div>
                {{ form_errors(form.plate) }}
              </div>
            </div>

            {# Modèle du véhicule #}
            <div class="col-md-6">
              <div class="form-group">
                {{ form_label(form.model, 'Modèle du véhicule', {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-group-modern">
                  <i class="bi bi-car-front input-icon"></i>
                  {{ form_widget(form.model, {
                    'attr': {
                      'class': 'form-control',
                      'placeholder': 'Ex: Renault Clio, Peugeot 308'
                    }
                  }) }}
                </div>
                {{ form_errors(form.model) }}
              </div>
            </div>



          </div>

          {# Actions du formulaire #}
          <div class="form-actions">
            <button type="submit" class="btn btn-primary-modern btn-modern" id="submit-btn">
              <i class="bi bi-check-lg"></i>
              {% if vehicle.id %}Enregistrer les modifications{% else %}Créer le véhicule{% endif %}
            </button>
            
            <a href="{{ path('admin_vehicle_index') }}" class="btn btn-secondary-modern btn-modern">
              <i class="bi bi-x-lg"></i>
              Annuler
            </a>
          </div>

        {{ form_end(form) }}
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const fileInput = document.getElementById('vehicle-photo');
  const fileLabel = document.getElementById('file-label');

  if (fileInput && fileLabel) {
    fileInput.addEventListener('change', function(e) {
      const fileName = e.target.files[0]?.name;
      if (fileName) {
        fileLabel.innerHTML = `<i class="bi bi-check-circle"></i> ${fileName}`;
        fileLabel.classList.add('has-file');
      } else {
        fileLabel.innerHTML = '<i class="bi bi-camera"></i> Choisir une photo du véhicule';
        fileLabel.classList.remove('has-file');
      }
    });
  }
});
</script>
{% endblock %}
