{% set base = field.customOptions.basePath ?? '/uploads/clients' %}

{% if field.value is iterable and field.value|length > 0 %}
  <div style="display:flex; gap:.5rem; flex-wrap:wrap;">
    {% for filename in field.value %}
      <a href="{{ asset(base ~ '/' ~ filename) }}" target="_blank" style="display:inline-block">
        <img src="{{ asset(base ~ '/' ~ filename) }}"
             alt=""
             style="width:70px;height:70px;object-fit:cover;border-radius:6px;border:1px solid #eee;">
        </a>
    {% endfor %}
  </div>
{% else %}
  <em>Aucune photo</em>
{% endif %}
