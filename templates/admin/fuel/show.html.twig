{% extends 'base.html.twig' %}
{% block title %}Détail du plein{% endblock %}

{% block body %}
<link rel="stylesheet" href="{{ asset('styles/admin/fuel/show.css') }}">

<div class="receipt-container">
  <!-- Actions en haut -->
  <div class="page-actions">
    <h1 class="page-title">Détail du plein</h1>
    <div class="actions-group">
      <button onclick="printReceipt()" class="btn-action btn-primary-action">
        🖨️ Imprimer
      </button>
      <a href="{{ path('admin_fuel_edit', {id: fill.id}) }}" class="btn-action btn-primary-action">
        ✏️ Modifier
      </a>
      <a href="{{ path('admin_fuel_index') }}" class="btn-action btn-secondary-action">
        ← Retour
      </a>
    </div>
  </div>

  <!-- Ticket de caisse -->
  <div class="fuel-receipt">
    <!-- Header avec logo -->
    <div class="receipt-header">
      <img src="{{ asset('assets/images/logo.png') }}" alt="ILD Security" class="company-logo">
      <div class="company-name">ILD SECURITY</div>
      <div class="company-subtitle">GESTION FLOTTE</div>
      <div class="receipt-title">Ticket de Carburant</div>
      <div class="receipt-number">#ILD_{{ "%05d"|format(fill.id) }}</div>
    </div>

    <!-- Corps du ticket -->
    <div class="receipt-body">
      <!-- Section véhicule -->
      <div class="vehicle-section">
        <div class="vehicle-info">
          <div class="vehicle-plate">{{ fill.vehicle.plate }}</div>
          {% if fill.vehicle.model %}
            <div class="vehicle-model">{{ fill.vehicle.model }}</div>
          {% endif %}
        </div>
        <div class="transaction-date">{{ fill.filledAt|date('d/m/Y à H:i') }}</div>
      </div>

      <!-- Détails du plein -->
      <div class="fuel-details">
        <div class="detail-row">
          <span class="detail-label">Odomètre</span>
          <span class="detail-value">{{ fill.odometer|number_format(0, ',', ' ') }} KM</span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Carburant</span>
          <span class="detail-value">{{ fill.liters|number_format(2, ',', ' ') }} L</span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Prix/Litre</span>
          <span class="detail-value">{{ fill.pricePerLitre|number_format(3, ',', ' ') }} €</span>
        </div>

        {% if fill.distanceKm is not null %}
          <div class="detail-row">
            <span class="detail-label">Distance</span>
            <span class="detail-value">{{ fill.distanceKm|number_format(0, ',', ' ') }} KM</span>
          </div>
        {% endif %}
      </div>

      <!-- Total -->
      <div class="total-section">
        <div class="total-row">
          <span class="total-label">TOTAL</span>
          <span class="total-value">{{ fill.totalPrice|number_format(2, ',', ' ') }} €</span>
        </div>
      </div>

      <!-- Notes si présentes -->
      {% if fill.notes %}
        <div class="notes-section">
          <div class="notes-label">Notes</div>
          <div class="notes-content">{{ fill.notes|nl2br }}</div>
        </div>
      {% endif %}
    </div>

    <!-- Footer -->
    <div class="receipt-footer">
      <div class="barcode-section">
        <div class="barcode"></div>
        <div class="barcode-number">{{ "%05d"|format(fill.id) }}</div>
      </div>
      
      <div class="footer-text">MERCI DE VOTRE CONFIANCE</div>
      <div class="footer-text">Document généré le {{ "now"|date('d/m/Y à H:i') }}</div>
      <div class="footer-text">ILD SECURITY - Gestion de flotte</div>
    </div>
  </div>
</div>

<script>
// Fonction d'impression spécifique au ticket
function printReceipt() {
  // Créer une nouvelle fenêtre pour l'impression
  const printWindow = window.open('', '_blank', 'width=600,height=800');
  
  // Récupérer le contenu du ticket
  const receiptContent = document.querySelector('.fuel-receipt').outerHTML;
  
  // Créer le HTML pour l'impression
  const printHTML = `
    <!DOCTYPE html>
    <html>
    <head>
      <title>Ticket de Carburant #ILD_{{ "%05d"|format(fill.id) }}</title>
      
    </head>
    <body>
      ${receiptContent}
    </body>
    </html>
  `;
  
  // Écrire le contenu dans la fenêtre d'impression
  printWindow.document.write(printHTML);
  printWindow.document.close();
  
  // Attendre que le contenu soit chargé puis imprimer
  printWindow.onload = function() {
    printWindow.focus();
    printWindow.print();
    
    // Fermer la fenêtre après impression
    printWindow.onafterprint = function() {
      printWindow.close();
    };
  };
}

// Raccourci clavier Ctrl+P pour imprimer
document.addEventListener('keydown', function(e) {
  if (e.ctrlKey && e.key === 'p') {
    e.preventDefault();
    printReceipt();
  }
});
</script>
{% endblock %}