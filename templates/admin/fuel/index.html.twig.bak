{% extends 'base.html.twig' %}
{% block title %}Gestion de la Flotte{% endblock %}

{% block body %}
<style>
/* ========== VARIABLES MODERNES ========== */
:root {
  --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  --success-gradient: linear-gradient(135deg, #10b981 0%, #059669 100%);
  --danger-gradient: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  --warning-gradient: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  --card-shadow-hover: 0 15px 40px rgba(0, 0, 0, 0.12);
  --border-radius: 12px;
  --border-radius-lg: 16px;
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ========== CONTAINER PRINCIPAL ========== */
.fleet-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 2rem;
  background: #f8fafc;
  min-height: 100vh;
}

/* ========== HEADER SECTION ========== */
.page-header {
  background: var(--primary-gradient);
  border-radius: var(--border-radius-lg);
  color: white;
  padding: 2rem;
  margin-bottom: 2rem;
  position: relative;
  overflow: hidden;
}
.page-header::before {
  content: '';
  position: absolute;
  top: 0; right: 0;
  width: 100%; height: 100%;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="80" cy="20" r="20" fill="rgba(255,255,255,0.1)"/><circle cx="90" cy="60" r="15" fill="rgba(255,255,255,0.08)"/><circle cx="70" cy="80" r="10" fill="rgba(255,255,255,0.06)"/></svg>');
  background-size: 200px 200px;
  opacity: 0.3;
}
.header-content {
  position: relative; z-index: 2;
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 1.5rem;
}
.header-title h1 { font-size: 2.5rem; font-weight: 700; margin: 0; }
.header-subtitle { opacity: 0.9; font-size: 1.1rem; margin-top: 0.5rem; }
.btn-new-fuel {
  background: rgba(255,255,255,0.15);
  border: 2px solid rgba(255,255,255,0.3);
  color: white; font-weight: 600; border-radius: var(--border-radius);
  backdrop-filter: blur(10px); transition: var(--transition);
  padding: .75rem 1.5rem; text-decoration: none; display: flex; align-items: center; gap: .5rem;
}
.btn-new-fuel:hover { background: rgba(255,255,255,0.25); border-color: rgba(255,255,255,0.5); color: white; transform: translateY(-2px); }

/* ========== STATS GLOBALES ========== */
.global-stats {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(200px,1fr));
  gap: 1rem; margin-bottom: 2rem;
}
.global-stat-card {
  background: white; border-radius: var(--border-radius); padding: 1.5rem;
  box-shadow: var(--card-shadow); text-align: center; transition: var(--transition);
}
.global-stat-card:hover { transform: translateY(-5px); box-shadow: var(--card-shadow-hover); }
.global-stat-icon { width: 50px; height: 50px; border-radius: 50%; display:flex; align-items:center; justify-content:center; margin: 0 auto 1rem; font-size: 1.5rem; color: white; }
.global-stat-icon.vehicles { background: var(--primary-gradient); }
.global-stat-icon.fills { background: var(--warning-gradient); }
.global-stat-icon.pending { background: var(--danger-gradient); }
.global-stat-icon.distance { background: linear-gradient(135deg,#06b6d4 0%,#0891b2 100%); }
.stat-value { font-size: 1.8rem; font-weight: 700; color: #1f2937; margin-bottom: .25rem; }
.stat-label { font-size: .9rem; color: #6b7280; text-transform: uppercase; letter-spacing: .5px; }

/* ========== SECTION VÉHICULE ========== */
.vehicle-section {
  background: white; border-radius: var(--border-radius-lg);
  box-shadow: var(--card-shadow); margin-bottom: 2rem; overflow: hidden; animation: slideInUp .5s ease-out;
}
.vehicle-header { background: linear-gradient(135deg,#f8fafc 0%,#e2e8f0 100%); padding: 1.5rem; border-bottom: 1px solid rgba(0,0,0,.05); }
.vehicle-info { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
.vehicle-avatar { width: 60px; height: 60px; border-radius: 50%; background: var(--primary-gradient); display:flex; align-items:center; justify-content:center; color:white; font-weight:700; font-size:1.2rem; }
.vehicle-details h3 { margin: 0; font-weight: 700; color: #1f2937; font-size: 1.4rem; }
.vehicle-details .text-muted { color: #6b7280; font-size: .9rem; margin-top: .25rem; }
.vehicle-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(100px,1fr)); gap: 1rem; text-align: center; }
.vehicle-stat-item .stat-value { font-size: 1.3rem; font-weight:700; color:#1f2937; display:block; }
.vehicle-stat-item .stat-label { font-size:.75rem; color:#6b7280; text-transform:uppercase; letter-spacing:.5px; margin-top:.25rem; }

/* ========== CARDS MOBILES ========== */
.fills-container { padding: 1rem; }
.fill-card {
  background:white; border-radius: var(--border-radius); box-shadow: 0 4px 12px rgba(0,0,0,.06);
  margin-bottom: 1rem; overflow:hidden; transition: var(--transition); border:1px solid #f1f5f9;
}
.fill-card:hover { box-shadow: var(--card-shadow); transform: translateY(-2px); }
.fill-card-header { padding:1rem; background:#f8fafc; border-bottom:1px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center; }
.fill-date { font-weight:700; color:#1f2937; font-size:1.1rem; }
.fill-time { font-size:.85rem; color:#6b7280; }
.status-badge { padding:.25rem .75rem; border-radius:20px; font-size:.75rem; font-weight:600; text-transform:uppercase; letter-spacing:.5px; }
.fill-card-body { padding:1rem; }
.fill-metrics { display:grid; grid-template-columns: repeat(2,1fr); gap:1rem; margin-bottom:1rem; }
.fill-metric { text-align:center; padding:.75rem; background:#f8fafc; border-radius: var(--border-radius); }
.metric-value { font-weight:700; color:#1f2937; font-size:1.1rem; display:block; }
.metric-label { font-size:.75rem; color:#6b7280; text-transform:uppercase; letter-spacing:.5px; margin-top:.25rem; }
.fill-total-cost { background: linear-gradient(135deg,#ecfdf5 0%,#d1fae5 100%); color:#059669; padding:.75rem; border-radius: var(--border-radius); text-align:center; margin-bottom:1rem; border:2px solid #a7f3d0; }
.total-cost-value { font-size:1.4rem; font-weight:700; }
.total-cost-label { font-size:.8rem; opacity:.8; margin-top:.25rem; }
.fill-card-actions { padding:1rem; background:#fafbfc; border-top:1px solid #e2e8f0; }
.actions-grid { display:grid; grid-template-columns: repeat(auto-fit, minmax(100px,1fr)); gap:.5rem; }
.action-btn {
  padding:.5rem 1rem; border:1px solid #e2e8f0; border-radius: var(--border-radius);
  background:white; color:#4a5568; font-size:.8rem; font-weight:600; transition: var(--transition);
  text-align:center; text-decoration:none; display:flex; align-items:center; justify-content:center; gap:.25rem; min-height:36px;
}
.action-btn:hover { border-color:#667eea; color:#667eea; transform: translateY(-1px); }
.action-btn.btn-success { border-color:#10b981; color:#10b981; }
.action-btn.btn-success:hover { background:#f0fdf4; }
.action-btn.btn-warning { border-color:#f59e0b; color:#f59e0b; }
.action-btn.btn-warning:hover { background:#fffbeb; }
.action-btn.btn-danger { border-color:#ef4444; color:#ef4444; }
.action-btn.btn-danger:hover { background:#fef2f2; }

/* ========== TABLEAU DESKTOP ========== */
.desktop-table { display:block; }
.modern-table { margin:0; border:none; width:100%; }
.modern-table thead th {
  background:#f8fafc; color:#2d3748; font-weight:700; font-size:.85rem; text-transform:uppercase; letter-spacing:.5px;
  border:none; padding:1rem; border-bottom:2px solid #e2e8f0;
}
.modern-table tbody tr { transition: var(--transition); border:none; }
.modern-table tbody tr:hover { background:#f8fafc; }
.modern-table tbody td { padding:1rem; border-top:1px solid #f1f5f9; vertical-align: middle; }

/* ========== EMPTY STATE ========== */
.empty-state { padding:3rem 2rem; text-align:center; color:#6b7280; }
.empty-state-icon { width:60px; height:60px; background:#f3f4f6; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 1rem; font-size:1.5rem; }

/* ========== ANIM / RESPONSIVE ========== */
@keyframes slideInUp { from { opacity:0; transform: translateY(20px);} to { opacity:1; transform: translateY(0);} }
.vehicle-section, .fill-card { animation: slideInUp .5s ease-out; }

@media (max-width: 768px) {
  .fleet-container { padding: 1rem; }
  .page-header { padding: 1.5rem; }
  .header-content { flex-direction: column; text-align: center; gap: 1rem; }
  .header-title h1 { font-size: 2rem; }
  .vehicle-header { padding: 1rem; }
  .vehicle-stats { grid-template-columns: repeat(2,1fr); gap: .75rem; }
  .global-stats { grid-template-columns: repeat(2,1fr); gap: 1rem; }
  .desktop-table { display: none; }
  .mobile-cards { display: block; }
  .fill-metrics { grid-template-columns: repeat(2,1fr); gap:.75rem; }
  .actions-grid { grid-template-columns: repeat(2,1fr); gap:.5rem; }
  .action-btn { font-size:.75rem; padding:.4rem .8rem; }
}
@media (min-width: 769px) { .mobile-cards { display: none; } }
@media (max-width: 480px) {
  .fleet-container { padding: .5rem; }
  .fill-metrics { grid-template-columns: 1fr; }
  .actions-grid { grid-template-columns: 1fr; }
  .global-stats { grid-template-columns: 1fr; }
}

/* ========== PAGINATION (PROPRE, CENTRÉE) ========== */
.pagination-container {
  padding: 1rem 1.5rem; background: white; border-radius: var(--border-radius);
  box-shadow: var(--card-shadow); display: flex; justify-content: center; margin-top: 1.25rem;
}
.pagination-container nav { width: 100%; display:flex; justify-content:center; }
.pagination {
  display: inline-flex; align-items: center; gap: .35rem; list-style: none; padding: 0; margin: 0;
}
.pagination .page-item { display: inline-flex; }
.pagination .page-link {
  display: inline-flex; align-items: center; justify-content: center;
  min-width: 38px; height: 38px; padding: 0 .75rem;
  border: 1px solid #e5e7eb; border-radius: 10px;
  text-decoration: none; color: #4b5563; font-weight: 600;
  transition: var(--transition); background: #fff;
}
.pagination .page-link:hover { transform: translateY(-2px); border-color: #a5b4fc; color: #4f46e5; background: #f8fafc; }
.pagination .page-item.active .page-link {
  background: var(--primary-gradient); color: white; border-color: transparent;
  box-shadow: 0 6px 16px rgba(102,126,234,.35);
}
.pagination .page-item.disabled .page-link { opacity: .45; cursor: not-allowed; pointer-events: none; }
.pagination .page-item:first-child .page-link, .pagination .page-item:last-child .page-link { min-width: 44px; }

@media (max-width: 480px) {
  .pagination .page-link { min-width: 34px; height: 34px; padding: 0 .6rem; font-size: .875rem; }
  .pagination-container { box-shadow: none; padding: .5rem; }
}
</style>

<div class="fleet-container">
  <!-- Header Section -->
  <div class="page-header">
    <div class="header-content">
      <div class="header-title">
        <h1>Gestion de la Flotte</h1>
        <div class="header-subtitle">
          {{ vehicles|length }} véhicule{{ vehicles|length > 1 ? 's' : '' }} • {{ totalToProcess }} plein{{ totalToProcess > 1 ? 's' : '' }} à traiter
        </div>
      </div>
      <div class="header-actions" style="display:flex; gap:.5rem; flex-wrap:wrap;">
      <a href="{{ path('admin_fuel_new') }}" class="btn-new-fuel">+ Nouveau Plein</a>
      <button type="button" class="btn-new-fuel" id="open-export-modal" style="background:rgba(255,255,255,.2);">⬇️ Exporter</button>
    </div>
    </div>
  </div>

  <!-- Stats Globales -->
  <div class="global-stats">
    <div class="global-stat-card">
      <div class="global-stat-icon vehicles">🚗</div>
      <div class="stat-value">{{ vehicles|length }}</div>
      <div class="stat-label">Véhicules</div>
    </div>
    <div class="global-stat-card">
      <div class="global-stat-icon fills">⛽</div>
      <div class="stat-value">{{ totalToProcess }}</div>
      <div class="stat-label">Pleins en attente</div>
    </div>
    <div class="global-stat-card">
      <div class="global-stat-icon pending">⏳</div>
      <div class="stat-value">{{ globalStats.pendingCount }}</div>
      <div class="stat-label">En validation</div>
    </div>
    <div class="global-stat-card">
      <div class="global-stat-icon distance">📏</div>
      <div class="stat-value">{{ globalStats.totalDistance|number_format(0, ',', ' ') }} km</div>
      <div class="stat-label">Distance parcourue</div>
    </div>
  </div>

  {% if vehicles is empty %}
    <div class="vehicle-section">
      <div class="empty-state">
        <div class="empty-state-icon">🚗</div>
        <h4>Aucun véhicule enregistré</h4>
        <p>Commencez par ajouter des véhicules à votre flotte pour pouvoir enregistrer des pleins de carburant.</p>
      </div>
    </div>
  {% else %}
    {% for vehicle in vehicles %}
      {% set vehiclePagination = fillsByVehicle[vehicle.id] ?? null %}
      {% set vehicleFills = vehiclePagination ? vehiclePagination.items : [] %}

      <div class="vehicle-section">
        <!-- En-tête du véhicule -->
        <div class="vehicle-header">
          <div class="vehicle-info">
            <div class="vehicle-avatar">{{ vehicle.plate|slice(0, 2) }}</div>
            <div class="vehicle-details">
              <h3>{{ vehicle.plate }}</h3>
              {% if vehicle.model %}
                <div class="text-muted">{{ vehicle.model }}</div>
              {% endif %}
            </div>
          </div>

          {% if vehicleStats[vehicle.id] is defined and vehicleStats[vehicle.id].fillsCount > 0 %}
            <div class="vehicle-stats">
              <div class="vehicle-stat-item">
                <span class="stat-value">{{ vehicleStats[vehicle.id].fillsCount }}</span>
                <div class="stat-label">Pleins</div>
              </div>
              <div class="vehicle-stat-item">
                <span class="stat-value">{{ vehicleStats[vehicle.id].totalLiters|number_format(1, ',', ' ') }} L</span>
                <div class="stat-label">Carburant</div>
              </div>
              <div class="vehicle-stat-item">
                <span class="stat-value">{{ vehicleStats[vehicle.id].totalCost|number_format(2, ',', ' ') }} €</span>
                <div class="stat-label">Coût total</div>
              </div>
              <div class="vehicle-stat-item">
                <span class="stat-value">{{ vehicleStats[vehicle.id].totalDistance|number_format(0, ',', ' ') }} km</span>
                <div class="stat-label">Distance</div>
              </div>
            </div>
          {% endif %}
        </div>

        {% if vehicleFills is empty %}
          <div class="empty-state">
            <div class="empty-state-icon">⛽</div>
            <h5>Aucun plein pour ce véhicule</h5>
            <p>Ce véhicule n'a pas encore de pleins de carburant enregistrés en attente de traitement.</p>
          </div>
        {% else %}

          <!-- VUE DESKTOP - Tableau -->
          <div class="desktop-table">
            <table class="modern-table table">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Odomètre</th>
                  <th>Carburant</th>
                  <th>Prix/L</th>
                  <th>Total</th>
                  <th>Distance</th>
                  <th>Statut</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for fill in vehicleFills %}
                  <tr>
                    <td>
                      <div style="font-weight:600">{{ fill.filledAt|date('d/m/Y') }}</div>
                      <div style="font-size:.85rem;color:#6b7280">{{ fill.filledAt|date('H:i') }}</div>
                    </td>
                    <td><span style="font-weight:600">{{ fill.odometer|number_format(0, ',', ' ') }} km</span></td>
                    <td><span style="font-weight:600">{{ fill.liters|number_format(2, ',', ' ') }} L</span></td>
                    <td><span style="font-weight:600">{{ fill.pricePerLitre|number_format(3, ',', ' ') }} €</span></td>
                    <td><span style="font-weight:700;color:#059669;font-size:1.05rem">{{ fill.totalPrice|number_format(2, ',', ' ') }} €</span></td>
                    <td>
                      {% if fill.distanceKm is not null and fill.distanceKm > 0 %}
                        <span style="background:#dbeafe;color:#1e40af;padding:.25rem .75rem;border-radius:20px;font-size:.85rem;font-weight:600">{{ fill.distanceKm|number_format(0, ',', ' ') }} km</span>
                      {% else %}
                        <span style="color:#9ca3af">—</span>
                      {% endif %}
                    </td>
                    <td>
                      <span class="status-badge" style="background-color: {{ fill.statusColor }}33; color: {{ fill.statusColor }}; border: 1px solid {{ fill.statusColor }};">
                        {{ fill.statusLabel ?? fill.status|default('Nouveau') }}
                      </span>
                    </td>
                    <td>
                      <div style="display:flex;gap:.5rem;flex-wrap:wrap">
                        <a href="{{ path('admin_fuel_show', {id: fill.id}) }}" class="action-btn" style="font-size:.75rem">👁️ Voir</a>
                        {% if fill.status != 'validated' %}
                          <a href="{{ path('admin_fuel_edit', {id: fill.id}) }}" class="action-btn" style="font-size:.75rem">✏️ Modifier</a>
                        {% endif %}
                      </div>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>

            {% if vehiclePagination %}
              <div class="pagination-container" aria-label="Pagination véhicule">
                {{ knp_pagination_render(vehiclePagination, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
              </div>
            {% endif %}
          </div>

          <!-- VUE MOBILE - Cards -->
          <div class="mobile-cards">
            <div class="fills-container">
              {% for fill in vehicleFills %}
                <div class="fill-card">
                  <div class="fill-card-header">
                    <div>
                      <div class="fill-date">{{ fill.filledAt|date('d/m/Y') }}</div>
                      <div class="fill-time">{{ fill.filledAt|date('H:i') }}</div>
                    </div>
                    <span class="status-badge" style="background-color: {{ fill.statusColor }}33; color: {{ fill.statusColor }}; border: 1px solid {{ fill.statusColor }};">
                      {{ (fill.statusLabel ?? fill.status|default('Nouveau'))|upper }}
                    </span>
                  </div>

                  <div class="fill-card-body">
                    <div class="fill-metrics">
                      <div class="fill-metric">
                        <span class="metric-value">{{ fill.odometer|number_format(0, ',', ' ') }} km</span>
                        <div class="metric-label">Odomètre</div>
                      </div>
                      <div class="fill-metric">
                        <span class="metric-value">{{ fill.liters|number_format(1, ',', ' ') }} L</span>
                        <div class="metric-label">Carburant</div>
                      </div>
                      <div class="fill-metric">
                        <span class="metric-value">{{ fill.pricePerLitre|number_format(3, ',', ' ') }} €</span>
                        <div class="metric-label">Prix/Litre</div>
                      </div>
                      {% if fill.distanceKm is not null and fill.distanceKm > 0 %}
                        <div class="fill-metric">
                          <span class="metric-value">{{ fill.distanceKm|number_format(0, ',', ' ') }} km</span>
                          <div class="metric-label">Distance</div>
                        </div>
                      {% endif %}
                    </div>

                    <div class="fill-total-cost">
                      <div class="total-cost-value">{{ fill.totalPrice|number_format(2, ',', ' ') }} €</div>
                      <div class="total-cost-label">COÛT TOTAL</div>
                    </div>
                  </div>

                  <div class="fill-card-actions">
                    <div class="actions-grid">
                      <a href="{{ path('admin_fuel_show', {id: fill.id}) }}" class="action-btn">👁️ Voir</a>
                      {% if fill.status != 'validated' %}
                        <a href="{{ path('admin_fuel_edit', {id: fill.id}) }}" class="action-btn">✏️ Modifier</a>
                        {% if fill.status == 'pending' %}
                          <form method="post" action="{{ path('admin_fuel_validate', {id: fill.id}) }}" style="display: contents;">
                            <input type="hidden" name="_token" value="{{ csrf_token('validate_fill_' ~ fill.id) }}">
                            <button type="submit" class="action-btn btn-success">✅ Valider</button>
                          </form>
                          <form method="post" action="{{ path('admin_fuel_reject', {id: fill.id}) }}" style="display: contents;">
                            <input type="hidden" name="_token" value="{{ csrf_token('reject_fill_' ~ fill.id) }}">
                            <button type="submit" class="action-btn btn-warning">❌ Refuser</button>
                          </form>
                        {% endif %}
                      {% else %}
                        <span class="action-btn" style="opacity:.6">🔒 Validé</span>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>

            {% if vehiclePagination %}
              <div class="pagination-container" aria-label="Pagination véhicule">
                {{ knp_pagination_render(vehiclePagination, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
              </div>
            {% endif %}
          </div>

        {% endif %}
      </div>
    {% endfor %}
  {% endif %}
</div>
<style>
/* Modal simple */
.modal-backdrop {
  position: fixed; inset: 0; background: rgba(15,23,42,.45);
  display: none; align-items: center; justify-content: center; z-index: 9999;
}
.modal-backdrop.active { display: flex; }
.modal-card {
  width: 100%; max-width: 680px; background: #fff; border-radius: 14px;
  box-shadow: 0 20px 60px rgba(0,0,0,.25); overflow: hidden;
  animation: slideInUp .25s ease-out;
}
.modal-header {
  padding: 1rem 1.25rem; background: linear-gradient(135deg,#667eea 0%, #764ba2 100%); color: #fff;
  display:flex; align-items:center; justify-content:space-between;
}
.modal-header h3 { margin: 0; font-weight: 700; }
.modal-body { padding: 1.25rem; }
.modal-footer { padding: 1rem 1.25rem; background: #f9fafb; display:flex; gap:.5rem; justify-content:flex-end; }
.input-row { display:grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
.input-col { display:flex; flex-direction:column; gap:.35rem; }
.label { font-size:.9rem; color:#374151; font-weight:600; }
.select, .input, .multiselect {
  border: 1px solid #e5e7eb; border-radius: 10px; padding: .6rem .75rem; font-size: .95rem; color:#111827; background:#fff;
}
.help { font-size:.8rem; color:#6b7280; }
.btn {
  border-radius: 10px; padding:.6rem 1rem; font-weight:700; border:1px solid transparent; cursor:pointer;
}
.btn-primary { background: linear-gradient(135deg,#667eea 0%,#764ba2 100%); color:#fff; }
.btn-primary:hover { filter: brightness(1.05); }
.btn-ghost { background:#fff; border-color:#e5e7eb; color:#374151; }
.btn-ghost:hover { background:#f8fafc; }
@media (max-width: 560px) {
  .input-row { grid-template-columns: 1fr; }
}
</style>

<div class="modal-backdrop" id="export-modal" aria-hidden="true" role="dialog" aria-labelledby="exportTitle">
  <div class="modal-card">
    <div class="modal-header">
      <h3 id="exportTitle">Exporter les bons</h3>
      <button type="button" class="btn btn-ghost" id="close-export-modal">✖</button>
    </div>
    <form action="{{ path('admin_fuel_export') }}" method="get">
      <div class="modal-body">
        <div class="input-row">
          <div class="input-col">
            <label class="label" for="date_from">Date début</label>
            <input class="input" type="date" id="date_from" name="date_from">
            <div class="help">Inclus à partir de 00:00</div>
          </div>
          <div class="input-col">
            <label class="label" for="date_to">Date fin</label>
            <input class="input" type="date" id="date_to" name="date_to">
            <div class="help">Inclus jusqu’à 23:59</div>
          </div>
        </div>

        <div class="input-row" style="margin-top:.75rem;">
          <div class="input-col">
            <label class="label" for="status">Statut</label>
            <select class="select" id="status" name="status">
              <option value="">— Tous —</option>
              <option value="validated">Validé</option>
              <option value="pending">En validation</option>
              <option value="rejected">Refusé</option>
              <option value="new">Nouveau</option>
            </select>
          </div>

          <div class="input-col">
            <label class="label" for="vehicles">Véhicules</label>
            <select class="multiselect" id="vehicles" name="vehicles[]" multiple size="6">
              {% for v in vehicles %}
                <option value="{{ v.id }}">{{ v.plate }}{% if v.model %} — {{ v.model }}{% endif %}</option>
              {% endfor %}
            </select>
            <div class="help">Laisser vide pour tous</div>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" id="cancel-export">Annuler</button>
        <button type="submit" class="btn btn-primary">Exporter en CSV</button>
      </div>
    </form>
  </div>
</div>

<script>
// Ouverture/fermeture modal
(function() {
  const openBtn = document.getElementById('open-export-modal');
  const closeBtn = document.getElementById('close-export-modal');
  const cancelBtn = document.getElementById('cancel-export');
  const modal = document.getElementById('export-modal');

  function open() { modal.classList.add('active'); modal.setAttribute('aria-hidden', 'false'); }
  function close() { modal.classList.remove('active'); modal.setAttribute('aria-hidden', 'true'); }

  if (openBtn)   openBtn.addEventListener('click', open);
  if (closeBtn)  closeBtn.addEventListener('click', close);
  if (cancelBtn) cancelBtn.addEventListener('click', close);
  modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
})();
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Animation des cards au scroll
  const cards = document.querySelectorAll('.fill-card');
  const cardObserver = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.style.opacity = '1';
        e.target.style.transform = 'translateY(0)';
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

  cards.forEach((card) => {
    card.style.opacity = '0';
    card.style.transform = 'translateY(20px)';
    card.style.transition = 'opacity .4s ease, transform .4s ease';
    cardObserver.observe(card);
  });

  // Confirmation suppression
  document.querySelectorAll('form[action*="delete"]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      if (!confirm('Êtes-vous sûr de vouloir supprimer ce plein ?')) e.preventDefault();
    });
  });

  // Haptique mobile
  const isMobile = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
  if (isMobile) {
    document.querySelectorAll('.action-btn').forEach((btn) => {
      btn.addEventListener('touchstart', () => { if ('vibrate' in navigator) navigator.vibrate(25); });
    });
  }

  // Accessibilité
  document.querySelectorAll('.fill-card').forEach((card, i) => {
    card.setAttribute('tabindex', '0');
    card.setAttribute('role', 'article');
    card.setAttribute('aria-label', 'Plein de carburant ' + (i + 1));
  });
});
</script>
{% endblock %}
