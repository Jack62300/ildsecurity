{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}{{ fill.id ? 'Modifier un plein' : 'Nouveau plein' }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <link rel="stylesheet" href="{{ asset('assets/css/admin/fuel/form.css') }}">
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">

  {# ========== HEADER MODERNE ========== #}
  <div class="page-header">
    <div class="d-flex flex-column">
      <h1>
        {% if fill.id %}
          <i class="bi bi-pencil-square me-2"></i>Modifier un Plein
        {% else %}
          <i class="bi bi-plus-circle me-2"></i>Nouveau Plein
        {% endif %}
      </h1>
      <p class="subtitle mb-0">
        {% if fill.id %}
          Modifiez les informations de ce plein de carburant
        {% else %}
          Enregistrez un nouveau plein de carburant
        {% endif %}
      </p>
      
      <nav class="breadcrumb-nav">
        <a href="{{ path('admin_fuel_index') }}">
          <i class="bi bi-fuel-pump me-1"></i>Pleins de carburant
        </a>
        <span class="separator">›</span>
        <span>{{ fill.id ? 'Modification' : 'Nouveau plein' }}</span>
      </nav>
    </div>
  </div>

  {# ========== FORMULAIRE MODERNE ========== #}
  <div class="form-container">
    <div class="modern-form-card">
      
      {# Header du formulaire #}
      <div class="form-header">
        <h2>
          <div class="form-icon">
            <i class="bi bi-fuel-pump"></i>
          </div>
          Informations du plein
        </h2>
      </div>

      {# Corps du formulaire #}
      <div class="form-body">
        {{ form_start(form, {'attr': {'id': 'fuel-form', 'novalidate': 'novalidate'}}) }}
          
          {# Section Véhicule et Date #}
          <div class="form-section">
            <div class="section-title">
              <i class="bi bi-truck"></i>
              Véhicule et Date
            </div>
            
            <div class="row g-4">
              <div class="col-md-6">
                <div class="form-group">
                  {{ form_label(form.vehicle, 'Véhicule', {'label_attr': {'class': 'form-label'}}) }}
                  <div class="input-group-modern">
                    <i class="bi bi-truck input-icon"></i>
                    {{ form_widget(form.vehicle, {'attr': {'class': 'form-select'}}) }}
                  </div>
                  <div class="form-help">
                    <i class="bi bi-info-circle"></i>
                    Sélectionnez le véhicule concerné
                  </div>
                  {{ form_errors(form.vehicle) }}
                </div>

                {# Aperçu véhicule #}
                <div id="vehicle-preview" class="vehicle-preview">
                  <img id="vehicle-photo" src="" alt="">
                  <div class="vehicle-info">
                    <h6 id="vehicle-plate"></h6>
                    <div class="text-muted">Véhicule sélectionné</div>
                  </div>
                </div>
              </div>

              <div class="col-md-6">
                <div class="form-group">
                  {{ form_label(form.filledAt, 'Date et heure', {'label_attr': {'class': 'form-label'}}) }}
                  <div class="input-group-modern">
                    <i class="bi bi-calendar input-icon"></i>
                    {{ form_widget(form.filledAt, {'attr': {'class': 'form-control'}}) }}
                  </div>
                  <div class="form-help">
                    <i class="bi bi-clock"></i>
                    Date et heure du plein
                  </div>
                  {{ form_errors(form.filledAt) }}
                </div>
              </div>
            </div>
          </div>

          {# Section Kilométrage #}
          <div class="form-section">
            <div class="section-title">
              <i class="bi bi-speedometer2"></i>
              Kilométrage
            </div>
            
            <div class="row g-4">
              <div class="col-md-12">
                <div class="form-group">
                  {{ form_label(form.odometer, 'Kilométrage', {'label_attr': {'class': 'form-label'}}) }}
                  <div class="input-group-modern">
                    <i class="bi bi-speedometer2 input-icon"></i>
                    {{ form_widget(form.odometer, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 15420'}}) }}
                  </div>
                  <div class="form-help">
                    <i class="bi bi-info-circle"></i>
                    Kilométrage du véhicule au moment du plein
                  </div>
                  {{ form_errors(form.odometer) }}
                </div>
              </div>
            </div>
          </div>

          {# Section Carburant et Prix #}
          <div class="form-section">
            <div class="section-title">
              <i class="bi bi-fuel-pump"></i>
              Carburant et Prix
            </div>
            
            <div class="row g-4">
              <div class="col-md-4">
                <div class="form-group">
                  {{ form_label(form.pricePerLitre, 'Prix au litre (€)', {'label_attr': {'class': 'form-label'}}) }}
                  <div class="input-group-modern">
                    <i class="bi bi-currency-euro input-icon"></i>
                    {{ form_widget(form.pricePerLitre, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 1.449', 'step': '0.001'}}) }}
                  </div>
                  <div class="form-help">
                    <i class="bi bi-info-circle"></i>
                    Prix du carburant par litre
                  </div>
                  {{ form_errors(form.pricePerLitre) }}
                </div>
              </div>

              <div class="col-md-4">
                <div class="form-group">
                  {{ form_label(form.liters, 'Quantité (L)', {'label_attr': {'class': 'form-label'}}) }}
                  <div class="input-group-modern">
                    <i class="bi bi-droplet input-icon"></i>
                    {{ form_widget(form.liters, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 45.25', 'step': '0.01'}}) }}
                  </div>
                  <div class="form-help">
                    <i class="bi bi-droplet"></i>
                    Quantité de carburant en litres
                  </div>
                  {{ form_errors(form.liters) }}
                </div>
              </div>

              <div class="col-md-4">
                <div class="form-group">
                  {{ form_label(form.totalPrice, 'Montant total (€)', {'label_attr': {'class': 'form-label'}}) }}
                  <div class="input-group-modern">
                    <i class="bi bi-receipt input-icon"></i>
                    {{ form_widget(form.totalPrice, {'attr': {'class': 'form-control', 'id': 'total-field', 'placeholder': 'Calculé automatiquement'}}) }}
                  </div>
                  <div class="calculation-section">
                    <div class="calculation-info">
                      <i class="bi bi-calculator"></i>
                      Calculé automatiquement (modifiable si besoin)
                    </div>
                  </div>
                  {{ form_errors(form.totalPrice) }}
                </div>
              </div>
            </div>
          </div>

          {# Section Statut (si présent dans le form)
          {% if form.status is defined %}
          <div class="form-section">
            <div class="section-title">
              <i class="bi bi-check-circle"></i>
              Statut
            </div>
            
            <div class="row g-4">
              <div class="col-md-6">
                <div class="form-group">
                  {{ form_label(form.status, 'Statut comptable', {'label_attr': {'class': 'form-label'}}) }}
                  <div class="input-group-modern">
                    <i class="bi bi-shield-check input-icon"></i>
                    {{ form_widget(form.status, {'attr': {'class': 'form-select'}}) }}
                  </div>
                  <div class="form-help">
                    <i class="bi bi-info-circle"></i>
                    État de validation comptable
                  </div>
                  {{ form_errors(form.status) }}
                </div>
              </div>
            </div>
          </div>
          {% endif %} #}

          {# Section Notes #}
          <div class="form-section">
            <div class="section-title">
              <i class="bi bi-chat-text"></i>
              Notes complémentaires
            </div>
            
            <div class="row g-4">
              <div class="col-12">
                <div class="form-group">
                  {{ form_label(form.notes, 'Notes', {'label_attr': {'class': 'form-label'}}) }}
                  <div class="input-group-modern">
                    <i class="bi bi-chat-text input-icon"></i>
                    {{ form_widget(form.notes, {'attr': {'class': 'form-control', 'rows': 3, 'placeholder': 'Notes additionnelles (station, type de carburant, etc.)'}}) }}
                  </div>
                  <div class="form-help">
                    <i class="bi bi-lightbulb"></i>
                    Informations complémentaires (optionnel)
                  </div>
                  {{ form_errors(form.notes) }}
                </div>
              </div>
            </div>
          </div>

          {# Actions du formulaire #}
          <div class="form-actions">
            <button type="submit" class="btn btn-primary-modern btn-modern" id="submit-btn">
              <i class="bi bi-check-lg"></i>
              {% if fill.id %}Enregistrer les modifications{% else %}Enregistrer le plein{% endif %}
            </button>
            
            <a href="{{ path('admin_fuel_index') }}" class="btn btn-secondary-modern btn-modern">
              <i class="bi bi-x-lg"></i>
              Annuler
            </a>
          </div>

        {{ form_end(form) }}
      </div>
    </div>
  </div>
</div>

{# ========== JAVASCRIPT VANILLA POUR UX AMÉLIORÉE ========== #}
<script>
document.addEventListener('DOMContentLoaded', function() {
  console.log('🚗 Initialisation du formulaire de plein...');

  // ========== ÉLÉMENTS DU DOM ========== 
  const form = document.getElementById('fuel-form');
  const submitBtn = document.getElementById('submit-btn');
  const priceInput = document.querySelector('input[name*="pricePerLitre"]');
  const litersInput = document.querySelector('input[name*="liters"]');
  const totalInput = document.getElementById('total-field');
  const vehicleSelect = document.querySelector('select[name*="vehicle"]');
  const vehiclePreview = document.getElementById('vehicle-preview');
  const vehiclePhoto = document.getElementById('vehicle-photo');
  const vehiclePlate = document.getElementById('vehicle-plate');

  // ========== DÉTECTION MOBILE ========== 
  const isMobile = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) || window.innerWidth <= 768;
  
  console.log('📱 Mode mobile:', isMobile);

  // ========== GESTION INTELLIGENTE DU CLAVIER VIRTUEL ========== 
  if (isMobile) {
    let initialViewportHeight = window.visualViewport ? window.visualViewport.height : window.innerHeight;
    
    function handleViewportChange() {
      const currentHeight = window.visualViewport ? window.visualViewport.height : window.innerHeight;
      const keyboardHeight = initialViewportHeight - currentHeight;
      
      if (keyboardHeight > 150) {
        document.body.classList.add('keyboard-open');
        const activeElement = document.activeElement;
        if (activeElement && (activeElement.matches('input') || activeElement.matches('textarea'))) {
          setTimeout(function() {
            activeElement.scrollIntoView({ 
              behavior: 'smooth', 
              block: 'center',
              inline: 'nearest' 
            });
          }, 300);
        }
      } else {
        document.body.classList.remove('keyboard-open');
      }
    }

    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', handleViewportChange);
    } else {
      window.addEventListener('resize', handleViewportChange);
    }
  }

  // ========== FORMATAGE INTELLIGENT DES NOMBRES ========== 
  const numericInputs = document.querySelectorAll('input[inputmode="numeric"], input[inputmode="decimal"]');
  
  numericInputs.forEach(function(input) {
    input.addEventListener('input', function(e) {
      let value = e.target.value;
      
      if (input.getAttribute('inputmode') === 'decimal') {
        value = value.replace(',', '.');
        const parts = value.split('.');
        if (parts.length > 2) {
          value = parts[0] + '.' + parts.slice(1).join('');
        }
      } else {
        value = value.replace(/[^\d]/g, '');
      }
      
      e.target.value = value;
      
      if (input.name.includes('pricePerLitre') || input.name.includes('liters')) {
        updateTotalWithAnimation();
      }
    });

    input.addEventListener('blur', function(e) {
      const value = parseFloat(e.target.value);
      if (!isNaN(value)) {
        if (e.target.name.includes('pricePerLitre')) {
          e.target.value = value.toFixed(3);
        } else if (e.target.name.includes('liters') || e.target.name.includes('totalPrice')) {
          e.target.value = value.toFixed(2);
        }
      }
      validateFieldEnhanced(e.target);
    });
  });

  // ========== CALCUL AUTOMATIQUE AMÉLIORÉ ========== 
  function updateTotalWithAnimation() {
    if (!priceInput || !litersInput || !totalInput) return;
    
    const price = parseFloat(priceInput.value.replace(',', '.')) || 0;
    const liters = parseFloat(litersInput.value.replace(',', '.')) || 0;
    const total = (price * liters);
    
    if (total > 0) {
      totalInput.value = total.toFixed(2);
      
      totalInput.classList.add('calculation-highlight');
      setTimeout(function() {
        totalInput.classList.remove('calculation-highlight');
      }, 600);
      
      if (isMobile && 'vibrate' in navigator) {
        navigator.vibrate(50);
      }
    }
  }

  // ========== GESTION AMÉLIORÉE DE LA SÉLECTION DE VÉHICULE ========== 
  function updateVehiclePreview() {
    if (!vehicleSelect) return;
    
    const selectedOption = vehicleSelect.options[vehicleSelect.selectedIndex];
    
    if (selectedOption && selectedOption.value && selectedOption.dataset.photo) {
      if (vehiclePhoto) vehiclePhoto.src = selectedOption.dataset.photo;
      if (vehiclePlate) vehiclePlate.textContent = selectedOption.dataset.plaque || selectedOption.textContent;
      if (vehiclePreview) {
        vehiclePreview.classList.add('show');
        if (isMobile && 'vibrate' in navigator) {
          navigator.vibrate(30);
        }
      }
    } else {
      if (vehiclePreview) vehiclePreview.classList.remove('show');
    }
  }

  if (vehicleSelect) {
    vehicleSelect.addEventListener('change', updateVehiclePreview);
    updateVehiclePreview();
  }

  // ========== VALIDATION TEMPS RÉEL AMÉLIORÉE ========== 
  const formInputs = document.querySelectorAll('input[type="number"], input[inputmode], textarea');
  
  formInputs.forEach(function(input) {
    input.addEventListener('input', function() {
      this.classList.remove('is-invalid', 'is-valid');
    });
    
    input.addEventListener('blur', function() {
      validateFieldEnhanced(this);
    });
  });

  function validateFieldEnhanced(field) {
    const value = field.value.trim();
    let isValid = true;
    let errorMessage = '';

    if (field.hasAttribute('inputmode')) {
      const inputMode = field.getAttribute('inputmode');
      
      if (inputMode === 'numeric' || inputMode === 'decimal') {
        const numValue = parseFloat(value.replace(',', '.'));
        const min = parseFloat(field.getAttribute('min')) || 0;
        const max = parseFloat(field.getAttribute('max')) || Infinity;
        
        if (value && (isNaN(numValue) || numValue < min || numValue > max)) {
          isValid = false;
          errorMessage = 'Valeur invalide (entre ' + min + ' et ' + (max === Infinity ? '∞' : max) + ')';
        }
      }
    }

    if (value) {
      if (isValid) {
        field.classList.remove('is-invalid');
        field.classList.add('is-valid');
        removeFieldError(field);
      } else {
        field.classList.remove('is-valid');
        field.classList.add('is-invalid');
        showFieldError(field, errorMessage);
      }
    } else {
      field.classList.remove('is-valid', 'is-invalid');
      removeFieldError(field);
    }
  }

  function showFieldError(field, message) {
    removeFieldError(field);
    
    const errorDiv = document.createElement('div');
    errorDiv.className = 'invalid-feedback d-block';
    errorDiv.textContent = message;
    errorDiv.setAttribute('data-field-error', field.name || 'unknown');
    
    field.parentNode.appendChild(errorDiv);
    
    if (isMobile && 'vibrate' in navigator) {
      navigator.vibrate([100, 50, 100]);
    }
  }

  function removeFieldError(field) {
    const fieldName = field.name || 'unknown';
    const existingError = field.parentNode.querySelector('[data-field-error="' + fieldName + '"]');
    if (existingError) {
      existingError.remove();
    }
  }

  // ========== GESTION AMÉLIORÉE DU FORMULAIRE ========== 
  if (form) {
    form.addEventListener('submit', function(e) {
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Enregistrement...';
        
        if (isMobile && 'vibrate' in navigator) {
          navigator.vibrate([50, 100, 50]);
        }
      }
      
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // ========== GESTION DU FOCUS INTELLIGENT ========== 
  if (isMobile) {
    const inputs = Array.from(document.querySelectorAll('input, select, textarea'));
    
    inputs.forEach(function(input, index) {
      input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && input.type !== 'textarea') {
          e.preventDefault();
          const nextInput = inputs[index + 1];
          if (nextInput) {
            nextInput.focus();
          } else {
            if (submitBtn) {
              submitBtn.focus();
            }
          }
        }
      });
    });
  }

  // ========== ÉVÉNEMENTS DE CALCUL ========== 
  if (priceInput) {
    priceInput.addEventListener('input', updateTotalWithAnimation);
    priceInput.addEventListener('blur', function() {
      const value = parseFloat(this.value.replace(',', '.'));
      if (!isNaN(value)) {
        this.value = value.toFixed(3);
      }
      updateTotalWithAnimation();
    });
  }

  if (litersInput) {
    litersInput.addEventListener('input', updateTotalWithAnimation);
    litersInput.addEventListener('blur', function() {
      const value = parseFloat(this.value.replace(',', '.'));
      if (!isNaN(value)) {
        this.value = value.toFixed(2);
      }
      updateTotalWithAnimation();
    });
  }

  // ========== FORMATAGE DES NOMBRES AU FOCUS ========== 
  const numberFields = [priceInput, litersInput, totalInput];
  numberFields.forEach(function(input) {
    if (input) {
      input.addEventListener('focus', function() {
        // Sélectionner tout le texte au focus pour faciliter la saisie
        setTimeout(function() {
          input.select();
        }, 100);
      });
    }
  });

  // ========== INITIALISATION FINALE ========== 
  console.log('✅ Formulaire de plein initialisé avec succès');
  
  // Calcul initial si les champs ont des valeurs
  updateTotalWithAnimation();
  
  // Vérification initiale du véhicule
  updateVehiclePreview();
  
  // Log des éléments trouvés pour debug
  console.log('🔍 Éléments détectés:', {
    form: !!form,
    submitBtn: !!submitBtn,
    priceInput: !!priceInput,
    litersInput: !!litersInput,
    totalInput: !!totalInput,
    vehicleSelect: !!vehicleSelect,
    vehiclePreview: !!vehiclePreview,
    isMobile: isMobile
  });
});
</script>
{% endblock %}