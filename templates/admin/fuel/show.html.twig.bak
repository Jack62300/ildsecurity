{% extends 'base.html.twig' %}
{% block title %}Détail du plein{% endblock %}

{% block body %}
<style>
/* ========== VARIABLES MODERNES ========== */
:root {
  --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  --border-radius: 12px;
  --border-radius-lg: 16px;
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ========== CONTAINER PRINCIPAL ========== */
.receipt-container {
  max-width: 500px;
  margin: 2rem auto;
  padding: 2rem;
  background: #f5f5f5;
  min-height: 100vh;
}

/* ========== HEADER AVEC ACTIONS ========== */
.page-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
  padding: 1rem 0;
}

.page-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: #2d3748;
  margin: 0;
}

.actions-group {
  display: flex;
  gap: 0.5rem;
}

.btn-action {
  padding: 0.5rem 1rem;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.9rem;
  text-decoration: none;
  transition: var(--transition);
  border: none;
  cursor: pointer;
}

.btn-primary-action {
  background: var(--primary-gradient);
  color: white;
}

.btn-secondary-action {
  background: white;
  color: #4a5568;
  border: 2px solid #e2e8f0;
}

.btn-action:hover {
  transform: translateY(-2px);
}

/* ========== TICKET DE CAISSE ========== */
.fuel-receipt {
  background: white;
  border-radius: 0;
  box-shadow: 0 0 30px rgba(0, 0, 0, 0.15);
  overflow: hidden;
  position: relative;
  font-family: 'Courier New', monospace;
}

/* Effet de papier perforé en haut */
.fuel-receipt::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 20px;
  background: 
    radial-gradient(circle at 10px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 30px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 50px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 70px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 90px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 110px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 130px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 150px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 170px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 190px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 210px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 230px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 250px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 270px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 290px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 310px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 330px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 350px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 370px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 390px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 410px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 430px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 450px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 470px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
    radial-gradient(circle at 490px 10px, transparent 3px, white 3px, white 7px, transparent 7px);
  background-size: 20px 20px;
}

/* Header du ticket */
.receipt-header {
  text-align: center;
  padding: 2rem 2rem 1.5rem;
  border-bottom: 2px dashed #e2e8f0;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
}

.company-logo {
  width: 80px;
  height: 80px;
  margin: 0 auto 1rem;
  display: block;
}

.company-name {
  font-size: 1.5rem;
  font-weight: 900;
  color: #2d3748;
  margin: 0.5rem 0;
  letter-spacing: 2px;
}

.company-subtitle {
  font-size: 0.9rem;
  color: #6b7280;
  font-weight: 600;
  margin: 0;
}

.receipt-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: #1f2937;
  margin: 1rem 0 0.5rem;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.receipt-number {
  font-size: 0.85rem;
  color: #6b7280;
  margin: 0;
}

/* Corps du ticket */
.receipt-body {
  padding: 1.5rem 2rem;
}

/* Section véhicule */
.vehicle-section {
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 1px dashed #d1d5db;
}

.vehicle-info {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  margin-bottom: 0.75rem;
}

.vehicle-plate {
  background: #1f2937;
  color: white;
  padding: 0.5rem 1rem;
  border-radius: 4px;
  font-weight: 900;
  font-size: 1.1rem;
  letter-spacing: 2px;
  font-family: monospace;
}

.vehicle-model {
  color: #4b5563;
  font-weight: 600;
  font-size: 0.95rem;
}

.transaction-date {
  text-align: center;
  font-size: 0.9rem;
  color: #6b7280;
  font-weight: 600;
}

/* Détails du plein */
.fuel-details {
  margin: 1.5rem 0;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.75rem 0;
  border-bottom: 1px dotted #d1d5db;
  font-size: 0.95rem;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  color: #4b5563;
  font-weight: 600;
  text-transform: uppercase;
  font-size: 0.85rem;
  letter-spacing: 0.5px;
}

.detail-value {
  color: #1f2937;
  font-weight: 700;
  font-family: monospace;
  font-size: 1rem;
}

/* Ligne total */
.total-section {
  margin: 1.5rem 0;
  padding: 1rem;
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  border-radius: 8px;
  border: 2px solid #f59e0b;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0;
}

.total-label {
  font-size: 1.2rem;
  font-weight: 900;
  color: #92400e;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.total-value {
  font-size: 1.5rem;
  font-weight: 900;
  color: #92400e;
  font-family: monospace;
}

/* Section notes */
.notes-section {
  margin-top: 1.5rem;
  padding: 1rem;
  background: #f8fafc;
  border-radius: 8px;
  border-left: 4px solid #3b82f6;
}

.notes-label {
  font-size: 0.85rem;
  font-weight: 700;
  color: #1e40af;
  text-transform: uppercase;
  margin-bottom: 0.5rem;
  letter-spacing: 0.5px;
}

.notes-content {
  color: #374151;
  font-size: 0.9rem;
  line-height: 1.5;
  font-family: system-ui, sans-serif;
}

/* Footer du ticket */
.receipt-footer {
  text-align: center;
  padding: 1.5rem 2rem 2rem;
  border-top: 2px dashed #e2e8f0;
  background: #f8fafc;
}

.footer-text {
  font-size: 0.8rem;
  color: #6b7280;
  margin: 0.25rem 0;
  line-height: 1.4;
}

.barcode-section {
  margin: 1rem 0;
  padding: 0.5rem;
  background: white;
  border-radius: 4px;
}

.barcode {
  height: 40px;
  background: repeating-linear-gradient(
    90deg,
    #000 0px,
    #000 2px,
    transparent 2px,
    transparent 4px,
    #000 4px,
    #000 5px,
    transparent 5px,
    transparent 8px,
    #000 8px,
    #000 9px,
    transparent 9px,
    transparent 11px
  );
  margin: 0.5rem 0;
}

.barcode-number {
  font-family: monospace;
  font-size: 0.75rem;
  color: #374151;
  text-align: center;
  letter-spacing: 2px;
}

/* Effet de papier déchiré en bas */
.fuel-receipt::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 15px;
  background: 
    linear-gradient(45deg, transparent 0%, transparent 45%, white 45%, white 55%, transparent 55%),
    linear-gradient(-45deg, transparent 0%, transparent 45%, white 45%, white 55%, transparent 55%);
  background-size: 20px 15px;
}

/* Responsive */
@media (max-width: 768px) {
  .receipt-container {
    padding: 1rem;
    margin: 1rem auto;
  }

  .page-actions {
    flex-direction: column;
    gap: 1rem;
    align-items: stretch;
  }

  .actions-group {
    justify-content: center;
  }

  .btn-action {
    flex: 1;
    text-align: center;
  }

  .fuel-receipt {
    margin: 0;
  }

  .receipt-header,
  .receipt-body,
  .receipt-footer {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .vehicle-info {
    flex-direction: column;
    gap: 0.5rem;
  }
}

/* Print styles */
@media print {
  .page-actions {
    display: none;
  }
  
  .receipt-container {
    padding: 0;
    margin: 0;
    background: white;
  }
  
  .fuel-receipt {
    box-shadow: none;
    page-break-inside: avoid;
  }
}
</style>

<div class="receipt-container">
  <!-- Actions en haut -->
  <div class="page-actions">
    <h1 class="page-title">Détail du plein</h1>
    <div class="actions-group">
      <button onclick="printReceipt()" class="btn-action btn-primary-action">
        🖨️ Imprimer
      </button>
      <a href="{{ path('admin_fuel_edit', {id: fill.id}) }}" class="btn-action btn-primary-action">
        ✏️ Modifier
      </a>
      <a href="{{ path('admin_fuel_index') }}" class="btn-action btn-secondary-action">
        ← Retour
      </a>
    </div>
  </div>

  <!-- Ticket de caisse -->
  <div class="fuel-receipt">
    <!-- Header avec logo -->
    <div class="receipt-header">
      <img src="{{ asset('assets/images/logo.png') }}" alt="ILD Security" class="company-logo">
      <div class="company-name">ILD SECURITY</div>
      <div class="company-subtitle">GESTION FLOTTE</div>
      <div class="receipt-title">Ticket de Carburant</div>
      <div class="receipt-number">#ILD_{{ "%05d"|format(fill.id) }}</div>
    </div>

    <!-- Corps du ticket -->
    <div class="receipt-body">
      <!-- Section véhicule -->
      <div class="vehicle-section">
        <div class="vehicle-info">
          <div class="vehicle-plate">{{ fill.vehicle.plate }}</div>
          {% if fill.vehicle.model %}
            <div class="vehicle-model">{{ fill.vehicle.model }}</div>
          {% endif %}
        </div>
        <div class="transaction-date">{{ fill.filledAt|date('d/m/Y à H:i') }}</div>
      </div>

      <!-- Détails du plein -->
      <div class="fuel-details">
        <div class="detail-row">
          <span class="detail-label">Odomètre</span>
          <span class="detail-value">{{ fill.odometer|number_format(0, ',', ' ') }} KM</span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Carburant</span>
          <span class="detail-value">{{ fill.liters|number_format(2, ',', ' ') }} L</span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Prix/Litre</span>
          <span class="detail-value">{{ fill.pricePerLitre|number_format(3, ',', ' ') }} €</span>
        </div>

        {% if fill.distanceKm is not null %}
          <div class="detail-row">
            <span class="detail-label">Distance</span>
            <span class="detail-value">{{ fill.distanceKm|number_format(0, ',', ' ') }} KM</span>
          </div>
        {% endif %}
      </div>

      <!-- Total -->
      <div class="total-section">
        <div class="total-row">
          <span class="total-label">TOTAL</span>
          <span class="total-value">{{ fill.totalPrice|number_format(2, ',', ' ') }} €</span>
        </div>
      </div>

      <!-- Notes si présentes -->
      {% if fill.notes %}
        <div class="notes-section">
          <div class="notes-label">Notes</div>
          <div class="notes-content">{{ fill.notes|nl2br }}</div>
        </div>
      {% endif %}
    </div>

    <!-- Footer -->
    <div class="receipt-footer">
      <div class="barcode-section">
        <div class="barcode"></div>
        <div class="barcode-number">{{ "%05d"|format(fill.id) }}</div>
      </div>
      
      <div class="footer-text">MERCI DE VOTRE CONFIANCE</div>
      <div class="footer-text">Document généré le {{ "now"|date('d/m/Y à H:i') }}</div>
      <div class="footer-text">ILD SECURITY - Gestion de flotte</div>
    </div>
  </div>
</div>

<script>
// Fonction d'impression spécifique au ticket
function printReceipt() {
  // Créer une nouvelle fenêtre pour l'impression
  const printWindow = window.open('', '_blank', 'width=600,height=800');
  
  // Récupérer le contenu du ticket
  const receiptContent = document.querySelector('.fuel-receipt').outerHTML;
  
  // Créer le HTML pour l'impression
  const printHTML = `
    <!DOCTYPE html>
    <html>
    <head>
      <title>Ticket de Carburant #ILD_{{ "%05d"|format(fill.id) }}</title>
      <style>
        /* Reset */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        /* Body */
        body {
          font-family: 'Courier New', monospace;
          background: white;
          padding: 20px;
          line-height: 1.4;
        }
        
        /* Container du ticket */
        .fuel-receipt {
          background: white;
          border-radius: 0;
          max-width: 400px;
          margin: 0 auto;
          position: relative;
        }
        
        /* Effet de papier perforé */
        .fuel-receipt::before {
          content: '';
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          height: 20px;
          background: 
            radial-gradient(circle at 10px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
            radial-gradient(circle at 30px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
            radial-gradient(circle at 50px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
            radial-gradient(circle at 70px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
            radial-gradient(circle at 90px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
            radial-gradient(circle at 110px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
            radial-gradient(circle at 130px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
            radial-gradient(circle at 150px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
            radial-gradient(circle at 170px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
            radial-gradient(circle at 190px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
            radial-gradient(circle at 210px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
            radial-gradient(circle at 230px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
            radial-gradient(circle at 250px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
            radial-gradient(circle at 270px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
            radial-gradient(circle at 290px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
            radial-gradient(circle at 310px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
            radial-gradient(circle at 330px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
            radial-gradient(circle at 350px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
            radial-gradient(circle at 370px 10px, transparent 3px, white 3px, white 7px, transparent 7px),
            radial-gradient(circle at 390px 10px, transparent 3px, white 3px, white 7px, transparent 7px);
          background-size: 20px 20px;
        }
        
        /* Header */
        .receipt-header {
          text-align: center;
          padding: 2rem 2rem 1.5rem;
          border-bottom: 2px dashed #e2e8f0;
          background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        }
        
        .company-logo {
          width: 60px;
          height: 60px;
          margin: 0 auto 1rem;
          display: block;
        }
        
        .company-name {
          font-size: 1.3rem;
          font-weight: 900;
          color: #2d3748;
          margin: 0.5rem 0;
          letter-spacing: 2px;
        }
        
        .company-subtitle {
          font-size: 0.8rem;
          color: #6b7280;
          font-weight: 600;
          margin: 0;
        }
        
        .receipt-title {
          font-size: 1rem;
          font-weight: 700;
          color: #1f2937;
          margin: 1rem 0 0.5rem;
          text-transform: uppercase;
          letter-spacing: 1px;
        }
        
        .receipt-number {
          font-size: 0.8rem;
          color: #6b7280;
          margin: 0;
        }
        
        /* Body */
        .receipt-body {
          padding: 1.5rem 2rem;
        }
        
        .vehicle-section {
          margin-bottom: 1.5rem;
          padding-bottom: 1rem;
          border-bottom: 1px dashed #d1d5db;
        }
        
        .vehicle-info {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 1rem;
          margin-bottom: 0.75rem;
        }
        
        .vehicle-plate {
          background: #1f2937;
          color: white;
          padding: 0.5rem 1rem;
          border-radius: 4px;
          font-weight: 900;
          font-size: 1rem;
          letter-spacing: 2px;
          font-family: monospace;
        }
        
        .vehicle-model {
          color: #4b5563;
          font-weight: 600;
          font-size: 0.9rem;
        }
        
        .transaction-date {
          text-align: center;
          font-size: 0.85rem;
          color: #6b7280;
          font-weight: 600;
        }
        
        .fuel-details {
          margin: 1.5rem 0;
        }
        
        .detail-row {
          display: flex;
          justify-content: space-between;
          align-items: center;
          padding: 0.6rem 0;
          border-bottom: 1px dotted #d1d5db;
          font-size: 0.9rem;
        }
        
        .detail-row:last-child {
          border-bottom: none;
        }
        
        .detail-label {
          color: #4b5563;
          font-weight: 600;
          text-transform: uppercase;
          font-size: 0.8rem;
          letter-spacing: 0.5px;
        }
        
        .detail-value {
          color: #1f2937;
          font-weight: 700;
          font-family: monospace;
          font-size: 0.9rem;
        }
        
        .total-section {
          margin: 1.5rem 0;
          padding: 1rem;
          background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
          border-radius: 8px;
          border: 2px solid #f59e0b;
        }
        
        .total-row {
          display: flex;
          justify-content: space-between;
          align-items: center;
          margin: 0;
        }
        
        .total-label {
          font-size: 1.1rem;
          font-weight: 900;
          color: #92400e;
          text-transform: uppercase;
          letter-spacing: 1px;
        }
        
        .total-value {
          font-size: 1.3rem;
          font-weight: 900;
          color: #92400e;
          font-family: monospace;
        }
        
        .notes-section {
          margin-top: 1.5rem;
          padding: 1rem;
          background: #f8fafc;
          border-radius: 8px;
          border-left: 4px solid #3b82f6;
        }
        
        .notes-label {
          font-size: 0.8rem;
          font-weight: 700;
          color: #1e40af;
          text-transform: uppercase;
          margin-bottom: 0.5rem;
          letter-spacing: 0.5px;
        }
        
        .notes-content {
          color: #374151;
          font-size: 0.85rem;
          line-height: 1.5;
          font-family: system-ui, sans-serif;
        }
        
        .receipt-footer {
          text-align: center;
          padding: 1.5rem 2rem 2rem;
          border-top: 2px dashed #e2e8f0;
          background: #f8fafc;
        }
        
        .footer-text {
          font-size: 0.75rem;
          color: #6b7280;
          margin: 0.25rem 0;
          line-height: 1.4;
        }
        
        .barcode-section {
          margin: 1rem 0;
          padding: 0.5rem;
          background: white;
          border-radius: 4px;
        }
        
        .barcode {
          height: 30px;
          background: repeating-linear-gradient(
            90deg,
            #000 0px,
            #000 2px,
            transparent 2px,
            transparent 4px,
            #000 4px,
            #000 5px,
            transparent 5px,
            transparent 8px,
            #000 8px,
            #000 9px,
            transparent 9px,
            transparent 11px
          );
          margin: 0.5rem 0;
        }
        
        .barcode-number {
          font-family: monospace;
          font-size: 0.7rem;
          color: #374151;
          text-align: center;
          letter-spacing: 2px;
        }
        
        /* Effet déchiré en bas */
        .fuel-receipt::after {
          content: '';
          position: absolute;
          bottom: 0;
          left: 0;
          right: 0;
          height: 15px;
          background: 
            linear-gradient(45deg, transparent 0%, transparent 45%, white 45%, white 55%, transparent 55%),
            linear-gradient(-45deg, transparent 0%, transparent 45%, white 45%, white 55%, transparent 55%);
          background-size: 20px 15px;
        }
        
        @page {
          margin: 0.5in;
          size: A4;
        }
        
        @media print {
          body {
            padding: 0;
          }
          .fuel-receipt {
            max-width: none;
            width: 100%;
          }
        }
      </style>
    </head>
    <body>
      ${receiptContent}
    </body>
    </html>
  `;
  
  // Écrire le contenu dans la fenêtre d'impression
  printWindow.document.write(printHTML);
  printWindow.document.close();
  
  // Attendre que le contenu soit chargé puis imprimer
  printWindow.onload = function() {
    printWindow.focus();
    printWindow.print();
    
    // Fermer la fenêtre après impression
    printWindow.onafterprint = function() {
      printWindow.close();
    };
  };
}

// Raccourci clavier Ctrl+P pour imprimer
document.addEventListener('keydown', function(e) {
  if (e.ctrlKey && e.key === 'p') {
    e.preventDefault();
    printReceipt();
  }
});
</script>
{% endblock %}