{% extends 'base.html.twig' %}
{% block title %}Interventions{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    /* ========== VARIABLES CSS ========== */
    :root {
      /* Couleurs principales */
      --primary-color: #4f46e5;
      --primary-hover: #3730a3;
      --primary-light: #e0e7ff;
      
      /* Couleurs secondaires */
      --secondary-color: #64748b;
      --success-color: #059669;
      --warning-color: #d97706;
      --danger-color: #dc2626;
      
      /* Couleurs de fond */
      --bg-primary: #ffffff;
      --bg-secondary: #f8fafc;
      --bg-tertiary: #f1f5f9;
      
      /* Couleurs de texte */
      --text-primary: #0f172a;
      --text-secondary: #475569;
      --text-muted: #94a3b8;
      
      /* Couleurs de bordure */
      --border-color: #e2e8f0;
      --border-light: #f1f5f9;
      
      /* Ombres */
      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
      --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
      
      /* Rayons */
      --radius-sm: 6px;
      --radius-md: 8px;
      --radius-lg: 12px;
      --radius-xl: 16px;
      
      /* Transitions */
      --transition-fast: all 0.15s ease;
      --transition-normal: all 0.25s ease;
      --transition-slow: all 0.35s ease;
      
      /* Espacements */
      --spacing-xs: 0.25rem;
      --spacing-sm: 0.5rem;
      --spacing-md: 1rem;
      --spacing-lg: 1.5rem;
      --spacing-xl: 2rem;
      --spacing-2xl: 3rem;
    }

    /* ========== RESET ET BASE ========== */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg-secondary);
      color: var(--text-primary);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* ========== CONTENEUR PRINCIPAL ========== */
    .container-fluid {
      max-width: 1400px;
      margin: 0 auto;
    }

    /* ========== HEADER DE LA PAGE ========== */
    .page-header {
      background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-tertiary) 100%);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-xl);
      padding: var(--spacing-lg);
      margin-bottom: var(--spacing-xl);
      box-shadow: var(--shadow-sm);
      position: relative;
      overflow: hidden;
    }

    .page-header::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--primary-color), #8b5cf6, #ec4899);
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    }

    .header-content {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-lg);
      align-items: stretch;
    }

    .header-info {
      flex: 1;
    }

    .page-title {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: var(--spacing-sm);
      display: flex;
      align-items: center;
      letter-spacing: -0.025em;
    }

    .title-icon {
      color: var(--primary-color);
      font-size: 1.5rem;
    }

    .page-subtitle {
      color: var(--text-secondary);
      font-size: 1rem;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
    }

    .counter-badge {
      background: var(--primary-light);
      color: var(--primary-color);
      padding: 0.25rem 0.75rem;
      border-radius: 50px;
      font-weight: 600;
      font-size: 0.875rem;
    }

    /* ========== BOUTON NOUVELLE INTERVENTION ========== */
    .btn-new-intervention {
      background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-hover) 100%);
      border: none;
      color: white;
      padding: var(--spacing-md) var(--spacing-lg);
      border-radius: var(--radius-md);
      font-weight: 600;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition-normal);
      box-shadow: var(--shadow-md);
      position: relative;
      overflow: hidden;
      white-space: nowrap;
    }

    .btn-new-intervention::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
      transition: left 0.6s;
    }

    .btn-new-intervention:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
      color: white;
      text-decoration: none;
    }

    .btn-new-intervention:hover::before {
      left: 100%;
    }

    .btn-text-mobile {
      display: inline;
    }

    .btn-text {
      display: none;
    }

    /* ========== FILTRES ET RECHERCHE ========== */
    .filters-container {
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: var(--spacing-lg);
      margin-bottom: var(--spacing-xl);
      box-shadow: var(--shadow-sm);
    }

    .search-box {
      position: relative;
      margin-bottom: var(--spacing-lg);
    }

    .search-icon {
      position: absolute;
      left: var(--spacing-md);
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      z-index: 2;
    }

    .search-input {
      width: 100%;
      padding: var(--spacing-md) var(--spacing-md) var(--spacing-md) 2.75rem;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-md);
      background: var(--bg-secondary);
      font-size: 1rem;
      transition: var(--transition-fast);
      color: #fff !important;
    }

    .search-input:focus {
      outline: none;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
      background: var(--bg-primary);
    }

    .filter-tabs {
      display: flex;
      gap: var(--spacing-sm);
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
    }

    .filter-actions {
      display: flex;
      gap: var(--spacing-xs);
      margin-left: auto;
    }

    .btn-filter-action {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-md);
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      color: var(--text-secondary);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: var(--transition-fast);
      font-size: 0.9rem;
    }

    .btn-filter-action:hover {
      background: var(--primary-color);
      border-color: var(--primary-color);
      color: white;
      transform: translateY(-1px);
    }

    .filter-tab {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      color: var(--text-secondary);
      padding: var(--spacing-sm) var(--spacing-md);
      border-radius: var(--radius-md);
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      transition: var(--transition-fast);
      display: flex;
      align-items: center;
      gap: var(--spacing-xs);
    }

    .filter-tab:hover {
      background: var(--bg-tertiary);
    }

    .filter-tab.active {
      background: var(--primary-color);
      color: white;
      border-color: var(--primary-color);
    }

    .tab-count {
      background: rgba(255, 255, 255, 0.2);
      padding: 0.125rem 0.5rem;
      border-radius: 50px;
      font-size: 0.75rem;
      font-weight: 600;
    }

    /* ========== ÉTAT VIDE ========== */
    .empty-state {
      background: var(--bg-primary);
      border: 2px dashed var(--border-color);
      border-radius: var(--radius-xl);
      padding: var(--spacing-2xl);
      text-align: center;
      margin-top: var(--spacing-xl);
    }

    .empty-state-content {
      max-width: 400px;
      margin: 0 auto;
    }

    .empty-state-icon {
      width: 80px;
      height: 80px;
      background: var(--bg-tertiary);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto var(--spacing-lg);
    }

    .empty-state-icon i {
      font-size: 2rem;
      color: var(--text-muted);
    }

    .empty-state-title {
      font-size: 1.5rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: var(--spacing-sm);
    }

    .empty-state-text {
      color: var(--text-secondary);
      font-size: 1rem;
      margin-bottom: var(--spacing-lg);
    }

    .btn-empty-action {
      background: var(--primary-color);
      color: white;
      padding: var(--spacing-md) var(--spacing-lg);
      border-radius: var(--radius-md);
      text-decoration: none;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      transition: var(--transition-normal);
      border: none;
      cursor: pointer;
    }

    .btn-empty-action:hover {
      background: var(--primary-hover);
      color: white;
      text-decoration: none;
      transform: translateY(-1px);
    }

    /* ========== TABLEAU DESKTOP (Caché par défaut) ========== */
    .desktop-table-container {
      display: none;
      background: var(--bg-primary);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border-color);
      overflow: hidden;
    }

    .table-wrapper {
      overflow-x: auto;
    }

    .interventions-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }

    .interventions-table thead {
      background: linear-gradient(135deg, var(--bg-tertiary) 0%, var(--bg-secondary) 100%);
    }

    .interventions-table thead th {
      padding: var(--spacing-lg) var(--spacing-md);
      font-weight: 600;
      color: var(--text-primary);
      border-bottom: 2px solid var(--border-color);
      text-align: left;
      white-space: nowrap;
    }

    .th-content {
      display: flex;
      align-items: center;
      gap: var(--spacing-xs);
      cursor: pointer;
    }

    .sortable:hover .sort-icon {
      opacity: 1;
    }

    .sort-icon {
      opacity: 0;
      transition: var(--transition-fast);
      font-size: 0.75rem;
    }

    .intervention-row {
      border-bottom: 1px solid var(--border-light);
      transition: var(--transition-fast);
    }

    .intervention-row:hover {
      background: var(--bg-secondary);
    }

    .interventions-table td {
      padding: var(--spacing-lg) var(--spacing-md);
      vertical-align: middle;
    }

    .client-info {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
    }

    .client-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--primary-color);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: 0.875rem;
    }

    .location-info {
      display: flex;
      align-items: center;
      gap: var(--spacing-xs);
    }

    .location-icon {
      color: var(--text-muted);
    }

    .date-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .date-relative {
      color: var(--text-muted);
      font-size: 0.75rem;
    }

    .type-badge {
      background: var(--bg-tertiary);
      color: var(--text-secondary);
      padding: 0.25rem 0.75rem;
      border-radius: var(--radius-sm);
      font-size: 0.8rem;
      font-weight: 500;
    }

    .action-buttons {
      display: flex;
      gap: var(--spacing-xs);
      justify-content: center;
    }

    .btn-action {
      width: 32px;
      height: 32px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--border-color);
      background: var(--bg-primary);
      color: var(--text-secondary);
      text-decoration: none;
      transition: var(--transition-fast);
      font-size: 0.875rem;
    }

    .btn-action:hover {
      text-decoration: none;
      transform: translateY(-1px);
    }

    .btn-view:hover {
      background: var(--primary-color);
      color: white;
      border-color: var(--primary-color);
    }

    .btn-edit:hover {
      background: var(--warning-color);
      color: white;
      border-color: var(--warning-color);
    }

    .btn-delete:hover {
      background: var(--danger-color);
      color: white;
      border-color: var(--danger-color);
    }

    /* ========== CARTES MOBILES (Visible par défaut) ========== */
    .mobile-cards-container {
      display: block;
      gap: var(--spacing-lg);
    }

    .intervention-card {
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
      transition: var(--transition-normal);
      margin-bottom: var(--spacing-lg);
      position: relative;
    }

    .intervention-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--primary-color), #8b5cf6);
    }

    .intervention-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
    }

    /* Header de carte */
    .card-header {
      padding: var(--spacing-lg);
      display: flex;
      align-items: center;
      gap: var(--spacing-md);
      border-bottom: 1px solid var(--border-light);
    }

    .card-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--primary-color), var(--primary-hover));
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 1.1rem;
      flex-shrink: 0;
    }

    .card-header-info {
      flex: 1;
      min-width: 0;
    }

    .card-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 0.25rem;
      line-height: 1.2;
    }

    .card-subtitle {
      color: var(--text-secondary);
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      font-weight: 500;
    }

    .card-status {
      display: flex;
      align-items: center;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--success-color);
      position: relative;
    }

    .status-dot::before {
      content: '';
      position: absolute;
      top: -2px;
      left: -2px;
      right: -2px;
      bottom: -2px;
      border: 2px solid var(--success-color);
      border-radius: 50%;
      opacity: 0.3;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); opacity: 0.3; }
      50% { transform: scale(1.5); opacity: 0.1; }
    }

    /* Corps de carte */
    .card-body {
      padding: var(--spacing-lg);
    }

    .card-details {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-md);
    }

    .detail-item {
      display: flex;
      align-items: flex-start;
      gap: var(--spacing-md);
    }

    .detail-item.detail-full {
      align-items: flex-start;
    }

    .detail-icon {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-sm);
      background: var(--bg-tertiary);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-secondary);
      flex-shrink: 0;
    }

    .detail-content {
      flex: 1;
      min-width: 0;
    }

    .detail-label {
      display: block;
      font-size: 0.8rem;
      color: var(--text-muted);
      font-weight: 500;
      margin-bottom: 0.25rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .detail-value {
      display: block;
      font-size: 0.95rem;
      color: var(--text-primary);
      font-weight: 500;
      line-height: 1.4;
    }

    .detail-description {
      line-height: 1.5;
      color: var(--text-secondary);
    }

    /* Actions de carte */
    .card-actions {
      padding: var(--spacing-md) var(--spacing-lg);
      background: var(--bg-secondary);
      border-top: 1px solid var(--border-light);
      display: flex;
      gap: var(--spacing-sm);
    }

    .btn-card-action {
      flex: 1;
      padding: var(--spacing-md);
      border-radius: var(--radius-md);
      font-weight: 600;
      font-size: 0.875rem;
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--spacing-xs);
      transition: var(--transition-normal);
      border: 1px solid;
      min-height: 44px;
      cursor: pointer;
    }

    .btn-card-action:hover {
      text-decoration: none;
      transform: translateY(-1px);
    }

    .btn-card-primary {
      background: var(--primary-color);
      border-color: var(--primary-color);
      color: white;
    }

    .btn-card-primary:hover {
      background: var(--primary-hover);
      border-color: var(--primary-hover);
      color: white;
      box-shadow: var(--shadow-md);
    }

    .btn-card-secondary {
      background: var(--bg-primary);
      border-color: var(--border-color);
      color: var(--text-secondary);
    }

    .btn-card-secondary:hover {
      background: var(--warning-color);
      border-color: var(--warning-color);
      color: white;
      box-shadow: var(--shadow-md);
    }

    .btn-card-danger {
      background: var(--bg-primary);
      border-color: var(--border-color);
      color: var(--text-secondary);
    }

    .btn-card-danger:hover {
      background: var(--danger-color);
      border-color: var(--danger-color);
      color: white;
      box-shadow: var(--shadow-md);
    }

    .btn-card-danger form {
      margin: 0;
      width: 100%;
      height: 100%;
    }

    .btn-card-danger button {
      background: none;
      border: none;
      color: inherit;
      font: inherit;
      cursor: inherit;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--spacing-xs);
    }

    /* ========== UTILITAIRES ========== */
    .hidden { display: none !important; }
    .search-focused { transform: scale(1.02); }
    .sorted { background-color: var(--primary-light); }
    .animate-in { animation: fadeInUp 0.5s ease-out; }

    .ripple {
      position: absolute;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.3);
      pointer-events: none;
      animation: ripple-animation 0.6s ease-out;
    }

    .text-truncate {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* ========== ANIMATIONS ========== */
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes slideInLeft {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes ripple-animation {
      0% { transform: scale(0); opacity: 1; }
      100% { transform: scale(1); opacity: 0; }
    }

    @keyframes fadeOut {
      0% { opacity: 1; transform: scale(1); }
      100% { opacity: 0; transform: scale(0.8); }
    }

    /* Animation des cartes */
    .intervention-card {
      animation: fadeInUp 0.5s ease-out;
    }

    .intervention-card:nth-child(2) { animation-delay: 0.1s; }
    .intervention-card:nth-child(3) { animation-delay: 0.2s; }
    .intervention-card:nth-child(4) { animation-delay: 0.3s; }
    .intervention-card:nth-child(5) { animation-delay: 0.4s; }

    /* Animation des lignes de tableau */
    .intervention-row {
      animation: slideInLeft 0.4s ease-out;
    }

    .intervention-row:nth-child(2) { animation-delay: 0.05s; }
    .intervention-row:nth-child(3) { animation-delay: 0.1s; }
    .intervention-row:nth-child(4) { animation-delay: 0.15s; }
    .intervention-row:nth-child(5) { animation-delay: 0.2s; }

    /* ========== RESPONSIVE - TABLET (768px+) ========== */
    @media (min-width: 768px) {
      /* Header */
      .header-content {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
      }

      .page-title {
        font-size: 2rem;
      }

      .btn-text-mobile {
        display: none;
      }

      .btn-text {
        display: inline;
      }

      /* Filtres */
      .filters-container {
        padding: var(--spacing-xl);
      }

      /* Tableau visible, cartes cachées */
      .desktop-table-container {
        display: block;
      }

      .mobile-cards-container {
        display: none;
      }

      /* Actions de table en ligne */
      .action-buttons {
        justify-content: flex-end;
      }
    }

    /* ========== RESPONSIVE - LARGE DESKTOP (1024px+) ========== */
    @media (min-width: 1024px) {
      .page-header {
        padding: var(--spacing-xl);
      }

      .page-title {
        font-size: 2.25rem;
      }

      .filters-container {
        display: flex;
        align-items: center;
        gap: var(--spacing-xl);
        padding: var(--spacing-lg) var(--spacing-xl);
      }

      .search-box {
        flex: 1;
        margin-bottom: 0;
        max-width: 400px;
      }

      .filter-tabs {
        flex-shrink: 0;
      }

      .interventions-table {
        font-size: 1rem;
      }

      .interventions-table td,
      .interventions-table th {
        padding: var(--spacing-lg);
      }
    }

    /* ========== RESPONSIVE - MOBILE SMALL (480px-) ========== */
    @media (max-width: 480px) {
      .page-header {
        padding: var(--spacing-md);
      }

      .page-title {
        font-size: 1.5rem;
      }

      .filters-container {
        padding: var(--spacing-md);
      }

      .card-header {
        padding: var(--spacing-md);
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: var(--spacing-sm);
      }

      .card-body {
        padding: var(--spacing-md);
      }

      .card-actions {
        padding: var(--spacing-sm);
        flex-direction: column;
      }

      .btn-card-action {
        width: 100%;
      }

      .detail-item {
        gap: var(--spacing-sm);
      }

      .detail-icon {
        width: 32px;
        height: 32px;
      }

      .filter-actions {
        margin-top: var(--spacing-sm);
        margin-left: 0;
      }
    }

    /* ========== FOCUS ET ACCESSIBILITÉ ========== */
    .btn-new-intervention:focus,
    .btn-card-action:focus,
    .btn-action:focus,
    .filter-tab:focus,
    .search-input:focus {
      outline: 2px solid var(--primary-color);
      outline-offset: 2px;
    }

    /* États de focus améliorés */
    .intervention-card:focus-within {
      box-shadow: var(--shadow-lg);
      outline: 2px solid var(--primary-color);
      outline-offset: 2px;
    }

    /* ========== DARK MODE SUPPORT (optionnel) ========== */
    @media (prefers-color-scheme: dark) {
      :root {
        --bg-primary: #1e293b;
        --bg-secondary: #0f172a;
        --bg-tertiary: #334155;
        --text-primary: #f1f5f9;
        --text-secondary: #cbd5e1;
        --text-muted: #64748b;
        --border-color: #334155;
        --border-light: #475569;
      }
    }

    /* ========== PRINT STYLES ========== */
    @media print {
      .card-actions,
      .btn-new-intervention,
      .filters-container {
        display: none !important;
      }

      .intervention-card {
        break-inside: avoid;
        box-shadow: none;
        border: 1px solid #000;
      }

      .page-header::before {
        display: none;
      }
    }
  </style>
{% endblock %}

{% block body %}
<div class="container-fluid px-3 px-md-4 py-3">

  {# ========== HEADER MODERNE ========== #}
  <div class="page-header">
    <div class="header-content">
      <div class="header-info">
        <h1 class="page-title">
          <i class="bi bi-tools me-3 title-icon"></i>
          Interventions
        </h1>
        <p class="page-subtitle">
          <span class="counter-badge" id="intervention-counter">{{ interventions|length }}</span>
          intervention{{ interventions|length > 1 ? 's' : '' }} enregistrée{{ interventions|length > 1 ? 's' : '' }}
        </p>
      </div>
      <div class="header-actions">
        <a href="{{ path('app_intervention_new') }}" class="btn-new-intervention">
          <i class="bi bi-plus-circle-fill me-2"></i>
          <span class="btn-text">Nouvelle Intervention</span>
          <span class="btn-text-mobile">Ajouter</span>
        </a>
      </div>
    </div>
  </div>

  {# ========== FILTRES ET RECHERCHE (Mobile First) ========== #}
  <div class="filters-container">
    <div class="search-box">
      <i class="bi bi-search search-icon"></i>
      <input type="text" class="form-control search-input" placeholder="Rechercher par client, ville, n° bon..." 
             aria-label="Rechercher des interventions" id="search-input">
    </div>
    <div class="filter-tabs">
      <button class="filter-tab active" data-filter="all" aria-pressed="true" id="filter-all">
        Toutes <span class="tab-count">{{ interventions|length }}</span>
      </button>
      <button class="filter-tab" data-filter="recent" aria-pressed="false" id="filter-recent">
        Récentes <span class="tab-count">0</span>
      </button>
      <div class="filter-actions">
        <button class="btn-filter-action" onclick="exportInterventions()" title="Exporter en CSV">
          <i class="bi bi-download"></i>
        </button>
        <button class="btn-filter-action" onclick="printInterventions()" title="Imprimer">
          <i class="bi bi-printer"></i>
        </button>
        <button class="btn-filter-action" onclick="refreshInterventions()" title="Actualiser">
          <i class="bi bi-arrow-clockwise"></i>
        </button>
      </div>
    </div>
  </div>

  {% if interventions is empty %}
    {# ========== ÉTAT VIDE ========== #}
    <div class="empty-state">
      <div class="empty-state-content">
        <div class="empty-state-icon">
          <i class="bi bi-tools"></i>
        </div>
        <h3 class="empty-state-title">Aucune intervention trouvée</h3>
        <p class="empty-state-text">Commencez par ajouter votre première intervention pour voir la liste ici</p>
        <a href="{{ path('app_intervention_new') }}" class="btn-empty-action">
          <i class="bi bi-plus-lg me-2"></i>
          Créer ma première intervention
        </a>
      </div>
    </div>
  {% else %}

    {# ========== TABLEAU DESKTOP (768px+) ========== #}
    <div class="desktop-table-container">
      <div class="table-wrapper">
        <table class="interventions-table">
          <thead>
            <tr>
              <th class="sortable" data-sort="bonNumero">
                <span class="th-content">
                  <i class="bi bi-hash me-2"></i>N° Bon
                  <i class="bi bi-chevron-up sort-icon"></i>
                </span>
              </th>
              <th class="sortable" data-sort="client">
                <span class="th-content">
                  <i class="bi bi-person me-2"></i>Client
                  <i class="bi bi-chevron-up sort-icon"></i>
                </span>
              </th>
              <th class="sortable" data-sort="ville">
                <span class="th-content">
                  <i class="bi bi-geo-alt me-2"></i>Ville
                  <i class="bi bi-chevron-up sort-icon"></i>
                </span>
              </th>
              <th class="sortable" data-sort="date">
                <span class="th-content">
                  <i class="bi bi-calendar me-2"></i>Date
                  <i class="bi bi-chevron-up sort-icon"></i>
                </span>
              </th>
              <th>
                <span class="th-content">
                  <i class="bi bi-file-text me-2"></i>Type
                </span>
              </th>
              <th class="actions-column">
                <span class="th-content">
                  <i class="bi bi-gear me-2"></i>Actions
                </span>
              </th>
            </tr>
          </thead>
          <tbody id="table-body">
            {% for intervention in interventions %}
              <tr class="intervention-row" data-intervention-id="{{ intervention.id }}" 
                  data-bon-numero="{{ intervention.bonNumero }}"
                  data-client="{{ intervention.client }}"
                  data-ville="{{ intervention.ville }}"
                  data-date="{{ intervention.dateBon ? intervention.dateBon|date('Y-m-d') : '' }}"
                  data-type="{{ intervention.compteRendu }}">
                <td class="bon-numero">
                  <span class="cell-value">{{ intervention.bonNumero }}</span>
                </td>
                <td class="client-name">
                  <div class="client-info">
                    <div class="client-avatar">
                      {{ intervention.client|first|upper }}
                    </div>
                    <span class="cell-value">{{ intervention.client }}</span>
                  </div>
                </td>
                <td class="ville">
                  <div class="location-info">
                    <i class="bi bi-geo-alt-fill location-icon"></i>
                    <span class="cell-value">{{ intervention.ville }}</span>
                  </div>
                </td>
                <td class="date-intervention">
                  <div class="date-info">
                    <span class="cell-value">{{ intervention.dateBon ? intervention.dateBon|date('d/m/Y') : 'Non définie' }}</span>
                    {% if intervention.dateBon %}
                      <small class="date-relative">{{ intervention.dateBon|date('D') }}</small>
                    {% endif %}
                  </div>
                </td>
                <td class="type-intervention">
                  <span class="type-badge">
                    {{ intervention.compteRendu|length > 20 ? intervention.compteRendu|slice(0, 20) ~ '...' : intervention.compteRendu }}
                  </span>
                </td>
                <td class="actions-cell">
                  <div class="action-buttons">
                    <a href="{{ path('app_intervention_show', {id: intervention.id}) }}" 
                       class="btn-action btn-view" 
                       data-bs-toggle="tooltip" 
                       title="Voir les détails">
                      <i class="bi bi-eye"></i>
                    </a>
                    <a href="{{ path('app_intervention_edit', {id: intervention.id}) }}" 
                       class="btn-action btn-edit"
                       data-bs-toggle="tooltip" 
                       title="Modifier">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <div class="btn-action btn-delete" onclick="return confirmDelete('{{ intervention.id }}', '{{ intervention.bonNumero }}')">
                      <i class="bi bi-trash"></i>
                    </div>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    {# ========== CARTES MOBILES (767px-) ========== #}
    <div class="mobile-cards-container" id="cards-container">
      {% for intervention in interventions %}
        <div class="intervention-card" data-intervention-id="{{ intervention.id }}"
             data-bon-numero="{{ intervention.bonNumero }}"
             data-client="{{ intervention.client }}"
             data-ville="{{ intervention.ville }}"
             data-date="{{ intervention.dateBon ? intervention.dateBon|date('Y-m-d') : '' }}"
             data-type="{{ intervention.compteRendu }}">
          
          {# Header de la carte #}
          <div class="card-header">
            <div class="card-avatar">
              {{ intervention.client|first|upper }}
            </div>
            <div class="card-header-info">
              <h3 class="card-title">{{ intervention.bonNumero }}</h3>
              <div class="card-subtitle">
                <i class="bi bi-person me-1"></i>
                {{ intervention.client }}
              </div>
            </div>
            <div class="card-status">
              <div class="status-dot status-active"></div>
            </div>
          </div>

          {# Contenu de la carte #}
          <div class="card-body">
            <div class="card-details">
              <div class="detail-item">
                <div class="detail-icon">
                  <i class="bi bi-geo-alt-fill"></i>
                </div>
                <div class="detail-content">
                  <span class="detail-label">Ville</span>
                  <span class="detail-value">{{ intervention.ville }}</span>
                </div>
              </div>

              <div class="detail-item">
                <div class="detail-icon">
                  <i class="bi bi-calendar3"></i>
                </div>
                <div class="detail-content">
                  <span class="detail-label">Date</span>
                  <span class="detail-value">
                    {{ intervention.dateBon ? intervention.dateBon|date('d/m/Y') : 'Non définie' }}
                  </span>
                </div>
              </div>

              <div class="detail-item detail-full">
                <div class="detail-icon">
                  <i class="bi bi-file-text"></i>
                </div>
                <div class="detail-content">
                  <span class="detail-label">Type d'intervention</span>
                  <span class="detail-value detail-description">
                    {{ intervention.compteRendu }}
                  </span>
                </div>
              </div>
            </div>
          </div>

          {# Actions de la carte #}
          <div class="card-actions">
            <a href="{{ path('app_intervention_show', {id: intervention.id}) }}" class="btn-card-action btn-card-primary">
              <i class="bi bi-eye me-2"></i>
              <span>Voir</span>
            </a>
            <a href="{{ path('app_intervention_edit', {id: intervention.id}) }}" class="btn-card-action btn-card-secondary">
              <i class="bi bi-pencil me-2"></i>
              <span>Modifier</span>
            </a>
            <button class="btn-card-action btn-card-danger" onclick="return confirmDelete('{{ intervention.id }}', '{{ intervention.bonNumero }}')">
              <i class="bi bi-trash me-2"></i>
              <span>Supprimer</span>
            </button>
          </div>
        </div>
      {% endfor %}
    </div>

  {% endif %}

</div>

<script>
// ========== GESTION DES INTERVENTIONS - JAVASCRIPT ========== //

document.addEventListener('DOMContentLoaded', function() {
    
    // ========== VARIABLES GLOBALES ========== //
    const searchInput = document.getElementById('search-input');
    const filterTabs = document.querySelectorAll('.filter-tab');
    const interventionCards = document.querySelectorAll('.intervention-card');
    const interventionRows = document.querySelectorAll('.intervention-row');
    const sortableHeaders = document.querySelectorAll('.sortable');
    const counter = document.getElementById('intervention-counter');
    
    let currentFilter = 'all';
    let currentSort = { column: 'bonNumero', direction: 'asc' };
    let interventions = [];

    // ========== INITIALISATION ========== //
    function init() {
        loadInterventions();
        initSearchFunctionality();
        initFilterTabs();
        initSortFunctionality();
        initAnimations();
        updateCounters();
        
        console.log('✅ Gestionnaire d\'interventions initialisé');
    }

    // ========== CHARGEMENT DES DONNÉES ========== //
    function loadInterventions() {
        // Charger depuis les cartes mobiles
        interventions = Array.from(interventionCards).map(card => {
            return {
                id: card.dataset.interventionId,
                bonNumero: card.dataset.bonNumero,
                client: card.dataset.client,
                ville: card.dataset.ville,
                date: card.dataset.date,
                type: card.dataset.type,
                cardElement: card,
                rowElement: document.querySelector(`[data-intervention-id="${card.dataset.interventionId}"].intervention-row`)
            };
        });

        // Si pas de cartes, charger depuis les lignes de tableau
        if (interventions.length === 0) {
            interventions = Array.from(interventionRows).map(row => {
                return {
                    id: row.dataset.interventionId,
                    bonNumero: row.dataset.bonNumero,
                    client: row.dataset.client,
                    ville: row.dataset.ville,
                    date: row.dataset.date,
                    type: row.dataset.type,
                    rowElement: row,
                    cardElement: null
                };
            });
        }
    }

    // ========== FONCTIONNALITÉ DE RECHERCHE ========== //
    function initSearchFunctionality() {
        if (!searchInput) return;

        let searchTimeout;
        
        searchInput.addEventListener('input', function(e) {
            clearTimeout(searchTimeout);
            
            searchTimeout = setTimeout(() => {
                const query = e.target.value.toLowerCase().trim();
                filterInterventions(query);
            }, 300);
        });

        searchInput.addEventListener('focus', function() {
            this.parentElement.classList.add('search-focused');
        });

        searchInput.addEventListener('blur', function() {
            this.parentElement.classList.remove('search-focused');
        });
    }

    function filterInterventions(query) {
        let visibleCount = 0;
        
        interventions.forEach(intervention => {
            const searchText = [
                intervention.bonNumero,
                intervention.client,
                intervention.ville,
                intervention.type
            ].join(' ').toLowerCase();

            const matches = query === '' || searchText.includes(query);
            const passesFilter = matchesCurrentFilter(intervention);
            const shouldShow = matches && passesFilter;
            
            if (shouldShow) {
                showIntervention(intervention);
                visibleCount++;
            } else {
                hideIntervention(intervention);
            }
        });

        updateCounters();
        showNoResultsMessage(visibleCount === 0 && interventions.length > 0);
    }

    function showIntervention(intervention) {
        if (intervention.cardElement) {
            intervention.cardElement.classList.remove('hidden');
            intervention.cardElement.style.animation = 'fadeInUp 0.3s ease-out';
        }
        if (intervention.rowElement) {
            intervention.rowElement.classList.remove('hidden');
            intervention.rowElement.style.animation = 'slideInLeft 0.3s ease-out';
        }
    }

    function hideIntervention(intervention) {
        if (intervention.cardElement) {
            intervention.cardElement.classList.add('hidden');
        }
        if (intervention.rowElement) {
            intervention.rowElement.classList.add('hidden');
        }
    }

    // ========== FILTRES PAR ONGLETS ========== //
    function initFilterTabs() {
        filterTabs.forEach(tab => {
            tab.addEventListener('click', function() {
                filterTabs.forEach(t => {
                    t.classList.remove('active');
                    t.setAttribute('aria-pressed', 'false');
                });
                
                this.classList.add('active');
                this.setAttribute('aria-pressed', 'true');
                
                currentFilter = this.dataset.filter;
                applyCurrentFilter();
                
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = 'scale(1)';
                }, 150);
            });
        });
    }

    function applyCurrentFilter() {
        const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
        filterInterventions(query);
    }

    function matchesCurrentFilter(intervention) {
        if (currentFilter === 'all') return true;
        
        if (currentFilter === 'recent') {
            if (!intervention.date) return false;
            const date = new Date(intervention.date);
            const now = new Date();
            const diffTime = Math.abs(now - date);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            return diffDays <= 30;
        }
        
        return true;
    }

    // ========== TRI DES COLONNES ========== //
    function initSortFunctionality() {
        sortableHeaders.forEach(header => {
            header.addEventListener('click', function() {
                const column = this.dataset.sort;
                
                if (currentSort.column === column) {
                    currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
                } else {
                    currentSort.column = column;
                    currentSort.direction = 'asc';
                }
                
                updateSortIcons();
                sortInterventions();
            });
        });
    }

    function updateSortIcons() {
        sortableHeaders.forEach(header => {
            const icon = header.querySelector('.sort-icon');
            const column = header.dataset.sort;
            
            if (column === currentSort.column) {
                icon.classList.remove('bi-chevron-up', 'bi-chevron-down');
                icon.classList.add(currentSort.direction === 'asc' ? 'bi-chevron-up' : 'bi-chevron-down');
                icon.style.opacity = '1';
                header.classList.add('sorted');
            } else {
                icon.classList.remove('bi-chevron-up', 'bi-chevron-down');
                icon.classList.add('bi-chevron-up');
                icon.style.opacity = '0';
                header.classList.remove('sorted');
            }
        });
    }

    function sortInterventions() {
        interventions.sort((a, b) => {
            let aValue = a[currentSort.column] || '';
            let bValue = b[currentSort.column] || '';
            
            if (currentSort.column === 'date') {
                aValue = new Date(aValue || '1900-01-01');
                bValue = new Date(bValue || '1900-01-01');
            }
            
            if (currentSort.direction === 'asc') {
                return aValue > bValue ? 1 : -1;
            } else {
                return aValue < bValue ? 1 : -1;
            }
        });
        
        // Réorganiser les éléments dans le DOM
        const cardContainer = document.getElementById('cards-container');
        const tableBody = document.getElementById('table-body');
        
        interventions.forEach((intervention, index) => {
            if (intervention.cardElement && cardContainer) {
                cardContainer.appendChild(intervention.cardElement);
            }
            if (intervention.rowElement && tableBody) {
                tableBody.appendChild(intervention.rowElement);
            }
            
            setTimeout(() => {
                if (intervention.cardElement) {
                    intervention.cardElement.style.animation = 'fadeInUp 0.2s ease-out';
                }
                if (intervention.rowElement) {
                    intervention.rowElement.style.animation = 'slideInLeft 0.2s ease-out';
                }
            }, index * 30);
        });
    }

    // ========== MESSAGE AUCUN RÉSULTAT ========== //
    function showNoResultsMessage(show) {
        const existingMessage = document.querySelector('.no-results-message');
        if (existingMessage) {
            existingMessage.remove();
        }
        
        if (show) {
            const container = document.getElementById('cards-container') || 
                             document.querySelector('.desktop-table-container');
            
            if (container) {
                const message = document.createElement('div');
                message.className = 'no-results-message';
                message.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-state-content">
                            <div class="empty-state-icon">
                                <i class="bi bi-search"></i>
                            </div>
                            <h3 class="empty-state-title">Aucun résultat trouvé</h3>
                            <p class="empty-state-text">Essayez de modifier vos critères de recherche</p>
                            <button class="btn-empty-action" onclick="clearSearch()">
                                <i class="bi bi-x-lg me-2"></i>
                                Effacer la recherche
                            </button>
                        </div>
                    </div>
                `;
                container.appendChild(message);
            }
        }
    }

    // ========== ANIMATIONS ========== //
    function initAnimations() {
        document.querySelectorAll('.btn-card-action, .btn-new-intervention').forEach(btn => {
            btn.addEventListener('click', function(e) {
                const ripple = document.createElement('span');
                ripple.className = 'ripple';
                
                const rect = this.getBoundingClientRect();
                const size = Math.max(rect.width, rect.height);
                ripple.style.width = ripple.style.height = size + 'px';
                ripple.style.left = (e.clientX - rect.left - size / 2) + 'px';
                ripple.style.top = (e.clientY - rect.top - size / 2) + 'px';
                
                this.appendChild(ripple);
                
                setTimeout(() => {
                    ripple.remove();
                }, 600);
            });
        });
    }

    // ========== MISE À JOUR DES COMPTEURS ========== //
    function updateCounters() {
        const visibleCount = interventions.filter(i => 
            (i.cardElement && !i.cardElement.classList.contains('hidden')) ||
            (i.rowElement && !i.rowElement.classList.contains('hidden'))
        ).length;
        
        // Compteur principal
        if (counter) {
            counter.textContent = visibleCount;
        }
        
        // Compteurs des onglets
        const recentCount = interventions.filter(intervention => {
            if (!intervention.date) return false;
            const date = new Date(intervention.date);
            const now = new Date();
            const diffTime = Math.abs(now - date);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            return diffDays <= 30;
        }).length;
        
        const allTab = document.getElementById('filter-all');
        const recentTab = document.getElementById('filter-recent');
        
        if (allTab) {
            allTab.querySelector('.tab-count').textContent = interventions.length;
        }
        if (recentTab) {
            recentTab.querySelector('.tab-count').textContent = recentCount;
        }
    }

    // ========== RACCOURCIS CLAVIER ========== //
    document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
            e.preventDefault();
            if (searchInput) {
                searchInput.focus();
                searchInput.select();
            }
        }
        
        if (e.key === 'Escape') {
            if (searchInput && document.activeElement === searchInput) {
                searchInput.blur();
                if (searchInput.value) {
                    clearSearch();
                }
            }
        }
        
        if ((e.ctrlKey || e.metaKey) && e.key === 'e') {
            e.preventDefault();
            exportInterventions();
        }
        
        if ((e.ctrlKey || e.metaKey) && e.key === 'p') {
            e.preventDefault();
            printInterventions();
        }
    });

    // ========== INITIALISATION ========== //
    init();
    
});

// ========== FONCTIONS GLOBALES ========== //

function clearSearch() {
    const searchInput = document.getElementById('search-input');
    if (searchInput) {
        searchInput.value = '';
        searchInput.dispatchEvent(new Event('input'));
    }
    
    const allTab = document.getElementById('filter-all');
    if (allTab && !allTab.classList.contains('active')) {
        allTab.click();
    }
}

function exportInterventions() {
    const visibleInterventions = Array.from(document.querySelectorAll('.intervention-card:not(.hidden), .intervention-row:not(.hidden)'));
    
    if (visibleInterventions.length === 0) {
        alert('Aucune intervention à exporter');
        return;
    }
    
    const headers = ['Numéro de bon', 'Client', 'Ville', 'Date', 'Type'];
    const csvContent = [
        headers.join(','),
        ...visibleInterventions.map(el => {
            const data = [
                el.dataset.bonNumero || '',
                el.dataset.client || '',
                el.dataset.ville || '',
                el.dataset.date || '',
                el.dataset.type || ''
            ];
            
            return data.map(field => 
                `"${field.replace(/"/g, '""')}"`
            ).join(',');
        })
    ].join('\n');
    
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = `interventions_${new Date().toISOString().split('T')[0]}.csv`;
    link.click();
    
    console.log('✅ Export CSV généré avec succès');
}

function printInterventions() {
    const visibleInterventions = Array.from(document.querySelectorAll('.intervention-card:not(.hidden), .intervention-row:not(.hidden)'));
    
    if (visibleInterventions.length === 0) {
        alert('Aucune intervention à imprimer');
        return;
    }
    
    const printWindow = window.open('', '_blank');
    const printContent = `
        <!DOCTYPE html>
        <html>
        <head>
            <title>Liste des Interventions</title>
            <meta charset="UTF-8">
            <style>
                body { font-family: Arial, sans-serif; margin: 20px; }
                h1 { color: #4f46e5; border-bottom: 2px solid #4f46e5; padding-bottom: 10px; }
                .intervention { margin-bottom: 20px; padding: 15px; border: 1px solid #ddd; border-radius: 8px; }
                .intervention h3 { margin: 0 0 10px 0; color: #333; }
                .intervention p { margin: 5px 0; }
                .meta { color: #666; font-size: 0.9em; }
                @media print { body { margin: 0; } }
            </style>
        </head>
        <body>
            <h1>Liste des Interventions</h1>
            <p class="meta">Généré le ${new Date().toLocaleDateString('fr-FR')} à ${new Date().toLocaleTimeString('fr-FR')}</p>
            <p class="meta">${visibleInterventions.length} intervention(s)</p>
            <hr>
            ${visibleInterventions.map(el => {
                return `
                    <div class="intervention">
                        <h3>${el.dataset.bonNumero}</h3>
                        <p><strong>Client:</strong> ${el.dataset.client}</p>
                        <p><strong>Ville:</strong> ${el.dataset.ville}</p>
                        <p><strong>Date:</strong> ${el.dataset.date || 'Non définie'}</p>
                        <p><strong>Type:</strong> ${el.dataset.type}</p>
                    </div>
                `;
            }).join('')}
        </body>
        </html>
    `;
    
    printWindow.document.write(printContent);
    printWindow.document.close();
    printWindow.print();
    
    console.log('✅ Version imprimable générée');
}

function refreshInterventions() {
    const container = document.getElementById('cards-container') || 
                     document.querySelector('.desktop-table-container');
    
    if (container) {
        container.style.opacity = '0.5';
        container.style.transition = 'opacity 0.3s ease';
        
        setTimeout(() => {
            location.reload();
        }, 500);
    }
    
    console.log('🔄 Actualisation des interventions...');
}

function confirmDelete(interventionId, interventionTitle) {
    if (confirm(`Êtes-vous sûr de vouloir supprimer l'intervention "${interventionTitle}" ?\n\nCette action est irréversible.`)) {
        console.log(`🗑️ Suppression de l'intervention ${interventionId}`);
        
        // Animation de suppression
        const cardElement = document.querySelector(`[data-intervention-id="${interventionId}"].intervention-card`);
        const rowElement = document.querySelector(`[data-intervention-id="${interventionId}"].intervention-row`);
        
        if (cardElement) {
            cardElement.style.animation = 'fadeOut 0.3s ease-out';
            setTimeout(() => {
                cardElement.remove();
            }, 300);
        }
        
        if (rowElement) {
            rowElement.style.animation = 'fadeOut 0.3s ease-out';
            setTimeout(() => {
                rowElement.remove();
            }, 300);
        }
        
        // Ici vous pourriez faire un appel AJAX réel pour supprimer du serveur
        // fetch(`/intervention/${interventionId}`, { method: 'DELETE' })
        //     .then(() => console.log('Supprimé du serveur'));
        
        return true;
    }
    return false;
}

function formatDate(dateString) {
    if (!dateString) return 'Non définie';
    
    const date = new Date(dateString);
    const now = new Date();
    const diffTime = Math.abs(now - date);
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
    
    if (diffDays === 0) return 'Aujourd\'hui';
    if (diffDays === 1) return 'Hier';
    if (diffDays < 7) return `Il y a ${diffDays} jours`;
    if (diffDays < 30) return `Il y a ${Math.ceil(diffDays / 7)} semaines`;
    
    return date.toLocaleDateString('fr-FR');
}

// Fonction pour statistiques (bonus)
function getInterventionStats() {
    const cards = document.querySelectorAll('.intervention-card:not(.hidden)');
    const total = cards.length;
    
    if (total === 0) return console.log('📊 Aucune intervention visible');
    
    const stats = {
        total,
        parVille: {},
        parMois: {},
        recent: 0
    };
    
    cards.forEach(card => {
        // Par ville
        const ville = card.dataset.ville;
        if (ville) {
            stats.parVille[ville] = (stats.parVille[ville] || 0) + 1;
        }
        
        // Par mois
        const dateStr = card.dataset.date;
        if (dateStr) {
            const date = new Date(dateStr);
            const mois = date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long' });
            stats.parMois[mois] = (stats.parMois[mois] || 0) + 1;
            
            // Compteur récent (30 jours)
            const diffTime = Math.abs(new Date() - date);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            if (diffDays <= 30) stats.recent++;
        }
    });
    
    console.log('📊 Statistiques des interventions:', stats);
    return stats;
}

// Message d'information sur les raccourcis (affiché une seule fois)
if (!localStorage.getItem('keyboardShortcutsShown')) {
    setTimeout(() => {
        console.log(`
🎯 Raccourcis clavier disponibles:
• Ctrl/⌘ + K : Focus sur la recherche
• Échap : Effacer la recherche
• Ctrl/⌘ + E : Exporter en CSV
• Ctrl/⌘ + P : Imprimer la liste
        `);
        localStorage.setItem('keyboardShortcutsShown', 'true');
    }, 2000);
}

console.log('✅ Toutes les fonctionnalités JavaScript sont chargées et prêtes !');

</script>
{% endblock %}