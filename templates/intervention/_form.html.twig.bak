{# ====================== FORMULAIRE BON D'INTERVENTION ====================== #}

<style>
/* ---- Variables CSS ---- */
.boi {
    --primary: #1e40af;
    --primary-light: #3b82f6;
    --secondary: #64748b;
    --success: #059669;
    --danger: #dc2626;
    --warning: #d97706;
    --dark: #1e293b;
    --light: #f8fafc;
    --gray-50: #f9fafb;
    --gray-100: #f3f4f6;
    --gray-200: #e5e7eb;
    --gray-300: #d1d5db;
    --gray-400: #9ca3af;
    --gray-500: #6b7280;
    --gray-600: #4b5563;
    --gray-700: #374151;
    --gray-800: #1f2937;
    --gray-900: #111827;
    --border-radius: 12px;
    --border-radius-sm: 8px;
    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
    --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
}

/* ---- Conteneur principal ---- */
.boi {
    max-width: 1200px;
    margin: 2rem auto;
    padding: 0 1rem;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    line-height: 1.5;
    color: var(--gray-900);
}

/* ---- Feuille principale ---- */
.boi .sheet {
    background: white;
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    border: 1px solid var(--gray-200);
}

/* ---- En-tête ---- */
.boi .band {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    color: white;
    padding: 1.5rem 2rem;
    text-align: center;
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    position: relative;
    overflow: hidden;
}

.boi .band::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.1'%3E%3Ccircle cx='30' cy='30' r='2'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    opacity: 0.3;
}

.boi .band > * {
    position: relative;
    z-index: 1;
}

/* ---- Zones de tampons ---- */
.boi .stamps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    padding: 1.5rem 2rem;
    background: var(--gray-50);
    border-bottom: 1px solid var(--gray-200);
}

.boi .stamp {
    height: 120px;
    border: 2px dashed var(--gray-300);
    border-radius: var(--border-radius-sm);
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gray-400);
    font-weight: 500;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    position: relative;
    transition: all 0.2s ease;
}

.boi .stamp::before {
    content: 'TAMPON';
    opacity: 0.7;
}

.boi .stamp:hover {
    border-color: var(--primary);
    background: var(--light);
}

/* ---- Informations client ---- */
.boi .line {
    display: grid;
    grid-template-columns: 1.5fr 1.5fr 1fr;
    gap: 2rem;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--gray-200);
    background: white;
}

.boi .field .lbl {
    font-size: 0.75rem;
    color: var(--primary);
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
}

.boi .field .under {
    border-bottom: 2px solid var(--primary);
    padding-bottom: 0.5rem;
    min-height: 1.5rem;
    display: flex;
    align-items: end;
}

.boi .field input {
    border: none !important;
    background: transparent !important;
    padding: 0 !important;
    font-weight: 600;
    font-size: 1rem;
    color: var(--gray-800);
    width: 100%;
}

/* ---- Section veille ---- */
.boi .tick-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    padding: 1.5rem 2rem;
    background: var(--light);
    border-bottom: 1px solid var(--gray-200);
}

.boi .tick {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--gray-700);
    padding: 0.75rem;
    background: white;
    border-radius: var(--border-radius-sm);
    border: 1px solid var(--gray-200);
    transition: all 0.2s ease;
    cursor: pointer;
}

.boi .tick:hover {
    background: var(--gray-50);
    border-color: var(--primary);
}

/* ---- Checkbox personnalisées carrées ---- */
.boi .tick input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    width: 1.25rem;
    height: 1.25rem;
    border: 2px solid var(--gray-300);
    border-radius: 0.25rem;
    background: white;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
    flex-shrink: 0;
}

.boi .tick input[type="checkbox"]:hover {
    border-color: var(--success);
}

.boi .tick input[type="checkbox"]:checked {
    background: var(--success);
    border-color: var(--success);
}

.boi .tick input[type="checkbox"]:checked::before {
    content: '✓';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: white;
    font-weight: bold;
    font-size: 0.875rem;
    line-height: 1;
}

.boi .tick input[type="checkbox"]:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.2);
}

/* ---- Séparateurs ---- */
.boi .divider {
    background: linear-gradient(90deg, var(--primary) 0%, var(--primary-light) 100%);
    color: white;
    padding: 1rem 2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.875rem;
    border-top: 1px solid var(--gray-200);
    border-bottom: 1px solid var(--gray-200);
}

/* ---- Section compte rendu ---- */
.boi .cr-wrap {
    display: grid;
    grid-template-columns: 1.2fr 1fr 0.8fr;
    gap: 2rem;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--gray-200);
    background: white;
}

.boi .cr-group .lbl {
    font-size: 0.75rem;
    color: var(--primary);
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 0.75rem;
    letter-spacing: 0.05em;
}

.boi .inline {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
}

.boi .datebox .date-title {
    font-size: 0.75rem;
    color: var(--primary);
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 0.75rem;
    letter-spacing: 0.05em;
}

.boi .datebox input {
    border: 2px solid var(--gray-300);
    border-radius: var(--border-radius-sm);
    padding: 0.75rem;
    font-weight: 600;
    transition: all 0.2s ease;
    width: 100%;
}

.boi .datebox input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgb(59 130 246 / 0.1);
}

/* ---- En-tête détail prestation ---- */
.boi .detail-head {
    background: var(--gray-800);
    color: white;
    padding: 1rem 2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.875rem;
    border-top: 1px solid var(--gray-200);
    border-bottom: 1px solid var(--gray-200);
}

/* ---- Section heures ---- */
.boi .hours {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--gray-200);
    background: var(--gray-50);
}

.boi .hour {
    background: white;
    border: 1px solid var(--gray-200);
    border-radius: var(--border-radius-sm);
    padding: 1.25rem;
    box-shadow: var(--shadow-sm);
    transition: all 0.2s ease;
}

.boi .hour:hover {
    box-shadow: var(--shadow);
    border-color: var(--primary);
}

.boi .hour .H {
    font-weight: 700;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
    font-size: 0.75rem;
}

.boi .hour .time input {
    border: none;
    background: transparent;
    width: 100%;
    height: 2.5rem;
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--gray-800);
    outline: none;
    text-align: center;
}

/* ---- Lignes de détail ---- */
.boi .rows {
    padding: 0.5rem 2rem 1rem;
    background: white;
}

.boi .rowline {
    display: grid;
    grid-template-columns: 1.1fr 2.2fr;
    gap: 2rem;
    align-items: center;
    border-bottom: 1px solid var(--gray-100);
    padding: 1.25rem 0;
    transition: all 0.2s ease;
}

.boi .rowline:hover {
    background: var(--gray-50);
    margin: 0 -1rem;
    padding-left: 1rem;
    padding-right: 1rem;
    border-radius: var(--border-radius-sm);
}

.boi .rowline .label {
    font-weight: 600;
    color: var(--gray-700);
    font-size: 0.925rem;
}

.boi .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
}

.boi .dash {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--gray-50);
    padding: 0.5rem 1rem;
    border-radius: var(--border-radius-sm);
    border: 1px solid var(--gray-200);
}

.boi .dash span {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--gray-600);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.boi .dash input[type="text"] {
    border: none;
    background: transparent;
    padding: 0.25rem 0.5rem;
    min-width: 120px;
    font-weight: 500;
    color: var(--gray-800);
}

/* ---- Boutons radio et checkbox standard ---- */
.boi .form-check {
    display: flex;
    align-items: center;
    margin: 0 0.5rem 0.5rem 0;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: white;
    border: 1px solid var(--gray-200);
    border-radius: var(--border-radius-sm);
    transition: all 0.2s ease;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
}

.boi .form-check:hover {
    background: var(--gray-50);
    border-color: var(--primary);
}

.boi .form-check-input {
    margin: 0;
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--gray-300);
    transition: all 0.2s ease;
    flex-shrink: 0;
}

.boi .form-check-input:checked {
    background: var(--primary);
    border-color: var(--primary);
}

.boi .form-check-input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgb(59 130 246 / 0.1);
}

.boi .form-check-label {
    font-weight: 500;
    color: var(--gray-700);
    font-size: 0.875rem;
    cursor: pointer;
    margin: 0;
    line-height: 1.4;
}

.boi .inline > div,
.boi .choices > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
}

/* ---- Section commentaires ---- */
.boi .comments {
    padding: 1.5rem 2rem;
    background: var(--gray-50);
    border-top: 1px solid var(--gray-200);
}

.boi .comments .lbl {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    color: var(--primary);
    font-size: 0.75rem;
}

.boi .comments textarea {
    width: 100%;
    min-height: 120px;
    border: 2px solid var(--gray-300);
    border-radius: var(--border-radius-sm);
    padding: 1rem;
    font-family: inherit;
    font-size: 0.925rem;
    line-height: 1.5;
    transition: all 0.2s ease;
    resize: vertical;
}

.boi .comments textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgb(59 130 246 / 0.1);
}

/* ---- Section bon ---- */
.boi .bon {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    padding: 1.5rem 2rem;
    background: white;
    border-top: 1px solid var(--gray-200);
}

.boi .bon .lbl {
    font-size: 0.75rem;
    color: var(--primary);
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 0.75rem;
    letter-spacing: 0.05em;
}

.boi .bon input[disabled] {
    background: var(--gray-100);
    border: 2px solid var(--gray-300);
    border-radius: var(--border-radius-sm);
    color: var(--gray-700);
    padding: 0.75rem 1rem;
    font-weight: 600;
    width: 100%;
}

/* ---- Section signatures ---- */
.boi .sigs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding: 2rem;
    background: var(--gray-50);
    border-top: 1px solid var(--gray-200);
}

.boi .sigbox {
    background: white;
    border: 2px solid var(--gray-300);
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: all 0.2s ease;
}

.boi .sigbox:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-lg);
}

.boi .sigbox .cap {
    background: var(--primary);
    color: white;
    padding: 0.75rem 1rem;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    font-weight: 700;
    text-align: center;
}

.boi .sigbox .body {
    padding: 1rem;
    min-height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
}

.boi .sigbox input {
    border: none !important;
    background: transparent !important;
    width: 100%;
    text-align: center;
    font-weight: 600;
    color: var(--gray-800);
    font-size: 0.925rem;
}

/* ---- Canvas signature ---- */
.boi .sigbox-sign .body {
    padding: 0.5rem;
    min-height: 140px;
}

.boi .sigbox canvas {
    width: 100%;
    height: 100%;
    touch-action: none;
    display: block;
    cursor: crosshair;
    border-radius: 0.25rem;
}

/* ---- Outils signature ---- */
.boi .sigtools {
    background: var(--gray-100);
    padding: 0.75rem;
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    border-top: 1px solid var(--gray-200);
}

.boi .sigtools .btn {
    background: white;
    border: 1px solid var(--gray-300);
    border-radius: 0.375rem;
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--gray-700);
    transition: all 0.2s ease;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.boi .sigtools .btn:hover {
    background: var(--gray-50);
    border-color: var(--primary);
    color: var(--primary);
}

.boi .sigtools .btn:active {
    transform: translateY(1px);
}

/* ---- Bouton de soumission ---- */
.boi .submit {
    background: linear-gradient(135deg, var(--gray-800) 0%, var(--gray-700) 100%);
    padding: 2rem;
    display: flex;
    justify-content: center;
    border-top: 1px solid var(--gray-200);
}

.boi .submit .btn {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    color: white;
    border: none;
    border-radius: var(--border-radius);
    padding: 1rem 2.5rem;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-lg);
}

.boi .submit .btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-xl);
}

.boi .submit .btn:active {
    transform: translateY(0);
}

/* ---- Masquer éléments vides ---- */
.boi input[type="radio"][value=""] {
    display: none;
}

.boi input[type="radio"][value=""] + label {
    display: none;
}

/* ---- Responsive Design ---- */
@media (max-width: 1024px) {
    .boi {
        margin: 1rem auto;
        padding: 0 0.5rem;
    }
    
    .boi .sheet {
        border-radius: var(--border-radius-sm);
    }
    
    .boi .line {
        padding: 1rem 1.5rem;
    }
    
    .boi .cr-wrap,
    .boi .hours,
    .boi .bon {
        padding: 1rem 1.5rem;
    }
}

@media (max-width: 768px) {
    .boi .stamps {
        grid-template-columns: 1fr;
        gap: 1rem;
        padding: 1rem 1.5rem;
    }
    
    .boi .line {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
    
    .boi .tick-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;
        padding: 1rem 1.5rem;
    }
    
    .boi .cr-wrap {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }
    
    .boi .hours {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
    
    .boi .bon {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
    
    .boi .sigs {
        grid-template-columns: 1fr;
        gap: 1rem;
        padding: 1.5rem;
    }
    
    .boi .rowline {
        grid-template-columns: 1fr;
        gap: 1rem;
        text-align: left;
    }
    
    .boi .choices {
        justify-content: flex-start;
    }
}

@media (max-width: 480px) {
    .boi .tick-grid {
        grid-template-columns: 1fr;
    }
    
    .boi .tick {
        padding: 0.5rem;
        font-size: 0.8rem;
    }
    
    .boi .band {
        padding: 1rem;
        font-size: 1rem;
    }
    
    .boi .rows {
        padding: 0.5rem 1rem 1rem;
    }
    
    .boi .comments {
        padding: 1rem;
    }
}
</style>

<div class="boi">
  {{ form_start(form, {'attr': {'class': 'sheet'}}) }}

  <div class="band">Bon d'intervention – Compte rendu</div>

  <div class="stamps">
    <div class="stamp"></div>
    <div class="stamp"></div>
  </div>

  {# Client / Adresse / Ville #}
  <div class="line">
    <div class="field">
      <div class="lbl">Client</div>
      <div class="under">{{ form_widget(form.client, {'attr': {'class': 'form-control-plaintext', 'style':'padding:0'}}) }}</div>
    </div>
    <div class="field">
      <div class="lbl">Adresse</div>
      <div class="under">{{ form_widget(form.adresse, {'attr': {'class': 'form-control-plaintext', 'style':'padding:0'}}) }}</div>
    </div>
    <div class="field">
      <div class="lbl">Ville</div>
      <div class="under">{{ form_widget(form.ville, {'attr': {'class': 'form-control-plaintext', 'style':'padding:0'}}) }}</div>
    </div>
  </div>

  {# Veille #}
  <div class="tick-grid">
    <label class="tick">{{ form_widget(form.vIntrusion) }} Intrusion</label>
    <label class="tick">{{ form_widget(form.vIncendie) }} Incendie</label>
    <label class="tick">{{ form_widget(form.vAgression) }} Agression</label>
    <label class="tick">{{ form_widget(form.vDefautSecteur) }} Défaut secteur</label>

    <label class="tick">{{ form_widget(form.vDefautBatterie) }} Défaut batterie</label>
    <label class="tick">{{ form_widget(form.vAbsTest) }} ABS test</label>
    <label class="tick">{{ form_widget(form.vAbsMes) }} ABS MES</label>
    <label class="tick">{{ form_widget(form.vMhsNonAutorisee) }} MHS non autorisée</label>

    <label class="tick">{{ form_widget(form.vMaintenance) }} Maintenance</label>
    <label class="tick">{{ form_widget(form.vTechnique) }} Technique</label>
    <label class="tick">{{ form_widget(form.vAscenseur) }} Ascenseur</label>
    <label class="tick">{{ form_widget(form.vAutre) }} Autre</label>
  </div>

  <div class="divider">Compte rendu</div>

  <div class="cr-wrap">
    <div class="cr-group">
      <div class="lbl">Type d'intervention</div>
      <div class="inline">
        {{ form_widget(form.compteRendu) }}
      </div>
    </div>
    <div class="cr-group">
      <div class="lbl">Avec moyen d'accès</div>
      <div class="inline">
        {{ form_widget(form.avecMoyenAcces) }}
      </div>
    </div>
    <div class="datebox">
      <div class="date-title">Date</div>
      <div class="date-input">{{ form_widget(form.dateBon) }}</div>
    </div>
  </div>

  <div class="detail-head">Détail de la prestation</div>

  {# Heures #}
  <div class="hours">
    <div class="hour">
      <div class="H">Heure d'appel</div>
      <div class="time">{{ form_widget(form.heureAppel) }}</div>
    </div>
    <div class="hour">
      <div class="H">Heure d'arrivée</div>
      <div class="time">{{ form_widget(form.heureArrivee) }}</div>
    </div>
    <div class="hour">
      <div class="H">Heure de départ</div>
      <div class="time">{{ form_widget(form.heureDepart) }}</div>
    </div>
  </div>

  {# Lignes 1 choix #}
  <div class="rows">
    <div class="rowline">
      <div class="label">Constat météo</div>
      <div class="choices">{{ form_widget(form.constatMeteo) }}</div>
    </div>

    <div class="rowline">
      <div class="label">Circulation</div>
      <div class="choices">
        {{ form_widget(form.circulation) }}
        <span class="dash"><span>Motif</span>{{ form_widget(form.circulationMotif, {'attr': {'placeholder':'(si mauvaise)'}}) }}</span>
      </div>
    </div>

    <div class="rowline">
      <div class="label">Circuit de vérification</div>
      <div class="choices">
        {{ form_widget(form.circuitVerification) }}
        <span class="dash"><span>Points</span>{{ form_widget(form.circuitPoints, {'attr': {'placeholder':'(si extérieur)'}}) }}</span>
      </div>
    </div>

    <div class="rowline">
      <div class="label">Lumière allumée</div>
      <div class="choices">
        {{ form_widget(form.lumiereAllumee) }}
        <span class="dash"><span>Pièce</span>{{ form_widget(form.lumierePiece) }}</span>
      </div>
    </div>

    <div class="rowline">
      <div class="label">Issue(s) ouverte(s)</div>
      <div class="choices">
        {{ form_widget(form.issuesOuvertes) }}
        <span class="dash"><span>Lesquelles</span>{{ form_widget(form.issuesLesquelles) }}</span>
      </div>
    </div>

    <div class="rowline"><div class="label">Sirène en fonction</div><div class="choices">{{ form_widget(form.sireneEnFonction) }}</div></div>
    <div class="rowline"><div class="label">Système</div><div class="choices">{{ form_widget(form.systemeEtat) }}</div></div>
    <div class="rowline"><div class="label">Remise en service du système</div><div class="choices">{{ form_widget(form.remiseEnService) }}</div></div>
    <div class="rowline"><div class="label">Zones</div><div class="choices">{{ form_widget(form.zones) }}</div></div>
    <div class="rowline"><div class="label">Effraction constatée</div><div class="choices">{{ form_widget(form.effraction) }}</div></div>
    <div class="rowline"><div class="label">Présence</div><div class="choices">{{ form_widget(form.presence) }}</div></div>

    <div class="rowline">
      <div class="label">Mise en place de</div>
      <div class="choices">
        {{ form_widget(form.miseEnPlace) }}
        <span class="dash"><span>Demandé par</span>{{ form_widget(form.demandePar) }}</span>
      </div>
    </div>

    <div class="rowline">
      <div class="label">Personnel sur place</div>
      <div class="choices">
        {{ form_widget(form.personnelSurPlace) }}
        <span class="dash"><span>Précisions</span>{{ form_widget(form.personnelNote) }}</span>
      </div>
    </div>

    <div class="rowline">
      <div class="label">Véhicule sur place</div>
      <div class="choices">
        {{ form_widget(form.vehiculeSurPlace) }}
        <span class="dash"><span>Marque</span>{{ form_widget(form.vehiculeMarque) }}</span>
        <span class="dash"><span>N°</span>{{ form_widget(form.vehiculeNumero) }}</span>
      </div>
    </div>

    <div class="rowline">
      <div class="label">Présence d'animaux</div>
      <div class="choices">
        {{ form_widget(form.animaux) }}
        <span class="dash"><span>Espèce</span>{{ form_widget(form.animauxEspece) }}</span>
      </div>
    </div>
  </div>

  <div class="comments">
    <div class="lbl" style="font-weight:800;text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px">
      Commentaires de l'intervenant
    </div>
    {{ form_widget(form.commentaires) }}
  </div>

  <div class="bon">
    <div>
      <div class="lbl">Bon n°</div>
      {{ form_widget(form.bonNumero, {'attr': {'disabled':'disabled'}}) }}
    </div>
    <div>
      <div class="lbl">Bon d'intervention déposé</div>
      <div class="choices">
        {{ form_widget(form.bonDepose) }}
        <span class="dash"><span>Préciser</span>{{ form_widget(form.bonDeposePrecision) }}</span>
      </div>
    </div>
  </div>

{# --- Signatures --- #}
<div class="sigs">
  <div class="sigbox">
    <div class="cap">Intervenant</div>
    <div class="body">
      {{ form_widget(form.intervenant, {'attr': {'class':'form-control-plaintext', 'style':'border:0;max-width:90%'}}) }}
    </div>
  </div>

  <div class="sigbox">
    <div class="cap">Entreprise</div>
    <div class="body">
      {{ form_widget(form.entreprise, {'attr': {'class':'form-control-plaintext', 'style':'border:0;max-width:90%'}}) }}
    </div>
  </div>

  <div class="sigbox sigbox-sign">
    <div class="cap">Signature</div>

    <div class="body">
      <canvas id="signature-pad"></canvas>
    </div>

    {# boutons alignés sous la case signature #}
    <div class="sigtools btn-toolbar justify-content-center border-top">
      <div class="btn-group mt-2 mb-2">
        <button type="button" id="sig-undo" class="btn btn-sm btn-outline-secondary">
          <i class="bi bi-arrow-counterclockwise me-1"></i> Annuler
        </button>
        <button type="button" id="sig-clear" class="btn btn-sm btn-outline-danger">
          <i class="bi bi-eraser me-1"></i> Effacer
        </button>
      </div>
    </div>

    {# champ caché pour envoyer l'image base64 #}
    <div style="display:none">{{ form_widget(form.signature_draw) }}</div>
  </div>
</div>

  <div class="submit">
    <button type="submit" class="btn">
      <i class="bi bi-check-circle me-2"></i>
      Valider le bon d'intervention
    </button>
  </div>

  {{ form_end(form) }}
</div>

{# ======================== Signature Pad (JS) ============================= #}
<script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.6/dist/signature_pad.umd.min.js"></script>
<script>
(function(){
  const canvas = document.getElementById('signature-pad');
  if(!canvas) return;
  const hidden = document.getElementById('{{ form.signature_draw.vars.id }}');

  function fitCanvas(){
    const ratio = Math.max(window.devicePixelRatio || 1, 1);
    const rect = canvas.getBoundingClientRect();
    canvas.width  = rect.width * ratio;
    canvas.height = rect.height * ratio;
    canvas.getContext('2d').scale(ratio, ratio);
    canvas.style.width = rect.width + 'px';
    canvas.style.height = rect.height + 'px';
  }

  const pad = new SignaturePad(canvas, {
    minWidth: 0.8, 
    maxWidth: 2.5, 
    throttle: 16,
    backgroundColor: 'rgba(255,255,255,0)', 
    penColor: '#1e40af',
    velocityFilterWeight: 0.7,
    minDistance: 5,
  });

  // Fonction de redimensionnement améliorée
  function resizeCanvas() {
    const data = pad.toData();
    fitCanvas();
    pad.clear();
    pad.fromData(data);
  }

  // Gestionnaire de redimensionnement avec délai
  let resizeTimeout;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(resizeCanvas, 250);
  });

  // Initialisation
  setTimeout(fitCanvas, 100);

  // Gestionnaires des boutons
  const clearBtn = document.getElementById('sig-clear');
  const undoBtn = document.getElementById('sig-undo');

  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      pad.clear();
      hidden.value = '';
      clearBtn.style.transform = 'scale(0.95)';
      setTimeout(() => clearBtn.style.transform = '', 150);
    });
  }

  if (undoBtn) {
    undoBtn.addEventListener('click', () => {
      const data = pad.toData();
      if (data.length > 0) {
        data.pop();
        pad.fromData(data);
        undoBtn.style.transform = 'scale(0.95)';
        setTimeout(() => undoBtn.style.transform = '', 150);
      }
    });
  }

  // Mise à jour du champ caché lors de la signature
  pad.addEventListener('endStroke', () => {
    hidden.value = pad.isEmpty() ? '' : pad.toDataURL('image/png');
  });

  // Soumission du formulaire
  const form = canvas.closest('form');
  if (form) {
    form.addEventListener('submit', (e) => {
      hidden.value = pad.isEmpty() ? '' : pad.toDataURL('image/png');
    });
  }

  // Support tactile amélioré
  canvas.style.touchAction = 'none';
  
  // Prévenir le scroll sur mobile lors de la signature
  canvas.addEventListener('touchstart', (e) => {
    e.preventDefault();
  }, { passive: false });
  
  canvas.addEventListener('touchmove', (e) => {
    e.preventDefault();
  }, { passive: false });
})();

// Animation d'apparition des éléments lors du scroll
document.addEventListener('DOMContentLoaded', function() {
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
      }
    });
  }, observerOptions);

  // Observer tous les éléments avec animation
  document.querySelectorAll('.boi .rowline, .boi .hour, .boi .sigbox').forEach(el => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(20px)';
    el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
    observer.observe(el);
  });

  // Animation des checkboxes lors du check
  document.querySelectorAll('.boi input[type="checkbox"], .boi input[type="radio"]').forEach(input => {
    input.addEventListener('change', function() {
      if (this.checked) {
        this.parentElement.style.transform = 'scale(1.05)';
        setTimeout(() => {
          this.parentElement.style.transform = '';
        }, 200);
      }
    });
  });

  // Effet focus amélioré pour les champs
  document.querySelectorAll('.boi input, .boi textarea').forEach(field => {
    field.addEventListener('focus', function() {
      this.parentElement.style.transform = 'translateY(-2px)';
    });
    
    field.addEventListener('blur', function() {
      this.parentElement.style.transform = '';
    });
  });
});
</script>