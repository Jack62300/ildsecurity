{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <link rel="stylesheet" href="{{ asset('assets/css/home/index.css') }}">
{% endblock %}

{% block body %}
<div class="login-container">
  <div class="login-card" role="dialog" aria-labelledby="titre-login" aria-modal="true">
    
    {# ========== SECTION LOGO ========== #}
    <div class="logo-section">
      <h1 id="titre-login" class="visually-hidden">ILD SECURITY MANAGEMENT</h1>
      <div class="company-logo" aria-hidden="true">
        <img src="{{ asset('assets/images/logo.png') }}" alt="Logo ILD Security" class="img-fluid">
      </div>
      <h2 class="company-title">ILD SECURITY</h2>
      <p class="company-subtitle">Gestion clients</p>
    </div>

    {# ========== MESSAGES D'ERREUR ========== #}
    {% if error %}
      <div class="px-4 pt-3">
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>
          <strong>Erreur de connexion :</strong>
          {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
      </div>
    {% endif %}

    {# ========== FORMULAIRE ========== #}
    <div class="form-section">
      <form action="{{ path('app_login') }}" method="post">
        <div class="form-group email">
          <label class="visually-hidden" for="login">Adresse email</label>
          <input id="login" type="email" class="form-control" 
                 placeholder="Adresse email" 
                 autocomplete="username" 
                 name="email"
                 value="{{ last_username|default('') }}" 
                 required autofocus>
        </div>

        <div class="form-group password">
          <label class="visually-hidden" for="pwd">Mot de passe</label>
          <input id="pwd" type="password" class="form-control" 
                 placeholder="Mot de passe"
                 autocomplete="current-password" 
                 name="password" 
                 required>
        </div>

        <div class="form-group agency">
          <label class="visually-hidden" for="agence">Code agence</label>
          <input id="agence" type="text" class="form-control" 
                 placeholder="Code agence"
                 name="agence" 
                 required>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="d-grid">
          <button type="submit" class="btn btn-login" id="login-btn">
            <i class="bi bi-shield-check btn-icon"></i>
            <span class="btn-text">Se connecter</span>
          </button>
        </div>
      </form>
    </div>

    {# ========== FOOTER ========== #}
    <div class="footer-section">
      <div class="alert alert-warning" role="alert">
        <i class="bi bi-info-circle-fill me-2"></i>
        <strong>INFORMATION :</strong> La création de compte s'effectue auprès de la société
      </div>
    </div>
    
  </div>
</div>

{# ========== JAVASCRIPT ========== #}
<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.querySelector('form');
  const loginBtn = document.getElementById('login-btn');
  const btnText = loginBtn.querySelector('.btn-text');
  
  // Animation de soumission
  form.addEventListener('submit', function(e) {
    loginBtn.classList.add('loading');
    btnText.textContent = 'Connexion en cours...';
    loginBtn.disabled = true;
  });

  // Animation des champs au focus
  const formControls = document.querySelectorAll('.form-control');
  formControls.forEach(control => {
    control.addEventListener('focus', function() {
      this.parentElement.style.transform = 'translateY(-2px)';
    });
    
    control.addEventListener('blur', function() {
      this.parentElement.style.transform = 'translateY(0)';
    });
  });

  // Suppression automatique des alertes d'erreur après 8 secondes
  const errorAlerts = document.querySelectorAll('.alert-danger');
  errorAlerts.forEach(alert => {
    setTimeout(() => {
      alert.style.animation = 'slideOutUp 0.5s ease-in forwards';
      setTimeout(() => alert.remove(), 500);
    }, 8000);
  });
});

// Animation de sortie
const style = document.createElement('style');
style.textContent = `
  @keyframes slideOutUp {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(-20px); }
  }
`;
document.head.appendChild(style);
</script>
{% endblock %}