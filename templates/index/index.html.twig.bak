{% extends 'base.html.twig' %}

{% block title %}Clients{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <style>
   /* ========== VARIABLES CSS MODERNES ========== */
:root {
  --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  --card-shadow-hover: 0 15px 40px rgba(0, 0, 0, 0.12);
  --border-radius: 12px;
  --border-radius-lg: 16px;
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  --glass-bg: rgba(255, 255, 255, 0.98);
  --glass-border: rgba(0, 0, 0, 0.08);
  
  /* Nouvelles variables pour la recherche */
  --search-transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  --search-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  --search-shadow-focus: 0 4px 20px rgba(102, 126, 234, 0.12);
  --search-border: #e2e8f0;
  --search-border-focus: #667eea;
  --text-primary: #1e293b;
  --text-secondary: #64748b;
  --text-muted: #94a3b8;
}

/* ========== HEADER SECTION ========== */
.page-header {
  background: var(--primary-gradient);
  border-radius: var(--border-radius-lg);
  color: white;
  padding: 2rem;
  margin-bottom: 2rem;
  position: relative;
  overflow: hidden;
}
.page-header::before {
  content: '';
  position: absolute; top: 0; right: 0; width: 100%; height: 100%;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="80" cy="20" r="20" fill="rgba(255,255,255,0.1)"/><circle cx="90" cy="60" r="15" fill="rgba(255,255,255,0.08)"/><circle cx="70" cy="80" r="10" fill="rgba(255,255,255,0.06)"/></svg>');
  background-size: 200px 200px; opacity: 0.3;
}
.page-header h1 { font-size: 2.5rem; font-weight: 700; margin-bottom: .5rem; position: relative; z-index: 1; }
.page-header .subtitle { opacity: .9; font-size: 1.1rem; position: relative; z-index: 1; }

.btn-new-client {
  position: relative; z-index: 1;
  background: rgba(255,255,255,.15);
  border: 2px solid rgba(255,255,255,.3);
  color: #fff; font-weight: 600; border-radius: var(--border-radius);
  backdrop-filter: blur(10px);
  transition: var(--transition);
}
.btn-new-client:hover { background: rgba(255,255,255,.25); border-color: rgba(255,255,255,.5); color:#fff; transform: translateY(-2px); }

/* ========== BARRE DE RECHERCHE MODERNISÉE ========== */
.search-container { 
  position: relative; 
  margin-bottom: 2rem; 
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.search-field {
  position: relative;
  background: white;
  border-radius: var(--border-radius);
  box-shadow: var(--search-shadow);
  border: 2px solid var(--search-border);
  transition: var(--search-transition);
  overflow: hidden;
}

.search-field::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, var(--search-border-focus), #764ba2);
  opacity: 0;
  transition: var(--search-transition);
  z-index: 1;
}

.search-field:focus-within::before {
  opacity: 0.02;
}

.search-field:focus-within {
  border-color: var(--search-border-focus);
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1), var(--search-shadow-focus);
  transform: translateY(-1px);
}

.search-input-wrapper {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  padding: 0.875rem 1rem;
}

.search-icon {
  color: var(--text-muted);
  font-size: 1.2rem;
  margin-right: 0.875rem;
  transition: var(--search-transition);
  flex-shrink: 0;
}

.search-field:focus-within .search-icon {
  color: var(--search-border-focus);
  transform: scale(1.05);
}

.search-input {
  border: none;
  outline: none;
  background: transparent;
  font-size: 1rem;
  font-weight: 500;
  color: var(--text-primary);
  flex: 1;
  padding: 0.5rem 0;
}

.search-input::placeholder {
  color: var(--text-muted);
  font-weight: 400;
}

.search-clear {
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  padding: 0.5rem;
  border-radius: 50%;
  transition: var(--search-transition);
  opacity: 0;
  transform: scale(0.8);
  flex-shrink: 0;
  margin-left: 0.5rem;
}

.search-clear.show {
  opacity: 1;
  transform: scale(1);
}

.search-clear:hover {
  background: #fef2f2;
  color: #dc2626;
  transform: scale(1.05);
}

/* ========== RÉSULTATS DE RECHERCHE REPENSÉS ========== */
.search-results {
  position: absolute; 
  top: calc(100% + 0.5rem); 
  left: 0; 
  right: 0;
  background: var(--glass-bg); 
  backdrop-filter: blur(25px); 
  -webkit-backdrop-filter: blur(25px);
  border: 1px solid var(--glass-border); 
  border-radius: var(--border-radius);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
  z-index: 1050;
  max-height: 400px; 
  overflow: hidden;
  transform: translateY(-8px) scale(0.98); 
  opacity: 0; 
  pointer-events: none;
  transition: var(--search-transition);
}

.search-results.d-none {
  display: block !important;
}

.search-results:not(.d-none) {
  transform: translateY(0) scale(1); 
  opacity: 1;
  pointer-events: all;
  animation: searchSlideIn 0.25s ease-out forwards;
}

@keyframes searchSlideIn { 
  from {
    transform: translateY(-8px) scale(0.98); 
    opacity: 0;
  }
  to { 
    transform: translateY(0) scale(1); 
    opacity: 1; 
  } 
}

.search-results-header {
  padding: 0.875rem 1.25rem;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.search-results-list {
  overflow-y: auto;
  max-height: 320px;
}

.search-results-list::-webkit-scrollbar { width: 5px; }
.search-results-list::-webkit-scrollbar-track { background: rgba(0,0,0,.02); }
.search-results-list::-webkit-scrollbar-thumb { 
  background: linear-gradient(180deg, #667eea, #764ba2); 
  border-radius: 3px; 
}

.search-result-item {
  padding: 1rem 1.25rem; 
  border-bottom: 1px solid rgba(0, 0, 0, 0.03);
  cursor: pointer; 
  transition: var(--search-transition);
  display: flex; 
  align-items: center; 
  gap: 1rem; 
  position: relative;
  text-decoration: none;
  color: inherit;
}

.search-result-item:last-child { border-bottom: none; }

.search-result-item:hover {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.06), rgba(118, 75, 162, 0.03));
  transform: translateX(4px);
  padding-left: calc(1.25rem + 4px);
  border-left: 3px solid var(--search-border-focus);
}

/* ========== AVATAR OPTIMISÉ ========== */
.search-result-avatar {
  width: 48px; 
  height: 48px; 
  border-radius: var(--border-radius); 
  object-fit: cover; 
  background: linear-gradient(135deg, #f1f5f9, #e2e8f0); 
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08); 
  transition: var(--search-transition);
  flex-shrink: 0;
}

.search-result-item:hover .search-result-avatar { 
  transform: scale(1.05);
  box-shadow: 0 5px 15px rgba(102, 126, 234, 0.15); 
}

/* ========== INFORMATIONS CLIENT RESTRUCTURÉES ========== */
.search-result-content {
  flex: 1; 
  min-width: 0;
}

.search-result-name {
  font-size: 1rem; 
  font-weight: 600; 
  color: var(--text-primary); 
  margin: 0 0 0.25rem 0; 
  line-height: 1.3;
  transition: var(--search-transition);
}

.search-result-item:hover .search-result-name { 
  color: var(--search-border-focus); 
}

.search-result-org {
  display: inline-block;
  background: linear-gradient(135deg, #e0f2fe 0%, #b3e5fc 100%);
  color: #0277bd;
  font-size: 0.75rem;
  font-weight: 600;
  padding: 0.2rem 0.6rem;
  border-radius: 10px;
  margin-bottom: 0.3rem;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.search-result-address {
  font-size: 0.85rem; 
  color: var(--text-secondary); 
  margin: 0;
  display: flex; 
  align-items: center; 
  gap: 0.4rem;
  line-height: 1.4;
}

.search-result-address i {
  color: var(--text-muted); 
  font-size: 0.8rem;
  flex-shrink: 0;
}

/* ========== INDICATEUR D'ACTION ========== */
.search-result-action {
  opacity: 0;
  transform: translateX(8px);
  transition: var(--search-transition);
  color: var(--text-muted);
  font-size: 1rem;
  flex-shrink: 0;
}

.search-result-item:hover .search-result-action { 
  opacity: 1; 
  transform: translateX(0);
  color: var(--search-border-focus); 
}

/* ========== RESPONSIVE MOBILE OPTIMISÉ ========== */
@media (max-width: 768px) {
  .search-container {
    margin-bottom: 1.5rem;
    padding: 0 1rem;
    max-width: 100%;
  }

  .search-field {
    border-radius: 14px;
    box-shadow: 0 2px 15px rgba(0, 0, 0, 0.06);
  }

  .search-input-wrapper {
    padding: 1rem 1.25rem;
  }

  .search-input {
    font-size: 16px; /* Évite le zoom sur iOS */
    padding: 0.625rem 0;
  }

  .search-icon {
    font-size: 1.25rem;
    margin-right: 1rem;
  }

  .search-clear {
    padding: 0.625rem;
    margin-left: 0.75rem;
  }

  .search-results {
    border-radius: 14px;
    max-height: 320px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
  }

  .search-results-header {
    padding: 1rem 1.5rem;
    font-size: 0.8rem;
  }

  .search-result-item {
    padding: 1.25rem 1.5rem;
    gap: 1rem;
  }

  .search-result-item:hover {
    transform: translateX(0);
    padding-left: 1.5rem;
    border-left: 4px solid var(--search-border-focus);
  }

  .search-result-avatar {
    width: 50px;
    height: 50px;
  }

  .search-result-name {
    font-size: 1rem;
  }

  .search-result-org {
    font-size: 0.7rem;
    padding: 0.25rem 0.6rem;
  }

  .search-result-address {
    font-size: 0.85rem;
  }

  .search-result-action {
    font-size: 1.1rem;
  }

  /* Focus amélioré sur mobile */
  .search-field:focus-within {
    transform: translateY(-2px);
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.08), 0 8px 25px rgba(0, 0, 0, 0.12);
  }
}

@media (max-width: 480px) {
  .search-container {
    padding: 0 0.75rem;
  }

  .search-field {
    border-radius: 12px;
  }

  .search-input-wrapper {
    padding: 0.875rem 1rem;
  }

  .search-input {
    font-size: 16px;
    padding: 0.5rem 0;
  }

  .search-icon {
    font-size: 1.1rem;
    margin-right: 0.875rem;
  }

  .search-clear {
    padding: 0.5rem;
    margin-left: 0.5rem;
  }

  .search-results {
    max-height: 280px;
    border-radius: 12px;
  }

  .search-results-header {
    padding: 0.875rem 1.25rem;
  }

  .search-result-item {
    padding: 1rem 1.25rem;
    gap: 0.875rem;
  }

  .search-result-avatar {
    width: 45px;
    height: 45px;
  }

  .search-result-name {
    font-size: 0.95rem;
  }

  .search-result-org {
    font-size: 0.65rem;
    padding: 0.2rem 0.5rem;
  }

  .search-result-address {
    font-size: 0.8rem;
  }
}

/* ========== RESPONSIVE TABLETTE ========== */
@media (min-width: 769px) and (max-width: 1024px) {
  .search-container {
    max-width: 650px;
  }

  .search-input-wrapper {
    padding: 1rem 1.25rem;
  }

  .search-input {
    font-size: 1.05rem;
  }

  .search-results {
    max-height: 380px;
  }

  .search-result-item {
    padding: 1.125rem 1.375rem;
  }

  .search-result-avatar {
    width: 52px;
    height: 52px;
  }
}

/* ========== ÉTATS SPÉCIAUX AMÉLIORÉS ========== */
.search-results-empty { 
  padding: 2.5rem 1.5rem; 
  text-align: center; 
  color: var(--text-secondary); 
}

.search-results-empty-icon { 
  font-size: 2.5rem; 
  color: var(--text-muted); 
  margin-bottom: 1rem; 
  opacity: 0.6; 
}

.search-results-empty h6 { 
  font-weight: 600; 
  color: var(--text-primary); 
  margin-bottom: 0.5rem; 
  font-size: 1.1rem;
}

.search-results-empty p { 
  margin: 0; 
  font-size: 0.9rem; 
  opacity: 0.8;
  max-width: 250px;
  margin: 0 auto;
}

.search-results-error { 
  padding: 2rem 1.5rem; 
  text-align: center; 
  background: linear-gradient(135deg, rgba(248, 113, 113, 0.08), rgba(239, 68, 68, 0.04)); 
  color: #dc2626; 
  border-radius: var(--border-radius);
  margin: 0.5rem;
}

.search-results-error i { 
  font-size: 2rem; 
  margin-bottom: 1rem; 
  display: block; 
}

/* ========== LOADER AMÉLIORÉ ========== */
.modern-loader {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  padding: 1.5rem;
  text-align: center;
  color: var(--text-secondary);
  font-size: 0.9rem;
  font-weight: 500;
}

.loader-spinner {
  width: 20px;
  height: 20px;
  border: 2px solid #e2e8f0;
  border-top: 2px solid var(--search-border-focus);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* ========== ACCESSIBILITÉ ========== */
.search-field:focus-within {
  outline: 2px solid transparent;
}

.search-result-item:focus {
  outline: 2px solid var(--search-border-focus);
  outline-offset: -2px;
}

@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ========== DARK MODE SUPPORT ========== */
@media (prefers-color-scheme: dark) {
  :root {
    --glass-bg: rgba(15, 23, 42, 0.95);
    --glass-border: rgba(255, 255, 255, 0.1);
    --search-border: #334155;
    --text-primary: #f1f5f9;
    --text-secondary: #cbd5e0;
    --text-muted: #94a3b8;
  }
  
  .search-field {
    background: #1e293b;
  }
  
  .search-results-header {
    background: linear-gradient(135deg, #334155 0%, #475569 100%);
    color: #cbd5e0;
  }
  
  .search-result-item:hover {
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.12), rgba(118, 75, 162, 0.08));
  }
}

/* ========== RESTE DU CSS INCHANGÉ ========== */
.modern-table-container {
  background: white;
  border-radius: var(--border-radius-lg);
  box-shadow: var(--card-shadow);
  overflow: visible !important;
  margin-bottom: 2rem;
}

.modern-table { margin: 0; border: none; }
.modern-table thead th {
  background: linear-gradient(135deg,#f8fafc 0%,#e2e8f0 100%);
  color:#2d3748; font-weight:700; font-size:.9rem; text-transform: uppercase; letter-spacing:.5px;
  border:none; padding:1.25rem 1rem;
}
.modern-table tbody tr { transition: var(--transition); border: none; }
.modern-table tbody tr:hover { background:#f8fafc; transform: none !important; }
.modern-table tbody td { padding:1rem; border-top:1px solid rgba(0,0,0,.05); vertical-align: middle; }

.client-avatar { width:60px; height:60px; border-radius: var(--border-radius); object-fit:cover; box-shadow: 0 4px 12px rgba(0,0,0,.1); transition: var(--transition); }
.client-avatar:hover { transform: scale(1.1); }
.client-name { font-weight:600; font-size:1.1rem; color:#2d3748; }
.client-id { font-size:.8rem; color:#6c757d; font-weight:500; }

.org-badge { font-weight:600; font-size:.85rem; padding:.5rem 1rem; border-radius:50px; border:none; letter-spacing:.3px; position:relative; overflow:hidden; }
.org-badge::before { content:''; position:absolute; top:0; left:-100%; width:100%; height:100%; background:linear-gradient(90deg,transparent,rgba(255,255,255,.2),transparent); transition:left .5s; }
.org-badge:hover::before { left:100%; }

.actions-dropdown { position: relative; }
.actions-dropdown .dropdown-toggle {
  border-radius: var(--border-radius);
  border: 2px solid #e2e8f0; background:white; color:#4a5568; font-weight:600; transition: var(--transition);
}
.actions-dropdown .dropdown-toggle:hover { border-color:#667eea; color:#667eea; transform: translateY(-2px); }

.dropdown-menu {
  border: none; border-radius: var(--border-radius);
  box-shadow: var(--card-shadow-hover);
  padding: .5rem 0;
  z-index: 2001 !important;
}
.dropdown-item { padding:.75rem 1.5rem; font-weight:500; transition: var(--transition); }
.dropdown-item:hover { background:#f8fafc; color:#667eea; transform: translateX(5px); }
.dropdown-item.text-danger:hover { background:#fef2f2; color:#dc2626; }

.client-card { background:#fff; border-radius: var(--border-radius-lg); box-shadow: var(--card-shadow); margin-bottom:1.5rem; overflow:hidden; transition: var(--transition); }
.client-card:hover { box-shadow: var(--card-shadow-hover); transform: translateY(-5px); }
.client-card-header { display:flex; align-items:center; gap:1rem; padding:1.5rem; border-bottom:1px solid rgba(0,0,0,.05); }
.client-card-avatar { width:70px; height:70px; border-radius: var(--border-radius); object-fit: cover; box-shadow: 0 4px 12px rgba(0,0,0,.1); }
.client-card-info h5 { margin:0 0 .25rem 0; font-weight:700; color:#2d3748; }
.client-card-actions { display:flex; gap:.5rem; padding:1rem 1.5rem; }
.btn-card-action { flex:1; border-radius: var(--border-radius); font-weight:600; transition: var(--transition); display:flex; align-items:center; justify-content:center; gap:.5rem; }
.btn-card-action:hover { transform: translateY(-2px); }

.modern-pagination { display:flex; justify-content:center; gap:.5rem; margin-top:2rem; }
.modern-pagination .page-link { border:none; border-radius: var(--border-radius); padding:.75rem 1rem; color:#4a5568; font-weight:600; background:#fff; box-shadow: 0 2px 8px rgba(0,0,0,.05); transition: var(--transition); }
.modern-pagination .page-link:hover { background:#667eea; color:#fff; transform: translateY(-2px); }
.modern-pagination .page-item.active .page-link { background: var(--primary-gradient); color:#fff; box-shadow: var(--card-shadow); }
.modern-pagination .page-item.disabled .page-link { opacity:.5; cursor:not-allowed; }

@media (max-width: 768px) {
  .page-header { padding: 1.5rem; text-align: center; }
  .page-header h1 { font-size: 2rem; }
  .modern-table-container { display: none; }
}
@media (min-width: 769px) { .mobile-cards { display: none; } }

.empty-state { text-align:center; padding:4rem 2rem; background:#fff; border-radius: var(--border-radius-lg); box-shadow: var(--card-shadow); }
.empty-state-icon { font-size:4rem; color:#a0aec0; margin-bottom:1rem; }
.empty-state h4 { color:#2d3748; font-weight:600; margin-bottom:.5rem; }
.empty-state p { color:#6c757d; margin-bottom:0; }

.search-result-item:focus-visible { outline:2px solid #667eea; outline-offset:-2px; background: linear-gradient(135deg, rgba(102,126,234,.1), rgba(118,75,162,.05)); }
  </style>
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">

  {# ========== HEADER MODERNE ========== #}
  <div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h1>Gestion des Clients</h1>
        <p class="subtitle mb-0">{{ clients|length }} client{{ clients|length > 1 ? 's' : '' }} enregistré{{ clients|length > 1 ? 's' : '' }}</p>
      </div>
      {% if is_granted('ROLE_ADMIN') %}
       <a href="{{ path('clients_new') }}" class="btn btn-new-client me-2">
        <i class="bi bi-plus-lg me-2"></i>Nouveau Client
      </a>

      <button type="button" class="btn btn-new-client" id="open-export-modal" style="background: rgba(255,255,255,.25);">
        <i class="bi bi-download me-2"></i>Exporter
      </button>
      {% endif %}
    </div>
  </div>

  {# ========== BARRE DE RECHERCHE MODERNISÉE ========== #}
<div class="search-container">
  <div class="search-field">
    <div class="search-input-wrapper">
      <i class="bi bi-search search-icon"></i>
      <input type="search" id="client-search" class="search-input"
             placeholder="Rechercher un client par nom, organisme..."
             autocomplete="off" spellcheck="false">
      <button type="button" id="search-clear" class="search-clear">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>
  </div>
  
  {# Résultats de recherche repensés #}
  <div id="client-results" class="search-results d-none">
    <div class="search-results-header">
      <span><i class="bi bi-people me-1"></i>Résultats de recherche</span>
    </div>
    <div class="search-results-list" id="results-list">
      {# Contenu dynamique #}
    </div>
  </div>
  
  <div id="client-loader" class="modern-loader d-none">
    <div class="loader-spinner"></div>
    <span>Recherche en cours...</span>
  </div>
</div>

  {% set baseUpload = '/uploads/clients' %}
  {% set palette = ['primary','success','info','warning','danger','dark','secondary'] %}
  {% set orgColors = {} %}
  {% set orgCount = 0 %}

  {% if clients is empty %}
    <div class="empty-state">
      <i class="bi bi-people empty-state-icon"></i>
      <h4>Aucun client trouvé</h4>
      <p>Commencez par ajouter votre premier client pour voir la liste ici</p>
    </div>
  {% else %}

    {# ========== TABLEAU (Desktop) ========== #}
    <div class="modern-table-container">
      <table class="table modern-table">
        <thead>
          <tr>
            <th style="width: 80px;">Photo</th>
            <th>Client</th>
            <th>Organisme</th>
            <th>Adresse</th>
            <th style="width: 120px;" class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
        {% for c in clients %}
          {% set thumb = null %}
          {% if c.photos|length > 0 %}
            {% for p in c.photos %}
              {% if p.imageName and thumb is null %}
                {% set thumb = asset(baseUpload ~ '/' ~ p.imageName) %}
              {% endif %}
            {% endfor %}
          {% endif %}
          {% if not thumb %}
            {% set thumb = 'https://picsum.photos/120/120?grayscale&random=' ~ c.id %}
          {% endif %}

          {% set orgName = c.organisme ? c.organisme.name : 'Sans organisme' %}
          {% if orgColors[orgName] is not defined %}
            {% set orgColors = orgColors|merge({ (orgName): palette[orgCount % (palette|length)] }) %}
            {% set orgCount = orgCount + 1 %}
          {% endif %}
          {% set color = orgColors[orgName] %}

          <tr>
            <td><img src="{{ thumb }}" alt="Photo {{ c.nom }}" class="client-avatar" loading="lazy"></td>
            <td>
              <div class="client-name">{{ c.nom }}</div>
              <div class="client-id">#{{ c.id }}</div>
            </td>
            <td><span class="badge bg-{{ color }} org-badge">{{ orgName }}</span></td>
            <td class="text-truncate" style="max-width: 300px;" title="{{ c.adresse ?? '' }}">
              {% if c.adresse %}
                <i class="bi bi-geo-alt text-muted me-1"></i>
                {{ c.adresse|length > 50 ? c.adresse|slice(0,50) ~ '...' : c.adresse }}
              {% else %}
                <span class="text-muted fst-italic">Non renseignée</span>
              {% endif %}
            </td>
            <td class="text-center">
              <div class="dropdown actions-dropdown">
                <button class="btn btn-sm dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown"
                        data-bs-boundary="viewport"
                        data-bs-offset="0,8">
                  <i class="bi bi-three-dots"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li>
                    <a class="dropdown-item" href="{{ path('client_show', {id: c.id}) }}">
                      <i class="bi bi-eye me-2"></i>Voir le détail
                    </a>
                  </li>
                  {% if is_granted('ROLE_ADMIN') %}
                    <li>
                      <a class="dropdown-item" href="{{ path('clients_edit', {id: c.id}) }}">
                        <i class="bi bi-pencil me-2"></i>Modifier
                      </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                      <form method="post" action="{{ path('clients_delete', {id: c.id}) }}"
                            onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce client ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_client_' ~ c.id) }}">
                        <button class="dropdown-item text-danger" type="submit">
                          <i class="bi bi-trash me-2"></i>Supprimer
                        </button>
                      </form>
                    </li>
                  {% endif %}
                </ul>
              </div>
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>

    {# ========== CARTES MOBILES ========== #}
    <div class="mobile-cards">
      {% for c in clients %}
        {% set thumb = null %}
        {% if c.photos|length > 0 %}
          {% for p in c.photos %}
            {% if p.imageName and thumb is null %}
              {% set thumb = asset(baseUpload ~ '/' ~ p.imageName) %}
            {% endif %}
          {% endfor %}
        {% endif %}
        {% if not thumb %}
          {% set thumb = 'https://picsum.photos/120/120?grayscale&random=' ~ c.id %}
        {% endif %}

        {% set orgName = c.organisme ? c.organisme.name : 'Sans organisme' %}
        {% if orgColors[orgName] is not defined %}
          {% set orgColors = orgColors|merge({ (orgName): palette[orgCount % (palette|length)] }) %}
          {% set orgCount = orgCount + 1 %}
        {% endif %}
        {% set color = orgColors[orgName] %}

        <div class="client-card">
          <div class="client-card-header">
            <img src="{{ thumb }}" alt="Photo {{ c.nom }}" class="client-card-avatar" loading="lazy">
            <div class="client-card-info flex-grow-1">
              <h5>{{ c.nom }}</h5>
              <div class="mb-2"><span class="badge bg-{{ color }} org-badge">{{ orgName }}</span></div>
              {% if c.adresse %}
                <p class="text-muted small mb-0">
                  <i class="bi bi-geo-alt me-1"></i>{{ c.adresse|slice(0,60) }}{{ c.adresse|length > 60 ? '...' : '' }}
                </p>
              {% endif %}
            </div>
          </div>
          <div class="client-card-actions">
            <a href="{{ path('client_show', {id: c.id}) }}" class="btn btn-primary btn-card-action">
              <i class="bi bi-eye"></i>Voir
            </a>
            {% if is_granted('ROLE_ADMIN') %}
              <a href="{{ path('clients_edit', {id: c.id}) }}" class="btn btn-outline-secondary btn-card-action">
                <i class="bi bi-pencil"></i>Éditer
              </a>
              <form method="post" action="{{ path('clients_delete', {id: c.id}) }}" onsubmit="return confirm('Supprimer ce client ?');" class="d-inline flex-fill">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_client_' ~ c.id) }}">
                <button class="btn btn-outline-danger btn-card-action w-100">
                  <i class="bi bi-trash"></i>Suppr.
                </button>
              </form>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {# ========== PAGINATION ========== #}
    {% set current = pagination.currentPageNumber %}
    {% set total = pagination.pageCount %}
    {% if total > 1 %}
      <nav class="modern-pagination">
        <ul class="pagination mb-0">
          {% if current > 1 %}
            <li class="page-item">
              <a class="page-link" href="{{ path(app.request.attributes.get('_route'), app.request.query.all | merge({'page': current - 1})) }}">
                <i class="bi bi-chevron-left"></i>
              </a>
            </li>
          {% endif %}
          {% set start = current - 2 < 1 ? 1 : current - 2 %}
          {% set end = current + 2 > total ? total : current + 2 %}
          {% for page in start..end %}
            <li class="page-item {{ page == current ? 'active' : '' }}">
              <a class="page-link" href="{{ path(app.request.attributes.get('_route'), app.request.query.all | merge({'page': page})) }}">{{ page }}</a>
            </li>
          {% endfor %}
          {% if current < total %}
            <li class="page-item">
              <a class="page-link" href="{{ path(app.request.attributes.get('_route'), app.request.query.all | merge({'page': current + 1})) }}">
                <i class="bi bi-chevron-right"></i>
              </a>
            </li>
          {% endif %}
        </ul>
      </nav>
    {% endif %}

  {% endif %}
</div>
{# --- Mini styles du modal (autonomes) --- #}
<style>
  .modal-backdrop-simple{position:fixed;inset:0;background:rgba(15,23,42,.5);display:none;align-items:center;justify-content:center;z-index:9999}
  .modal-backdrop-simple.active{display:flex}
  .modal-card-simple{width:100%;max-width:720px;background:#fff;border-radius:14px;box-shadow:0 20px 60px rgba(0,0,0,.25);overflow:hidden}
  .modal-head{padding:1rem 1.25rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;display:flex;align-items:center;justify-content:space-between}
  .modal-body{padding:1rem 1.25rem}
  .modal-foot{padding:1rem 1.25rem;background:#f8fafc;display:flex;gap:.5rem;justify-content:flex-end}
  .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
  .label{font-weight:600;color:#334155;font-size:.95rem}
  .input, .select{width:100%;border:1px solid #e5e7eb;border-radius:10px;padding:.6rem .75rem}
  @media(max-width:640px){.grid-2{grid-template-columns:1fr}}
</style>

{# --- Construire un dictionnaire (id => libellé) d'organismes à partir des clients si tu ne passes pas "organismes" depuis le contrôleur --- #}
{% set orgMap = {} %}
{% for c in clients %}
  {% if c.organisme %}
    {% set orgMap = orgMap|merge({ (c.organisme.id): c.organisme.name }) %}
  {% endif %}
{% endfor %}

<div class="modal-backdrop-simple" id="exportModal" role="dialog" aria-hidden="true" aria-labelledby="exportTitle">
  <div class="modal-card-simple">
    <div class="modal-head">
      <h5 id="exportTitle" class="mb-0"><i class="bi bi-download me-2"></i>Exporter les clients (CSV)</h5>
      <button type="button" class="btn btn-light btn-sm" id="closeExportModal">Fermer</button>
    </div>

    <form action="{{ path('clients_export') }}" method="get">
      <div class="modal-body">
        <div class="grid-2">
          <div>
            <label class="label" for="q">Recherche</label>
            <input id="q" name="q" class="input" placeholder="Nom, adresse, organisme…">
          </div>
          <div>
            <label class="label" for="org">Organisme</label>
            <select id="org" name="org" class="select">
              <option value="">— Tous —</option>
              {% for id, name in orgMap %}
                <option value="{{ id }}">{{ name }}</option>
              {% endfor %}
              <option value="">Sans organisme</option>
            </select>
          </div>
        </div>

        <div class="mt-3">
          <label class="label" for="clients">Limiter à certains clients</label>
          <select id="clients" name="clients[]" class="select" size="8" multiple>
            {% for c in clients %}
              <option value="{{ c.id }}">{{ c.nom }}{% if c.organisme %} — {{ c.organisme.name }}{% endif %}</option>
            {% endfor %}
          </select>
          <small class="text-muted d-block mt-1">Laisser vide pour exporter tous les clients correspondant aux filtres.</small>
        </div>
      </div>

      <div class="modal-foot">
        <button type="button" class="btn btn-outline-secondary" id="cancelExport">Annuler</button>
        <button type="submit" class="btn btn-primary">
          <i class="bi bi-filetype-csv me-2"></i>Exporter en CSV
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  (function(){
    const openBtn = document.getElementById('open-export-modal');
    const modal   = document.getElementById('exportModal');
    const close1  = document.getElementById('closeExportModal');
    const close2  = document.getElementById('cancelExport');
    function open(){ modal.classList.add('active'); modal.setAttribute('aria-hidden','false'); }
    function close(){ modal.classList.remove('active'); modal.setAttribute('aria-hidden','true'); }
    openBtn?.addEventListener('click', open);
    close1?.addEventListener('click', close);
    close2?.addEventListener('click', close);
    modal?.addEventListener('click',(e)=>{ if(e.target===modal) close(); });
    document.addEventListener('keydown',(e)=>{ if(e.key==='Escape') close(); });
  })();
</script>
{# ========== JAVASCRIPT AMÉLIORÉ ========== #}
<script>
(function() {
  'use strict';
  
  const input = document.getElementById('client-search');
  const results = document.getElementById('client-results');
  const resultsList = document.getElementById('results-list');
  const loader = document.getElementById('client-loader');
  const clearBtn = document.getElementById('search-clear');
  
  if (!input || !results || !loader || !resultsList) return;

  const endpoint = "{{ path('clients_search') }}";
  let searchTimeout = null;
  let currentRequest = null;

  // Utilitaires
  const showLoader = () => loader.classList.remove('d-none');
  const hideLoader = () => loader.classList.add('d-none');
  const showResults = () => results.classList.remove('d-none');
  const hideResults = () => results.classList.add('d-none');
  const showClear = () => clearBtn.classList.add('show');
  const hideClear = () => clearBtn.classList.remove('show');

  // Templates de résultats
  function createSearchResultHTML(client) {
    const avatarUrl = client.avatar || `https://picsum.photos/100/100?grayscale&random=${client.id}`;
    const orgName = client.organisme || 'Sans organisme';
    const address = client.adresse || '';
    const truncatedAddress = address.length > 40 ? address.slice(0, 40) + '...' : address;
    
    return `
      <a href="/client/${client.id}" class="search-result-item">
        <img src="${avatarUrl}" alt="Photo ${client.nom}" class="search-result-avatar" loading="lazy">
        <div class="search-result-content">
          <h6 class="search-result-name">${client.nom}</h6>
          <div class="search-result-org">${orgName}</div>
          ${address ? `<div class="search-result-address">
            <i class="bi bi-geo-alt"></i>
            <span>${truncatedAddress}</span>
          </div>` : ''}
        </div>
        <i class="bi bi-arrow-right search-result-action"></i>
      </a>
    `;
  }

  function createEmptyStateHTML(query) {
    return `
      <div class="search-results-empty">
        <i class="bi bi-search search-results-empty-icon"></i>
        <h6>Aucun résultat trouvé</h6>
        <p>Aucun client ne correspond à "${query}"</p>
      </div>
    `;
  }

  function createErrorStateHTML() {
    return `
      <div class="search-results-error">
        <i class="bi bi-exclamation-triangle"></i>
        <h6>Erreur de recherche</h6>
        <p>Une erreur est survenue. Veuillez réessayer.</p>
      </div>
    `;
  }

  // Fonction de recherche
  function performSearch(query) {
    if (!query.trim()) {
      hideResults();
      hideLoader();
      hideClear();
      return;
    }

    showClear();
    showLoader();

    // Annuler la requête précédente si elle existe
    if (currentRequest) {
      currentRequest.abort();
    }

    const controller = new AbortController();
    currentRequest = controller;

    const url = new URL(endpoint, window.location.origin);
    url.searchParams.set('q', query.trim());

    fetch(url, { 
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
      signal: controller.signal
    })
    .then(response => {
      if (!response.ok) {
        throw new Error('Network response was not ok');
      }
      return response.json();
    })
    .then(data => {
      hideLoader();
      
      if (data.results && data.results.length > 0) {
        resultsList.innerHTML = data.results.map(createSearchResultHTML).join('');
        showResults();
      } else {
        resultsList.innerHTML = createEmptyStateHTML(query);
        showResults();
      }
    })
    .catch(error => {
      hideLoader();
      if (error.name !== 'AbortError') {
        resultsList.innerHTML = createErrorStateHTML();
        showResults();
      }
    })
    .finally(() => {
      currentRequest = null;
    });
  }

  // Événements
  input.addEventListener('input', function() {
    const query = this.value.trim();
    
    clearTimeout(searchTimeout);
    
    if (!query) {
      hideResults();
      hideClear();
      return;
    }

    searchTimeout = setTimeout(() => performSearch(query), 300);
  });

  input.addEventListener('focus', function() {
    if (this.value.trim()) {
      showResults();
      showClear();
    }
  });

  clearBtn.addEventListener('click', function() {
    input.value = '';
    input.focus();
    hideResults();
    hideClear();
    
    // Annuler toute recherche en cours
    if (currentRequest) {
      currentRequest.abort();
      hideLoader();
    }
  });

  // Fermer les résultats en cliquant à l'extérieur
  document.addEventListener('click', function(e) {
    if (!input.contains(e.target) && !results.contains(e.target)) {
      hideResults();
    }
  });

  // Navigation clavier
  input.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      hideResults();
      this.blur();
    }
  });

  // Gestion du clic sur les résultats
  results.addEventListener('click', function(e) {
    const resultItem = e.target.closest('.search-result-item');
    if (resultItem && resultItem.href) {
      // Laisser le comportement par défaut du lien
      hideResults();
    }
  });

  // Amélioration mobile - feedback haptique
  const isMobile = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
  
  if (isMobile) {
    results.addEventListener('touchstart', function(e) {
      const resultItem = e.target.closest('.search-result-item');
      if (resultItem && 'vibrate' in navigator) {
        navigator.vibrate(25);
      }
    });
  }

  // Accessibilité - navigation au clavier dans les résultats
  let currentFocus = -1;
  
  input.addEventListener('keydown', function(e) {
    const resultItems = results.querySelectorAll('.search-result-item');
    
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      currentFocus = Math.min(currentFocus + 1, resultItems.length - 1);
      updateFocus(resultItems);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      currentFocus = Math.max(currentFocus - 1, -1);
      if (currentFocus === -1) {
        input.focus();
        removeFocus(resultItems);
      } else {
        updateFocus(resultItems);
      }
    } else if (e.key === 'Enter' && currentFocus >= 0) {
      e.preventDefault();
      if (resultItems[currentFocus]) {
        resultItems[currentFocus].click();
      }
    }
  });

  function updateFocus(items) {
    removeFocus(items);
    if (items[currentFocus]) {
      items[currentFocus].style.background = 'linear-gradient(135deg, rgba(102, 126, 234, 0.15), rgba(118, 75, 162, 0.08))';
      items[currentFocus].scrollIntoView({ block: 'nearest' });
    }
  }

  function removeFocus(items) {
    items.forEach(item => {
      item.style.background = '';
    });
  }

  // Reset focus quand les résultats changent
  const observer = new MutationObserver(() => {
    currentFocus = -1;
  });
  observer.observe(resultsList, { childList: true });

})();
</script>
{% endblock %}