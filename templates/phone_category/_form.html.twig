



{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/phone_category/_form.css') }}">
{% endblock %}

{% block body %}
<div class="page-container">
  <div class="content-wrapper">
    
    <!-- Header de la page -->
    <section class="page-header">
      <div class="header-content">
        <h1 class="page-title">
          <span class="title-icon">
            {% if edit_mode|default(false) %}✏️{% else %}➕{% endif %}
          </span>
          {% if edit_mode|default(false) %}
            Modifier la catégorie
          {% else %}
            Nouvelle catégorie
          {% endif %}
        </h1>
        <p class="page-subtitle">
          {% if edit_mode|default(false) %}
            Mettez à jour les informations de votre catégorie
          {% else %}
            Créez une nouvelle catégorie pour organiser vos numéros de téléphone
          {% endif %}
        </p>
      </div>
    </section>

    <!-- Formulaire principal -->
    <section class="form-section">
      <div class="form-container">
        
        {{ form_start(form, {'attr': {'class': 'phone-category-form', 'novalidate': 'novalidate'}}) }}
        
        <!-- Section Informations -->
        <div class="form-section-group">
          <div class="section-header">
            <h2 class="section-title">
              <span class="section-icon">📝</span>
              Informations de la catégorie
            </h2>
            <p class="section-description">
              Définissez le nom et la description de votre catégorie
            </p>
          </div>
          
          <div class="form-fields">
            <div class="form-field-wrapper">
              {{ form_row(form.name, {
                'label': 'Nom de la catégorie',
                'attr': {
                  'placeholder': 'Ex: Urgences, Services publics, Contacts professionnels...',
                  'class': 'form-input'
                }
              }) }}
              <small class="field-hint">
                <span class="hint-icon">💡</span>
                Choisissez un nom clair et descriptif pour identifier facilement cette catégorie
              </small>
            </div>
            
            <div class="form-field-wrapper">
              {{ form_row(form.description, {
                'label': 'Description (optionnel)',
                'attr': {
                  'placeholder': 'Ajoutez une description pour préciser l\'usage de cette catégorie...',
                  'class': 'form-input',
                  'rows': 4
                }
              }) }}
              <small class="field-hint">
                <span class="hint-icon">💡</span>
                La description aide à mieux comprendre le contenu de cette catégorie
              </small>
            </div>
          </div>
        </div>

        <!-- Actions du formulaire -->
        <div class="form-actions mt-3">
          <div class="actions-group">
            <button type="submit" class="btn btn-primary">
              <span class="btn-icon">💾</span>
              <span class="btn-text">Enregistrer</span>
            </button>
            <a class="btn btn-secondary" href="{{ path('phone_category_index') }}">
              <span class="btn-icon">↩︎</span>
              <span class="btn-text">Annuler</span>
            </a>
          </div>
        </div>

        {{ form_end(form) }}
        
      </div>
    </section>

    <!-- Section aide (optionnelle) -->
    <aside class="help-section">
      <div class="help-card">
        <div class="help-icon">💡</div>
        <h3 class="help-title">Besoin d'aide ?</h3>
        <p class="help-text">
          Les catégories vous permettent d'organiser vos numéros de téléphone de manière structurée. 
          Vous pourrez ensuite associer plusieurs numéros à chaque catégorie.
        </p>
      </div>
    </aside>

  </div>
</div>
{% endblock %}
