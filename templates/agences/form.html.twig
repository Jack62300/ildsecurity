{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}{{ mode == 'new' ? 'Nouvelle agence' : 'Éditer agence #' ~ agence.id }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <style>
    /* ========== VARIABLES CSS MODERNES ========== */
    :root {
      --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      --card-shadow-hover: 0 15px 40px rgba(0, 0, 0, 0.12);
      --border-radius: 12px;
      --border-radius-lg: 16px;
      --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* ========== HEADER SECTION ========== */
    .page-header {
      background: var(--primary-gradient);
      border-radius: var(--border-radius-lg);
      color: white;
      padding: 2rem;
      margin-bottom: 2rem;
      position: relative;
      overflow: hidden;
    }

    .page-header::before {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      width: 100%;
      height: 100%;
      background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="80" cy="20" r="20" fill="rgba(255,255,255,0.1)"/><circle cx="90" cy="60" r="15" fill="rgba(255,255,255,0.08)"/><circle cx="70" cy="80" r="10" fill="rgba(255,255,255,0.06)"/></svg>');
      background-size: 200px 200px;
      opacity: 0.3;
    }

    .page-header h1 {
      font-size: 2.2rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      position: relative;
      z-index: 1;
    }

    .page-header .subtitle {
      opacity: 0.9;
      font-size: 1.1rem;
      position: relative;
      z-index: 1;
    }

    .breadcrumb-nav {
      position: relative;
      z-index: 1;
      margin-top: 1rem;
    }

    .breadcrumb-nav a {
      color: rgba(255, 255, 255, 0.8);
      text-decoration: none;
      transition: var(--transition);
    }

    .breadcrumb-nav a:hover {
      color: white;
    }

    .breadcrumb-nav .separator {
      color: rgba(255, 255, 255, 0.6);
      margin: 0 0.5rem;
    }

    /* ========== FORMULAIRE MODERNE ========== */
    .form-container {
      max-width: 700px;
      margin: 0 auto;
    }

    .modern-form-card {
      background: white;
      border-radius: var(--border-radius-lg);
      box-shadow: var(--card-shadow);
      overflow: hidden;
      transition: var(--transition);
    }

    .modern-form-card:hover {
      box-shadow: var(--card-shadow-hover);
    }

    .form-header {
      background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
      padding: 1.5rem 2rem;
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .form-header h2 {
      margin: 0;
      font-size: 1.5rem;
      font-weight: 700;
      color: #2d3748;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .form-icon {
      width: 40px;
      height: 40px;
      background: var(--primary-gradient);
      border-radius: var(--border-radius);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 1.2rem;
    }

    .form-body {
      padding: 2rem;
    }

    /* ========== CHAMPS DE FORMULAIRE MODERNES ========== */
    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-label {
      font-weight: 600;
      color: #2d3748;
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .form-label .required::after {
      content: '*';
      color: #dc2626;
      margin-left: 0.25rem;
    }

    .form-control {
      border: 2px solid #e2e8f0;
      border-radius: var(--border-radius);
      padding: 0.875rem 1rem;
      font-size: 1rem;
      transition: var(--transition);
      background: #fafbfc;
    }

    .form-control:focus {
      border-color: #667eea;
      background: white;
      box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
      outline: none;
    }

    .form-control:hover:not(:focus) {
      border-color: #cbd5e0;
      background: white;
    }

    /* ========== INPUT AVEC ICÔNES ========== */
    .input-group-modern {
      position: relative;
    }

    .input-icon {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: #6c757d;
      font-size: 1.1rem;
      z-index: 2;
    }

    .input-group-modern .form-control {
      padding-left: 3rem;
    }

    /* ========== BOUTONS MODERNES ========== */
    .form-actions {
      display: flex;
      gap: 1rem;
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(0, 0, 0, 0.05);
    }

    .btn-modern {
      padding: 0.875rem 2rem;
      font-weight: 600;
      border-radius: var(--border-radius);
      transition: var(--transition);
      display: flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 48px;
    }

    .btn-primary-modern {
      background: var(--primary-gradient);
      border: none;
      color: white;
    }

    .btn-primary-modern:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
      color: white;
    }

    .btn-secondary-modern {
      background: white;
      border: 2px solid #e2e8f0;
      color: #4a5568;
    }

    .btn-secondary-modern:hover {
      border-color: #cbd5e0;
      background: #f7fafc;
      transform: translateY(-1px);
      color: #4a5568;
    }

    /* ========== MESSAGES D'AIDE ========== */
    .form-help {
      font-size: 0.875rem;
      color: #6c757d;
      margin-top: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* ========== VALIDATION ÉTATS ========== */
    .is-invalid {
      border-color: #dc2626 !important;
      background: #fef2f2 !important;
    }

    .is-invalid:focus {
      box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.1) !important;
    }

    .invalid-feedback {
      color: #dc2626;
      font-size: 0.875rem;
      margin-top: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .is-valid {
      border-color: #10b981 !important;
      background: #f0fdf4 !important;
    }

    .is-valid:focus {
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1) !important;
    }

    /* ========== ANIMATIONS ========== */
    @keyframes slideInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .modern-form-card {
      animation: slideInUp 0.5s ease-out;
    }

    /* ========== RESPONSIVE ========== */
    @media (max-width: 768px) {
      .page-header {
        padding: 1.5rem;
        text-align: center;
      }

      .page-header h1 {
        font-size: 1.8rem;
      }

      .form-container {
        margin: 0 1rem;
      }

      .form-body {
        padding: 1.5rem;
      }

      .form-actions {
        flex-direction: column;
      }

      .btn-modern {
        justify-content: center;
        width: 100%;
      }
    }

    /* ========== LOADING STATE ========== */
    .btn-loading {
      position: relative;
      pointer-events: none;
    }

    .btn-loading::after {
      content: '';
      position: absolute;
      width: 20px;
      height: 20px;
      border: 2px solid transparent;
      border-top: 2px solid currentColor;
      border-radius: 50%;
      animation: spin 1s linear infinite;
      margin-left: 0.5rem;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
  </style>
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">

  {# ========== HEADER MODERNE ========== #}
  <div class="page-header">
    <div class="d-flex flex-column">
      <h1>
        {% if mode == 'new' %}
          <i class="bi bi-plus-circle me-2"></i>Nouvelle Agence
        {% else %}
          <i class="bi bi-pencil-square me-2"></i>Éditer l'Agence
        {% endif %}
      </h1>
      <p class="subtitle mb-0">
        {% if mode == 'new' %}
          Ajoutez une nouvelle agence à votre système
        {% else %}
          Modifiez les informations de l'agence #{{ agence.id }}
        {% endif %}
      </p>
      
      <nav class="breadcrumb-nav">
        <a href="{{ path('agences_index') }}">
          <i class="bi bi-house me-1"></i>Agences
        </a>
        <span class="separator">›</span>
        <span>{{ mode == 'new' ? 'Nouvelle agence' : 'Édition' }}</span>
      </nav>
    </div>
  </div>

  {# ========== FORMULAIRE MODERNE ========== #}
  <div class="form-container">
    <div class="modern-form-card">
      
      {# Header du formulaire #}
      <div class="form-header">
        <h2>
          <div class="form-icon">
            <i class="bi bi-building"></i>
          </div>
          Informations de l'agence
        </h2>
      </div>

      {# Corps du formulaire #}
      <div class="form-body">
        {{ form_start(form, {'attr': {'id': 'agence-form', 'novalidate': 'novalidate'}}) }}
          
          <div class="row g-4">
            
            {# Nom de l'agence #}
            <div class="col-12">
              <div class="form-group">
                {{ form_label(form.name, null, {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-group-modern">
                  <i class="bi bi-building input-icon"></i>
                  {{ form_widget(form.name, {
                    'attr': {
                      'class': 'form-control',
                      'placeholder': 'Nom de l\'agence (ex: Agence Paris Centre)'
                    }
                  }) }}
                </div>
                {% if form.name.vars.help %}
                  <div class="form-help">
                    <i class="bi bi-info-circle"></i>
                    {{ form.name.vars.help }}
                  </div>
                {% endif %}
                {{ form_errors(form.name) }}
              </div>
            </div>

            {# Email de l'agence #}
            <div class="col-12">
              <div class="form-group">
                {{ form_label(form.email, null, {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-group-modern">
                  <i class="bi bi-envelope input-icon"></i>
                  {{ form_widget(form.email, {
                    'attr': {
                      'class': 'form-control',
                      'placeholder': 'contact@agence.com'
                    }
                  }) }}
                </div>
                {% if form.email.vars.help %}
                  <div class="form-help">
                    <i class="bi bi-info-circle"></i>
                    {{ form.email.vars.help }}
                  </div>
                {% endif %}
                {{ form_errors(form.email) }}
              </div>
            </div>

            {# Code agence #}
            <div class="col-12">
              <div class="form-group">
                {{ form_label(form.codeAgence, null, {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-group-modern">
                  <i class="bi bi-hash input-icon"></i>
                  {{ form_widget(form.codeAgence, {
                    'attr': {
                      'class': 'form-control',
                      'placeholder': 'Code unique (ex: AG001, PAR-CTR)'
                    }
                  }) }}
                </div>
                {% if form.codeAgence.vars.help %}
                  <div class="form-help">
                    <i class="bi bi-info-circle"></i>
                    {{ form.codeAgence.vars.help }}
                  </div>
                {% else %}
                  <div class="form-help">
                    <i class="bi bi-lightbulb"></i>
                    Utilisez un code court et unique pour identifier cette agence
                  </div>
                {% endif %}
                {{ form_errors(form.codeAgence) }}
              </div>
            </div>

          </div>

          {# Actions du formulaire #}
          <div class="form-actions">
            <button type="submit" class="btn btn-primary-modern btn-modern" id="submit-btn">
              <i class="bi bi-check-lg"></i>
              {% if mode == 'new' %}Créer l'agence{% else %}Enregistrer les modifications{% endif %}
            </button>
            
            <a href="{{ path('agences_index') }}" class="btn btn-secondary-modern btn-modern">
              <i class="bi bi-x-lg"></i>
              Annuler
            </a>
          </div>

        {{ form_end(form) }}
      </div>
    </div>
  </div>
</div>

{# ========== JAVASCRIPT POUR UX AMÉLIORÉE ========== #}
<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('agence-form');
  const submitBtn = document.getElementById('submit-btn');
  
  if (!form || !submitBtn) return;

  // Animation de validation en temps réel
  const inputs = form.querySelectorAll('input[type="text"], input[type="email"]');
  
  inputs.forEach(input => {
    input.addEventListener('blur', function() {
      validateField(this);
    });
    
    input.addEventListener('input', function() {
      // Enlever les états d'erreur pendant la saisie
      this.classList.remove('is-invalid');
      const feedback = this.parentNode.parentNode.querySelector('.invalid-feedback');
      if (feedback) {
        feedback.style.display = 'none';
      }
    });
  });

  // Validation des champs
  function validateField(field) {
    const value = field.value.trim();
    let isValid = true;
    let message = '';

    // Validation selon le type de champ
    switch(field.name) {
      case 'agence[name]':
        isValid = value.length >= 2;
        message = 'Le nom doit contenir au moins 2 caractères';
        break;
      
      case 'agence[email]':
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        isValid = value === '' || emailRegex.test(value);
        message = 'Format d\'email invalide';
        break;
      
      case 'agence[codeAgence]':
        isValid = value.length >= 2 && value.length <= 20;
        message = 'Le code doit contenir entre 2 et 20 caractères';
        break;
    }

    // Appliquer les styles de validation
    if (value && isValid) {
      field.classList.remove('is-invalid');
      field.classList.add('is-valid');
    } else if (value && !isValid) {
      field.classList.remove('is-valid');
      field.classList.add('is-invalid');
      showFieldError(field, message);
    }
  }

  // Afficher l'erreur de champ
  function showFieldError(field, message) {
    const container = field.parentNode.parentNode;
    let feedback = container.querySelector('.invalid-feedback');
    
    if (!feedback) {
      feedback = document.createElement('div');
      feedback.className = 'invalid-feedback';
      container.appendChild(feedback);
    }
    
    feedback.innerHTML = `<i class="bi bi-exclamation-triangle"></i> ${message}`;
    feedback.style.display = 'flex';
  }

  // Animation de soumission
  form.addEventListener('submit', function(e) {
    // Validation finale
    let hasErrors = false;
    inputs.forEach(input => {
      validateField(input);
      if (input.classList.contains('is-invalid')) {
        hasErrors = true;
      }
    });

    if (!hasErrors) {
      // Animation de chargement
      submitBtn.classList.add('btn-loading');
      submitBtn.disabled = true;
      
      // Simuler un délai pour l'animation (optionnel)
      setTimeout(() => {
        // Le formulaire continuera sa soumission normale
      }, 100);
    }
  });

  // Auto-génération du code agence basé sur le nom (optionnel)
  const nameInput = form.querySelector('input[name="agence[name]"]');
  const codeInput = form.querySelector('input[name="agence[codeAgence]"]');
  
  if (nameInput && codeInput && !codeInput.value) {
    nameInput.addEventListener('input', function() {
      if (!codeInput.value) {
        const suggestion = this.value
          .toUpperCase()
          .replace(/[^A-Z0-9]/g, '')
          .substring(0, 6);
        codeInput.setAttribute('placeholder', suggestion ? `Suggestion: ${suggestion}` : 'Code unique');
      }
    });
  }
});
</script>
{% endblock %}