{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}{{ mode == 'new' ? 'Nouvelle agence' : 'Éditer agence #' ~ agence.id }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <link rel="stylesheet" href="{{ asset('styles/agences/form.css') }}">
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">

  {# ========== HEADER MODERNE ========== #}
  <div class="page-header">
    <div class="d-flex flex-column">
      <h1>
        {% if mode == 'new' %}
          <i class="bi bi-plus-circle me-2"></i>Nouvelle Agence
        {% else %}
          <i class="bi bi-pencil-square me-2"></i>Éditer l'Agence
        {% endif %}
      </h1>
      <p class="subtitle mb-0">
        {% if mode == 'new' %}
          Ajoutez une nouvelle agence à votre système
        {% else %}
          Modifiez les informations de l'agence #{{ agence.id }}
        {% endif %}
      </p>
      
      <nav class="breadcrumb-nav">
        <a href="{{ path('agences_index') }}">
          <i class="bi bi-house me-1"></i>Agences
        </a>
        <span class="separator">›</span>
        <span>{{ mode == 'new' ? 'Nouvelle agence' : 'Édition' }}</span>
      </nav>
    </div>
  </div>

  {# ========== FORMULAIRE MODERNE ========== #}
  <div class="form-container">
    <div class="modern-form-card">
      
      {# Header du formulaire #}
      <div class="form-header">
        <h2>
          <div class="form-icon">
            <i class="bi bi-building"></i>
          </div>
          Informations de l'agence
        </h2>
      </div>

      {# Corps du formulaire #}
      <div class="form-body">
        {{ form_start(form, {'attr': {'id': 'agence-form', 'novalidate': 'novalidate'}}) }}
          
          <div class="row g-4">
            
            {# Nom de l'agence #}
            <div class="col-12">
              <div class="form-group">
                {{ form_label(form.name, null, {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-group-modern">
                  <i class="bi bi-building input-icon"></i>
                  {{ form_widget(form.name, {
                    'attr': {
                      'class': 'form-control',
                      'placeholder': 'Nom de l\'agence (ex: Agence Paris Centre)'
                    }
                  }) }}
                </div>
                {% if form.name.vars.help %}
                  <div class="form-help">
                    <i class="bi bi-info-circle"></i>
                    {{ form.name.vars.help }}
                  </div>
                {% endif %}
                {{ form_errors(form.name) }}
              </div>
            </div>

            {# Email de l'agence #}
            <div class="col-12">
              <div class="form-group">
                {{ form_label(form.email, null, {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-group-modern">
                  <i class="bi bi-envelope input-icon"></i>
                  {{ form_widget(form.email, {
                    'attr': {
                      'class': 'form-control',
                      'placeholder': 'contact@agence.com'
                    }
                  }) }}
                </div>
                {% if form.email.vars.help %}
                  <div class="form-help">
                    <i class="bi bi-info-circle"></i>
                    {{ form.email.vars.help }}
                  </div>
                {% endif %}
                {{ form_errors(form.email) }}
              </div>
            </div>

            {# Code agence #}
            <div class="col-12">
              <div class="form-group">
                {{ form_label(form.codeAgence, null, {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-group-modern">
                  <i class="bi bi-hash input-icon"></i>
                  {{ form_widget(form.codeAgence, {
                    'attr': {
                      'class': 'form-control',
                      'placeholder': 'Code unique (ex: AG001, PAR-CTR)'
                    }
                  }) }}
                </div>
                {% if form.codeAgence.vars.help %}
                  <div class="form-help">
                    <i class="bi bi-info-circle"></i>
                    {{ form.codeAgence.vars.help }}
                  </div>
                {% else %}
                  <div class="form-help">
                    <i class="bi bi-lightbulb"></i>
                    Utilisez un code court et unique pour identifier cette agence
                  </div>
                {% endif %}
                {{ form_errors(form.codeAgence) }}
              </div>
            </div>

          </div>

          {# Actions du formulaire #}
          <div class="form-actions">
            <button type="submit" class="btn btn-primary-modern btn-modern" id="submit-btn">
              <i class="bi bi-check-lg"></i>
              {% if mode == 'new' %}Créer l'agence{% else %}Enregistrer les modifications{% endif %}
            </button>
            
            <a href="{{ path('agences_index') }}" class="btn btn-secondary-modern btn-modern">
              <i class="bi bi-x-lg"></i>
              Annuler
            </a>
          </div>

        {{ form_end(form) }}
      </div>
    </div>
  </div>
</div>

{# ========== JAVASCRIPT POUR UX AMÉLIORÉE ========== #}
<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('agence-form');
  const submitBtn = document.getElementById('submit-btn');
  
  if (!form || !submitBtn) return;

  // Animation de validation en temps réel
  const inputs = form.querySelectorAll('input[type="text"], input[type="email"]');
  
  inputs.forEach(input => {
    input.addEventListener('blur', function() {
      validateField(this);
    });
    
    input.addEventListener('input', function() {
      // Enlever les états d'erreur pendant la saisie
      this.classList.remove('is-invalid');
      const feedback = this.parentNode.parentNode.querySelector('.invalid-feedback');
      if (feedback) {
        feedback.style.display = 'none';
      }
    });
  });

  // Validation des champs
  function validateField(field) {
    const value = field.value.trim();
    let isValid = true;
    let message = '';

    // Validation selon le type de champ
    switch(field.name) {
      case 'agence[name]':
        isValid = value.length >= 2;
        message = 'Le nom doit contenir au moins 2 caractères';
        break;
      
      case 'agence[email]':
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        isValid = value === '' || emailRegex.test(value);
        message = 'Format d\'email invalide';
        break;
      
      case 'agence[codeAgence]':
        isValid = value.length >= 2 && value.length <= 20;
        message = 'Le code doit contenir entre 2 et 20 caractères';
        break;
    }

    // Appliquer les styles de validation
    if (value && isValid) {
      field.classList.remove('is-invalid');
      field.classList.add('is-valid');
    } else if (value && !isValid) {
      field.classList.remove('is-valid');
      field.classList.add('is-invalid');
      showFieldError(field, message);
    }
  }

  // Afficher l'erreur de champ
  function showFieldError(field, message) {
    const container = field.parentNode.parentNode;
    let feedback = container.querySelector('.invalid-feedback');
    
    if (!feedback) {
      feedback = document.createElement('div');
      feedback.className = 'invalid-feedback';
      container.appendChild(feedback);
    }
    
    feedback.innerHTML = `<i class="bi bi-exclamation-triangle"></i> ${message}`;
    feedback.style.display = 'flex';
  }

  // Animation de soumission
  form.addEventListener('submit', function(e) {
    // Validation finale
    let hasErrors = false;
    inputs.forEach(input => {
      validateField(input);
      if (input.classList.contains('is-invalid')) {
        hasErrors = true;
      }
    });

    if (!hasErrors) {
      // Animation de chargement
      submitBtn.classList.add('btn-loading');
      submitBtn.disabled = true;
      
      // Simuler un délai pour l'animation (optionnel)
      setTimeout(() => {
        // Le formulaire continuera sa soumission normale
      }, 100);
    }
  });

  // Auto-génération du code agence basé sur le nom (optionnel)
  const nameInput = form.querySelector('input[name="agence[name]"]');
  const codeInput = form.querySelector('input[name="agence[codeAgence]"]');
  
  if (nameInput && codeInput && !codeInput.value) {
    nameInput.addEventListener('input', function() {
      if (!codeInput.value) {
        const suggestion = this.value
          .toUpperCase()
          .replace(/[^A-Z0-9]/g, '')
          .substring(0, 6);
        codeInput.setAttribute('placeholder', suggestion ? `Suggestion: ${suggestion}` : 'Code unique');
      }
    });
  }
});
</script>
{% endblock %}