{% extends 'base.html.twig' %}

{% block title %}Agences{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <link rel="stylesheet" href="{{ asset('assets/css/agences/index.css') }}">
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">

  {# ========== HEADER MODERNE ========== #}
  <div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h1>Gestion des Agences</h1>
        <p class="subtitle mb-0">{{ agences|length }} agence{{ agences|length > 1 ? 's' : '' }} enregistrée{{ agences|length > 1 ? 's' : '' }}</p>
      </div>
      <a href="{{ path('agences_new') }}" class="btn btn-new-agence">
        <i class="bi bi-plus-lg me-2"></i>Nouvelle Agence
      </a>
    </div>
  </div>

  {# ========== MESSAGES FLASH ========== #}
  {% for m in app.flashes('agence_success') %}
    <div class="modern-alert alert-success">
      <i class="bi bi-check-circle-fill"></i>
      {{ m }}
    </div>
  {% endfor %}
  {% for m in app.flashes('agence_error') %}
    <div class="modern-alert alert-danger">
      <i class="bi bi-exclamation-triangle-fill"></i>
      {{ m }}
    </div>
  {% endfor %}

  {% if agences is empty %}
    {# ========== ÉTAT VIDE ========== #}
    <div class="empty-state">
      <i class="bi bi-building empty-state-icon"></i>
      <h4>Aucune agence trouvée</h4>
      <p>Commencez par ajouter votre première agence pour voir la liste ici</p>
    </div>
  {% else %}

    {# ========== TABLEAU MODERNE (Desktop) ========== #}
    <div class="modern-table-container">
      <div class="table-wrapper">
        <table class="table modern-table">
          <thead>
            <tr>
              <th style="width: 60px;">#</th>
              <th>Agence</th>
              <th>Contact</th>
              <th>Code</th>
              <th style="width: 120px;" class="text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
          {% for a in agences %}
            <tr>
              <td>
                <div class="agence-avatar">
                  {{ a.name|slice(0, 1)|upper }}
                </div>
              </td>
              <td>
                <div class="agence-name">{{ a.name }}</div>
                <div class="agence-id">#{{ a.id }}</div>
              </td>
              <td>
                {% if a.email %}
                  <i class="bi bi-envelope text-muted me-2"></i>{{ a.email }}
                {% else %}
                  <span class="text-muted fst-italic">Email non renseigné</span>
                {% endif %}
              </td>
              <td>
                <span class="code-badge">{{ a.codeAgence }}</span>
              </td>
              <td class="text-center">
                <div class="dropdown actions-dropdown">
                  <button class="btn btn-sm dropdown-toggle" 
                          type="button" 
                          data-bs-toggle="dropdown"
                          data-bs-boundary="viewport">
                    <i class="bi bi-three-dots"></i>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                      <a class="dropdown-item" href="{{ path('agences_edit', {id: a.id}) }}">
                        <i class="bi bi-pencil me-2"></i>Modifier
                      </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                      <form method="post" action="{{ path('agences_delete', {id: a.id}) }}"
                            onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette agence ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_agence_' ~ a.id) }}">
                        <button class="dropdown-item text-danger" type="submit">
                          <i class="bi bi-trash me-2"></i>Supprimer
                        </button>
                      </form>
                    </li>
                  </ul>
                </div>
              </td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    {# ========== CARTES MOBILES ========== #}
    <div class="mobile-cards">
      {% for a in agences %}
        <div class="agence-card">
          <div class="agence-card-header">
            <div class="agence-avatar">
              {{ a.name|slice(0, 1)|upper }}
            </div>
            <div class="agence-card-info flex-grow-1">
              <h5>{{ a.name }}</h5>
              {% if a.email %}
                <p class="text-muted small mb-2">
                  <i class="bi bi-envelope me-1"></i>{{ a.email }}
                </p>
              {% endif %}
              <div class="mb-0">
                <span class="code-badge">{{ a.codeAgence }}</span>
              </div>
            </div>
          </div>
          
          <div class="agence-card-actions">
            <a href="{{ path('agences_edit', {id: a.id}) }}" 
               class="btn btn-primary btn-card-action">
              <i class="bi bi-pencil"></i>Modifier
            </a>
            <form method="post" 
                  action="{{ path('agences_delete', {id: a.id}) }}"
                  onsubmit="return confirm('Supprimer cette agence ?');"
                  class="d-inline flex-fill">
              <input type="hidden" name="_token" value="{{ csrf_token('delete_agence_' ~ a.id) }}">
              <button class="btn btn-outline-danger btn-card-action w-100">
                <i class="bi bi-trash"></i>Supprimer
              </button>
            </form>
          </div>
        </div>
      {% endfor %}
    </div>

  {% endif %}
</div>
{% endblock %}