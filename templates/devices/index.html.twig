{% extends 'base.html.twig' %}

{% block title %}Appareils de confiance{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <link rel="stylesheet" href="{{ asset('styles/devices/index.css') }}">
{% endblock %}

{% block body %}
<div class="container px-4 py-3">

  {# ========== HEADER MODERNE ========== #}
  <div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h1>Appareils de confiance</h1>
        <p class="subtitle mb-0">{{ devices|length }} appareil{{ devices|length > 1 ? 's' : '' }} enregistré{{ devices|length > 1 ? 's' : '' }}</p>
      </div>
      {# <button class="btn btn-new-device">
        <i class="bi bi-plus-lg me-2"></i>Nouvel Appareil
      </button> #}
    </div>
  </div>

  {# ========== BARRE DE RECHERCHE ========== #}
  {# <div class="search-container">
    <div class="search-input-wrapper">
      <i class="bi bi-search search-icon"></i>
      <input type="search" id="device-search" class="search-input"
             placeholder="Rechercher un appareil par IP, utilisateur ou user-agent..."
             autocomplete="off" spellcheck="false">
      <button type="button" id="search-clear" class="search-clear">
        <i class="bi bi-x-circle-fill"></i>
      </button>
    </div>
  </div> #}

  {% if devices is empty %}
    <div class="empty-state">
      <i class="bi bi-shield-x empty-state-icon"></i>
      <h4>Aucun appareil trouvé</h4>
      <p>Les appareils de confiance apparaîtront ici une fois qu'ils seront enregistrés</p>
    </div>
  {% else %}

    {# ========== TABLEAU (Desktop) ========== #}
    <div class="modern-table-container">
      <table class="table modern-table">
        <thead>
          <tr>
            <th style="width: 80px;">Photo</th>
            <th>Appareil</th>
            <th>IP</th>
            <th>User-Agent</th>
            <th>Date</th>
            <th style="width: 120px;" class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
        {% for d in devices %}
          <tr>
            <td>
              <div class="device-avatar">
                <i class="bi bi-shield-check"></i>
              </div>
            </td>
            <td>
              <div class="device-name">Appareil #{{ d.id }}</div>
              <div class="device-id">{{ d.user.email }}</div>
            </td>
            <td>
              <span class="ip-badge">{{ d.ip }}</span>
            </td>
            <td class="text-truncate" style="max-width: 300px;" title="{{ d.userAgent }}">
              <i class="bi bi-browser-chrome text-muted me-1"></i>
              {{ d.userAgent|length > 40 ? d.userAgent|slice(0,40) ~ '...' : d.userAgent }}
            </td>
            <td>
              <div style="font-size: 0.9rem;">
                <div class="fw-semibold">{{ d.createdAt|date('d/m/Y') }}</div>
                <div class="text-muted small">{{ d.createdAt|date('H:i') }}</div>
              </div>
            </td>
            <td class="text-center">
              <div class="d-flex align-items-center justify-content-center gap-2">
                {% if d.approved %}
                  <span class="badge bg-success status-badge">Approuvé</span>
                {% else %}
                  <span class="badge bg-warning status-badge">En attente</span>
                {% endif %}
                
                <div class="dropdown actions-dropdown">
                  <button class="btn btn-sm dropdown-toggle"
                          type="button"
                          data-bs-toggle="dropdown"
                          data-bs-boundary="viewport"
                          data-bs-offset="0,8">
                    <i class="bi bi-three-dots"></i>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end">
                    {% if not d.approved %}
                      <li>
                        <a class="dropdown-item" href="{{ path('devices_approve_admin', {id: d.id}) }}" 
                           onclick="return confirm('Valider cet appareil ?');">
                          <i class="bi bi-check-circle text-success me-2"></i>Approuver
                        </a>
                      </li>
                      <li><hr class="dropdown-divider"></li>
                    {% endif %}
                    <li>
                      <form method="post" action="{{ path('devices_delete', {id: d.id}) }}" 
                            onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet appareil ?');" class="m-0">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_device_' ~ d.id) }}">
                        <button class="dropdown-item text-danger" type="submit">
                          <i class="bi bi-trash me-2"></i>Supprimer
                        </button>
                      </form>
                    </li>
                  </ul>
                </div>
              </div>
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>

    {# ========== CARTES MOBILES ========== #}
    <div class="mobile-cards">
      {% for d in devices %}
        <div class="device-card">
          <div class="device-card-header">
            <div class="device-card-avatar">
              <i class="bi bi-shield-check"></i>
            </div>
            <div class="device-card-info flex-grow-1">
              <h5>Appareil #{{ d.id }}</h5>
              <div class="mb-2">
                {% if d.approved %}
                  <span class="badge bg-success status-badge">Approuvé</span>
                {% else %}
                  <span class="badge bg-warning status-badge">En attente</span>
                {% endif %}
              </div>
              <p class="text-muted small mb-1">
                <i class="bi bi-person me-1"></i>{{ d.user.email }}
              </p>
              <p class="text-muted small mb-1">
                <i class="bi bi-globe me-1"></i><span class="ip-badge">{{ d.ip }}</span>
              </p>
              <p class="text-muted small mb-0">
                <i class="bi bi-calendar me-1"></i>{{ d.createdAt|date('d/m/Y H:i') }}
              </p>
            </div>
          </div>
          <div class="device-card-actions">
            {% if not d.approved %}
              <a href="{{ path('devices_approve_admin', {id: d.id}) }}" 
                 onclick="return confirm('Valider cet appareil ?');"
                 class="btn btn-success btn-card-action">
                <i class="bi bi-check-circle"></i>Approuver
              </a>
            {% endif %}
            <form method="post" action="{{ path('devices_delete', {id: d.id}) }}" 
                  onsubmit="return confirm('Supprimer cet appareil ?');" 
                  class="d-inline flex-fill">
              <input type="hidden" name="_token" value="{{ csrf_token('delete_device_' ~ d.id) }}">
              <button class="btn btn-outline-danger btn-card-action w-100">
                <i class="bi bi-trash"></i>Supprimer
              </button>
            </form>
          </div>
        </div>
      {% endfor %}
    </div>

  {% endif %}
</div>

{# ========== JAVASCRIPT ========== #}
<script>
(function() {
  const input = document.getElementById('device-search');
  const clearBtn = document.getElementById('search-clear');
  if (!input || !clearBtn) return;

  const showClear = () => clearBtn.classList.add('show');
  const hideClear = () => clearBtn.classList.remove('show');

  function performSearch(query) {
    const devices = document.querySelectorAll('.modern-table tbody tr, .device-card');
    
    devices.forEach(device => {
      const text = device.textContent.toLowerCase();
      if (text.includes(query.toLowerCase())) {
        device.style.display = '';
      } else {
        device.style.display = 'none';
      }
    });
  }

  input.addEventListener('input', function() {
    const q = this.value.trim();
    if (!q) { 
      hideClear(); 
      // Afficher tous les appareils
      const devices = document.querySelectorAll('.modern-table tbody tr, .device-card');
      devices.forEach(device => device.style.display = '');
      return; 
    }
    showClear();
    performSearch(q);
  });

  input.addEventListener('focus', function() {
    if (this.value.trim()) { showClear(); }
  });

  clearBtn.addEventListener('click', function() {
    input.value = ''; 
    input.focus(); 
    hideClear();
    // Afficher tous les appareils
    const devices = document.querySelectorAll('.modern-table tbody tr, .device-card');
    devices.forEach(device => device.style.display = '');
  });

  input.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { 
      // Afficher tous les appareils
      const devices = document.querySelectorAll('.modern-table tbody tr, .device-card');
      devices.forEach(device => device.style.display = '');
      this.blur(); 
    }
  });
})();
</script>
{% endblock %}