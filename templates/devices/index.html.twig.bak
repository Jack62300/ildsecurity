{% extends 'base.html.twig' %}

{% block title %}Appareils de confiance{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <style>
    /* ========== VARIABLES CSS MODERNES ========== */
    :root {
      --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      --card-shadow-hover: 0 15px 40px rgba(0, 0, 0, 0.12);
      --border-radius: 12px;
      --border-radius-lg: 16px;
      --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      --glass-bg: rgba(255, 255, 255, 0.95);
      --glass-border: rgba(255, 255, 255, 0.2);
    }

    /* ========== HEADER SECTION ========== */
    .page-header {
      background: var(--primary-gradient);
      border-radius: var(--border-radius-lg);
      color: white;
      padding: 2rem;
      margin-bottom: 2rem;
      position: relative;
      overflow: hidden;
    }
    .page-header::before {
      content: '';
      position: absolute; top: 0; right: 0; width: 100%; height: 100%;
      background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="80" cy="20" r="20" fill="rgba(255,255,255,0.1)"/><circle cx="90" cy="60" r="15" fill="rgba(255,255,255,0.08)"/><circle cx="70" cy="80" r="10" fill="rgba(255,255,255,0.06)"/></svg>');
      background-size: 200px 200px; opacity: 0.3;
    }
    .page-header h1 { font-size: 2.5rem; font-weight: 700; margin-bottom: .5rem; position: relative; z-index: 1; }
    .page-header .subtitle { opacity: .9; font-size: 1.1rem; position: relative; z-index: 1; }

    .btn-new-device {
      position: relative; z-index: 1;
      background: rgba(255,255,255,.15);
      border: 2px solid rgba(255,255,255,.3);
      color: #fff; font-weight: 600; border-radius: var(--border-radius);
      backdrop-filter: blur(10px);
      transition: var(--transition);
    }
    .btn-new-device:hover { background: rgba(255,255,255,.25); border-color: rgba(255,255,255,.5); color:#fff; transform: translateY(-2px); }

    /* ========== BARRE DE RECHERCHE ========== */
    .search-container { position: relative; margin-bottom: 2rem; }
    .search-input-wrapper { position: relative; max-width: 500px; margin: 0 auto; }
    .search-input {
      border: none; border-radius: var(--border-radius-lg);
      padding: 1rem 1rem 1rem 3rem; font-size: 1.1rem;
      background: white; box-shadow: var(--card-shadow);
      transition: var(--transition); width: 100%;
    }
    .search-input:focus { box-shadow: var(--card-shadow-hover); transform: translateY(-2px); outline: none; border: 2px solid #667eea; }
    .search-icon { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color:#6c757d; font-size:1.2rem; z-index:2; }
    .search-clear { position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); background: none; border: none; color:#6c757d; font-size:1.2rem; cursor: pointer; opacity: 0; transition: var(--transition); }
    .search-clear.show { opacity: 1; }
    .search-clear:hover { color: #dc3545; }

    /* ========== TABLEAU (Desktop) ========== */
    .modern-table-container {
      background: white;
      border-radius: var(--border-radius-lg);
      box-shadow: var(--card-shadow);
      overflow: visible !important;
      margin-bottom: 2rem;
    }
    .modern-table { margin: 0; border: none; }
    .modern-table thead th {
      background: linear-gradient(135deg,#f8fafc 0%,#e2e8f0 100%);
      color:#2d3748; font-weight:700; font-size:.9rem; text-transform: uppercase; letter-spacing:.5px;
      border:none; padding:1.25rem 1rem;
    }
    .modern-table tbody tr { transition: var(--transition); border: none; }
    .modern-table tbody tr:hover { background:#f8fafc; transform: none !important; }
    .modern-table tbody td { padding:1rem; border-top:1px solid rgba(0,0,0,.05); vertical-align: middle; }

    .device-avatar { 
      width:60px; height:60px; border-radius: var(--border-radius); 
      display: flex; align-items: center; justify-content: center;
      background: var(--primary-gradient);
      color: white; font-size: 1.5rem;
      box-shadow: 0 4px 12px rgba(0,0,0,.1); transition: var(--transition); 
    }
    .device-avatar:hover { transform: scale(1.1); }
    .device-name { font-weight:600; font-size:1.1rem; color:#2d3748; }
    .device-id { font-size:.8rem; color:#6c757d; font-weight:500; }

    /* ========== BADGES STATUT ========== */
    .status-badge { font-weight:600; font-size:.85rem; padding:.5rem 1rem; border-radius:50px; border:none; letter-spacing:.3px; position:relative; overflow:hidden; }
    .status-badge::before { content:''; position:absolute; top:0; left:-100%; width:100%; height:100%; background:linear-gradient(90deg,transparent,rgba(255,255,255,.2),transparent); transition:left .5s; }
    .status-badge:hover::before { left:100%; }

    /* Badge IP */
    .ip-badge { 
      background: rgba(102,126,234,0.1); 
      color: #667eea; 
      font-family: 'Courier New', monospace; 
      font-weight: 500; 
      padding: .4rem .8rem; 
      border-radius: var(--border-radius); 
      font-size: .85rem;
    }

    /* ========== DROPDOWN ACTIONS ========== */
    .actions-dropdown { position: relative; }
    .actions-dropdown .dropdown-toggle {
      border-radius: var(--border-radius);
      border: 2px solid #e2e8f0; background:white; color:#4a5568; font-weight:600; transition: var(--transition);
    }
    .actions-dropdown .dropdown-toggle:hover { border-color:#667eea; color:#667eea; transform: translateY(-2px); }

    .dropdown-menu {
      border: none; border-radius: var(--border-radius);
      box-shadow: var(--card-shadow-hover);
      padding: .5rem 0;
      z-index: 2001 !important;
    }
    .dropdown-item { padding:.75rem 1.5rem; font-weight:500; transition: var(--transition); }
    .dropdown-item:hover { background:#f8fafc; color:#667eea; transform: translateX(5px); }
    .dropdown-item.text-danger:hover { background:#fef2f2; color:#dc2626; }

    /* ========== CARTES MOBILES ========== */
    .device-card { background:#fff; border-radius: var(--border-radius-lg); box-shadow: var(--card-shadow); margin-bottom:1.5rem; overflow:hidden; transition: var(--transition); }
    .device-card:hover { box-shadow: var(--card-shadow-hover); transform: translateY(-5px); }
    .device-card-header { display:flex; align-items:center; gap:1rem; padding:1.5rem; border-bottom:1px solid rgba(0,0,0,.05); }
    .device-card-avatar { 
      width:70px; height:70px; border-radius: var(--border-radius); 
      display: flex; align-items: center; justify-content: center;
      background: var(--primary-gradient);
      color: white; font-size: 1.8rem;
      box-shadow: 0 4px 12px rgba(0,0,0,.1); 
    }
    .device-card-info h5 { margin:0 0 .25rem 0; font-weight:700; color:#2d3748; }
    .device-card-actions { display:flex; gap:.5rem; padding:1rem 1.5rem; }
    .btn-card-action { flex:1; border-radius: var(--border-radius); font-weight:600; transition: var(--transition); display:flex; align-items:center; justify-content:center; gap:.5rem; }
    .btn-card-action:hover { transform: translateY(-2px); }

    /* ========== RESPONSIVE ========== */
    @media (max-width: 768px) {
      .page-header { padding: 1.5rem; text-align: center; }
      .page-header h1 { font-size: 2rem; }
      .modern-table-container { display: none; }
      .search-input-wrapper { max-width: 100%; }
    }
    @media (min-width: 769px) { .mobile-cards { display: none; } }

    /* ========== ÉTAT VIDE ========== */
    .empty-state { text-align:center; padding:4rem 2rem; background:#fff; border-radius: var(--border-radius-lg); box-shadow: var(--card-shadow); }
    .empty-state-icon { font-size:4rem; color:#a0aec0; margin-bottom:1rem; }
    .empty-state h4 { color:#2d3748; font-weight:600; margin-bottom:.5rem; }
    .empty-state p { color:#6c757d; margin-bottom:0; }
  </style>
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">

  {# ========== HEADER MODERNE ========== #}
  <div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h1>Appareils de confiance</h1>
        <p class="subtitle mb-0">{{ devices|length }} appareil{{ devices|length > 1 ? 's' : '' }} enregistré{{ devices|length > 1 ? 's' : '' }}</p>
      </div>
      {# <button class="btn btn-new-device">
        <i class="bi bi-plus-lg me-2"></i>Nouvel Appareil
      </button> #}
    </div>
  </div>

  {# ========== BARRE DE RECHERCHE ========== #}
  {# <div class="search-container">
    <div class="search-input-wrapper">
      <i class="bi bi-search search-icon"></i>
      <input type="search" id="device-search" class="search-input"
             placeholder="Rechercher un appareil par IP, utilisateur ou user-agent..."
             autocomplete="off" spellcheck="false">
      <button type="button" id="search-clear" class="search-clear">
        <i class="bi bi-x-circle-fill"></i>
      </button>
    </div>
  </div> #}

  {% if devices is empty %}
    <div class="empty-state">
      <i class="bi bi-shield-x empty-state-icon"></i>
      <h4>Aucun appareil trouvé</h4>
      <p>Les appareils de confiance apparaîtront ici une fois qu'ils seront enregistrés</p>
    </div>
  {% else %}

    {# ========== TABLEAU (Desktop) ========== #}
    <div class="modern-table-container">
      <table class="table modern-table">
        <thead>
          <tr>
            <th style="width: 80px;">Photo</th>
            <th>Appareil</th>
            <th>IP</th>
            <th>User-Agent</th>
            <th>Date</th>
            <th style="width: 120px;" class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
        {% for d in devices %}
          <tr>
            <td>
              <div class="device-avatar">
                <i class="bi bi-shield-check"></i>
              </div>
            </td>
            <td>
              <div class="device-name">Appareil #{{ d.id }}</div>
              <div class="device-id">{{ d.user.email }}</div>
            </td>
            <td>
              <span class="ip-badge">{{ d.ip }}</span>
            </td>
            <td class="text-truncate" style="max-width: 300px;" title="{{ d.userAgent }}">
              <i class="bi bi-browser-chrome text-muted me-1"></i>
              {{ d.userAgent|length > 40 ? d.userAgent|slice(0,40) ~ '...' : d.userAgent }}
            </td>
            <td>
              <div style="font-size: 0.9rem;">
                <div class="fw-semibold">{{ d.createdAt|date('d/m/Y') }}</div>
                <div class="text-muted small">{{ d.createdAt|date('H:i') }}</div>
              </div>
            </td>
            <td class="text-center">
              <div class="d-flex align-items-center justify-content-center gap-2">
                {% if d.approved %}
                  <span class="badge bg-success status-badge">Approuvé</span>
                {% else %}
                  <span class="badge bg-warning status-badge">En attente</span>
                {% endif %}
                
                <div class="dropdown actions-dropdown">
                  <button class="btn btn-sm dropdown-toggle"
                          type="button"
                          data-bs-toggle="dropdown"
                          data-bs-boundary="viewport"
                          data-bs-offset="0,8">
                    <i class="bi bi-three-dots"></i>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end">
                    {% if not d.approved %}
                      <li>
                        <a class="dropdown-item" href="{{ path('devices_approve_admin', {id: d.id}) }}" 
                           onclick="return confirm('Valider cet appareil ?');">
                          <i class="bi bi-check-circle text-success me-2"></i>Approuver
                        </a>
                      </li>
                      <li><hr class="dropdown-divider"></li>
                    {% endif %}
                    <li>
                      <form method="post" action="{{ path('devices_delete', {id: d.id}) }}" 
                            onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet appareil ?');" class="m-0">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_device_' ~ d.id) }}">
                        <button class="dropdown-item text-danger" type="submit">
                          <i class="bi bi-trash me-2"></i>Supprimer
                        </button>
                      </form>
                    </li>
                  </ul>
                </div>
              </div>
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>

    {# ========== CARTES MOBILES ========== #}
    <div class="mobile-cards">
      {% for d in devices %}
        <div class="device-card">
          <div class="device-card-header">
            <div class="device-card-avatar">
              <i class="bi bi-shield-check"></i>
            </div>
            <div class="device-card-info flex-grow-1">
              <h5>Appareil #{{ d.id }}</h5>
              <div class="mb-2">
                {% if d.approved %}
                  <span class="badge bg-success status-badge">Approuvé</span>
                {% else %}
                  <span class="badge bg-warning status-badge">En attente</span>
                {% endif %}
              </div>
              <p class="text-muted small mb-1">
                <i class="bi bi-person me-1"></i>{{ d.user.email }}
              </p>
              <p class="text-muted small mb-1">
                <i class="bi bi-globe me-1"></i><span class="ip-badge">{{ d.ip }}</span>
              </p>
              <p class="text-muted small mb-0">
                <i class="bi bi-calendar me-1"></i>{{ d.createdAt|date('d/m/Y H:i') }}
              </p>
            </div>
          </div>
          <div class="device-card-actions">
            {% if not d.approved %}
              <a href="{{ path('devices_approve_admin', {id: d.id}) }}" 
                 onclick="return confirm('Valider cet appareil ?');"
                 class="btn btn-success btn-card-action">
                <i class="bi bi-check-circle"></i>Approuver
              </a>
            {% endif %}
            <form method="post" action="{{ path('devices_delete', {id: d.id}) }}" 
                  onsubmit="return confirm('Supprimer cet appareil ?');" 
                  class="d-inline flex-fill">
              <input type="hidden" name="_token" value="{{ csrf_token('delete_device_' ~ d.id) }}">
              <button class="btn btn-outline-danger btn-card-action w-100">
                <i class="bi bi-trash"></i>Supprimer
              </button>
            </form>
          </div>
        </div>
      {% endfor %}
    </div>

  {% endif %}
</div>

{# ========== JAVASCRIPT ========== #}
<script>
(function() {
  const input = document.getElementById('device-search');
  const clearBtn = document.getElementById('search-clear');
  if (!input || !clearBtn) return;

  const showClear = () => clearBtn.classList.add('show');
  const hideClear = () => clearBtn.classList.remove('show');

  function performSearch(query) {
    const devices = document.querySelectorAll('.modern-table tbody tr, .device-card');
    
    devices.forEach(device => {
      const text = device.textContent.toLowerCase();
      if (text.includes(query.toLowerCase())) {
        device.style.display = '';
      } else {
        device.style.display = 'none';
      }
    });
  }

  input.addEventListener('input', function() {
    const q = this.value.trim();
    if (!q) { 
      hideClear(); 
      // Afficher tous les appareils
      const devices = document.querySelectorAll('.modern-table tbody tr, .device-card');
      devices.forEach(device => device.style.display = '');
      return; 
    }
    showClear();
    performSearch(q);
  });

  input.addEventListener('focus', function() {
    if (this.value.trim()) { showClear(); }
  });

  clearBtn.addEventListener('click', function() {
    input.value = ''; 
    input.focus(); 
    hideClear();
    // Afficher tous les appareils
    const devices = document.querySelectorAll('.modern-table tbody tr, .device-card');
    devices.forEach(device => device.style.display = '');
  });

  input.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { 
      // Afficher tous les appareils
      const devices = document.querySelectorAll('.modern-table tbody tr, .device-card');
      devices.forEach(device => device.style.display = '');
      this.blur(); 
    }
  });
})();
</script>
{% endblock %}