{# Variables attendues:
  appName, approveUrl, ip, ua, userIdentifier, ttlHours, supportEmail (optionnel), logoUrl (optionnel)
#}
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ appName }} – Validation d'un nouvel appareil</title>
  <link rel="stylesheet" href="{{ asset('assets/css/email/trusted_device_approval.css') }}">
</head>
<body>
  <div class="email-wrapper">
    <table role="presentation" class="email-container">
      <!-- Header -->
      <tr>
        <td class="email-header">
          <div class="brand-section">
            {% if logoUrl %}
              <img class="brand-logo" src="{{ logoUrl }}" alt="{{ appName }} logo">
            {% endif %}
            <div class="brand-info">
              <h1>{{ appName }}</h1>
              <div class="brand-subtitle">Système de sécurité</div>
            </div>
          </div>
        </td>
      </tr>

      <!-- Contenu principal -->
      <tr>
        <td class="email-content">
          <!-- Alerte sécurité -->
          <div class="security-alert">
            <div class="alert-icon"></div>
            <h2 class="main-title">Nouvel appareil détecté</h2>
            <p class="main-description">
              Une tentative de connexion a été détectée sur le compte 
              <span class="user-highlight">{{ userIdentifier }}</span>
            </p>
          </div>

          <!-- Informations de l'appareil -->
          <div class="device-info">
            <h3 class="info-title">Détails de la connexion</h3>
            <div class="info-grid">
              <div class="info-item">
                <div class="info-icon">IP</div>
                <div class="info-content">
                  <div class="info-label">Adresse IP</div>
                  <div class="info-value">{{ ip }}</div>
                </div>
              </div>
              
              <div class="info-item">
                <div class="info-icon">UA</div>
                <div class="info-content">
                  <div class="info-label">Navigateur/Appareil</div>
                  <div class="info-value">{{ ua }}</div>
                </div>
              </div>
              
              <div class="info-item">
                <div class="info-icon">⏱</div>
                <div class="info-content">
                  <div class="info-label">Validité du lien</div>
                  <div class="info-value">{{ ttlHours }} heure{{ ttlHours > 1 ? 's' : '' }}</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Action de validation -->
          <div class="action-section">
            <p class="action-description">
              <strong>Si c'était bien vous</strong>, validez cet appareil pour autoriser les futures connexions :
            </p>
            
            <div class="btn-container">
              <a class="btn-primary" href="{{ approveUrl }}" target="_blank" rel="noopener">
                <span class="btn-text">
                  <span class="btn-icon"></span>
                  Valider cet appareil
                </span>
              </a>
            </div>
          </div>

          <!-- Avertissement sécurité -->
          <div class="security-warning">
            <p class="warning-text">
              <strong>Si vous n'êtes pas à l'origine de cette connexion</strong>, ignorez ce message et contactez immédiatement notre équipe de support. Votre compte pourrait être compromis.
            </p>
          </div>
        </td>
      </tr>

      <!-- Footer -->
      <tr>
        <td class="email-footer">
          <div class="footer-content">
            <p>
              <strong>{{ appName }}</strong> • Cet email a été envoyé automatiquement pour protéger votre compte.
              {% if supportEmail %}
                <br>Besoin d'aide ? Contactez-nous : <a href="mailto:{{ supportEmail }}" class="support-link">{{ supportEmail }}</a>
              {% endif %}
            </p>
            
            <div class="footer-note">
              Ce message de sécurité a été généré automatiquement. Merci de ne pas répondre à cet email.
            </div>
          </div>
        </td>
      </tr>
    </table>
  </div>

  <!-- Fallback pour certains clients email -->
  <div style="display:none; white-space:nowrap; font-size:0;">
    &zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;
  </div>
</body>
</html>