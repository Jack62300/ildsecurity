{% extends 'base.html.twig' %}
{% block title %}Suggestions à valider{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/modification/admin_index.css') }}">
{% endblock %}

{% block body %}
<div class="container py-4">
  {# === En-tête avec gradient === #}
  <div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
      <div class="header-content">
        <h1>Suggestions à valider</h1>
        <p class="subtitle mb-0">
          <span class="counter-badge">{{ pending|length }}</span> 
          suggestion{{ pending|length > 1 ? 's' : '' }} en attente
        </p>
      </div>
      <div class="header-actions">
        <button class="btn-refresh" id="refreshBtn" title="Rafraîchir">
          <i class="bi bi-arrow-clockwise"></i>
        </button>
      </div>
    </div>
  </div>

  {% if pending is empty %}
    {# === État vide === #}
    <div class="empty-state">
      <div class="empty-state-icon">
        <i class="bi bi-inbox"></i>
      </div>
      <h4>Aucune suggestion en attente</h4>
      <p>Toutes les suggestions ont été traitées. Tout est à jour !</p>
    </div>
  {% else %}
    {# === Liste des suggestions === #}
    <div class="suggestions-container">
      <div class="suggestions-header">
        <div class="suggestions-stats">
          <div class="stat-item">
            <i class="bi bi-clock-history"></i>
            <span>{{ pending|length }} en attente</span>
          </div>
        </div>
      </div>

      <div class="suggestions-list">
        {% for r in pending %}
          <a class="suggestion-card" href="{{ path('mod_request_review', {id: r.id}) }}">
            <div class="suggestion-icon">
              <i class="bi bi-pencil-square"></i>
            </div>
            
            <div class="suggestion-content">
              <div class="suggestion-main">
                <h5 class="suggestion-client">{{ r.client.nom }}</h5>
                {% if r.client.organisme %}
                  <span class="suggestion-org">{{ r.client.organisme }}</span>
                {% endif %}
              </div>
              
              <div class="suggestion-meta">
                <span class="suggestion-date">
                  <i class="bi bi-calendar3"></i>
                  {{ r.createdAt|date('d/m/Y à H:i') }}
                </span>
                {% if r.submittedByName %}
                  <span class="suggestion-author">
                    <i class="bi bi-person"></i>
                    {{ r.submittedByName }}
                  </span>
                {% endif %}
              </div>

              {% if r.comment %}
                <div class="suggestion-comment">
                  <i class="bi bi-chat-left-text"></i>
                  <span>{{ r.comment|length > 80 ? r.comment|slice(0, 80) ~ '...' : r.comment }}</span>
                </div>
              {% endif %}
            </div>

            <div class="suggestion-status">
              <span class="status-badge status-pending">
                <i class="bi bi-hourglass-split"></i>
                En attente
              </span>
              <i class="bi bi-chevron-right suggestion-arrow"></i>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

<script>
// Animation du bouton refresh
document.getElementById('refreshBtn')?.addEventListener('click', function() {
  this.classList.add('rotating');
  setTimeout(() => {
    location.reload();
  }, 500);
});
</script>
{% endblock %}